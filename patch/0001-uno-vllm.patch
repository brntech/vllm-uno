+    assert (output is result) if condition == "hit" else (output is None)
+    assert len(calls) == (1 if condition == "hit" else 0)
+    reason = {
+        "user_adapter": "user_adapters",
+        "dropped_adapter": "adapter_not_registered",
+        "debug_no_lora": "debug_no_lora",
+    }.get(condition)
