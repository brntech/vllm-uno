+"""CPU graph bookkeeping: prep freshness and draft-only adapter binding.
+
+Reuse 0015's fake CUDA recorder and execute the shipped prep kernel through
+the CPU language harness. This tests captured operation order and invalidation;
+it does not simulate CUDA's capture rules, cuBLAS, or attention/KV commits.
+"""
+
+import ast
+import contextlib
+import os
+import sys
+from collections import namedtuple
+from pathlib import Path
+from types import MethodType
+from types import SimpleNamespace as NS
+
+import numpy as np
+import pytest
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from test_uno_draftgraph import (  # noqa: E402
+    SOURCE,
+    UNO_ID,
+    Mapping,
+    dg,
+    live_inputs,
+    ns,
+)
