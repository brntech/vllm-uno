+    graphs = p._draft_graph_runner = dg.UnoDraftGraphRunner()
+    graphs.capture(p)
+    captured_adapter, captured_slots = manager.adapter, tuple(manager.lora_index_to_id)
+    captured_key = controller.binding_key
+    captured_plans = controller.plans if with_overlap else None
+    captured_native_plans = dict(runner._uno_lora_plans.entries)
+
+    def remove_all_adapters():
+        manager.registered.clear()
+        manager.adapter = None
+        manager.lora_index_to_id[:] = [None] * len(captured_slots)
+
+    def reload_adapter(request):
+        manager.adapter = NS(id=UNO_ID, weights=captured_adapter.weights)
+        manager.registered.add(UNO_ID)
+        manager.lora_index_to_id[:] = captured_slots
+
+    runner.lora_manager.add_adapter = reload_adapter
+    runner.lora_manager.remove_all_adapters = remove_all_adapters
+    runner.lora_manager.dummy_lora_cache = contextlib.nullcontext
+    runner.lora_manager.get_dummy_lora_warmup_rank = lambda rank: rank
+    runner.lora_manager.add_dummy_lora = lambda request, rank: manager.registered.add(
+        request.lora_int_id
+    )
