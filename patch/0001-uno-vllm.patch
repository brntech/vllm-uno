--- /dev/null
+++ b/vllm/v1/spec_decode/uno_draft_profile.py
@@ -0,0 +1,384 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in Uno step ranges; CUDA work is measured only in future GPU sessions.
+
+``UNO_DEBUG_TIMING=1`` enables this diagnostic. Ranges report inclusive host
+wall time and CUDA-stream elapsed intervals, NOT exclusive CPU compute or kernel
+activity. A CUDA event interval can contain host submission gaps and stream waits.
+Torch profiler traces supply actual CUDA activity and synchronization API waits.
+Nested categories must not be summed. Production timing uses a fresh server
+without this flag: range events and the terminal flush deliberately perturb it.
+
+Integration: begin_step(batch_size, k), span(name), execution(...), end_step().
+Install model ranges once after loading; no hooks or torch imports when disabled.
+"""
+
+import itertools
+import json
+import os
+import time
+from contextlib import nullcontext
+from functools import wraps
+
+PREFIX = "UNO_DRAFT_PROFILE "
+TRACE_PREFIX = "uno_dc/"
+_ACTIVE = None
+_IDS = itertools.count(1)
+_NOOP = nullcontext()
+
+
+def enabled():
+    return os.environ.get("UNO_DEBUG_TIMING", "").lower() in ("1", "true", "yes")
+
+
+class _Step:
+    def __init__(self, batch_size, k, step_id, cuda_events):
+        import torch
+
+        self.torch = torch
+        self.pid = os.getpid()
+        self.step_id = step_id
+        self.batch_size = batch_size
+        self.k = k
+        self.phase = "verify"
+        self.stack = []
+        self.records = []
+        self.executions = {}
+        self.graph_events = []
+        self.started_unix_ns = time.time_ns()
+        self.started = time.perf_counter_ns()
+        # False is used by CPU-only collector tests. Runtime default is True.
+        self.cuda = cuda_events and torch.cuda.is_available()
+        self.root_range = torch.profiler.record_function(
+            f"{TRACE_PREFIX}step/{self.pid}:{self.step_id}"
+        )
+        self.root_range.__enter__()
+
+
+class _Span:
+    def __init__(self, step, name, cuda_events):
+        self.step, self.name = step, name
+        self.cuda = step.cuda and cuda_events
+
+    def __enter__(self):
+        step = self.step
+        self.started = time.perf_counter_ns()
+        self.scope = step.torch.profiler.record_function(TRACE_PREFIX + self.name)
+        self.scope.__enter__()
+        self.start_event = self.end_event = None
+        if self.cuda:
+            self.start_event = step.torch.cuda.Event(enable_timing=True)
+            self.end_event = step.torch.cuda.Event(enable_timing=True)
+            self.start_event.record()
+        step.stack.append(self.name)
+        prefix = self.name.split(".", 1)[0]
+        if prefix in ("draft", "verify"):
+            step.phase = prefix
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        if self.end_event is not None:
+            self.end_event.record()
+        wall = (time.perf_counter_ns() - self.started) / 1e6
+        self.step.records.append(
+            {
+                "name": self.name,
+                "inclusive_host_wall_ms": wall,
+                "events": (self.start_event, self.end_event),
+                "exception": exc_type.__name__ if exc_type else None,
+            }
+        )
+        self.step.stack.pop()
+        self.scope.__exit__(exc_type, exc_value, traceback)
+        return False
+
+
+def begin_step(batch_size, k, step_id=None, *, cuda_events=True):
+    """Start one actual scheduler iteration, including target and next draft."""
+    global _ACTIVE
+    if not enabled():
+        return None
+    if _ACTIVE is not None:
+        raise RuntimeError(
+            "Uno draft profiler step was not closed before the next step"
+        )
+    if batch_size < 1 or k < 0:
+        raise ValueError("profile batch_size must be positive and k nonnegative")
+    _ACTIVE = _Step(
+        int(batch_size), int(k), next(_IDS) if step_id is None else step_id, cuda_events
+    )
+    return _ACTIVE.step_id
+
+
+def span(name, *, cuda_events=True):
+    """Range names use e.g. draft.mapping / draft.forward / verify.sample."""
+    if _ACTIVE is None:
+        return _NOOP
+    return _Span(_ACTIVE, name, cuda_events)
+
+
+def execution(phase, mode, actual_tokens, padded_tokens):
+    """Record the actual dispatcher decision, never infer it from concurrency."""
+    if _ACTIVE is not None:
+        _ACTIVE.phase = phase
+        _ACTIVE.executions[phase] = {
+            "mode": str(mode),
+            "actual_tokens": int(actual_tokens),
+            "padded_tokens": int(padded_tokens),
+        }
+
+
+def draft_k(k):
+    """Record this proposal's K, including dynamic-K bypass (zero)."""
+    if _ACTIVE is not None:
+        _ACTIVE.k = int(k)
+
+
+def graph_event(event, mode):
+    """Actual wrapper capture/replay, distinct from the dispatcher's intent."""
+    if _ACTIVE is not None:
+        _ACTIVE.graph_events.append(
+            {"phase": current_phase(), "event": event, "mode": str(mode)}
+        )
+
+
+def begin_runner_step(runner, batch_size):
+    if not enabled():
+        return None
+    sc = runner.speculative_config
+    if sc is None or not sc.use_uno():
+        return None
+    parallel = runner.parallel_config
+    distributed = any(
+        getattr(parallel, key, 1) != 1
+        for key in (
+            "tensor_parallel_size",
+            "pipeline_parallel_size",
+            "data_parallel_size",
+            "decode_context_parallel_size",
+            "prefill_context_parallel_size",
+        )
+    )
+    if (
+        distributed
+        or getattr(parallel, "use_ubatching", False)
+        or runner.is_pooling_model
+        or getattr(sc, "uno_fused", False)
+        or getattr(sc, "uno_lookup", False)
+    ):
+        raise ValueError(
+            "Uno draft profiling requires single-GPU two-pass generation "
+            "without microbatching or lookup routing"
+        )
+    return begin_step(batch_size, sc.num_speculative_tokens)
+
+
+def runner_lifecycle(*, sample=False):
+    """Close errors/early outputs; ordinary execute(None) continues into sample."""
+
+    def decorate(function):
+        if not enabled():
+            return function
+
+        @wraps(function)
+        def wrapped(*args, **kwargs):
+            try:
+                result = function(*args, **kwargs)
+            except BaseException as error:
+                end_step(error=error)
+                raise
+            if sample or result is not None:
+                end_step()
+            return result
+
+        return wrapped
+
+    return decorate
+
+
+def synchronize():
+    """Attribute existing legacy debug waits without adding a new device wait."""
+    import torch
+
+    with span("host.sync", cuda_events=False):
+        torch.cuda.synchronize()
+
+
+def end_step(*, error=None, emit=None):
+    """Flush after drafting/bookkeeping; emit a self-contained JSON log line.
+
+    The final event wait is reported separately from the preceding host wall
+    span. Existing debug synchronizations remain visible in torch-profiler
+    traces; none of their wall time is claimed as mapping CPU compute.
+    """
+    global _ACTIVE
+    step = _ACTIVE
+    if step is None:
+        return None
+    try:
+        host_wall = (time.perf_counter_ns() - step.started) / 1e6
+        flush_wait = 0.0
+        with step.torch.profiler.record_function(TRACE_PREFIX + "profile.flush_sync"):
+            if step.cuda:
+                terminal = step.torch.cuda.Event()
+                terminal.record()
+                wait_started = time.perf_counter_ns()
+                terminal.synchronize()
+                flush_wait = (time.perf_counter_ns() - wait_started) / 1e6
+        ranges = []
+        for record in step.records:
+            start, end = record["events"]
+            ranges.append(
+                {
+                    "name": record["name"],
+                    "inclusive_host_wall_ms": record["inclusive_host_wall_ms"],
+                    "stream_elapsed_ms": start.elapsed_time(end)
+                    if start is not None
+                    else None,
+                    "exception": record["exception"],
+                }
+            )
+        result = {
+            "schema": "uno-draft-profile-v1",
+            "pid": step.pid,
+            "step_id": step.step_id,
+            "batch_size": step.batch_size,
+            "k": step.k,
+            "started_unix_ns": step.started_unix_ns,
+            "host_wall_before_flush_ms": host_wall,
+            "profile_flush_host_wait_ms": flush_wait,
+            "cuda_events": step.cuda,
+            "executions": step.executions,
+            "graph_events": step.graph_events,
+            "ranges": ranges,
+            "error": None if error is None else str(error),
+        }
+        line = PREFIX + json.dumps(result, separators=(",", ":"), allow_nan=False)
+        if emit is None:
+            print(line, flush=True)
+        else:
+            emit(line)
+        return result
+    finally:
+        step.root_range.__exit__(None, None, None)
+        _ACTIVE = None
+
+
+def current_phase():
+    if _ACTIVE is None:
+        return "verify"
+    if _ACTIVE.stack:
+        return _ACTIVE.stack[-1].split(".", 1)[0]
+    return _ACTIVE.phase
+
+
+def profiled(name):
+    """Decorate a helper with a range; name may be a callable for phase labels."""
+
+    def decorate(function):
+        if not enabled():
+            return function
+
+        @wraps(function)
+        def wrapped(*args, **kwargs):
+            if _ACTIVE is None:
+                return function(*args, **kwargs)
+            with span(name() if callable(name) else name):
+                return function(*args, **kwargs)
+
+        return wrapped
+
+    return decorate
+
+
+def install_model_ranges(model, *, module_hooks=False):
+    """Install once for diagnostics; graph replay may hide these CPU ranges.
+
+    Attention labels target the actual vLLM Attention layer, excluding the
+    model's larger QwenAttention block that also contains projections. LoRA
+    projection wrappers are labeled projection_plus_lora; their base_layer gets
+    its own projection range. Explicit LoRA helper ranges can then take priority
+    in trace attribution. The two projections are NOT numerically subtracted.
+    Pass module_hooks=True only for eager profiling: dynamic module hooks can
+    alter Dynamo graph guards, while graph replay hides their CPU annotations.
+    """
+    if not enabled() or getattr(model, "_uno_dc_profile_installed", False):
+        return []
+    handles = []
+    projections = {
+        "qkv_proj",
+        "q_proj",
+        "k_proj",
+        "v_proj",
+        "o_proj",
+        "gate_up_proj",
+        "gate_proj",
+        "up_proj",
+        "down_proj",
+    }
+
+    def install(module, category):
+        contexts = []
+
+        def before(_module, _args):
+            ctx = span(f"{current_phase()}.{category}")
+            contexts.append(ctx)
+            ctx.__enter__()
+
+        def after(_module, _args, _output):
+            contexts.pop().__exit__(None, None, None)
+
+        handles.append(module.register_forward_pre_hook(before))
+        handles.append(module.register_forward_hook(after, always_call=True))
+
+    punica_seen = set()
+    for name, module in model.named_modules() if module_hooks else ():
+        # Hooks run inside forward, so wrapping is deliberately eager-only.
+        for key, hook in list(module._forward_hooks.items()):
+            if (
+                "UnoGatedLoRA" in getattr(hook, "__qualname__", "")
+                or "uno_gated_lora" in getattr(hook, "__module__", "")
+                or "uno_draft_cost_lora" in getattr(hook, "__module__", "")
+            ):
+                module._forward_hooks[key] = profiled(
+                    lambda: f"{current_phase()}.lora"
+                )(hook)
+        punica = getattr(module, "punica_wrapper", None)
+        if punica is not None and id(punica) not in punica_seen:
+            punica_seen.add(id(punica))
+            # Lowest common helpers avoid double-counting add_lora_linear.
+            for method in (
+                "add_shrink",
+                "add_expand",
+                "add_lora_embedding",
+                "add_lora_logits",
+            ):
+                if hasattr(punica, method):
+                    setattr(
+                        punica,
+                        method,
+                        profiled(lambda: f"{current_phase()}.lora")(
+                            getattr(punica, method)
+                        ),
+                    )
+        leaf = name.rsplit(".", 1)[-1]
+        namespace = type(module).__module__
+        if namespace.startswith("vllm.model_executor.layers.attention.") and hasattr(
+            module, "impl"
+        ):
+            install(module, "attention")
+        elif leaf in projections:
+            install(
+                module,
+                "projection_plus_lora"
+                if hasattr(module, "base_layer")
+                else "projection",
+            )
+        elif leaf == "base_layer" and name.rsplit(".", 2)[-2] in projections:
+            install(module, "projection")
+    if hasattr(model, "compute_logits"):
+        model.compute_logits = profiled(lambda: f"{current_phase()}.lm_head")(
+            model.compute_logits
+        )
+    model._uno_dc_profile_installed = True
+    model._uno_dc_profile_handles = handles
+    return handles
diff --git a/vllm/v1/spec_decode/uno_fused.py b/vllm/v1/spec_decode/uno_fused.py
