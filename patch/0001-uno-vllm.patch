+
+def test_layout_k1_is_bonus_only():
+    is_noise, sample_idx, lora_map = uno_query_layout(batch_size=3, k=1, uno_lora_id=5, device="cpu")
+    assert is_noise.tolist() == [False, False, False]
+    assert sample_idx.tolist() == [0, 1, 2]
+    assert lora_map == (0, 0, 0)
