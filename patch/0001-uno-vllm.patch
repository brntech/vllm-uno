+def test_noise_only_gathers_input_once_never_output_and_only_updates_active_rows(
+    monkeypatch,
+):
+    generator = torch.Generator().manual_seed(353)
+    specs, offsets = _specs(generator, dtype=torch.float64)
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=True, noise_only=True, share_a=False
+    )
+    hook = wrapper._make_hook(specs, offsets)
+    mask = torch.tensor([False, True, True, False, True, False])
+    indices = torch.tensor([1, 2, 4])
+    wrapper.arm(mask, row_indices=indices)
+    assert wrapper.row_indices is indices
+    x = torch.ones((6, 6), dtype=torch.float64)
+    y = torch.zeros((6, offsets[-1] + 1), dtype=torch.float64)
+    calls = []
+    real_select, real_add = torch.Tensor.index_select, torch.Tensor.index_add_
+
+    def select(tensor, dimension, selected):
+        calls.append(("gather", tensor is x, selected.tolist()))
+        return real_select(tensor, dimension, selected)
+
+    def add(tensor, dimension, selected, values):
+        calls.append(("scatter", values.shape[0], selected.tolist()))
+        return real_add(tensor, dimension, selected, values)
+
+    monkeypatch.setattr(torch.Tensor, "index_select", select)
+    monkeypatch.setattr(torch.Tensor, "index_add_", add)
+    hook(None, (x,), y)
+    assert calls == [("gather", True, [1, 2, 4]), ("scatter", 3, [1, 2, 4])]
+    assert torch.equal(y[~mask], torch.zeros_like(y[~mask]))
+
+
+def test_cached_selection_skips_nonzero_and_all_active_rows_skip_gather_scatter(
+    monkeypatch,
+):
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=False, noise_only=True, share_a=False
+    )
+    specs = [(torch.ones((2, 3)), torch.ones((4, 2)))]
+    hook = wrapper._make_hook(specs, [0, 4])
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError(
+            "cached/all-active layout should not perform this operation"
+        )
+
+    monkeypatch.setattr(torch.Tensor, "nonzero", forbidden)
+    wrapper.arm(torch.tensor([False, True]), row_indices=torch.tensor([1]))
+    wrapper.arm(torch.tensor([True, True]), all_rows=True)
+    monkeypatch.setattr(torch.Tensor, "index_select", forbidden)
+    monkeypatch.setattr(torch.Tensor, "index_add_", forbidden)
+    output = torch.zeros((2, 4))
+    hook(None, (torch.ones((2, 3)),), output)
+    torch.testing.assert_close(output, torch.full_like(output, 4.2))
+
+
+def test_uncached_selection_is_computed_once_per_arm_not_per_hook(monkeypatch):
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=False, noise_only=True, share_a=False
+    )
+    specs = [(torch.ones((2, 3)), torch.ones((4, 2)))]
+    hooks = [wrapper._make_hook(specs, [0, 4]) for _ in range(12)]
+    real_nonzero, calls = torch.Tensor.nonzero, []
+
+    def nonzero(tensor, *args, **kwargs):
+        calls.append(tensor)
+        return real_nonzero(tensor, *args, **kwargs)
+
+    monkeypatch.setattr(torch.Tensor, "nonzero", nonzero)
+    mask = torch.tensor([False, True, True])
+    wrapper.arm(mask)
+    for hook in hooks:
+        hook(None, (torch.ones((3, 3)),), torch.zeros((3, 4)))
+    assert len(calls) == 1
+    mask[1] = False
+    wrapper.arm(mask)
+    assert wrapper.row_indices.tolist() == [2]
+    assert len(calls) == 2
+
