+                    logger.info(
+                        "UNO_TIMING draft-pass ms: mean %.1f min %.1f max %.1f (last 50) graphs=%s phases(avg ms)=%s",
+                        sum(h) / len(h), min(h), max(h), use_graphs, laps,
+                    )
