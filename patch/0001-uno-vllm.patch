+    probs /= probs.sum(dim=-1, keepdim=True)
+    k, budget = 3, 13
+    tree = build_tree(probs, k, budget)
+    assert tree.tokens.shape == (3, budget)
+    assert tree.tokens.dtype == tree.parents.dtype == tree.depths.dtype == torch.long
+    for batch in range(3):
+        oracle = _brute(probs[batch], k, budget)
+        assert _paths(tree, batch) == [path for path, _ in oracle]
+        torch.testing.assert_close(
+            tree.scores[batch],
+            torch.tensor([score for _, score in oracle], dtype=torch.float64),
+        )
+        assert (tree.parents[batch] < torch.arange(budget)).all()
+        for node, path in enumerate(_paths(tree, batch)):
+            assert tree.depths[batch, node] == len(path)
+            assert (
+                tree.draft_probs[batch, node] == probs[batch, len(path) - 1, path[-1]]
+            )
+        assert len(set(_paths(tree, batch))) == budget
