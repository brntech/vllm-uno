+@pytest.mark.parametrize("with_overlap", [False, True])
+def test_capture_sampler_warmup_and_live_fallback_preserve_graph_bindings(
+    harness, binding, with_overlap
+):
+    """A live fallback must not strand graphs after startup's sampler warmup."""
+    controller, binding_manager, _ = binding
+    controller.route = None
+    manager, p = harness.manager, harness.proposer
+    manager.adapter = binding_manager.adapter
+    manager.adapter.id = UNO_ID
+    manager.modules = binding_manager.modules
+    manager._get_lora_layer_weights = binding_manager._get_lora_layer_weights
+    manager.get_adapter = lambda adapter_id: (
+        manager.adapter if adapter_id in manager.registered else None
+    )
+    if with_overlap:
+        p._lora_overlap = controller
+    runner = p.runner
+    runner.speculative_config = p.speculative_config
+    p.speculative_config.uno_draft_cost_cache_mapping = False
+    p.speculative_config.uno_no_host_sync = True
+    p.speculative_config.uno_lora_overlap = with_overlap
+    p.speculative_config.enforce_eager = True
+    runner.input_batch.num_reqs = 1
+    runner.input_batch.lora_id_to_lora_request = {}
+    runner.input_batch.make_lora_inputs = lambda scheduled, sampled: (
+        (0,) * int(sampled.sum()),
+        (0,) * int(scheduled.sum()),
+        set(),
+    )
+    logger = NS(info=lambda message, *args: harness.state.logs.append(message % args))
+    profile = NS(
+        profiled=lambda name: lambda function: function,
+        execution=lambda *args: None,
+        span=lambda name: contextlib.nullcontext(),
+    )
+    scope = {
+        "contextmanager": contextlib.contextmanager,
+        "LoRAConfig": object,
+        "LoRARequest": namedtuple("LoRARequest", "lora_name lora_int_id lora_path"),
+        "LoRAMappingType": NS(LANGUAGE="language"),
+        "LoRAMapping": lambda tokens, prompts, **kwargs: Mapping(tokens, prompts),
+        "UnoProposer": object,
+        "np": np,
+        "os": os,
+        "logger": logger,
+        "_dc_profile": profile,
+    }
+
+    def load_methods(target, path, names):
+        tree = ast.parse(path.read_text(encoding="utf-8"))
+        methods = [
+            node
+            for node in ast.walk(tree)
+            if isinstance(node, ast.FunctionDef) and node.name in names
+        ]
+        assert len(methods) == len(names)
+        exec(
+            compile(ast.Module(body=methods, type_ignores=[]), str(path), "exec"), scope
+        )
+        for method in methods:
+            setattr(target, method.name, MethodType(scope[method.name], target))
+        return tree
+
+    mixin_path = SOURCE / "vllm/v1/worker/lora_model_runner_mixin.py"
+    load_methods(
+        runner,
+        mixin_path,
+        {
+            "_ensure_lora_enabled",
+            "_set_active_loras",
+            "maybe_setup_dummy_loras",
+            "maybe_select_dummy_loras",
+            "maybe_dummy_run_with_lora",
+        },
+    )
+    runner_path = SOURCE / "vllm/v1/worker/gpu_model_runner.py"
+    load_methods(runner, runner_path, {"_install_uno_lora", "_uno_set_base_loras"})
+    uno_path = SOURCE / "vllm/v1/spec_decode/uno.py"
+    uno_tree = load_methods(
