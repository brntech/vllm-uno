+            if not seedrow_enabled and sparse is None:
+                draft_token_ids, draft_probs = self._sample_draft_tokens(
+                    sample_hidden_states, sampling_metadata
+                )
+            elif sparse is not None:
+                draft_token_ids, draft_probs = sparse.token_ids, None
+            junk = os.environ.get("UNO_DEBUG_DRAFT_JUNK")
+            if junk is not None:
+                # Gate knob (forced all-reject): every draft is one fixed id and the draft distribution is one-hot
+                # on it. Rejection sampling with q = one-hot(junk) accepts with prob p(junk) and otherwise samples
+                # the residual, so the output law must still be exactly p — a test of the recovery path.
+                jid = int(junk)
