+@pytest.mark.parametrize("with_overlap", [False, True])
+@pytest.mark.parametrize("seedrow", [False, True])
+def test_graph_prep_replays_fresh_inputs_and_shares_counter_with_fallback(
+    harness, prep, monkeypatch, with_overlap, seedrow
+):
+    p = harness.proposer
+    p.speculative_config.uno_fused_draft_prep = True
+    p.speculative_config.uno_seedrow_verify = seedrow
+    verify_width = 7 if seedrow else 8
+    p.runner.compilation_config.cudagraph_capture_sizes = [
+        batch * verify_width for batch in (1, 2, 4)
+    ]
+    p._draft_prep_step = torch.zeros((), dtype=torch.int64)
+    p.uno_noise_seed, p.uno_low, p.uno_high, p.block_size = 11, 1, 250624, 16
+    controller = OverlapScope()
+    if with_overlap:
+        p._lora_overlap = controller
+    model = p.model
+
+    def checked_model(**kwargs):
+        if with_overlap:
+            assert controller.route is not None
+        return model(**kwargs)
+
+    p.model = checked_model
+
+    def record_prepare(*args, **kwargs):
+        if harness.state.active is not None:
+            harness.state.active.ops.append(
+                lambda: prep.prepare_uno_draft(*args, **kwargs)
+            )
+        prep.prepare_uno_draft(*args, **kwargs)
+
+    monkeypatch.setitem(
+        sys.modules,
+        "vllm.v1.spec_decode.uno_draft_prep",
+        NS(DraftPrepInputs=prep.DraftPrepInputs, prepare_uno_draft=record_prepare),
+    )
+    graphs = dg.UnoDraftGraphRunner()
+    graphs.capture(p)
+    assert controller.route is None
+    assert p._draft_prep_step == 0
+    for step, batch in enumerate((1, 4, 3, 2, 1), 1):
+        raw, blocks = case(
+            prep, batch, 7, widths=[verify_width] * batch, rejected=step % 2 == 0
+        )
+        raw.next_token_ids = raw.next_token_ids.long() + step
+        ids, positions, cad = live_inputs(batch)
+        cad.block_table_tensor.copy_(blocks[:, :16])
+        expected = eager_oracle(
+            raw, cad.block_table_tensor, 7, step, 11, 1, 250624, 256
+        )
+        result = graphs.replay(
+            batch,
+            7,
+            ids,
+            positions,
+            cad,
+            harness.manager,
+            raw,
+            verify_width=verify_width,
+        )
+        if batch == 3:
+            assert result is None
+            actual = execute(
+                prep,
+                raw,
+                cad.block_table_tensor,
+                7,
+                p._draft_prep_step,
+                max_model_len=256,
+            )
+            assert all(torch.equal(got, want) for got, want in zip(actual, expected))
+        else:
+            entry = graphs.entries[batch, 7, verify_width]
+            actual = (
+                entry.input_ids,
+                entry.positions,
+                entry.slot_mapping,
+                entry.seq_lens,
+            )
+            assert all(torch.equal(got, want) for got, want in zip(actual, expected))
+            route = torch.tensor([-1] + [0] * 6).repeat(batch)
+            assert torch.equal(result, expected[0] + expected[1] + route)
+        assert p._draft_prep_step == step
+        assert controller.route is None
+    assert (graphs.replays, graphs.fallbacks) == (4, 1)
+
