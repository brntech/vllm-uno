+# SPDX-License-Identifier: Apache-2.0
+"""CPU execution of fused-prep arithmetic, not a CUDA compiler/capture test.
+
+A small Torch-backed implementation of Triton's loads/stores executes the
+actual kernel body. The oracle independently reproduces the existing DFlash
+position setup followed by fill_uno_noise and the bounds mask. GPU compilation,
+capture safety, and scheduler KV-commit behavior remain hardware gate checks.
+"""
+
+import ast
+import importlib.util
+import os
+import sys
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+SOURCE = Path(
+    os.environ.get("VLLM_UNO_SOURCE_ROOT", Path(__file__).resolve().parents[3])
+)
+
+
+class Pointer:
+    def __init__(self, tensor, offset=0):
+        self.tensor, self.offset = tensor, offset
+
+    def __add__(self, offset):
+        return Pointer(self.tensor, self.offset + offset)
+
+    def __sub__(self, offset):
+        return Pointer(self.tensor, self.offset - offset)
+
+
+class Language:
+    constexpr = int
+    int64 = torch.int64
+    arange = staticmethod(torch.arange)
+    full = staticmethod(
+        lambda shape, value, dtype: torch.full(shape, value, dtype=dtype)
+    )
+    where = staticmethod(torch.where)
+    program = (0, 0)
+
+    @classmethod
+    def program_id(cls, axis):
+        return torch.tensor(cls.program[axis], dtype=torch.int32)
+
+    @staticmethod
+    def minimum(value, other):
+        return value.clamp(max=other)
+
+    @staticmethod
+    def load(pointer, mask=None, other=0):
+        source = pointer.tensor.reshape(-1)
+        offset = torch.as_tensor(pointer.offset)
+        if mask is None:
+            return source[offset].clone()
+        output = torch.full(offset.shape, other, dtype=source.dtype)
+        output[mask] = source[offset[mask]]
+        return output
+
+    @staticmethod
+    def store(pointer, value, mask=None):
+        target = pointer.tensor.reshape(-1)
+        offset = torch.as_tensor(pointer.offset)
+        value = torch.as_tensor(value).to(target.dtype)
+        if mask is None:
+            target[offset] = value
+        else:
+            target[offset[mask]] = value.expand(offset.shape)[mask]
+
+
+class Kernel:
+    def __init__(self, function):
+        self.function = function
+
+    def __getitem__(self, grid):
+        if self.function.__name__ == "_prepare_uno_draft_kernel":
+            assert grid == (1,), "one CTA owns the shared step counter"
+
+        def launch(*args, num_warps=4, **kwargs):
+            pointers = [
+                Pointer(arg) if isinstance(arg, torch.Tensor) else arg for arg in args
+            ]
+            keywords = {
+                key: Pointer(value) if isinstance(value, torch.Tensor) else value
+                for key, value in kwargs.items()
+            }
+            for request in range(grid[0]):
+                for block in range(grid[1] if len(grid) > 1 else 1):
+                    Language.program = (request, block)
+                    self.function(*pointers, **keywords)
+
+        return launch
+
+
+def load_source(name, filename):
+    spec = importlib.util.spec_from_file_location(
+        name, SOURCE / "vllm/v1/spec_decode" / filename
+    )
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture(scope="module")
+def prep():
+    fake = types.ModuleType("vllm.triton_utils")
+    fake.tl = Language
+    fake.triton = types.SimpleNamespace(
+        jit=Kernel, next_power_of_2=lambda n: 1 << (n - 1).bit_length()
+    )
+    previous = sys.modules.get(fake.__name__)
+    sys.modules[fake.__name__] = fake
+    try:
+        yield load_source("uno_prep_under_test", "uno_draft_prep.py")
+    finally:
+        if previous is None:
+            del sys.modules[fake.__name__]
+        else:
+            sys.modules[fake.__name__] = previous
+
+
+noise = load_source("uno_noise_prep_oracle", "uno_noise.py")
+
+
+def original_expand_kernel():
+    tree = ast.parse((SOURCE / "vllm/v1/spec_decode/utils.py").read_text())
+    function = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "copy_and_expand_dflash_inputs_kernel"
+    )
+    namespace = {"tl": Language, "triton": types.SimpleNamespace(jit=Kernel)}
+    exec(
+        compile(ast.Module(body=[function], type_ignores=[]), "utils.py", "exec"),
+        namespace,
+    )
+    return namespace[function.name]
+
+
+expand_kernel = original_expand_kernel()
+
+
+def case(
+    prep, batch, k, *, rejected=True, large_positions=False, widths=None, starts=None
+):
+    # Variable target widths exercise request offsets, including padding and
+    # rejected suffixes. One valid context token always remains.
+    widths = (
+        torch.arange(batch, dtype=torch.int32) % (k + 1) + 1
+        if widths is None
+        else torch.tensor(widths, dtype=torch.int32)
+    )
+    qsl = torch.cat((torch.zeros(1, dtype=torch.int32), widths.cumsum(0).int()))
+    reject = widths // 2 if rejected else None
+    if starts is None:
+        starts = [2**40 if large_positions else i * 3 for i in range(batch)]
+    positions = torch.cat(
+        [torch.arange(int(width)) + starts[i] for i, width in enumerate(widths)]
+    )
+    inputs = prep.DraftPrepInputs(
+        torch.arange(batch, dtype=torch.int32) + 200,
+        positions,
+        qsl,
+        widths + 17,
+        reject,
+    )
+    # Large physical page ids prove that slot multiplication is 64-bit.
+    blocks = torch.arange(batch * 32, dtype=torch.int32).reshape(batch, 32)
+    blocks += 2**29
+    return inputs, blocks
+
+
+def eager_oracle(inputs, blocks, k, step, seed, low, high, max_model_len):
+    batch = inputs.next_token_ids.numel()
+    rejected = inputs.num_rejected_tokens
+    if rejected is None:
+        rejected = torch.zeros_like(inputs.seq_lens)
+    positions = torch.empty(batch * k, dtype=torch.int64)
+    slots = torch.empty_like(positions)
+    ids = torch.empty(batch * k, dtype=torch.int32)
+    width = int((inputs.query_start_loc[1:] - inputs.query_start_loc[:-1]).max())
+    block = min(256, 1 << (width + k - 1).bit_length())
+    expand_kernel[(batch, (width + k + block - 1) // block)](
+        next_token_ids_ptr=inputs.next_token_ids,
+        target_positions_ptr=inputs.target_positions,
+        out_input_ids_ptr=ids,
+        out_context_positions_ptr=torch.empty_like(inputs.target_positions),
+        out_query_positions_ptr=positions,
+        out_context_slot_mapping_ptr=torch.empty_like(inputs.target_positions),
+        out_query_slot_mapping_ptr=slots,
+        out_token_indices_ptr=torch.empty(batch * k, dtype=torch.int32),
+        block_table_ptr=blocks,
+        block_table_stride=blocks.stride(0),
+        query_start_loc_ptr=inputs.query_start_loc,
+        num_rejected_tokens_ptr=rejected,
+        parallel_drafting_token_id=0,
+        block_size=16,
+        num_query_per_req=k,
+        num_speculative_tokens=k,
+        total_input_tokens=inputs.target_positions.numel(),
+        BLOCK_SIZE=block,
+        HAS_NUM_REJECTED=True,
+    )
+    slots.masked_fill_(positions >= max_model_len, -1)
+    mask = torch.arange(batch * k) % k != 0
+    seeds = (torch.arange(batch, dtype=torch.int64) + seed).repeat_interleave(k)
+    noise.fill_uno_noise(ids, mask, seeds, step, low, high)
+    return ids, positions, slots, inputs.seq_lens - rejected + k
+
+
+def execute(
+    prep, inputs, blocks, k, counter, *, seed=11, low=1, high=250624, max_model_len=81
+):
+    batch = inputs.next_token_ids.numel()
+    outputs = (
+        torch.empty(batch * k, dtype=torch.int32),
+        torch.empty(batch * k, dtype=torch.int64),
+        torch.empty(batch * k, dtype=torch.int64),
+        torch.empty(batch, dtype=torch.int32),
+    )
+    prep.prepare_uno_draft(
+        inputs,
+        *outputs,
+        blocks,
+        counter,
+        k=k,
+        seed=seed,
+        low=low,
+        high=high,
+        block_size=16,
+        max_model_len=max_model_len,
+    )
+    return outputs
+
+
+@pytest.mark.parametrize("batch", range(1, 33))
+@pytest.mark.parametrize("k", range(1, 16))
+def test_fused_prep_matches_eager_for_every_requested_layout(prep, batch, k):
+    inputs, blocks = case(prep, batch, k, rejected=batch % 2 == 0)
+    counter = torch.tensor(114, dtype=torch.int64)
+    actual = execute(prep, inputs, blocks, k, counter)
+    expected = eager_oracle(inputs, blocks, k, 115, 11, 1, 250624, 81)
+    assert all(torch.equal(got, want) for got, want in zip(actual, expected))
+    assert counter == 115
+    assert torch.equal(actual[0].reshape(batch, k)[:, 0], inputs.next_token_ids)
+    # KVs remain temporary exactly where the eager draft writes them; beyond
+    # max_model_len they use the padding slot. No sampler/commit state is an input.
+    assert torch.equal(actual[2] == -1, actual[1] >= 81)
+
