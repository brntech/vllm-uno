+@pytest.mark.parametrize(
+    ("k", "max_num_seqs"),
+    [(1, 4), (8, 4), (1, 16), (8, 16)],
+    ids=["k1_seqs4", "k8_seqs4", "k1_seqs16", "k8_seqs16"],
