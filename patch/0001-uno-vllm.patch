+@pytest.mark.parametrize("batch", [1, 3])
+def test_fold_cuda_graph_replays_fresh_rows_with_side_stream(batch):
+    """Exercise real cuBLAS capture and static B/scratch lifetime when CUDA exists."""
+    device = torch.device("cuda")
+    gen = torch.Generator(device=device).manual_seed(18)
+
+    def rand(*shape):
+        return (torch.randn(*shape, generator=gen, device=device) * 0.15).bfloat16()
+
+    pairs = tuple((rand(r, 11), rand(w, r)) for r, w in ((4, 7), (3, 3), (5, 3)))
+    route = overlap.DraftLoRARoute(batch, 11, batch * 11 + 3)
+    x, weight = rand(route.num_tokens, 11), rand(13, 11)
+    output = torch.empty(route.num_tokens, 13, device=device, dtype=x.dtype)
+    plan = overlap.SingleAdapterPlan(pairs, (7, 3, 3), fold=True)
+    plan.prepare(route)
+    latent = plan.allocate(x, route)
+    events = overlap._StreamEvents(device)
+
+    def forward():
+        events.run(
+            lambda: plan.shrink(x, route, latent),
+            lambda: torch.mm(x, weight.t(), out=output),
+        )
+        plan.expand(latent, output, route)
+
+    capture_stream = torch.cuda.Stream(device=device)
+    capture_stream.wait_stream(torch.cuda.current_stream(device))
+    with torch.cuda.stream(capture_stream):
+        for _ in range(3):
+            forward()
+    torch.cuda.current_stream(device).wait_stream(capture_stream)
+    torch.cuda.synchronize(device)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, stream=capture_stream):
+        forward()
+    reference = overlap.SingleAdapterPlan(pairs, (7, 3, 3))
+    for _ in range(3):
+        x.copy_(rand(route.num_tokens, 11))
+        latent.fill_(float("nan"))
+        graph.replay()
+        actual = output.clone()
+        expected = x @ weight.t()
+        ref_latent = reference.allocate(x, route)
+        reference.shrink(x, route, ref_latent)
+        reference.expand(ref_latent, expected, route)
+        torch.testing.assert_close(actual, expected, atol=0.016, rtol=0.016)
