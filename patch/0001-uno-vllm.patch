+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only profile collector/parser contracts; synthetic CUDA trace events."""
+
+import importlib.util
+import json
+import os
+import sys
+import uuid
+from pathlib import Path
+
+import pytest
+
+SOURCE_ROOT = Path(__file__).resolve().parents[3]
+BASE = Path(os.environ.get("VLLM_DC_KIT_ROOT", SOURCE_ROOT.parent))
+if not (BASE / "gates/draft_profile.py").is_file():
+    pytest.skip(
+        "Set VLLM_DC_KIT_ROOT to the Uno vllm-port kit for gate parser tests",
+        allow_module_level=True,
+    )
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+driver = load("uno_draft_profile_driver_test", BASE / "gates/draft_profile.py")
+profile = load(
+    "uno_draft_profile_collector_test",
+    SOURCE_ROOT / "vllm/v1/spec_decode/uno_draft_profile.py",
+)
+
+
+def event(name, start, duration, category="cpu_op", *, pid=1, tid=1, **args):
+    return {
+        "ph": "X",
+        "name": name,
+        "ts": start,
+        "dur": duration,
+        "cat": category,
+        "pid": pid,
+        "tid": tid,
+        "args": args,
+    }
+
+
+def synthetic_trace():
+    return {
+        "traceEvents": [
+            event("uno_dc/step/1:1", 0, 1000, "user_annotation"),
+            event("uno_dc/draft.forward", 100, 500, "user_annotation"),
+            event("uno_dc/draft.projection", 150, 100, "user_annotation"),
+            event("uno_dc/draft.lora", 175, 25, "user_annotation"),
+            event("aten::mm", 180, 5, **{"External id": 1}),
+            event("aten::mm", 210, 5, **{"External id": 2}),
+            event("cudaGraphLaunch", 300, 2, "cuda_runtime", correlation=99),
+            event("uno_dc/host.sync", 600, 200, "user_annotation"),
+            event("cudaEventSynchronize", 620, 100, "cuda_runtime"),
+            event(
+                "sgmv_lora",
+                1000,
+                80,
+                "kernel",
+                pid=9,
+                tid=7,
+                **{"External id": 1, "device": 0},
+            ),
+            event(
+                "cutlass_gemm",
+                1020,
+                90,
+                "kernel",
+                pid=9,
+                tid=8,
+                **{"External id": 2, "device": 0},
+            ),
+            event(
+                "flash_attention",
+                1100,
+                200,
+                "kernel",
+                pid=9,
+                tid=7,
+                correlation=99,
+                device=0,
+            ),
+            event(
+                "unknown_kernel",
+                1200,
+                50,
+                "kernel",
+                pid=9,
+                tid=8,
+                **{"External id": 404, "device": 0},
+            ),
+        ]
+    }
+
+
+def test_trace_uses_inner_scope_and_preserves_overlapping_cuda_costs():
+    report = driver.analyze_trace(synthetic_trace())
+    assert report["cuda_activity"]["activity_sum_ms"] == pytest.approx(0.420)
+    assert report["cuda_activity"]["busy_union_ms_by_device"] == {"0": 0.3}
+    scopes = report["cuda_by_innermost_scope"]
+    assert scopes["draft.lora"]["activity_sum_ms"] == pytest.approx(0.08)
+    assert scopes["draft.projection"]["activity_sum_ms"] == pytest.approx(0.09)
+    assert scopes["draft.forward"]["activity_sum_ms"] == pytest.approx(0.2)
+    assert scopes["unattributed"]["activity_sum_ms"] == pytest.approx(0.05)
+    assert report["cuda_by_step"]["1:1"]["activity_sum_ms"] == pytest.approx(0.37)
+    assert report["host_synchronize_api_wall_ms_by_scope"] == {
+        "host.sync": {"calls": 1, "sum_ms": 0.1}
+    }
+    assert report["links"] == {"linked_events": 3, "unlinked_events": 1}
+    # A graph kernel named flash_attention stays in broad replay scope; names
+    # are separately identified as hints, never fabricated layer provenance.
+    assert "draft.attention" not in scopes
+    assert report["kernel_name_hints_activity_sum_ms"]["attention_name_hint"] == 0.2
+
+
+def test_trace_ambiguous_external_ids_never_choose_arbitrary_rank():
+    trace = synthetic_trace()
+    trace["traceEvents"] += [
+        event("uno_dc/verify.forward", 0, 100, "user_annotation", pid=2),
+        event("aten::mm", 2, 8, pid=2, **{"External id": 1}),
+    ]
+    result = driver.analyze_trace(trace)
+    assert result["links"]["ambiguous_events"] == 1
+    assert result["cuda_by_innermost_scope"]["unattributed"][
+        "activity_sum_ms"
+    ] == pytest.approx(0.13)
+
+
+def test_cpu_only_trace_has_no_fabricated_cuda_evidence():
+    report = driver.analyze_trace({"traceEvents": [event("aten::mm", 0, 50)]})
+    assert report["cuda_activity"] == {
+        "events": 0,
+        "activity_sum_ms": 0,
+        "busy_union_ms_by_device": {},
+    }
+
+
+@pytest.mark.parametrize(
+    "intervals,total",
+    [
+        ([], 0),
+        ([(1, 3)], 2),
+        ([(0, 10), (2, 3), (4, 5)], 10),
+        ([(1, 3), (3, 7), (10, 12)], 8),
+        ([(10, 15), (0, 2), (1, 12)], 15),
+    ],
+)
+def test_interval_union(intervals, total):
+    assert driver.union_duration(intervals) == total
+
+
+def step_record(batch=8, mode="CUDAGraphMode.FULL"):
+    return {
+        "schema": "uno-draft-profile-v1",
+        "pid": 1,
+        "step_id": 1,
+        "batch_size": batch,
+        "k": 7,
+        "host_wall_before_flush_ms": 5,
+        "profile_flush_host_wait_ms": 0.7,
+        "executions": {
+            "draft": {
+                "mode": mode,
+                "actual_tokens": batch * 7,
+                "padded_tokens": batch * 8,
+            }
+        },
+        "ranges": [
+            {
+                "name": "draft.forward",
+                "inclusive_host_wall_ms": 4,
+                "stream_elapsed_ms": 3,
+            },
+            {
+                "name": "draft.lora",
+                "inclusive_host_wall_ms": 1,
+                "stream_elapsed_ms": 0.8,
+            },
+            {
+                "name": "draft.lora",
+                "inclusive_host_wall_ms": 0.5,
+                "stream_elapsed_ms": 0.3,
+            },
+        ],
+    }
+
+
+def test_log_parser_keeps_real_shapes_and_inclusive_categories():
+    line = json.dumps(step_record())
+    records = driver.parse_step_lines(
+        "other log\n(worker) UNO_DRAFT_PROFILE " + line + "\n"
+    )
+    assert records == [step_record()]
+    summary = driver.summarize_steps(records + [step_record(1, "CUDAGraphMode.NONE")])
+    assert [r["batch_size"] for r in summary] == [1, 8]
+    assert summary[1]["draft_shapes"] == [{"actual_tokens": 56, "padded_tokens": 64}]
+    assert (
+        summary[1]["inclusive_ranges"]["draft.lora"][
+            "inclusive_host_ms_per_present_step"
+        ]["mean"]
+        == 1.5
+    )
+    assert summary[1]["host_wall_before_flush_ms"]["mean"] == 5
+    # It must not add 4+1+.5 (nested scopes) and claim a 5.5 ms step.
+    assert "total_category_ms" not in summary[1]
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "UNO_DRAFT_PROFILE broken",
+        "UNO_DRAFT_PROFILE {}",
+        'UNO_DRAFT_PROFILE {"schema":"wrong"}',
+    ],
+)
+def test_corrupt_diagnostic_line_fails_visibly(text):
+    with pytest.raises(ValueError, match="Malformed"):
+        driver.parse_step_lines(text)
+
+
+def test_dry_run_does_not_touch_http_or_paths(monkeypatch):
+    monkeypatch.setattr(driver, "_post", lambda *a, **k: pytest.fail("HTTP attempted"))
+    missing = BASE / ("does-not-exist-" + uuid.uuid4().hex)
+    assert (
+        driver.main(
+            [
+                "--server-log",
+                str(missing),
+                "--trace-dir",
+                str(missing),
+                "--out",
+                str(missing / "report"),
+            ]
+        )
+        == 0
+    )
+    assert not missing.exists()
+
+
+def test_collector_disabled_is_noop(monkeypatch):
+    monkeypatch.delenv("UNO_DEBUG_TIMING", raising=False)
+    assert profile.begin_step(8, 7) is None
+    with profile.span("draft.mapping"):
+        pass
+    assert profile.end_step() is None
+
+
+def test_cpu_collector_nested_ranges_and_explicit_execution(monkeypatch):
+    monkeypatch.setenv("UNO_DEBUG_TIMING", "1")
+    profile.begin_step(8, 7, step_id=42, cuda_events=False)
+    try:
+        profile.execution("draft", "CUDAGraphMode.NONE", 56, 56)
+        with profile.span("draft.forward"), profile.span("draft.mapping"):
+            pass
+        lines = []
+        result = profile.end_step(emit=lines.append)
+    finally:
+        profile.end_step(emit=lambda _line: None)
+    assert result["step_id"] == 42 and not result["cuda_events"]
+    assert [r["name"] for r in result["ranges"]] == ["draft.mapping", "draft.forward"]
+    assert all(r["stream_elapsed_ms"] is None for r in result["ranges"])
+    assert driver.parse_step_lines(lines[0]) == [result]
+
+
+def test_model_ranges_leave_graph_modules_unhooked_by_default(monkeypatch):
+    import torch
+
+    monkeypatch.setenv("UNO_DEBUG_TIMING", "1")
+
+    class Model(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.q_proj = torch.nn.Linear(2, 2)
+
+        def compute_logits(self, x):
+            return x + 1
+
+    model = Model()
+    profile.install_model_ranges(model)
+    assert not model.q_proj._forward_hooks
+    x = torch.tensor([1.0, 2.0])
+    assert torch.equal(model.compute_logits(x), x + 1)
+    profile.begin_step(1, 7, cuda_events=False)
+    try:
+        profile.execution("draft", "CUDAGraphMode.PIECEWISE", 7, 8)
+        assert torch.equal(model.compute_logits(x), x + 1)
+        record = profile.end_step(emit=lambda _line: None)
+    finally:
+        profile.end_step(emit=lambda _line: None)
