index 0000000000000000000000000000000000000000..f212d4aa904dea2578abe4c05ebf1b78a8704d9f
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_fused_layout.py
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Index math for the fused single-pass Uno batch.
+
+The scheduler hands the runner a compact decode batch: request r has ``1 + k_r`` query rows
+(bonus + k_r drafts; k_r may be < K near the context limit). Fused mode appends E = (K+1)·K noise rows to
+every request that has exactly K drafts (others run plain). This module computes, on the CPU from numpy
+arrays, everything the runner needs for the expanded batch without touching the scheduler's bookkeeping.
+"""
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from vllm.v1.spec_decode.uno_fused_mask import fused_layout
+
+
+@dataclass
+class FusedBatchLayout:
+    k: int
+    e: int                                   # noise rows per fused request = (K+1)*K
+    fused: np.ndarray                        # bool [num_reqs]: request gets noise rows
+    compact_start: np.ndarray                # int [num_reqs]: row offset in the compact batch
+    expanded_start: np.ndarray               # int [num_reqs]: row offset in the expanded batch
+    expanded_query_start_loc: np.ndarray     # int [num_reqs + 1]
+    num_expanded_tokens: int
+    # for every expanded row: which compact row it copies (-1 for a noise row)
+    src_row: np.ndarray                      # int [num_expanded_tokens]
+    noise_group: np.ndarray                  # int [num_expanded_tokens]: -1, or group j of a noise row
+    noise_index: np.ndarray                  # int [num_expanded_tokens]: -1, or i within the group
+
+
+def build_fused_layout(num_scheduled_tokens: np.ndarray, num_draft_tokens: np.ndarray, k: int) -> FusedBatchLayout:
+    """num_scheduled_tokens[r] = compact rows of request r; num_draft_tokens[r] = its drafts (0 for
+    prefill chunks). A request is fused iff it is a decode step with exactly K drafts."""
+    n = len(num_scheduled_tokens)
+    e = (k + 1) * k
+    fused = (num_draft_tokens == k) & (num_scheduled_tokens == k + 1)
+    compact_start = np.zeros(n + 1, dtype=np.int64)
+    np.cumsum(num_scheduled_tokens, out=compact_start[1:])
+    expanded_len = num_scheduled_tokens.astype(np.int64) + fused.astype(np.int64) * e
+    expanded_qsl = np.zeros(n + 1, dtype=np.int64)
+    np.cumsum(expanded_len, out=expanded_qsl[1:])
+    total = int(expanded_qsl[-1])
+    src_row = np.full(total, -1, dtype=np.int64)
+    group = np.full(total, -1, dtype=np.int64)
+    idx = np.full(total, -1, dtype=np.int64)
+    for r in range(n):
+        s, c = int(expanded_qsl[r]), int(compact_start[r])
+        m = int(num_scheduled_tokens[r])
+        src_row[s : s + m] = np.arange(c, c + m)
+        if fused[r]:
+            rows = np.arange(e)
+            group[s + m : s + m + e] = rows // k
+            idx[s + m : s + m + e] = rows % k
+    return FusedBatchLayout(
+        k=k, e=e, fused=fused, compact_start=compact_start[:-1], expanded_start=expanded_qsl[:-1],
+        expanded_query_start_loc=expanded_qsl, num_expanded_tokens=total,
+        src_row=src_row, noise_group=group, noise_index=idx,
+    )
+
+
+def noise_positions(layout: FusedBatchLayout, bonus_positions: np.ndarray) -> np.ndarray:
+    """Position id for every expanded row: copied rows keep their compact position (caller supplies
+    ``compact_positions`` via src_row); noise row (group j, index i) of request r gets p_r + j + 1 + i where
+    p_r is the bonus row's position."""
+    out = np.full(layout.num_expanded_tokens, -1, dtype=np.int64)
+    n = len(layout.expanded_start)
+    for r in range(n):
+        if not layout.fused[r]:
+            continue
+        s = int(layout.expanded_start[r]) + layout.k + 1
+        rows = np.arange(layout.e)
+        out[s : s + layout.e] = int(bonus_positions[r]) + rows // layout.k + 1 + rows % layout.k
+    return out
+
+
+def expanded_logits_indices(layout: FusedBatchLayout, num_sampled_tokens: np.ndarray) -> np.ndarray:
+    """Rows whose logits the sampler needs, on the expanded layout: the last ``num_sampled_tokens[r]``
+    compact rows of each request (bonus + drafts), i.e. rows 0..K of a fused request."""
+    parts = []
+    n = len(layout.expanded_start)
+    for r in range(n):
+        m = int(num_sampled_tokens[r])
+        # compact rows of request r sit first in its expanded span; the last m of them are sampled
+        start = int(layout.expanded_start[r])
+        clen = int(layout.expanded_query_start_loc[r + 1] - start) - (layout.e if layout.fused[r] else 0)
+        parts.append(np.arange(start + clen - m, start + clen))
+    return np.concatenate(parts) if parts else np.zeros(0, dtype=np.int64)
+
+
+def group_row_offsets(layout: FusedBatchLayout, num_accepted: np.ndarray) -> np.ndarray:
+    """For each fused request, the expanded row index of the first row of noise group j = num_accepted[r]
+    (the group whose seed is the last committed token); -1 for non-fused requests."""
+    _, first_noise = fused_layout(layout.k)
+    out = np.full(len(layout.expanded_start), -1, dtype=np.int64)
+    for r in range(len(out)):
+        if layout.fused[r]:
+            j = int(num_accepted[r])
+            assert 0 <= j <= layout.k
+            out[r] = int(layout.expanded_start[r]) + first_noise + j * layout.k
+    return out
