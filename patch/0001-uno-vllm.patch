@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The decode-step LoRA install must not synchronise with the host.
+
+A tripwire replaces every host-reading tensor operation with one that raises, so
+a test that passes inside it did not read device state back. The tripwire is
+proved to work by running the *native* metadata builder inside it and watching it
+fire: a test that only ever passes is indistinguishable from a test that sees
+nothing.
+
+**Scope, stated because it is easy to overread.** These are cache-unit tests.
+They drive the plan cache against a stand-in punica wrapper, not the runner, the
+proposer or a model forward, and a Python-level tripwire cannot see every way
+CUDA can synchronise (an allocator call inside a kernel launch, a caching
+allocator flush, a stream event wait). What they establish is that *the plan
+install path* issues no host-reading call. They are evidence about that path,
+**not proof that a whole decode step is host-sync-free** -- only the warmed-step
+probe in ``gates/nosync.sh``, with ``VLLM_GPU_SYNC_REPORT_ALLOWED=1``, can say
+that, and it has not been run.
+
+CPU only. These tests never import ``vllm``, start a server or touch a device.
+"""
+
+import contextlib
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from test_uno_nosync_plan import (  # noqa: E402
+    MAX_LORAS,
+    SLOTS,
+    UNO_ID,
+    FakeWrapper,
+    Mapping,
+    draft_mapping,
+    install,
+    ns,
+    snapshot_state,
+)
+
+
+class HostSyncError(AssertionError):
+    """A decode-step call read device state back to the host."""
+
+
+# Every operation torch's own sync debugger reports, plus the Python-level
+# conversions that force one. `torch.cuda.synchronize` is included even though
+# these tests are CPU only: a patch that stopped calling it would still be
+# caught on the device.
+TRIPWIRES = (
+    "item",
+    "tolist",
+    "cpu",
+    "numpy",
+    "nonzero",
+    "__bool__",
+    "__int__",
+    "__float__",
+)
+
+
+@contextlib.contextmanager
+def no_host_sync():
+    saved = {name: getattr(torch.Tensor, name) for name in TRIPWIRES}
+    saved_sync = torch.cuda.synchronize
+
+    def trip(name):
+        def fail(*args, **kwargs):
+            raise HostSyncError(f"Tensor.{name} on the decode-step path")
+
+        return fail
+
+    try:
+        for name in TRIPWIRES:
+            setattr(torch.Tensor, name, trip(name))
+        torch.cuda.synchronize = trip("cuda.synchronize")
+        yield
+    finally:
+        for name, original in saved.items():
+            setattr(torch.Tensor, name, original)
+        torch.cuda.synchronize = saved_sync
+
+
+def base_mapping(num_tokens, num_prompt):
+    return Mapping((0,) * num_tokens, (0,) * num_prompt)
+
+
+# ------------------------------------------------------- the tripwire itself works
+
+
+def test_tripwire_fires_on_a_plain_host_read():
+    with pytest.raises(HostSyncError), no_host_sync():
+        torch.zeros(4).tolist()
+
+
+def test_native_metadata_build_trips_the_tripwire():
+    """The path this patch removes does read device state back.
+
+    ``LoRAKernelMeta.prepare_tensors`` writes ``torch.all(mapping == -1)`` into a
+    CPU flag and then branches on it. On CUDA that is a device-to-host copy
+    followed by a ``bool()``; here the ``bool()`` is what the tripwire sees. If
+    upstream ever makes that branch host-free this test fails, which is the
+    signal to re-measure rather than a defect.
+    """
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    with pytest.raises(HostSyncError), no_host_sync():
+        install(wrapper, cache, "draft", (8, 2, 4, UNO_ID),
+                draft_mapping(8, 2, 4), SLOTS)
+
+
+# ------------------------------------------------------------- the flag-on path
+
+
+@pytest.mark.parametrize("batch,k", [(1, 4), (4, 4), (16, 2), (32, 8)])
+def test_draft_plan_restore_issues_no_host_sync(batch, k):
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper(max_num_tokens=512)
+    num_tokens = batch * k
+    shape = (num_tokens, batch, k, UNO_ID)
+    mapping = draft_mapping(num_tokens, batch, k)
+
+    # First step of this shape: the native builder runs and is allowed to
+    # synchronise once.
+    assert install(wrapper, cache, "draft", shape, mapping, SLOTS) is False
+    expected = snapshot_state(wrapper)
+
+    with no_host_sync():
+        for _ in range(5):
+            assert cache.restore(wrapper, "draft", shape, SLOTS) is True
+
+    assert snapshot_state(wrapper).keys() == expected.keys()
+    for key, want in expected.items():
+        got = snapshot_state(wrapper)[key]
+        if isinstance(want, torch.Tensor):
+            assert torch.equal(got, want), key
+        else:
+            assert got == want, key
+
+
+def test_base_plan_restore_issues_no_host_sync():
+    """The target pass installs the all-base mapping the same way."""
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    install(wrapper, cache, "base", (12, 12), base_mapping(12, 12), SLOTS)
+    with no_host_sync():
+        for _ in range(5):
+            assert cache.restore(wrapper, "base", (12, 12), SLOTS) is True
+
+
+def test_warm_installs_in_step_order_issue_no_host_sync():
+    """Target install then draft install, the order a decode step uses.
+
+    The *installs* in step order, not a step: no forward, no sampler, no runner.
+    """
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper(max_num_tokens=512)
+    batch, k = 8, 4
+    draft_shape = (batch * k, batch, k, UNO_ID)
+    install(wrapper, cache, "base", (batch, batch), base_mapping(batch, batch), SLOTS)
+    install(wrapper, cache, "draft", draft_shape, draft_mapping(batch * k, batch, k),
+            SLOTS)
+    native_after_warmup = wrapper.native_calls
+
+    with no_host_sync():
+        for _ in range(10):
+            assert cache.restore(wrapper, "base", (batch, batch), SLOTS) is True
+            assert cache.restore(wrapper, "draft", draft_shape, SLOTS) is True
+    assert wrapper.native_calls == native_after_warmup
+
+
+def test_step_constants_issue_no_host_sync():
+    constants = ns.StepConstants()
+    device = torch.device("cpu")
+    token_arange_np = torch.arange(256, dtype=torch.int32).numpy()
+    constants.req_seeds(8, 4, 3, device)
+    constants.query_start_loc_cpu(8, 4, token_arange_np)
+    with no_host_sync():
+        for _ in range(10):
+            constants.req_seeds(8, 4, 3, device)
+            constants.query_start_loc_cpu(8, 4, token_arange_np)
+    assert constants.stats()["misses"] == 2
+
+
+# --------------------------------------------------- deferred vs eager equivalence
+
+
+@pytest.mark.parametrize("seed", [0, 1, 2, 3, 4])
+def test_random_shape_sequences_agree_with_the_native_build(seed):
+    """On a random interleaving of shapes, every restore matches what the
+    native builder would have produced for that shape at that moment."""
+    rng = torch.Generator().manual_seed(seed)
+    shapes = []
+    for _ in range(12):
+        batch = int(torch.randint(1, 9, (1,), generator=rng).item())
+        k = int(torch.randint(2, 6, (1,), generator=rng).item())
+        shapes.append((batch, k))
+
+    cached_wrapper = FakeWrapper(max_num_tokens=512)
+    eager_wrapper = FakeWrapper(max_num_tokens=512)
+    cache = ns.UnoLoRAPlanCache()
+
+    for batch, k in shapes:
+        num_tokens = batch * k
+        mapping = draft_mapping(num_tokens, batch, k)
+        shape = (num_tokens, batch, k, UNO_ID)
+
+        install(cached_wrapper, cache, "draft", shape, mapping, SLOTS)
+        # The comparison build always runs natively.
+        eager_wrapper.update_metadata(mapping, list(SLOTS), MAX_LORAS + 1, 512)
+
+        cached = snapshot_state(cached_wrapper)
+        eager = snapshot_state(eager_wrapper)
+        assert cached.keys() == eager.keys()
+        for key, want in eager.items():
+            got = cached[key]
+            if isinstance(want, torch.Tensor):
+                assert torch.equal(got, want), (batch, k, key)
+            else:
+                assert got == want, (batch, k, key)
+
+    # The steady state is hits, not rebuilds: 12 installs over however many
+    # distinct shapes the sequence drew, and every repeat is served from cache.
+    assert cached_wrapper.native_calls == len(set(shapes))
+    assert eager_wrapper.native_calls == len(shapes)
