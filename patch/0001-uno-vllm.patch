+
+    def take_last_draft_sparse(self):
+        """The compact draft support of the last two-pass draft, or None. The
+        runner caches it exactly as it caches the dense draft probabilities."""
+        return self._last_draft_sparse
+
+    def _sample_draft_sparse(self, hidden_states, sampling_metadata, k: int):
+        """Draft from a compact top-k support (``uno_sparse_topk``).
+
+        Returns None whenever the batch is not exactly representable on a
+        support, which puts the step back on the dense draft sampler. The
+        support is the *actual* q the tokens were drawn from, so the verifier
+        stays exact; note that it is a different q from the dense path, which
+        applies temperature only and ignores top-k/top-p when drafting.
+        """
+        if not getattr(self.speculative_config, "uno_sparse_topk", False):
+            return None
+        from vllm.v1.spec_decode import uno_sampler as _us
+
+        def decline(reason):
+            _us.STATS.declined_for("draft_sparse", reason)
+            return None
+
+        if not getattr(self, "_enable_probabilistic_draft_probs", False):
+            # draft_sample_method defaults to "greedy", which makes the dense
+            # path return no draft probabilities at all. Without this the flag
+            # is silently inert unless the method is selected explicitly.
+            return decline("draft_sample_method_not_probabilistic")
+        if getattr(self, "use_heterogeneous_vocab", False):
+            return decline("heterogeneous_vocab")
+        input_batch = getattr(self.runner, "input_batch", None) if self.runner is not None else None
+        if input_batch is None:
+            return decline("no_input_batch")
+        max_top_k = _us.batch_max_top_k(input_batch, len(input_batch.req_ids))
+        reason = _us.sparse_blocker(sampling_metadata, max_top_k)
+        if reason is not None:
+            return decline(reason)
+        temperature = sampling_metadata.temperature
+        if temperature is None or hidden_states.shape[0] != temperature.shape[0] * k:
+            return decline("row_count_mismatch")
+        rows = int(hidden_states.shape[0])
+        logits = self.model.compute_logits(hidden_states)
+        top_p = sampling_metadata.top_p
+        repeats = torch.full((temperature.shape[0],), k, dtype=torch.int64,
+                             device=temperature.device)
+        support = _us.build_sparse_support(
+            logits,
+            _us.expand_per_request(temperature, repeats, rows),
+            _us.expand_per_request(sampling_metadata.top_k, repeats, rows),
+            _us.expand_per_request(top_p, repeats, rows),
+            max_top_k,
+            _us.STATS if _us.track_ambiguity() else None,
+        )
+        line = _us.STATS.used("draft_sparse")
+        if line is not None:
+            logger.info(line)
+        return _us.SparseDraft(
+            token_ids=_us.sample_from_support(
+                support, use_fp64_gumbel=getattr(self, "use_fp64_gumbel", False)
+            ),
+            support=support,
+        )
+
+    def _lookup_route(self, next_token_ids, cad, k: int) -> dict | None:
+        """A4 router. Returns {"skip_forward", "mixed", "lists", "lists_by_row"} or None (no lookup/AR row)."""
+        from vllm.v1.spec_decode.ngram_proposer import _find_longest_matched_ngram_and_propose_tokens as ngram
+        sc = self.speculative_config
+        ib = self.runner.input_batch
+        batch_size = cad.batch_size()
+        # accepted-this-step counts (sampled tokens incl. the bonus), from the runner's async CPU copy
+        ev, cnt = self.runner.valid_sampled_token_count_event, self.runner.valid_sampled_token_count_cpu
+        if ev is None or cnt is None:
+            return None
+        ev.synchronize()
+        counts = cnt[:batch_size].tolist()
+        bonus = next_token_ids[:batch_size].tolist()
+        min_n, max_n = int(sc.uno_lookup_min), int(sc.uno_lookup_max)
+        full_only, min_hit, ar_below = bool(sc.uno_lookup_full_only), int(sc.uno_lookup_min_hit), float(sc.uno_ar_below)
+        ema = self.__dict__.setdefault("_acc_ema", {})
+        by_row: dict[int, list[int]] = {}
+        n_lk = n_ar = 0
+        for r in range(batch_size):
+            rid = ib.req_ids[r]
+            n = int(ib.num_tokens_no_spec[r])
+            spec = ib.spec_token_ids[r]
+            acc = max(int(counts[r]) - 1, 0)
+            if spec:  # a real speculative step: update the request's acceptance EMA
+                ema[rid] = 0.8 * ema.get(rid, float(k)) + 0.2 * acc
+            hist = np.concatenate([ib.token_ids_cpu[r, :n], np.asarray(list(spec[:acc]) + [bonus[r]], dtype=ib.token_ids_cpu.dtype)])
+            d = ngram(hist, min_n, max_n, int(self.max_model_len), k)
+            if len(d) == k or (not full_only and len(d) >= min_hit):
+                by_row[r] = [int(x) for x in d]; n_lk += 1
+            elif ar_below > 0 and ema.get(rid, float(k)) < ar_below:
+                by_row[r] = []; n_ar += 1
+        self._n_lk_rows = getattr(self, "_n_lk_rows", 0) + n_lk
+        self._n_ar_rows = getattr(self, "_n_ar_rows", 0) + n_ar
+        self._n_lk_steps = getattr(self, "_n_lk_steps", 0) + 1
+        if self._n_lk_steps % 500 == 0:
+            logger.info("UNO_LOOKUP steps=%d lookup_rows=%d ar_rows=%d forwards_skipped=%d",
+                        self._n_lk_steps, self._n_lk_rows, self._n_ar_rows, getattr(self, "_n_lk_skip", 0))
+        if not by_row:
+            return None
+        skip = len(by_row) == batch_size
+        return {"skip_forward": skip, "mixed": not skip, "lists_by_row": by_row,
+                "lists": [by_row[r] for r in range(batch_size)] if skip else None}
+
+    def fused_g(self) -> int:
+        return int(getattr(self.speculative_config, "uno_fused_groups", 0) or 0)
+
+    def fused_e(self) -> int:
+        k = int(self.speculative_config.uno_fused_k)
+        g = self.fused_g()
+        return (g if g > 0 else k + 1) * k
+
+    def default_groups(self) -> tuple:
+        """Initial carried groups for a request: alternate the ends (0, K, 1, K-1, ...), first G."""
+        k = int(self.speculative_config.uno_fused_k)
+        g = self.fused_g()
+        if g <= 0:
+            return tuple(range(k + 1))
+        order = []
+        lo, hi = 0, k
+        while len(order) < k + 1:
+            if lo <= hi:
+                order.append(lo); lo += 1
+            if hi >= lo:
+                order.append(hi); hi -= 1
+        return tuple(sorted(order[:g]))
+
+    def groups_for(self, req_id) -> tuple:
+        return self.groups.get(req_id) or self.default_groups()
+
+    def _update_groups(self, req_id, j: int) -> tuple:
+        """Record the accepted count j for req_id and choose the next block's carried groups (top-G by a
+        decayed histogram; ties prefer larger j). Returns the NEXT groups."""
+        k = int(self.speculative_config.uno_fused_k)
+        g = self.fused_g()
+        if g <= 0:
+            return tuple(range(k + 1))
+        h = self.j_hist.get(req_id)
+        if h is None:
+            h = [0.0] * (k + 1)
+            for jj in self.default_groups():
+                h[jj] = 1.0  # prior
+        h = [0.9 * x for x in h]
+        h[j] += 1.0
+        self.j_hist[req_id] = h
+        top = sorted(range(k + 1), key=lambda jj: (-h[jj], -jj))[:g]
+        nxt = tuple(sorted(top))
+        self.groups[req_id] = nxt
+        return nxt
+
+    def _fresh_noise(self, batch_size: int, e: int) -> torch.Tensor:
+        """E uniform noise ids per request for the NEXT step's groups (scheduler-placed)."""
+        ids = torch.zeros(batch_size * e, dtype=torch.int32, device=self.device)
+        seeds = (torch.arange(batch_size, device=self.device, dtype=torch.int64)
+                 + self.uno_noise_seed).repeat_interleave(e)
+        if os.environ.get("UNO_DEBUG_SAME_SEED"):
+            # Diagnostic: every request draws the same noise (identical-request pair test).
+            seeds = torch.full_like(seeds, int(self.uno_noise_seed))
+        self._step += 1
+        fill_uno_noise(ids, torch.ones_like(ids, dtype=torch.bool), seeds, self._step,
+                       self.uno_low, self.uno_high)
+        return ids.view(batch_size, e).to(torch.int64)
+
+    def _want_dump(self, batch_size: int) -> bool:
+        """UNO_DEBUG_DUMP: dump up to 80 fused steps whose batch has >= UNO_DEBUG_DUMP_MINB requests."""
+        if not os.environ.get("UNO_DEBUG_DUMP"):
+            return False
+        if batch_size < int(os.environ.get("UNO_DEBUG_DUMP_MINB", "1")):
+            return False
+        n = getattr(self, "_dump_n", 0)
+        if n >= 80:
+            return False
+        self._dump_n = n + 1
+        return True
+
+    def _propose_fused(self, num_speculative_tokens, target_token_ids, target_positions,
+                       target_hidden_states, next_token_ids, token_indices_to_sample,
+                       cad, sampling_metadata, num_rejected_tokens_gpu):
+        k = int(self.speculative_config.uno_fused_k)
+        e = self.fused_e()
+        hybrid = self.fused_g() > 0
+        batch_size = cad.batch_size()
+        qsl = cad.query_start_loc_cpu[: batch_size + 1]
+        q_lens = (qsl[1:] - qsl[:-1]).tolist()
+        # authoritative per-request fused mask from the runner (draft count == K+E AND query length == 1+K+E);
+        # a query-length-only test would also match an ordinary Q-token prefill in the same batch
+        _rm = getattr(self.runner, "_uno_fused_mask_np", None) if self.runner is not None else None
+        if _rm is not None and len(_rm) >= batch_size:
+            fused_np = np.asarray(_rm[:batch_size], dtype=bool)
+        else:
+            fused_np = np.array([q == 1 + k + e for q in q_lens], dtype=bool)
+        all_fused = bool(fused_np.all())
+        req_ids = list(self.runner.input_batch.req_ids[:batch_size]) if (hybrid and self.runner is not None) else None
+        j = None
+        if fused_np.any() and num_rejected_tokens_gpu is not None:
+            rejected = num_rejected_tokens_gpu[:batch_size]
+            if bool(getattr(self.runner, "_uno_restricted", False)):
+                # Per-request verification boundary: the runner restricted the sampler window of every fused
+                # request to its K+1 real rows (mixed batches included), so `rejected` is relative to K for fused
+                # rows and to the scheduled drafts for the others. The base class computed
+                # token_indices_to_sample / num_rejected against the full K+E block: re-derive both, per request,
+                # for the two-pass paths below.
+                fused_t = torch.from_numpy(fused_np).to(self.device)
+                num_rejected_tokens_gpu = num_rejected_tokens_gpu.clone()
+                num_rejected_tokens_gpu[:batch_size] = rejected + fused_t.to(rejected.dtype) * e
+                tis_fused = (cad.query_start_loc[:batch_size] + k - rejected).to(token_indices_to_sample.dtype)
+                token_indices_to_sample = torch.where(fused_t, tis_fused, token_indices_to_sample[:batch_size])
+                # accepted real drafts j = K - rejected; the carried group standing for j (index g in block
+                # order) has rows request_start + 1 + k + g*k .. +k
+                j = (k - rejected).clamp(0, k)
+            else:
+                # UNO_DEBUG_WHOLE_BATCH_BOUNDARY (gate A/B knob, mixed batch): the sampler saw all K+E rows
+                j = (k + e - rejected).clamp_(0, k)
+        if all_fused and num_rejected_tokens_gpu is not None:
+            if hybrid:
+                j_cpu = j.tolist()
+                gidx = []
+                for r, rid in enumerate(req_ids):
+                    grp = self.groups_for(rid)
+                    gidx.append(grp.index(j_cpu[r]) if j_cpu[r] in grp else -1)
+                    self._update_groups(rid, j_cpu[r])
+                hit = [x >= 0 for x in gidx]
+                if not all(hit):
+                    # miss: two-pass draft for the whole batch (memory-bound, ~1 forward), then overwrite the
+                    # hits with their gathered drafts
+                    saved = self.num_speculative_tokens
+                    self.speculative_config.uno_fused = False
+                    try:
+                        drafts = self.propose(
+                            k, target_token_ids, target_positions, target_hidden_states, next_token_ids,
+                            token_indices_to_sample, cad, sampling_metadata,
+                            num_rejected_tokens_gpu=num_rejected_tokens_gpu,
+                        )
+                    finally:
+                        self.speculative_config.uno_fused = True
+                        self.num_speculative_tokens = saved
+                    self._last_draft_probs = None
+                    self._n_miss = getattr(self, "_n_miss", 0) + 1
+                    hit_idx = [r for r, h in enumerate(hit) if h]
+                    if hit_idx:
+                        hi = torch.tensor(hit_idx, device=self.device)
+                        gi = torch.tensor([gidx[r] for r in hit_idx], device=self.device)
+                        starts = cad.query_start_loc[:batch_size][hi] + 1 + k + gi * k
+                        rows = (starts[:, None] + torch.arange(k, device=self.device)[None, :]).reshape(-1)
+                        got = self.model.compute_logits(target_hidden_states[rows]).argmax(dim=-1).view(-1, k)
+                        drafts = drafts.clone()
+                        drafts[hi] = got.to(drafts.dtype)
+                    noise = self._noise_for_next(batch_size, e, target_positions, token_indices_to_sample, cad)
+                    return torch.cat([drafts.to(torch.int64), noise], dim=1)
+                self._n_hit = getattr(self, "_n_hit", 0) + 1
+                g_t = torch.tensor(gidx, device=self.device)
+            else:
+                g_t = j
+            starts = cad.query_start_loc[:batch_size] + 1 + k + g_t * k
+            rows = (starts[:, None] + torch.arange(k, device=self.device)[None, :]).reshape(-1)
+            logits = self.model.compute_logits(target_hidden_states[rows])
+            drafts = logits.argmax(dim=-1).view(batch_size, k)
+            if self._want_dump(batch_size):
+                torch.save({"step": self._step, "q_lens": q_lens, "rejected": rejected.cpu(),
+                            "j": j.cpu(), "drafts": drafts.cpu(),
+                            "bonus": next_token_ids[:batch_size].cpu()},
+                           os.path.join(os.environ["UNO_DEBUG_DUMP"], f"uno-fused-step{self._step}.pt"))
+        else:
+            if self._want_dump(batch_size):
+                torch.save({"step": self._step, "q_lens": q_lens, "bootstrap": True},
+                           os.path.join(os.environ["UNO_DEBUG_DUMP"], f"uno-fused-step{self._step}-boot.pt"))
+            # bootstrap / mixed batch: regular two-pass draft with K rows
+            saved = self.num_speculative_tokens
+            self.speculative_config.uno_fused = False
+            try:
+                drafts = self.propose(
+                    k, target_token_ids, target_positions, target_hidden_states, next_token_ids,
+                    token_indices_to_sample, cad, sampling_metadata,
+                    num_rejected_tokens_gpu=num_rejected_tokens_gpu,
+                )
+            finally:
+                self.speculative_config.uno_fused = True
+                self.num_speculative_tokens = saved
+            self._last_draft_probs = None
+            if hybrid:
+                for rid in req_ids:
+                    self.groups.setdefault(rid, self.default_groups())
+        noise = self._noise_for_next(batch_size, e, target_positions, token_indices_to_sample, cad)
+        r = getattr(self, 'runner', None)
+        if r is not None and hasattr(r, '_uno_lap') and getattr(r, '_uno_t_exec', None) is not None:
+            r._uno_lap("exec", r._uno_t_exec)
+            if hasattr(r, '_uno_seg'): r._uno_seg("propose")
+        return torch.cat([drafts.to(torch.int64), noise], dim=1)
+
+    def _noise_for_next(self, batch_size, e, target_positions, token_indices_to_sample, cad) -> torch.Tensor:
+        """Noise ids for the next fused block. UNO_DEBUG_NOISE_ORACLE=<json {prompt_len, ids}> (gate knob) sets
+        the FIRST noise row in block order to the true greedy token of its verification position (bonus + K + 1):
+        the exact coincidence that would let a sampler whose window reaches past the K real drafts accept a noise
+        row after an all-accept step. With the per-request boundary the output must stay identical to plain."""
+        noise = self._fresh_noise(batch_size, e)
+        spec = os.environ.get("UNO_DEBUG_NOISE_ORACLE")
+        if spec:
+            if getattr(self, "_oracle", None) is None:
+                self._oracle = json.load(open(spec))
+                self._oracle_hits = 0
+            k = int(self.speculative_config.uno_fused_k)
+            if token_indices_to_sample is not None:
+                idx = token_indices_to_sample[:batch_size].long()
+            else:
+                idx = (cad.query_start_loc[1 : batch_size + 1] - 1).long()
+            p_next = (target_positions[idx] + 1).tolist()
+            plen, ids = int(self._oracle["prompt_len"]), self._oracle["ids"]
+            for r in range(batch_size):
+                t = p_next[r] + k + 1 - plen
+                if 0 <= t < len(ids):
+                    noise[r, 0] = int(ids[t])
+                    self._oracle_hits += 1
+            if self._oracle_hits in (1, 50, 200):
+                logger.info("UNO_DEBUG_NOISE_ORACLE: %d forced noise ids so far", self._oracle_hits)
+        return noise
+
+    def _maybe_dump(self, draft_token_ids: torch.Tensor) -> None:
+        """UNO_DEBUG_DUMP=<dir>: save the first few draft passes (inputs, positions, slots, the
+        active per-token LoRA indices and the drafts) for offline comparison with a PEFT reference."""
+        d = os.environ.get("UNO_DEBUG_DUMP")
+        if not d or self._step > 4:
+            return
+        n = self.num_speculative_tokens * draft_token_ids.shape[0]
+        lora_idx = None
+        try:
+            pw = self.runner.lora_manager._adapter_manager.punica_wrapper
+            lora_idx = pw._token_lora_indices[:n].detach().cpu()
+        except Exception as e:  # noqa: BLE001
+            lora_idx = str(e)
+        torch.save(
+            {
+                "step": self._step,
+                "input_ids": self.input_ids[:n].detach().cpu(),
+                "positions": self.positions[:n].detach().cpu(),
+                "slots": self._slot_mapping_buffer[:n].detach().cpu(),
+                "lora_token_indices": lora_idx,
+                "draft_token_ids": draft_token_ids.detach().cpu(),
+            },
+            os.path.join(d, f"uno-dump-step{self._step}.pt"),
+        )
+
+    @override
+    def dummy_run(self, num_tokens: int, use_cudagraphs: bool = True,
+                  is_graph_capturing: bool = False, slot_mappings=None) -> None:
+        # Self-drafting: the target model is warmed up and graph-captured by the runner
+        # itself. Running it again from here (inside the runner's capture loop, through
+        # its piecewise backend, with the drafter's buffers) faults with an illegal
+        # memory access. Nothing to do.
+        return
