+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One-kernel input preparation for the linear two-pass Uno draft.
+
+The step counter is shared by all private graph buckets and eager fallbacks.
+A single CTA loads and advances it once, so graph replay does not freeze the
+noise seed or require a per-step host-to-device scalar transfer. Startup resets
+the counter after capture warmups, before the first live proposal.
+"""
+
+from dataclasses import dataclass
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _prepare_uno_draft_kernel(
+    next_ids_ptr,
+    target_positions_ptr,
+    target_qsl_ptr,
+    target_seq_lens_ptr,
+    rejected_ptr,
+    block_table_ptr,
+    step_ptr,
+    out_ids_ptr,
+    out_positions_ptr,
+    out_slots_ptr,
+    out_seq_lens_ptr,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BASE_SEED: tl.constexpr,
+    LOW: tl.constexpr,
+    HIGH: tl.constexpr,
+    KV_BLOCK_SIZE: tl.constexpr,
+    BLOCK_STRIDE: tl.constexpr,
+    MAX_MODEL_LEN: tl.constexpr,
+    HAS_REJECTED: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.arange(0, BLOCK).to(tl.int64)
+    valid = row < N
+    request = row // K
+    offset = row % K
+    rejected = tl.full((BLOCK,), 0, tl.int64)
+    if HAS_REJECTED:
+        rejected = tl.load(rejected_ptr + request, valid, other=0).to(tl.int64)
+    end = tl.load(target_qsl_ptr + request + 1, valid, other=1).to(tl.int64)
+    last = tl.load(target_positions_ptr + end - rejected - 1, valid, other=0)
+    position = last.to(tl.int64) + 1 + offset
+    tl.store(out_positions_ptr + row, position, valid)
+
+    # Only reserved, in-bounds draft slots may be written. The verifier replaces
+    # these temporary KVs before the scheduler commits any accepted draft.
+    slot_valid = valid & (position >= 0) & (position < MAX_MODEL_LEN)
+    block = tl.minimum(position // KV_BLOCK_SIZE, BLOCK_STRIDE - 1)
+    block_id = tl.load(
+        block_table_ptr + request * BLOCK_STRIDE + block,
+        slot_valid,
+        other=0,
+    ).to(tl.int64)
+    slot = block_id * KV_BLOCK_SIZE + position % KV_BLOCK_SIZE
+    tl.store(out_slots_ptr + row, tl.where(slot_valid, slot, -1), valid)
+
+    step = tl.load(step_ptr).to(tl.int64) + 1
+    mask: tl.constexpr = (1 << 62) - 1
+    seeds = ((request + BASE_SEED) * 0x1E3779B185EBCA8) & mask
+    step_term = (step * 0x11B54A32D192ED0) & mask
+    h = (seeds + step_term + row) & mask
+    h = ((h ^ (h >> 30)) * 0x3F58476D1CE4E5B9) & mask
+    h = ((h ^ (h >> 27)) * 0x14D049BB133111EB) & mask
+    h = h ^ (h >> 31)
+    noise = h % (HIGH - LOW) + LOW
+    bonus = tl.load(next_ids_ptr + request, valid, other=0)
+    tl.store(out_ids_ptr + row, tl.where(offset == 0, bonus, noise), valid)
+    seq_len = tl.load(target_seq_lens_ptr + request, valid, other=0)
+    tl.store(
+        out_seq_lens_ptr + request,
+        seq_len.to(tl.int64) - rejected + K,
+        valid & (offset == 0),
+    )
+    # Exactly one program owns this scalar. It is loaded once above, and no
+    # read follows the write, so no cross-program or read-after-write race exists.
+    tl.store(step_ptr, step)
+
+
+@dataclass
+class DraftPrepInputs:
+    next_token_ids: torch.Tensor
+    target_positions: torch.Tensor
+    query_start_loc: torch.Tensor
+    seq_lens: torch.Tensor
+    num_rejected_tokens: torch.Tensor | None
+
+    def accepts(self, other: "DraftPrepInputs") -> bool:
+        """Only shape/dtype/device checks; never inspect live device values."""
+        return self.miss_reason(other) is None
+
+    def miss_reason(self, other: "DraftPrepInputs") -> str | None:
+        for name in ("next_token_ids", "query_start_loc", "seq_lens"):
+            target, source = getattr(self, name), getattr(other, name)
+            if target.shape != source.shape:
+                return f"{name}_shape"
+            if target.dtype != source.dtype or target.device != source.device:
+                return f"{name}_device_or_dtype"
+            if source.ndim != 1 or not source.is_contiguous():
+                return f"{name}_layout"
+        target, source = self.target_positions, other.target_positions
+        if source.ndim != 1 or not source.is_contiguous():
+            return "target_positions_layout"
+        if source.numel() > target.numel() or source.numel() == 0:
+            return "target_positions_capacity"
+        if source.dtype != target.dtype or source.device != target.device:
+            return "target_positions_device_or_dtype"
+        rejected = other.num_rejected_tokens
+        if rejected is not None and not (
+            self.num_rejected_tokens is not None
+            and rejected.shape == self.seq_lens.shape
+            and rejected.dtype == self.num_rejected_tokens.dtype
+            and rejected.device == self.seq_lens.device
+            and rejected.is_contiguous()
+        ):
+            return "num_rejected_tokens"
+        return None
+
+    def copy_from(self, other: "DraftPrepInputs") -> None:
+        assert self.num_rejected_tokens is not None
+        for name in ("next_token_ids", "query_start_loc", "seq_lens"):
+            getattr(self, name).copy_(getattr(other, name), non_blocking=True)
+        self.target_positions[: other.target_positions.numel()].copy_(
+            other.target_positions, non_blocking=True
+        )
+        if other.num_rejected_tokens is None:
+            self.num_rejected_tokens.zero_()
+        else:
+            self.num_rejected_tokens.copy_(other.num_rejected_tokens, non_blocking=True)
+
+
+def prepare_uno_draft(
+    inputs: DraftPrepInputs,
+    out_ids: torch.Tensor,
+    out_positions: torch.Tensor,
+    out_slots: torch.Tensor,
+    out_seq_lens: torch.Tensor,
+    block_table: torch.Tensor,
+    step_counter: torch.Tensor,
+    *,
+    k: int,
+    seed: int,
+    low: int,
+    high: int,
+    block_size: int,
+    max_model_len: int,
+) -> None:
+    """Fill exactly B*K draft rows, preserving bonus ids and the eager hash.
+
+    Query row zero is the real bonus token and rows 1..K-1 contain noise. The
+    output is only model input; sampling and scheduler/KV commit state are not
+    touched. The caller must execute this once per live proposal, either inside
+    its private graph or on the eager fallback, never both.
+    """
+    batch = inputs.next_token_ids.numel()
+    n = out_ids.numel()
+    if k < 1 or batch < 1 or n != batch * k:
+        raise ValueError("Uno draft prep requires exactly batch_size * K rows, K >= 1")
+    if high <= low or block_size < 1 or max_model_len < 1:
+        raise ValueError("Uno draft prep requires valid noise and position bounds")
+    vectors = (
+        inputs.next_token_ids,
+        inputs.target_positions,
+        inputs.query_start_loc,
+        inputs.seq_lens,
+        out_ids,
+        out_positions,
+        out_slots,
+        out_seq_lens,
+    )
+    if any(value.ndim != 1 or not value.is_contiguous() for value in vectors):
+        raise ValueError("Uno draft prep requires contiguous one-dimensional inputs")
+    if (
+        inputs.query_start_loc.numel() != batch + 1
+        or inputs.seq_lens.numel() != batch
+        or out_seq_lens.numel() != batch
+        or out_positions.numel() != n
+        or out_slots.numel() != n
+        or inputs.target_positions.numel() == 0
+        or step_counter.numel() != 1
+        or step_counter.dtype != torch.int64
+        or block_table.ndim != 2
+        or block_table.shape[0] != batch
+        or block_table.shape[1] == 0
+        or block_table.stride(1) != 1
+    ):
+        raise ValueError("Uno draft prep input/output metadata shapes are inconsistent")
+    rejected = inputs.num_rejected_tokens
+    if rejected is not None and (
+        rejected.shape != inputs.seq_lens.shape or not rejected.is_contiguous()
+    ):
+        raise ValueError(
+            "Uno draft prep requires one contiguous rejected count per request"
+        )
+    _prepare_uno_draft_kernel[(1,)](
+        inputs.next_token_ids,
+        inputs.target_positions,
+        inputs.query_start_loc,
+        inputs.seq_lens,
+        inputs.num_rejected_tokens,
+        block_table,
+        step_counter,
+        out_ids,
+        out_positions,
+        out_slots,
+        out_seq_lens,
+        N=n,
+        K=k,
+        BASE_SEED=seed,
+        LOW=low,
+        HIGH=high,
+        KV_BLOCK_SIZE=block_size,
+        BLOCK_STRIDE=block_table.stride(0),
+        MAX_MODEL_LEN=max_model_len,
+        HAS_REJECTED=inputs.num_rejected_tokens is not None,
+        BLOCK=triton.next_power_of_2(n),
+        num_warps=4 if n <= 1024 else 8,
+    )
