+        index = result.tokens[:, 0] * 9 + result.tokens[:, 1] * 3 + result.tokens[:, 2]
+        counts += torch.bincount(index, minlength=27)
+    expected = []
+    for a, b, c in itertools.product(range(vocab), repeat=3):
+        expected.append(
+            probs[0, a]
+            * probs[paths.index((a,)) + 1, b]
+            * probs[paths.index((a, b)) + 1, c]
+        )
+    _chi_square(counts, torch.stack(expected), alpha=1e-7)
+
+
+def test_kv_compaction_gathers_before_overlapping_scatter_and_discards_siblings():
+    q = torch.tensor([[[0.6, 0.4], [0.6, 0.4], [0.6, 0.4]]])
+    tree = build_tree(q, 2, 14)
+    paths = _paths(tree)
+    draws = torch.zeros((1, 15), dtype=torch.long)
+    draws[0, 0] = 1
+    draws[0, paths.index((1,)) + 1] = 1
+    draws[0, paths.index((1, 1)) + 1] = 0
+    result = walk_tree(tree, draws)
+    sources = accepted_target_rows(result)[0]
+    assert sources.tolist() == [
+        0,
+        paths.index((1,)) + 1,
+        paths.index((1, 1)) + 1,
+        paths.index((1, 1, 0)) + 1,
+    ]
+    cache = torch.arange(15 * 8).reshape(15, 8)
+    expected = cache[sources].clone()
+    compact = cache[sources].clone()  # materialize before any overlapping write
+    cache[: len(sources)] = compact
+    visible_length = int(result.num_accepted[0]) + 1
+    assert torch.equal(cache[:visible_length], expected)
+    # The last sampled token is intentionally uncached; the caller advances the
+    # valid cache extent only over root + accepted nodes, not every tree row.
+    assert visible_length == 4
+    assert result.lengths[0] == 4
+    assert set(sources.tolist()).isdisjoint(
+        {paths.index((0,)) + 1, paths.index((1, 0)) + 1}
+    )
