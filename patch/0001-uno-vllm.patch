+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Host-synchronisation removal for the Uno two-pass decode step.
+
+Everything here is reached only when ``speculative_config.uno_no_host_sync`` is
+set; with the flag off not one byte of behaviour changes.
+
+Why it exists
+-------------
+vLLM's async scheduling only wins when the model-runner step enqueues its work
+and returns without waiting on the device. The Uno two-pass proposer serves its
+draft rows through a gated LoRA, and vLLM rebuilds the Punica per-token LoRA
+metadata from scratch on *both* passes of every step:
+
+* the target pass, from ``GPUModelRunner._prepare_inputs`` ->
+  ``set_active_loras`` -> ``LoRAModelManager.set_adapter_mapping``;
+* the draft pass, from the proposer's LoRA hook, with the noise-row mapping.
+
+``PunicaWrapperGPU.update_metadata`` wraps that rebuild in ``gpu_sync_allowed()``
+with a standing ``# TODO avoid gpu<->cpu sync here``: ``LoRAKernelMeta.
+prepare_tensors`` writes a device boolean into a CPU tensor and then branches on
+it, and calls ``torch.unique``, whose output size is data dependent. Both
+synchronise. Two passes x two metas is up to four full host waits per decode
+step, every one of them issued *before* the pass they belong to is enqueued, so
+each drains the previous step's verify forward. That is the overlap async
+scheduling was supposed to buy.
+
+The content of both mappings is a function of shape alone:
+
+* the draft mapping is ``(0, uno, uno, ...)`` repeated per request -- one clean
+  bonus row then ``k - 1`` noise rows -- plus zero padding to the graph bucket;
+* the target mapping of an Uno server with no user adapters is all-base.
+
+So the metadata is cached per shape and restored with in-place copies, exactly
+as SGLang's UNO integration caches one ``batch_info`` per draft batch size
+(``reference/sglang-uno/uno_lora.py::UnoCudaGraphLoRAState``). A miss runs
+vLLM's own unmodified builder and is allowed to synchronise once; every later
+step of that shape is sync-free.
+
+Nothing here changes the numbers the kernels see: a restored plan is a
+byte-for-byte copy of what the native builder produced for that shape, so the
+sampling law and the greedy output are untouched.
+"""
+
+from collections import OrderedDict
+
+import torch
+
+from vllm.v1.spec_decode.uno_draft_cost import (
+    _BASE_FIELDS,
+    _KERNEL_PREFIX,
+    _KERNEL_RESET,
+    _METAS,
+)
+
+
+class StepConstants:
+    """Per-shape device and host tensors the draft pass rebuilds every step.
+
+    ``req_seeds`` (one noise seed per request, expanded to the draft rows) and
+    the CPU ``query_start_loc`` depend only on ``(batch_size, q)`` and the fixed
+    configured seed. Building them per step is not a synchronisation, but it is
+    two kernel launches and two allocations of host work in front of a pass we
+    are trying to keep enqueued; caching them is free.
+
+    Entries allocated while a CUDA graph is capturing are never retained: such
+    an allocation lives in the capture pool and a later capture would overwrite
+    it (the same hazard encountered by the fused block mask).
+    """
+
+    def __init__(self, capacity: int = 64):
+        if capacity < 1:
+            raise ValueError("cache capacity must be positive")
+        self.capacity = capacity
+        self._seeds: OrderedDict = OrderedDict()
+        self._qsl: OrderedDict = OrderedDict()
+        self._qsl_device: OrderedDict = OrderedDict()
+        self.hits = 0
+        self.misses = 0
+
+    @staticmethod
+    def _capturing(device: torch.device) -> bool:
+        return device.type == "cuda" and torch.cuda.is_current_stream_capturing()
+
+    def _put(self, store: OrderedDict, key, value) -> None:
+        store[key] = value
+        store.move_to_end(key)
+        if len(store) > self.capacity:
+            store.popitem(last=False)
+
+    def req_seeds(
+        self, batch_size: int, q: int, base_seed: int, device: torch.device
+    ) -> torch.Tensor:
+        """``(arange(batch) + base_seed).repeat_interleave(q)`` on ``device``."""
+        if batch_size < 1 or q < 1:
+            raise ValueError("req_seeds requires positive batch and q")
+        device = torch.device(device)
+        key = (batch_size, q, int(base_seed), device)
+        cached = self._seeds.get(key)
+        if cached is not None:
+            self.hits += 1
+            self._seeds.move_to_end(key)
+            return cached
+        self.misses += 1
+        seeds = (
+            torch.arange(batch_size, device=device, dtype=torch.int64) + int(base_seed)
+        ).repeat_interleave(q)
+        if not self._capturing(device):
+            self._put(self._seeds, key, seeds)
+        return seeds
+
+    def query_start_loc_cpu(
+        self, batch_size: int, q: int, token_arange_np
+    ) -> torch.Tensor:
+        """The draft pass's host ``query_start_loc``: ``arange(batch + 1) * q``.
+
+        Returned buffers are read-only to callers; the attention builders only
+        read them.
+        """
+        if batch_size < 1 or q < 1:
+            raise ValueError("query_start_loc requires positive batch and q")
+        key = (batch_size, q)
+        cached = self._qsl.get(key)
+        if cached is not None:
+            self.hits += 1
+            self._qsl.move_to_end(key)
+            return cached
+        self.misses += 1
+        value = torch.from_numpy(token_arange_np[: batch_size + 1]).clone() * q
+        self._put(self._qsl, key, value)
+        return value
+
+    def query_start_loc_device(
+        self, batch_size: int, q: int, token_arange_np, device: torch.device
+    ) -> torch.Tensor:
+        """Immutable device query offsets for the fused draft-prep path."""
+        device = torch.device(device)
+        key = (batch_size, q, device)
+        cached = self._qsl_device.get(key)
+        if cached is not None:
+            self.hits += 1
+            self._qsl_device.move_to_end(key)
+            return cached
+        self.misses += 1
+        value = self.query_start_loc_cpu(batch_size, q, token_arange_np).to(device)
+        if not self._capturing(device):
+            self._put(self._qsl_device, key, value)
+        return value
+
+    def stats(self) -> dict:
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "seed_entries": len(self._seeds),
+            "qsl_entries": len(self._qsl),
+        }
+
+
+class UnoLoRAPlan:
+    """One shape's Punica metadata, restorable without touching the device."""
+
+    __slots__ = ("lengths", "is_prefill", "tensors")
+
+    def __init__(self, lengths, is_prefill, tensors):
+        self.lengths = lengths
+        self.is_prefill = is_prefill
+        self.tensors = tensors
+
+    def restore(self, wrapper) -> None:
+        for name, snapshot in self.tensors:
+            target = _target(wrapper, name)
+            target[: snapshot.shape[0]].copy_(snapshot, non_blocking=True)
+        wrapper.indices_len[:] = self.lengths
+        wrapper.is_prefill = self.is_prefill
+
+
+def _target(wrapper, name):
+    if isinstance(name, tuple):
+        return getattr(getattr(wrapper, name[0]), name[1])
+    return getattr(wrapper, name)
+
+
+def snapshot_plan(wrapper) -> UnoLoRAPlan | None:
+    """Capture whatever the native builder just wrote into ``wrapper``.
+
+    Mirrors ``PunicaMappingCache.remember`` field for field, so a
+    restore reproduces the native result exactly, including the deliberate
+    omission of the token buffers on an all-no-LoRA update -- the native path
+    resets the counters and flags there but leaves the token buffers alone, and
+    a restore must leave them alone too.
+
+    ``None`` means the wrapper does not have the layout this cache understands;
+    the caller then keeps using the native builder on every step.
+    """
+    try:
+        lengths = tuple(wrapper.indices_len)
+        if any(length is None for length in lengths):
+            return None
+        tensors: list = [
+            (name, getattr(wrapper, name)[:length].clone())
+            for name, length in zip(_BASE_FIELDS, lengths)
+        ]
+        for owner, length in zip(_METAS, lengths[:2]):
+            meta = getattr(wrapper, owner)
+            tensors.extend(
+                ((owner, name), getattr(meta, name).clone()) for name in _KERNEL_RESET
+            )
+            # `no_lora_flag_cpu` is already CPU resident: reading it is not a
+            # device synchronisation.
+            if not bool(meta.no_lora_flag_cpu[0]):
+                tensors.extend(
+                    ((owner, name), getattr(meta, name)[:length].clone())
+                    for name in _KERNEL_PREFIX
+                )
+        return UnoLoRAPlan(lengths, wrapper.is_prefill, tensors)
+    except (AttributeError, IndexError, TypeError):
+        return None
+
+
+def wrapper_fingerprint(wrapper):
+    """Buffer identity: addresses, shapes, strides, dtypes, devices.
+
+    A plan is only valid while the buffers it was cloned out of are the same
+    objects at the same addresses. An out-of-band ``add_lora`` that evicts and
+    reassigns adapter slots, or any reallocation, changes this and clears the
+    cache.
+    """
+    try:
+        parts = []
+        for name in _BASE_FIELDS:
+            parts.append((name, _describe(getattr(wrapper, name))))
+        for owner in _METAS:
+            meta = getattr(wrapper, owner)
+            for name in (*_KERNEL_PREFIX, *_KERNEL_RESET,
+                         "default_num_active_loras_cpu"):
+                parts.append(((owner, name), _describe(getattr(meta, name))))
+            parts.append(((owner, "captured"), tuple(meta.captured_lora_counts)))
+        return tuple(parts)
+    except AttributeError:
+        return None
+
+
+def _describe(value):
+    if not isinstance(value, torch.Tensor):
+        raise AttributeError("expected a tensor buffer")
+    return (
+        value.data_ptr(),
+        tuple(value.shape),
+        value.stride(),
+        value.dtype,
+        value.device,
+    )
+
+
+class UnoLoRAPlanCache:
+    """Shape-keyed Punica plans for the Uno draft pass and the base target pass.
+
+    ``kind`` separates the two mappings a step installs. Both are pure functions
+    of shape for an Uno server:
+
+    * ``"draft"``: ``(0, uno, ... , uno)`` per request, then zero padding;
+    * ``"base"``: every token on the base model.
+
+    A miss falls through to the caller's native builder (which may synchronise
+    once) and is snapshotted afterwards. A hit performs in-place device copies
+    only. Capture-time installs never read or write the cache: an allocation
+    made inside a capture belongs to the graph pool.
+    """
+
+    def __init__(self, capacity: int = 64):
+        if capacity < 1:
+            raise ValueError("cache capacity must be positive")
+        self.capacity = capacity
+        self.entries: OrderedDict = OrderedDict()
+        self.hits = self.misses = self.bypasses = self.invalidations = 0
+        self._fingerprint = None
+
+    def _key(self, wrapper, kind, shape, slots):
+        device = getattr(wrapper, "_token_lora_indices", None)
+        if device is None:
+            return None
+        if device.device.type == "cuda" and torch.cuda.is_current_stream_capturing():
+            return None
+        fingerprint = wrapper_fingerprint(wrapper)
+        if fingerprint is None:
+            return None
+        if self._fingerprint != fingerprint:
+            if self._fingerprint is not None:
+                self.invalidations += 1
+            self.entries.clear()
+            self._fingerprint = fingerprint
+        return (kind, tuple(shape), tuple(slots))
+
+    def restore(self, wrapper, kind, shape, slots) -> bool:
+        """Install a cached plan. ``False`` means the caller must build it."""
+        key = self._key(wrapper, kind, shape, slots)
+        if key is None:
+            self.bypasses += 1
+            return False
+        plan = self.entries.get(key)
+        if plan is None:
+            self.misses += 1
+            return False
+        self.hits += 1
+        self.entries.move_to_end(key)
+        plan.restore(wrapper)
+        return True
+
+    def remember(self, wrapper, kind, shape, slots) -> None:
+        """Snapshot what the native builder wrote for this shape."""
+        key = self._key(wrapper, kind, shape, slots)
+        if key is None:
+            return
+        plan = snapshot_plan(wrapper)
+        if plan is None:
+            return
+        self.entries[key] = plan
+        self.entries.move_to_end(key)
+        if len(self.entries) > self.capacity:
+            self.entries.popitem(last=False)
+
+    def stats(self) -> dict:
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "bypasses": self.bypasses,
+            "invalidations": self.invalidations,
+            "entries": len(self.entries),
+        }
+
+
+def draft_lora_mapping(num_input_tokens: int, batch_size: int, k: int,
+                       uno_lora_id: int) -> tuple[int, ...]:
+    """The draft pass's per-token mapping, built only on a cache miss.
+
+    Row 0 of each request is the clean bonus row (base weights, paper Eq. 4);
+    rows 1..k-1 carry the diffusion adapter. Anything past ``batch_size * k`` is
+    CUDA-graph padding and takes the base model.
+    """
+    if num_input_tokens < batch_size * k:
+        raise ValueError("padding cannot truncate the draft rows")
+    per_request = (0,) + (uno_lora_id,) * (k - 1)
+    return per_request * batch_size + (0,) * (num_input_tokens - batch_size * k)
+
+
+def validate_no_host_sync(config, lora_impl: str) -> None:
+    """Reject configurations the plan path does not serve.
+
+    Lives here rather than in ``SpeculativeConfig``'s validator for the same
+    reason 0012's ``validate_draft_cost`` does: the LoRA implementation is an
+    environment choice the proposer resolves, and the tensor-parallel size is
+    on ``VllmConfig``, neither of which the speculative-config validator can
+    see. The speculative-only guards (method, fused, lookup, tree) stay there.
+
+    * ``UNO_LORA_IMPL=punica`` -- the runner installs planned mappings only on
+      the punica path; the hooks implementation applies the adapter by dynamic
+      boolean row indexing inside a forward hook, which the plan cache neither
+      covers nor makes sync-free.
+    * ``tensor_parallel_size == 1`` -- a plan is a snapshot of one punica
+      wrapper's buffers. Multi-rank behaviour is unreasoned and untested.
+    """
+    sc = config.speculative_config
+    if sc is None or not getattr(sc, "uno_no_host_sync", False):
+        return
+    if lora_impl != "punica":
+        raise ValueError(
+            "uno_no_host_sync requires UNO_LORA_IMPL=punica; the hooks "
+            f"implementation (UNO_LORA_IMPL={lora_impl}) applies the adapter by "
+            "dynamic boolean row indexing in a forward hook, which the plan "
+            "cache does not cover"
+        )
+    if config.parallel_config.tensor_parallel_size != 1:
+        raise ValueError(
+            "uno_no_host_sync requires tensor_parallel_size=1; a plan snapshots "
+            "one punica wrapper's buffers and multi-rank behaviour is untested"
+        )
