+class OverlapScope:
+    def __init__(self):
+        self.binding_key = 1
+        self.route = None
+        self.valid = True
+        self.binding_state = NS(describe=lambda: {"slot": 0, "lora_id": UNO_ID})
+
+    def resolve_binding(self, manager, adapter_id):
+        return self.binding_state
+
+    def matches(self, manager, adapter_id):
+        return self.valid
+
+    @contextlib.contextmanager
+    def draft(self, manager, adapter_id, batch, k, n):
+        assert self.route is None
+        self.route = (batch, k, n)
+        try:
+            yield
+        finally:
+            self.route = None
+
