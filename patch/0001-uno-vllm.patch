+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Separate Uno's physical verifier rows from its logical sampling rows.
+
+All K proposals remain rejectable. The sampler sees [seed, d1, ..., dK]
+logits, while attention forwards only [d1, ..., dK] for a reusable request.
+
+Prefix hits change absolute positions and block IDs, not these query-local
+rows. The seed occupies the allocated suffix beyond the borrowed prefix;
+only an actual draft seed write can establish a reusable frontier.
+"""
+
+from collections import Counter, OrderedDict
+from dataclasses import dataclass, replace
+
+import numpy as np
+import torch
+
+from vllm.v1.spec_decode.metadata import VerifyRowLayout
+
+
+@dataclass
+class RowPlan:
+    rows: torch.Tensor
+    logits_indices: torch.Tensor
+    restore_indices: torch.Tensor
+    seed_rows: torch.Tensor
+    seed_starts: torch.Tensor
+    model_logit_rows: torch.Tensor
+    seed_logit_rows: torch.Tensor
+
+
+def make_row_plan(scheduled, counts, reuse, device):
+    """Map physical model rows and cached seeds to the original sampler order."""
+    from vllm.utils.torch_utils import async_tensor_h2d
+
+    starts = np.concatenate(([0], np.cumsum(scheduled)))
+    rows, sampled, restore, seeds, seed_starts = [], [], [], [], []
+    for req, (width, count, compact) in enumerate(zip(scheduled, counts, reuse)):
+        layout = VerifyRowLayout(count, reuse_seed=bool(compact))
+        if width < layout.logical_width or (
+            compact and (count < 1 or width != layout.logical_width)
+        ):
+            raise ValueError("invalid Uno seed-row span")
+        physical_start = len(rows)
+        rows.extend(range(starts[req] + int(compact), starts[req + 1]))
+        if compact:
+            seeds.append(req)
+            seed_starts.append(starts[req])
+            restore.append(-len(seeds))
+        sample_start = physical_start + width - layout.logical_width
+        n_sampled = layout.verify_width
+        restore.extend(range(len(sampled), len(sampled) + n_sampled))
+        sampled.extend(range(sample_start, sample_start + n_sampled))
+    model_rows = [row for row, source in enumerate(restore) if source >= 0]
+    seed_logit_rows = [row for row, source in enumerate(restore) if source < 0]
+    restore = [len(sampled) - i - 1 if i < 0 else i for i in restore]
+    return RowPlan(
+        *(
+            async_tensor_h2d(value, dtype=torch.int64, device=device)
+            for value in (
+                rows,
+                sampled,
+                restore,
+                seeds,
+                seed_starts,
+                model_rows,
+                seed_logit_rows,
+            )
+        )
+    )
+
+
+@dataclass
+class SeedWrite:
+    positions: torch.Tensor
+    slots: torch.Tensor
+    tokens: torch.Tensor
+    logits: torch.Tensor
+
+
+@dataclass
+class SeedFrontier:
+    request: object
+    blocks: tuple
+    position: torch.Tensor
+    slot: torch.Tensor
+    token: torch.Tensor
+    logits: torch.Tensor
+    candidates: torch.Tensor
+
+
+class SeedRowRuntime:
+    def __init__(self, runner):
+        self.runner = runner
+        self.pending = {}
+        self.current = {}
+        self.plans = OrderedDict()
+        self._query_starts = OrderedDict()
+        self._logged = set()
+        self._checked_cache = False
+        self.fallback_request_steps = 0
+        self.fallback_reasons = Counter()
+        self._fallback_reqs = set()
+
+    def log(self, message, key=None, *, once=True):
+        key = message if key is None else key
+        if not once or key not in self._logged:
+            from vllm.logger import init_logger
+
+            init_logger(__name__).info("UNO_SEEDROW_VERIFY %s", message)
+            if once:
+                self._logged.add(key)
+
+    def report_fallbacks(self, *, once=False):
+        reasons = (
+            ",".join(
+                f"{reason}:{count}"
+                for reason, count in sorted(self.fallback_reasons.items())
+            )
+            or "-"
+        )
+        self.log(
+            f"fallback_counts total={self.fallback_request_steps} reasons={reasons}",
+            key="fallback_counter_start" if once else None,
+            once=once,
+        )
+
+    def fallback(self, reason, req_ids):
+        """Count each request once per runner step, including skipped drafts."""
+        req_ids = set(req_ids) - self._fallback_reqs
+        if not req_ids:
+            return
+        self.log(f"fallback {reason}")
+        self._fallback_reqs.update(req_ids)
+        self.fallback_request_steps += len(req_ids)
+        self.fallback_reasons[reason] += len(req_ids)
+
+    def skip_draft(self, reason):
+        """A skipped first draft must be visible even without a later verifier."""
+        before = self.fallback_request_steps
+        self.fallback(
+            reason,
+            (
+                req_id
+                for row, req_id in enumerate(self.runner.input_batch.req_ids)
+                if not self.runner.discard_request_mask.np[row]
+            ),
+        )
+        self.pending.clear()
+        if self.fallback_request_steps != before:
+            self.report_fallbacks()
+
+    def update(self, output):
+        """Discard ownership before request replacement or block reassignment."""
+        invalid = set(output.finished_req_ids)
+        invalid.update(output.scheduled_cached_reqs.resumed_req_ids)
+        invalid.update(req.req_id for req in output.scheduled_new_reqs)
+        self.pending = {
+            key: value
+            for key, value in self.pending.items()
+            if key in output.num_scheduled_tokens and key not in invalid
+        }
+        self.current = {}
+        self._fallback_reqs.clear()
+
+    def _blocks(self, req_id):
+        return tuple(tuple(group) for group in self.runner.requests[req_id].block_ids)
+
+    def copy_query_start_loc(self):
+        """Never upload from the pinned buffer that compaction rewrites in place."""
+        from vllm.utils.torch_utils import async_tensor_h2d
+
+        buffer = self.runner.query_start_loc
+        key = tuple(map(int, buffer.np))
+        source = self._query_starts.get(key)
+        if source is None:
+            source = async_tensor_h2d(
+                list(key), dtype=buffer.gpu.dtype, device=buffer.gpu.device
+            )
+            self._query_starts[key] = source
+            if len(self._query_starts) > 64:
+                self._query_starts.popitem(last=False)
+        self._query_starts.move_to_end(key)
+        buffer.gpu.copy_(source, non_blocking=True)
+
+    def _check_cache(self):
+        if self._checked_cache:
+            return
+        from vllm.v1.kv_cache_interface import (
+            FullAttentionSpec,
+            UniformTypeKVCacheSpecs,
+        )
+
+        groups = self.runner.kv_cache_config.kv_cache_groups
+        if len(groups) != 1:
+            raise ValueError("uno_seedrow_verify requires one full-attention KV group")
+        spec = groups[0].kv_cache_spec
+        specs = (
+            spec.kv_cache_specs.values()
+            if isinstance(spec, UniformTypeKVCacheSpecs)
+            else [spec]
+        )
+        if any(
+            type(s) is not FullAttentionSpec
+            or s.sliding_window is not None
+            or s.attention_chunk_size is not None
+            or s.non_causal
+            for s in specs
+        ):
+            raise ValueError("uno_seedrow_verify requires causal full attention")
+        self._checked_cache = True
+
+    def draft_enabled(self):
+        self.pending.clear()
+        if self.runner.input_batch.lora_id_to_lora_request:
+            self.skip_draft("user_adapter")
+            return False
+        self._check_cache()
+        return True
+
+    def record(self, write, candidates):
+        if write is None:
+            self.skip_draft("missing_seed_write")
+            return
+        r = self.runner
+        # Discarded partial-prefill outputs never own a reusable frontier.
+        for row, req_id in enumerate(r.input_batch.req_ids):
+            if r.discard_request_mask.np[row]:
+                continue
+            self.pending[req_id] = SeedFrontier(
+                r.requests[req_id],
+                self._blocks(req_id),
+                write.positions[row],
+                write.slots[row],
+                write.tokens[row],
+                write.logits[row],
+                candidates[row].clone(),
+            )
+
+    def compact(self, scheduled, metadata):
+        """Compact after the runner has resolved async positions and draft IDs."""
+        self._fallback_reqs.clear()
+        self.report_fallbacks(once=True)
+        if metadata is None:
+            if self.pending:
+                self.fallback("no_scheduled_candidates", self.pending)
+                self.report_fallbacks()
+            self.pending.clear()
+            return None
+        r = self.runner
+        counts = np.asarray(metadata.num_draft_tokens, dtype=np.int32)
+        if r.input_batch.lora_id_to_lora_request:
+            before = self.fallback_request_steps
+            self.fallback(
+                "user_adapter",
+                (r.input_batch.req_ids[row] for row in np.flatnonzero(counts)),
+            )
+            if self.fallback_request_steps != before:
+                self.report_fallbacks()
+            self.pending.clear()
+            return None
+        reuse = np.zeros(len(counts), dtype=bool)
+        before = self.fallback_request_steps
+        for row, req_id in enumerate(r.input_batch.req_ids):
+            saved = self.pending.pop(req_id, None)
+            if not counts[row]:
+                if saved is not None:
+                    self.fallback("no_scheduled_candidates", [req_id])
+                continue
+            if saved is None:
+                # A one-token cache-hit prefill can be padded with speculative
+                # placeholders. It has no draft seed yet; retain its full span.
+                self.fallback("missing_frontier", [req_id])
+                continue
+            if scheduled[row] != VerifyRowLayout(counts[row]).logical_width:
+                self.fallback("non_decode_span", [req_id])
+                continue
+            blocks = self._blocks(req_id)
+            valid_blocks = len(blocks) == len(saved.blocks) and all(
+                now[: len(old)] == old for old, now in zip(saved.blocks, blocks)
+            )
+            if (
+                saved.request is not r.requests[req_id]
+                or not valid_blocks
+                or counts[row] > saved.candidates.numel()
+            ):
+                self.fallback("stale_frontier", [req_id])
+                continue
+            self.current[row] = saved
+            reuse[row] = True
+        if self.fallback_request_steps != before:
+            self.report_fallbacks()
+        if not reuse.any():
+            return None
+        key = (tuple(scheduled), tuple(counts), tuple(reuse))
+        plan = self.plans.get(key)
+        if plan is None:
+            plan = make_row_plan(scheduled, counts, reuse, r.device)
+            self.plans[key] = plan
+            if len(self.plans) > 64:
+                self.plans.popitem(last=False)
+        self.plans.move_to_end(key)
+        self.plan = plan
+        saved = list(self.current.values())
+        starts = plan.seed_starts
+        torch._assert_async(
+            (r.positions[starts] == torch.stack([s.position for s in saved])).all(),
+            "UNO_SEEDROW_VERIFY seed position mismatch",
+        )
+        torch._assert_async(
+            (r.input_ids.gpu[starts] == torch.stack([s.token for s in saved])).all(),
+            "UNO_SEEDROW_VERIFY seed token mismatch",
+        )
+        torch._assert_async(
+            (
+                r.input_batch.block_table[0].slot_mapping.gpu[starts]
+                == torch.stack([s.slot for s in saved])
+            ).all(),
+            "UNO_SEEDROW_VERIFY seed slot mismatch",
+        )
+        draft_starts = np.concatenate(([0], np.cumsum(counts)))
+        actual = torch.cat(
+            [
+                metadata.draft_token_ids[draft_starts[row] : draft_starts[row + 1]]
+                for row in self.current
+            ]
+        )
+        expected = torch.cat(
+            [item.candidates[: counts[row]] for row, item in self.current.items()]
+        )
+        torch._assert_async(
+            (actual == expected).all(), "UNO_SEEDROW_VERIFY candidate mismatch"
+        )
+        self.seed_logits = torch.stack([s.logits for s in saved])
+        self.logical_counts = scheduled.copy()
+        logical_n = int(scheduled.sum())
+        self.logical_ids = r.input_ids.gpu[:logical_n].clone()
+        self.logical_positions = r.positions[:logical_n].clone()
+        self.logical_slots = (
+            r.input_batch.block_table[0].slot_mapping.gpu[:logical_n].clone()
+        )
+        self.logical_qsl = r.query_start_loc.gpu[: len(counts) + 1].clone()
+        self.logical_qsl_cpu = r.query_start_loc.cpu[: len(counts) + 1].clone()
+        self.reuse_cpu = torch.from_numpy(reuse.astype(np.int32))
+        n = plan.rows.numel()
+        r.input_ids.gpu[:n].copy_(self.logical_ids[plan.rows])
+        r.positions[:n].copy_(self.logical_positions[plan.rows])
+        scheduled -= reuse.astype(np.int32)
+        self.physical_tokens = n
+        cumulative = np.cumsum(scheduled, dtype=np.int32)
+        r.query_start_loc.np[0] = 0
+        r.query_start_loc.np[1 : len(counts) + 1] = cumulative
+        r.query_start_loc.np[len(counts) + 1 :].fill(n)
+        self.copy_query_start_loc()
+        r.input_batch.block_table.compute_slot_mapping(
+            len(counts), r.query_start_loc.gpu[: len(counts) + 1], r.positions[:n]
+        )
+        self.log(
+            f"active batch={len(counts)} reused={int(reuse.sum())} "
+            f"logical_rows={logical_n} physical_rows={n} "
+            f"sampled={not r.input_batch.sampling_metadata.all_greedy}",
+            key=(
+                r.input_batch.sampling_metadata.all_greedy,
+                len(counts),
+                int(reuse.sum()),
+                logical_n,
+                n,
+            ),
+        )
+        return plan.logits_indices
+
+    def restore_logits(self, logits):
+        """Restore raw seed logits before the ordinary target sampler processes them."""
+        output = logits.new_empty((self.plan.restore_indices.numel(), logits.shape[1]))
+        output.index_copy_(0, self.plan.model_logit_rows, logits)
+        output.index_copy_(0, self.plan.seed_logit_rows, self.seed_logits)
+        return output
+
+    def draft_context(self, cad):
+        """Keep rejection and next-seed gathers in logical coordinates, even at d1."""
+        return replace(
+            cad,
+            query_start_loc=self.logical_qsl,
+            query_start_loc_cpu=self.logical_qsl_cpu,
+            num_actual_tokens=int(self.logical_counts.sum()),
+            max_query_len=int(self.logical_counts.max()),
+            slot_mapping=self.logical_slots,
+            positions=self.logical_positions,
+            _num_computed_tokens_cpu=None,
+        )
