--- /dev/null
+++ b/vllm/v1/spec_decode/uno_sampler.py
@@ -0,0 +1,547 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Uno compact-support draft/verify sampling and an all-greedy fast path.
+
+Both paths are opt-in (``uno_sparse_topk`` / ``uno_greedy_fastpath``, default
+false) and sit *beside* ``vllm/v1/sample/rejection_sampler.py``; that module is
+never modified. Every request that this file cannot serve exactly falls back to
+the dense ``RejectionSampler``.
+
+Borrowed from SGLang's UNO integration (Apache-2.0, ``reference/sglang-uno``):
+the compact top-k support representation and the id-match p/q lookup of
+``uno_utils._sparse_rejection_from_support``. The *truncation* and the
+*acceptance rule* follow vLLM, not SGLang:
+
+* order is temperature, then top-k, then top-p, then softmax
+  (``Sampler.sample`` / ``apply_sampling_constraints``);
+* top-k keeps every entry whose value equals the k-th largest, and top-p drops
+  the ascending-cumulative tail at ``<= 1 - p`` while always keeping the single
+  largest entry, exactly as ``apply_top_k_top_p_pytorch`` does;
+* acceptance is ``target_prob / draft_prob >= uniform`` with a
+  ``draft_prob > 0`` guard and a float64 uniform, exactly as
+  ``rejection_random_sample_kernel`` writes it (SGLang uses ``u < ratio`` on a
+  float32 uniform and clamps the ratio first).
+
+**On ties, and which vLLM this matches.** vLLM has two truncation backends and
+they do not agree with each other. ``apply_top_k_top_p_pytorch`` thresholds by
+value, so it keeps *every* entry equal to the k-th largest (logits ``[0,0,0,0]``
+with ``top_k=2`` stay uniform over four). The Triton kernel that actually runs on
+CUDA keeps *exactly* k, resolving duplicates by vocabulary index, and it finds
+its pivot by an 18-step ternary search with a ``1e-9`` duplicate tolerance, so it
+is not bitwise reproducible by any other implementation. This file matches the
+PyTorch reference: it is exact, deterministic, and independent of ``topk``'s own
+tie order. Where the tie group is wider than the retained support the two must
+differ; that case is detected exactly and counted under ``UNO_SPARSE_STATS=1``.
+Ties are *not* negligible with bf16 logits, which is why this is a value
+threshold and not a rank cut.
+
+No operation here waits on the device: no ``.item()``, ``.cpu()``, ``bool()`` or
+unsized ``repeat_interleave``. ``test_uno_sampler_nosync.py`` enforces that.
+
+This module imports torch only: the CPU gates load it by path.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Requests whose top_k exceeds this stay on the dense path (SGLang's limit).
+SPARSE_TOP_K_LIMIT = 128
+# Must equal vllm.v1.sample.rejection_sampler.PLACEHOLDER_TOKEN_ID; the source
+# integration test asserts that it does.
+PLACEHOLDER_TOKEN_ID = -1
+
+
+# --------------------------------------------------------------------------
+# Counters. Host-side integers, so counting costs no device wait. A validation run
+# that reports a measurement must show these positive: a silent fallback and a
+# working fast path are otherwise indistinguishable from the outside.
+# --------------------------------------------------------------------------
+
+
+class FastPathStats:
+    KINDS = ("draft_sparse", "verify_sparse", "greedy_fastpath")
+
+    def __init__(self, log_every: int = 500):
+        self.log_every = log_every
+        self.counts = dict.fromkeys(self.KINDS, 0)
+        self.declined: dict[str, int] = {}
+        self._since_report = 0
+        self._ambiguous: torch.Tensor | None = None
+
+    def used(self, kind: str) -> str | None:
+        """Count one step on ``kind``. Returns a line to log, or None."""
+        first = self.counts[kind] == 0
+        self.counts[kind] += 1
+        self._since_report += 1
+        if first or self._since_report >= self.log_every:
+            self._since_report = 0
+            return self.report()
+        return None
+
+    def declined_for(self, kind: str, reason: str) -> None:
+        key = f"{kind}:{reason}"
+        self.declined[key] = self.declined.get(key, 0) + 1
+        if self.declined[key] == 1:
+            logger.info("UNO_SAMPLER first refusal %s", key)
+
+    def add_ambiguous(self, mask: torch.Tensor) -> None:
+        """Accumulate boundary-tie rows on the device; read only when reported."""
+        total = mask.sum()
+        self._ambiguous = total if self._ambiguous is None else self._ambiguous + total
+
+    def report(self) -> str:
+        counts = " ".join(f"{k}={self.counts[k]}" for k in self.KINDS)
+        declined = ",".join(f"{k}={v}" for k, v in sorted(self.declined.items()))
+        # The only device read in this file, and it happens only when ambiguity
+        # tracking was explicitly enabled.
+        ties = "off" if self._ambiguous is None else str(int(self._ambiguous))
+        return (
+            f"UNO_SPARSE {counts} boundary_tie_rows={ties} declined=[{declined or '-'}]"
+        )
+
+    def reset(self) -> None:
+        self.counts = dict.fromkeys(self.KINDS, 0)
+        self.declined = {}
+        self._since_report = 0
+        self._ambiguous = None
+
+
+STATS = FastPathStats()
+
+
+def track_ambiguity() -> bool:
+    """Whether to detect boundary ties. Off by default: it is a diagnostic, and
+    reporting it reads a device tensor. Correctness arms set UNO_SPARSE_STATS=1."""
+    return bool(os.environ.get("UNO_SPARSE_STATS"))
+
+
+@dataclass(frozen=True)
+class SparseSupport:
+    """A compact per-row distribution: ``probs[r, j]`` is the probability of
+    ``ids[r, j]``. Entries outside the support have probability exactly zero,
+    so a lookup that misses is a true zero and not a truncation artefact."""
+
+    ids: torch.Tensor  # [rows, width] int64, descending logit order
+    probs: torch.Tensor  # [rows, width] float32, each row sums to 1
+
+    @property
+    def rows(self) -> int:
+        return int(self.ids.shape[0])
+
+    @property
+    def width(self) -> int:
+        return int(self.ids.shape[1])
+
+    def index(self, rows: torch.Tensor) -> "SparseSupport":
+        return SparseSupport(ids=self.ids[rows], probs=self.probs[rows])
+
+    def lookup(self, token_ids: torch.Tensor) -> torch.Tensor:
+        """Probability of ``token_ids`` under each row (0 outside the support).
+
+        ``token_ids`` is ``[rows, n]``; the result is ``[rows, n]``. Support ids
+        are unique per row, so the masked sum picks at most one entry.
+        """
+        match = self.ids.unsqueeze(1).eq(token_ids.unsqueeze(-1))
+        return torch.where(
+            match,
+            self.probs.unsqueeze(1),
+            torch.zeros((), dtype=self.probs.dtype, device=self.probs.device),
+        ).sum(-1)
+
+
+@dataclass(frozen=True)
+class SparseDraft:
+    """One draft pass' sampled tokens plus the exact q they were drawn from."""
+
+    token_ids: torch.Tensor  # [rows] int64
+    support: SparseSupport
+
+    def per_request(self, k: int) -> tuple[torch.Tensor, torch.Tensor]:
+        """Reshape the flat draft rows to ``[batch, k, width]`` for the runner
+        cache, mirroring the dense ``_last_draft_probs`` layout."""
+        width = self.support.width
+        ids = self.support.ids.view(-1, k, width).contiguous()
+        probs = self.support.probs.view(-1, k, width).contiguous()
+        return ids, probs
+
+
+def one_hot_draft(token_ids: torch.Tensor) -> SparseDraft:
+    """q = one-hot(token_ids): the sparse form of the UNO_DEBUG_DRAFT_JUNK knob
+    (forced all-reject), whose whole point is to exercise the recovery path."""
+    ids = token_ids.view(-1, 1).to(torch.int64)
+    probs = torch.ones_like(ids, dtype=torch.float32)
+    return SparseDraft(
+        token_ids=ids.view(-1), support=SparseSupport(ids=ids, probs=probs)
+    )
+
+
+def _noise_like(values: torch.Tensor, use_fp64_gumbel: bool, generator) -> torch.Tensor:
+    """Exp(1) noise for the Gumbel-max trick, in the dtype vLLM would use.
+
+    ``empty_exponential_noise_like`` widens to float64 under
+    ``--use-fp64-gumbel``; ``sample_recovered_tokens`` does the same for the
+    residual draw, so the sparse path follows rather than silently downgrading.
+    """
+    dtype = torch.float64 if use_fp64_gumbel else values.dtype
+    noise = torch.empty(values.shape, dtype=dtype, device=values.device)
+    noise.exponential_(generator=generator)
+    return noise
+
+
+def build_sparse_support(
+    logits: torch.Tensor,
+    temperature: torch.Tensor | None,
+    top_k: torch.Tensor | None,
+    top_p: torch.Tensor | None,
+    max_top_k: int,
+    stats: FastPathStats | None = None,
+) -> SparseSupport:
+    """Compact top-k support with ``apply_top_k_top_p_pytorch`` semantics.
+
+    ``logits`` is ``[rows, vocab]``; ``temperature`` / ``top_k`` / ``top_p`` are
+    per-row (already expanded), any of them may be None. Temperature is applied
+    *after* ``topk`` rather than before: division by a positive scalar cannot
+    reorder a row and gives the same float per surviving element, and it keeps
+    this function from allocating any ``rows x vocab`` intermediate of its own.
+
+    top-k keeps every entry whose value is at least the ``top_k``-th largest, so
+    the retained set never depends on how ``topk`` happened to order equal
+    values. One extra column beyond the retained width is probed purely to see
+    whether a tie group runs off the end of the support, which is the one case
+    the compact form cannot represent; passing ``stats`` counts those rows.
+    """
+    rows, vocab = logits.shape
+    width = min(int(max_top_k), int(vocab))
+    if width < 1:
+        raise ValueError(f"sparse support width must be >= 1, got {width}")
+    probe = min(width + 1, int(vocab))
+    values, ids = torch.topk(logits, probe, dim=-1, sorted=True)
+    values = values.to(torch.float32)
+    if temperature is not None:
+        values = values / temperature.to(torch.float32).view(rows, 1)
+    edge = values[:, width:]  # empty when the support already spans the vocab
+    values, ids = values[:, :width], ids[:, :width]
+    if top_k is not None:
+        # Threshold by value, like the PyTorch reference: the k-th largest is
+        # kept along with everything equal to it.
+        rank = top_k.to(torch.int64).clamp(min=1, max=width).view(rows, 1) - 1
+        threshold = values.gather(1, rank)
+        keep = values >= threshold
+        if stats is not None and edge.shape[1] > 0:
+            # The tie group continues past the support: entries the dense path
+            # would keep are missing here. Exactly detectable, never guessed.
+            stats.add_ambiguous(edge[:, 0].eq(threshold.view(-1)))
+        values = values.masked_fill(~keep, float("-inf"))
+    if top_p is not None:
+        # vLLM sorts ascending, drops the cumulative tail at <= 1 - p and keeps
+        # the largest entry unconditionally. The flip reproduces that order, so
+        # the same float additions happen in the same sequence.
+        ascending = values.flip(-1)
+        probs_sort = ascending.softmax(dim=-1)
+        cumulative = torch.cumsum(probs_sort, dim=-1)
+        drop = cumulative <= (1.0 - top_p.to(torch.float32)).view(rows, 1)
+        drop[:, -1] = False
+        if stats is not None:
+            # Equal probabilities straddling the cut resolve by sort order, so
+            # the dense path may drop the other one of the pair.
+            straddle = (
+                drop[:, :-1] & ~drop[:, 1:] & probs_sort[:, :-1].eq(probs_sort[:, 1:])
+            )
+            stats.add_ambiguous(straddle.any(dim=-1))
+        values = ascending.masked_fill(drop, float("-inf")).flip(-1)
+    return SparseSupport(ids=ids.to(torch.int64), probs=values.softmax(dim=-1))
+
+
+def sample_from_support(
+    support: SparseSupport,
+    generator: torch.Generator | None = None,
+    use_fp64_gumbel: bool = False,
+) -> torch.Tensor:
+    """One token per row, drawn from the support by the Gumbel-max trick that
+    ``sample_with_exponential_noise`` uses (``argmax(probs / Exp(1))``)."""
+    noise = _noise_like(support.probs, use_fp64_gumbel, generator)
+    offsets = support.probs.div(noise).argmax(dim=-1, keepdim=True)
+    return support.ids.gather(1, offsets).view(-1)
+
+
+def expand_per_request(
+    values: torch.Tensor | None,
+    counts: torch.Tensor,
+    output_size: int,
+    replace_from: float | None = None,
+    replace_to: float | None = None,
+) -> torch.Tensor | None:
+    """Per-request tensor to per-token, the torch equivalent of
+    ``expand_batch_to_tokens``.
+
+    ``output_size`` is mandatory and is the flattened row count the caller
+    already knows. Without it ``repeat_interleave`` has to read ``counts`` on
+    the host, which is a device wait on every verification step.
+    """
+    if values is None:
+        return None
+    if replace_from is not None:
+        values = torch.where(
+            values == replace_from, torch.full_like(values, replace_to), values
+        )
+    return values.repeat_interleave(counts, output_size=output_size)
+
+
+def counts_from_cumulative(cu_num_draft_tokens: torch.Tensor) -> torch.Tensor:
+    """Per-request draft counts from vLLM's cumulative tensor, on the device.
+
+    ``SpecDecodeMetadata`` carries ``cu_num_draft_tokens`` on the device already,
+    so deriving the counts here avoids copying the Python list back down.
+    """
+    cu = cu_num_draft_tokens.to(torch.int64)
+    starts = torch.zeros_like(cu)
+    starts[1:] = cu[:-1]
+    return cu - starts
+
+
+def _padded_layout(
+    counts: torch.Tensor, max_spec_len: int, num_tokens: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """(flat row index, validity, positions) for a ``[batch, max_spec_len]``
+    view of the flat draft rows. Indices of invalid slots are clamped into
+    range and never read for a result."""
+    device = counts.device
+    starts = torch.zeros_like(counts)
+    starts[1:] = torch.cumsum(counts, dim=0)[:-1]
+    positions = torch.arange(max_spec_len, device=device)
+    valid = positions.view(1, -1) < counts.view(-1, 1)
+    flat = (starts.view(-1, 1) + positions.view(1, -1)).clamp_(
+        min=0, max=max(num_tokens - 1, 0)
+    )
+    return flat, valid, positions
+
+
+def greedy_prefix_sample(
+    *,
+    draft_token_ids: torch.Tensor,
+    counts: torch.Tensor,
+    target_argmax: torch.Tensor,
+    bonus_token_ids: torch.Tensor,
+    max_spec_len: int,
+) -> torch.Tensor:
+    """All-greedy acceptance without the rejection sampler.
+
+    Reproduces ``rejection_greedy_sample_kernel`` exactly: accept while the
+    draft equals the target argmax, write the target argmax at every position
+    up to and including the first mismatch, and append the bonus token only when
+    nothing was rejected. Consumes no random numbers, exactly like the dense
+    greedy path (which skips ``generate_uniform_probs`` when ``all_greedy``).
+    """
+    num_tokens = int(draft_token_ids.shape[0])
+    flat, valid, positions = _padded_layout(counts, max_spec_len, num_tokens)
+    drafts = draft_token_ids.to(torch.int64)[flat]
+    argmax = target_argmax.to(torch.int64)[flat]
+    matched = valid & drafts.eq(argmax)
+    accepted = matched.to(torch.int32).cumprod(dim=1).sum(dim=1)
+
+    batch = int(counts.shape[0])
+    out = torch.full(
+        (batch, max_spec_len + 1),
+        PLACEHOLDER_TOKEN_ID,
+        dtype=torch.int32,
+        device=draft_token_ids.device,
+    )
+    write = valid & (positions.view(1, -1) <= accepted.view(-1, 1))
+    out[:, :max_spec_len] = torch.where(
+        write, argmax.to(torch.int32), out[:, :max_spec_len]
+    )
+    all_accepted = accepted.eq(counts.to(accepted.dtype))
+    bonus = torch.where(
+        all_accepted,
+        bonus_token_ids.view(-1).to(torch.int32),
+        torch.full_like(all_accepted, PLACEHOLDER_TOKEN_ID, dtype=torch.int32),
+    )
+    out.scatter_(1, counts.view(-1, 1).to(torch.int64), bonus.view(-1, 1))
+    return out
+
+
+def sparse_rejection_sample(
+    *,
+    draft_token_ids: torch.Tensor,
+    counts: torch.Tensor,
+    draft_support: SparseSupport,
+    target_support: SparseSupport,
+    bonus_token_ids: torch.Tensor,
+    uniform_probs: torch.Tensor,
+    max_spec_len: int,
+    generator: torch.Generator | None = None,
+    recovery_noise: torch.Tensor | None = None,
+    use_fp64_gumbel: bool = False,
+) -> torch.Tensor:
+    """Exact p/q chain rejection on compact supports.
+
+    ``draft_support`` is the q the drafter actually sampled from and
+    ``target_support`` is the truncated target p, both in the flat
+    ``[num_tokens, width]`` layout the dense path uses for its per-token
+    tensors. p is exactly zero outside its own support, so the residual
+    ``(p - q)+`` is complete on that support and the output law is exactly p.
+    """
+    num_tokens = int(draft_token_ids.shape[0])
+    if num_tokens == 0:
+        raise ValueError("sparse rejection needs at least one draft row")
+    flat, valid, positions = _padded_layout(counts, max_spec_len, num_tokens)
+    drafts = draft_token_ids.to(torch.int64)[flat]
+
+    p_of_draft = (
+        target_support.index(flat.reshape(-1))
+        .lookup(drafts.reshape(-1, 1))
+        .view_as(drafts)
+    )
+    q_of_draft = (
+        draft_support.index(flat.reshape(-1))
+        .lookup(drafts.reshape(-1, 1))
+        .view_as(drafts)
+    )
+    # rejection_random_sample_kernel: reject a negative (padded) draft id, guard
+    # against a zero draft probability, and compare in the uniform's dtype.
+    ratio = torch.where(
+        q_of_draft > 0, p_of_draft / q_of_draft, torch.zeros_like(p_of_draft)
+    )
+    coins = uniform_probs[flat]
+    accepted = valid & drafts.ge(0) & q_of_draft.gt(0) & ratio.to(coins.dtype).ge(coins)
+    accepted_len = accepted.to(torch.int32).cumprod(dim=1).sum(dim=1)
+
+    # Recovery is only ever read at the first rejected position, so it is drawn
+    # there alone. The dense path draws one exponential vector per request and
+    # reuses it across positions; only one of those draws is ever used, so the
+    # marginal law of the emitted token is the same.
+    rejected = accepted_len.lt(counts.to(accepted_len.dtype))
+    pick = accepted_len.to(torch.int64).clamp(max=max(max_spec_len - 1, 0)).view(-1, 1)
+    rows = flat.gather(1, pick).view(-1)
+    target_rows = target_support.index(rows)
+    q_on_target = draft_support.index(rows).lookup(target_rows.ids)
+    residual = (target_rows.probs - q_on_target).clamp_min(0.0)
+    total = residual.sum(dim=-1, keepdim=True)
+    # An exactly empty residual means p == q on p's support, which cannot be
+    # reached by a rejection; keep the SGLang guard and fall back to p.
+    weights = torch.where(total > 0, residual, target_rows.probs)
+    # ``recovery_noise`` is the Exp(1) draw the Gumbel-max trick consumes, in
+    # the support's own column order. Passing it in is how the gates compare
+    # this path against a dense reference under one shared random stream;
+    # ``sample_recovered_tokens`` takes its own noise as an argument too.
+    if recovery_noise is None:
+        noise = _noise_like(weights, use_fp64_gumbel, generator)
+    else:
+        noise = recovery_noise
+    scores = weights.to(noise.dtype).div(noise)
+    recovered = target_rows.ids.gather(1, scores.argmax(dim=-1, keepdim=True)).view(-1)
+
+    batch = int(counts.shape[0])
+    out = torch.full(
+        (batch, max_spec_len + 1),
+        PLACEHOLDER_TOKEN_ID,
+        dtype=torch.int32,
+        device=draft_token_ids.device,
+    )
+    write = valid & (positions.view(1, -1) < accepted_len.view(-1, 1))
+    out[:, :max_spec_len] = torch.where(
+        write, drafts.to(torch.int32), out[:, :max_spec_len]
+    )
+    tail_index = torch.where(
+        rejected, accepted_len.to(torch.int64), counts.to(torch.int64)
+    )
+    tail_value = torch.where(
+        rejected, recovered.to(torch.int32), bonus_token_ids.view(-1).to(torch.int32)
+    )
+    out.scatter_(1, tail_index.view(-1, 1), tail_value.view(-1, 1))
+    return out
+
+
+# --------------------------------------------------------------------------
+# Eligibility. Every predicate returns None when the fast path is usable and a
+# short reason string otherwise, so a caller can log why it fell back.
+# --------------------------------------------------------------------------
+
+
+def _active_logits_processors(logitsprocs) -> list:
+    """Non-argmax-invariant processors that would actually touch this batch.
+
+    Speculative decoding always installs ``MinTokensLogitsProcessor`` even when
+    no request asked for ``min_tokens``; with an empty ``min_toks`` table its
+    ``apply`` is a no-op, so it must not veto the fast paths; otherwise every
+    step is refused with ``logits_processors`` on a stock server.
+    Unknown processors are still treated as active.
+    """
+    active = []
+    for proc in logitsprocs.non_argmax_invariant:
+        min_toks = getattr(proc, "min_toks", None)
+        if isinstance(min_toks, dict) and type(proc).__name__ == "MinTokensLogitsProcessor":
+            if min_toks:
+                active.append(proc)
+            continue
+        active.append(proc)
+    return active
+
+
+def _shared_blocker(sampling_metadata) -> str | None:
+    if sampling_metadata.max_num_logprobs is not None:
+        return "logprobs"
+    if getattr(sampling_metadata, "logprob_token_ids", None):
+        return "logprob_token_ids"
+    if not sampling_metadata.no_penalties:
+        return "penalties"
+    if sampling_metadata.bad_words_token_ids:
+        return "bad_words"
+    if sampling_metadata.allowed_token_ids_mask is not None:
+        return "allowed_token_ids"
+    logitsprocs = getattr(sampling_metadata, "logitsprocs", None)
+    if logitsprocs is not None and _active_logits_processors(logitsprocs):
+        return "logits_processors"
+    holder = getattr(sampling_metadata, "thinking_budget_state_holder", None)
+    if holder is not None and holder.has_tracked_requests():
+        return "thinking_budget"
+    return None
+
+
+def greedy_blocker(sampling_metadata) -> str | None:
+    """Why the all-greedy fast path cannot serve this batch."""
+    if not sampling_metadata.all_greedy:
+        return "not_all_greedy"
+    return _shared_blocker(sampling_metadata)
+
+
+def sparse_blocker(sampling_metadata, max_top_k: int | None) -> str | None:
+    """Why the compact-support path cannot serve this batch.
+
+    Mixed greedy/random batches fall back rather than run two laws in one
+    kernel; per-request seeded generators fall back because the sparse path
+    consumes a different number of random values than the dense one.
+    """
+    if not sampling_metadata.all_random:
+        return "not_all_random"
+    if getattr(sampling_metadata, "generators", None):
+        return "seeded_generators"
+    if sampling_metadata.top_k is None:
+        return "no_top_k"
+    if max_top_k is None or max_top_k < 1:
+        return "no_top_k"
+    if max_top_k > SPARSE_TOP_K_LIMIT:
+        return "top_k_above_limit"
+    logitsprocs = getattr(sampling_metadata, "logitsprocs", None)
+    if logitsprocs is not None and list(logitsprocs.argmax_invariant):
+        # min_p is the usual member here; it is defined against the row maximum
+        # over the full vocabulary, so it is not reproducible on a support.
+        return "argmax_invariant_processors"
+    return _shared_blocker(sampling_metadata)
+
+
+def batch_max_top_k(input_batch, num_reqs: int) -> int | None:
+    """Largest top_k in the batch, read from the host mirror so the decision
+    costs no device synchronisation. ``top_k_cpu`` holds the vocabulary size for
+    any request that did not set top_k, which makes such a batch ineligible."""
+    top_k_cpu = getattr(input_batch, "top_k_cpu", None)
+    if top_k_cpu is None or num_reqs < 1:
+        return None
+    return int(top_k_cpu[:num_reqs].max())
