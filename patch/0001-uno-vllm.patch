+    calls = []
+    misses = []
+    graphs = NS(
+        replays=1,
+        replay=lambda *args, **kwargs: calls.append((args, kwargs)) or result,
+        miss=lambda reason, key, manager, **kwargs: misses.append((reason, key)),
