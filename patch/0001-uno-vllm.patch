+@pytest.mark.parametrize("fold", [False, True])
+@pytest.mark.parametrize("dtype", [torch.float64, torch.bfloat16])
+@pytest.mark.parametrize("batch", range(1, 33))
+@pytest.mark.parametrize("k", range(1, 16))
+def test_cublas_contract_matches_punica_math_and_keeps_real_rows_clean(
+    fold, dtype, batch, k
+):
+    """Noise deltas stay within each request, including padding and K=1."""
+    gen = torch.Generator().manual_seed(1000 + batch * 31 + k)
+    # Unequal output widths and ranks guard independent fused q/k/v slices.
+    pairs = tuple(
+        (
+            (torch.randn(rank, 11, generator=gen) * 0.15).to(dtype),
+            (torch.randn(width, rank, generator=gen) * 0.15).to(dtype),
+        )
+        for rank, width in ((4, 7), (3, 3), (5, 3))
+    )
+    n = batch * k + 3
+    route = overlap.DraftLoRARoute(batch, k, n)
+    x = torch.randn(n, 11, generator=gen).to(dtype)
+    weight = (torch.randn(13, 11, generator=gen) * 0.15).to(dtype)
+    base = x @ weight.t()
+    rows = torch.arange(n)
+    noise = (rows < batch * k) & (rows % k != 0)
+    expected = _punica_math(x, base, pairs, noise)
+    plan = overlap.SingleAdapterPlan(pairs, (7, 3, 3), fold=fold)
+    plan.prepare(route)
+    latent = plan.allocate(x, route)
+    plan.shrink(x, route, latent)
+    result = plan.expand(latent, base.clone(), route)
+    # addmm_ has one final rounding; Punica rounds delta before adding base.
+    tolerance = (
+        dict(atol=0.016, rtol=0.016)
+        if dtype == torch.bfloat16
+        else dict(atol=1e-12, rtol=1e-12)
+    )
+    torch.testing.assert_close(result, expected, **tolerance)
+    assert torch.equal(result[~noise], base[~noise])
+
