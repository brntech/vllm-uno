index 0000000000000000000000000000000000000000..f2d0dc676de36013867b7c865aa4a518c0a7b5f3
--- /dev/null
+++ b/vllm/v1/spec_decode/uno.py
@@ -0,0 +1,1179 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Uno (arXiv 2609.04010) as a vLLM parallel-drafting proposer.
+
+Draft pass, per request: query = ``[bonus_token, z_1 .. z_(K-1)]`` with ``z_i``
+uniform noise, run through the *target* model against the target KV cache with
+the gated LoRA active only on the K-1 noise rows. All K rows' logits are needed:
+the clean bonus row predicts draft token 1 under next-token parameterization.
+Verification uses vLLM's standard rejection sampler. With uno_seedrow_verify,
+the target forwards only the candidates and reuses the draft's base seed KV
+and raw logits; all K candidates remain rejectable. Two forwards per step, exactly
+as in the paper's Psi-Spec linear sampler (Sec. 4.2).
+"""
+
+import json
+import os
+import time
+from contextlib import nullcontext
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn as nn
+from typing_extensions import override
+
+from vllm.config import VllmConfig, get_layers_from_vllm_config
+from vllm.forward_context import set_forward_context
+from vllm.logger import init_logger
+from vllm.lora.request import LoRARequest
+from vllm.model_executor.layers.attention_layer_base import AttentionLayerBase
+from vllm.v1.attention.backend import CommonAttentionMetadata
+from vllm.v1.spec_decode.llm_base_proposer import SpecDecodeBaseProposer
+from vllm.v1.spec_decode.uno_gated_lora import UnoGatedLoRA
+from vllm.v1.spec_decode.uno_draft_cost import QueryLayoutCache, validate_draft_cost
+from vllm.v1.spec_decode.uno_draft_cost_lora import install_draft_cost_lora
+from vllm.v1.spec_decode.uno_noise import fill_uno_noise
+from vllm.v1.spec_decode import uno_nosync as _nosync
+from vllm.v1.spec_decode.utils import (
+    PADDING_SLOT_ID,
+    copy_and_expand_dflash_inputs_kernel,
+    next_power_of_2,
+)
+
+from vllm.v1.spec_decode import uno_draft_profile as _dc_profile
+
+logger = init_logger(__name__)
+
+fill_uno_noise = _dc_profile.profiled("draft.noise")(fill_uno_noise)
+
+# Reserved LoRA id for the Uno adapter; user LoRA ids start at 1 and stay small.
+UNO_LORA_INT_ID = 1_000_003
+
+
+def uno_query_layout(batch_size: int, k: int, uno_lora_id: int, device):
+    """Per request: row 0 = bonus (no LoRA), rows 1..k-1 = noise (LoRA on); k rows in all.
+
+    Returns (is_noise[bool, B*k], sample_idx[int32, B*k], lora_map tuple).
+    """
+    q = k
+    off = torch.arange(batch_size * q, device=device) % q
+    is_noise = off > 0
+    # Next-token parameterisation (paper Sec. 3.1): the row at position p predicts the
+    # token at p+1. So draft_1 (position p+1) comes from the BONUS row (AR weights only,
+    # paper Eq. 4) and draft_{j+1} from noise row j. All k rows are sampled.
+    sample_idx = torch.arange(batch_size * q, device=device, dtype=torch.int32)
+    lora_map = tuple(uno_lora_id if (i % q) else 0 for i in range(batch_size * q))
+    return is_noise, sample_idx, lora_map
+
+
+class UnoProposer(SpecDecodeBaseProposer):
+    def __init__(self, vllm_config: VllmConfig, device: torch.device, runner=None):
+        assert vllm_config.speculative_config is not None
+        assert vllm_config.speculative_config.use_uno()
+        self.runner = runner
+        super().__init__(
+            vllm_config=vllm_config,
+            device=device,
+            pass_hidden_states_to_model=False,
+            runner=runner,
+        )
+        sc = self.speculative_config
+        self.uno_low = 1
+        self.uno_high = int(sc.uno_mask_token_id)
+        self.uno_noise_seed = int(sc.uno_noise_seed)
+        self.uno_lora_id = UNO_LORA_INT_ID
+        self.lora_request = LoRARequest(
+            lora_name="uno", lora_int_id=self.uno_lora_id, lora_path=sc.uno_lora_path
+        )
+        self._lora_hook = None
+        self._lora_plan_hook = None
+        self._pending_lora_map: tuple[int, ...] = ()
+        self._pending_batch_size = 0
+        # No-host-sync mode. The two-pass step installs its LoRA metadata
+        # from a shape-keyed plan instead of rebuilding it (which synchronises),
+        # and reuses the per-shape constants it would otherwise rebuild.
+        self.no_host_sync = bool(getattr(sc, "uno_no_host_sync", False))
+        self._step_constants = (
+            _nosync.StepConstants() if self.no_host_sync else None
+        )
+        # LoRA implementation: "hooks" (default; gated matmuls via forward hooks, no --enable-lora)
+        # or "punica" (vLLM LoRA manager with a per-token mapping).
+        self.lora_impl = os.environ.get("UNO_LORA_IMPL", "punica")
+        from vllm.v1.spec_decode.uno_draft_graph import validate_draft_graph
+
+        validate_draft_graph(vllm_config, self.lora_impl)
+        from vllm.v1.spec_decode.uno_overlap_config import validate_overlap
+
+        validate_overlap(vllm_config, self.lora_impl)
+        from vllm.v1.spec_decode.uno_seedrow_config import validate_seedrow
+
+        validate_seedrow(vllm_config, self.lora_impl)
+        self._last_seedrow = None
+        self._lora_overlap = None
+        self._draft_graph_runner = None
+        validate_draft_cost(vllm_config, self.lora_impl)
+        self._query_layout_cache = (
+            QueryLayoutCache() if sc.uno_draft_cost_cache_mapping
+            or sc.uno_draft_cost_noise_only else None
+        )
+        self._pending_noise_indices = None
+        # Compact draft support (ids, probs) when uno_sparse_topk drew
+        # the drafts, in place of the dense per-row probabilities.
+        self._last_draft_sparse = None
+        if self.no_host_sync:
+            # Refuse what the plan path does not serve (punica only, TP=1). The
+            # check lives beside validate_draft_cost because the LoRA
+            # implementation and the tensor-parallel size are not visible to
+            # SpeculativeConfig's own validator.
+            _nosync.validate_no_host_sync(vllm_config, self.lora_impl)
+            if self._query_layout_cache is None:
+                # Rebuilding the layout per step is host work in front of
+                # a pass we are trying to keep enqueued; the cache is the same
+                # object the draft-cost flags already use.
+                self._query_layout_cache = QueryLayoutCache()
+        self.gated_lora: UnoGatedLoRA | None = None
+        self._step = 0
+        if getattr(sc, "uno_lookup", False) and getattr(sc, "uno_fused", False):
+            raise ValueError("uno_lookup and uno_fused cannot be combined (the lookup router is two-pass only)")
+        if getattr(self.speculative_config, "uno_fused", False):
+            from vllm.v1.spec_decode import uno_fused_attn as _uno_fa
+            _k = int(self.speculative_config.uno_fused_k)
+            _g = int(getattr(self.speculative_config, "uno_fused_groups", 0) or 0)
+            _uno_fa.FUSED_K = _k
+            _uno_fa.FUSED_G = _g
+            _uno_fa.FUSED_Q = 1 + _k + (_g if _g > 0 else _k + 1) * _k
+            if _g > 0:
+                # static per-request mask buffer, allocated BEFORE graph capture so every graph sees one address
+                _uno_fa.mask_buffer(self.vllm_config.scheduler_config.max_num_seqs, _uno_fa.FUSED_Q, self.device)
+            else:
+                # the [Q, Q] block mask of the FA2 split path, pre-built BEFORE graph capture: with the FUSED_ACTIVE
+                # gate the first split-attention call is the capture itself, and a tensor first allocated inside
+                # capture lives in the graph pool and can be overwritten by later captures, causing NaN logits at replay.
+                _uno_fa.fused_block_mask(_uno_fa.FUSED_Q, _k, self.device)
+        # hybrid groups: per request, the accepted counts j whose noise groups the CURRENT block carries,
+        # and a decayed histogram of observed j used to pick the next block's groups
+        self.groups: dict = {}
+        self.j_hist: dict = {}
+        # Query-only buffers (bonus + K noise per request), like DFlash.
+        self.max_query_tokens = self.max_batch_size * (1 + self.num_speculative_tokens)
+        self.max_padded_query_tokens = max(
+            self.max_query_tokens,
+            vllm_config.compilation_config.max_cudagraph_capture_size or 0,
+        )
+        self.max_positions = self.max_num_tokens + self.max_padded_query_tokens
+        self._context_slot_mapping_buffer = torch.zeros(
+            self.max_num_tokens, dtype=torch.int64, device=device
+        )
+        self._context_positions_buffer = torch.zeros(
+            self.max_num_tokens, dtype=torch.int64, device=device
+        )
+        self._slot_mapping_buffer = torch.zeros(
+            self.max_padded_query_tokens, dtype=torch.int64, device=device
+        )
+        self.positions = torch.zeros(
+            self.max_padded_query_tokens, dtype=torch.int64, device=device
+        )
+        self.arange = torch.arange(
+            self.max_positions + 1, device=device, dtype=torch.int32
+        )
+        self._pending_draft_prep = None
+        if sc.uno_fused_draft_prep:
+            self._draft_prep_step = torch.zeros((), dtype=torch.int64, device=device)
+            self._draft_prep_seq_lens = torch.empty(
+                self.max_batch_size, dtype=torch.int32, device=device
+            )
+
+    # ------------------------------------------------------------------ wiring
+    def set_lora_hook(self, fn) -> None:
+        """``fn(token_lora_mapping | None)`` switches the active per-token LoRA
+        mapping (runner-owned). ``None`` means "draft pass over"."""
+        self._lora_hook = fn
+
+    def set_lora_plan_hook(self, fn) -> None:
+        """``fn(num_input_tokens, batch_size, k, make_mapping)`` installs
+        the draft pass's LoRA metadata from the runner's shape-keyed plan cache.
+
+        ``make_mapping`` is called only on a cache miss, so the steady state
+        never builds the per-token mapping tuple at all.
+        """
+        self._lora_plan_hook = fn
+
+    def _install_draft_lora(
+        self, num_input_tokens: int, batch_size: int, k: int
+    ) -> None:
+        """Arm the per-token LoRA mapping for the draft forward."""
+        if self._lora_plan_hook is not None:
+            self._lora_plan_hook(
+                num_input_tokens,
+                batch_size,
+                k,
+                lambda: self._pending_lora_map
+                + (0,) * max(num_input_tokens - len(self._pending_lora_map), 0),
+            )
+        elif self._lora_hook is not None:
+            pad = num_input_tokens - len(self._pending_lora_map)
+            self._lora_hook(self._pending_lora_map + (0,) * max(pad, 0))
+
+    def capture_draft_graphs(self) -> None:
+        """Startup-only, called after the target runner finishes its captures."""
+        if not self.speculative_config.uno_draft_full_graph:
+            return
+        from vllm.v1.spec_decode.uno_draft_graph import UnoDraftGraphRunner
+        from vllm.v1.worker.workspace import lock_workspace
+
+        # Existing verifier graphs already bind workspace addresses. Refuse
+        # growth rather than invalidating them during the private warmups.
+        lock_workspace()
+        self._draft_graph_runner = UnoDraftGraphRunner()
+        self._draft_graph_runner.capture(self)
+
+    def _replay_draft_graph(self, num_tokens, cad, k):
+        graphs = self._draft_graph_runner
+        if graphs is None:
+            return None
+        manager = self.runner.lora_manager._adapter_manager
+        from vllm.v1.spec_decode.metadata import VerifyRowLayout
+
+        verify_width = VerifyRowLayout(
+            k, reuse_seed=getattr(self.speculative_config, "uno_seedrow_verify", False)
+        ).verify_width
+        key = (cad.batch_size(), k, verify_width)
+        prep = getattr(self, "_pending_draft_prep", None)
+        reason = None
+        if self.runner.input_batch.lora_id_to_lora_request:
+            reason = "user_adapters"
+        elif self.uno_lora_id not in self.runner.lora_manager.list_adapters():
+            reason = "adapter_not_registered"
+        elif os.environ.get("UNO_DEBUG_NO_LORA"):
+            reason = "debug_no_lora"
+        if reason is not None:
+            return graphs.miss(
+                reason, key, manager, input_ids=self.input_ids[:num_tokens],
+                positions=self.positions[:num_tokens], cad=cad, prep_inputs=prep,
+            )
+        args = (
+            cad.batch_size(), k, self.input_ids[:num_tokens],
+            self.positions[:num_tokens], cad, manager,
+        )
+        output = (
+            graphs.replay(*args, prep_inputs=prep, verify_width=verify_width)
+            if prep is not None else graphs.replay(*args, verify_width=verify_width)
+        )
+        count = graphs.fallbacks if output is None else graphs.replays
+        if count == 1 or count % 1000 == 0 or (output is None and count <= 20):
+            logger.info("UNO_DRAFT_GRAPH %s count=%d batch_size=%d k=%d",
+                        "fallback" if output is None else "replay",
+                        count, cad.batch_size(), k)
+        return output
+
+    def clear_draft_graphs(self) -> None:
+        if self._draft_graph_runner is not None:
+            self._draft_graph_runner.entries.clear()
+            self._draft_graph_runner = None
+
+    @override
+    def _warn_if_multimodal(self):
+        pass
+
+    @override
+    def _raise_if_padded_drafter_batch_disabled(self):
+        pass
+
+    @override
+    def load_model(self, target_model: nn.Module) -> None:
+        # Self-drafting: the draft model IS the target model; the draft attention
+        # layers are the target's attention layers (one KV-cache group for K2).
+        self.model = target_model
+        if self.speculative_config.uno_lora_overlap:
+            from vllm.v1.spec_decode.uno_lora_overlap import UnoLoRAOverlap
+
+            self._lora_overlap = UnoLoRAOverlap(
+                target_model, fold=self.speculative_config.uno_lora_fold
+            )
+        all_attn = get_layers_from_vllm_config(
+            self.vllm_config,
+            AttentionLayerBase,  # type: ignore[type-abstract]
+        )
+        self._draft_attn_layer_names = {
+            name
+            for name, layer in all_attn.items()
+            if layer.get_kv_cache_spec(self.vllm_config) is not None
+        }
+        self.supports_mm_inputs = False
+        if self.lora_impl == "hooks":
+            self.gated_lora = UnoGatedLoRA(
+                self.lora_request.lora_path, target_model, self.device, self.dtype
+            )
+            sc = self.speculative_config
+            self.gated_lora = install_draft_cost_lora(
+                self.gated_lora, target_model,
+                fuse_lora=sc.uno_draft_cost_fuse_lora,
+                noise_only=sc.uno_draft_cost_noise_only,
+                share_a=sc.uno_draft_cost_share_a,
+            )
+        logger.info(
+            "UnoProposer: self-drafting over %d target attention layers, "
+            "K=%d noise rows, noise range [%d, %d), adapter %s",
+            len(self._draft_attn_layer_names),
+            self.num_speculative_tokens,
+            self.uno_low,
+            self.uno_high,
+            self.lora_request.lora_path,
+        )
+
+        _dc_profile.install_model_ranges(
+            self.model, module_hooks=self.vllm_config.model_config.enforce_eager
+        )
+        if _dc_profile.enabled():
+            self.build_per_group_and_layer_attn_metadata = _dc_profile.profiled(
+                "draft.attn_metadata")(self.build_per_group_and_layer_attn_metadata)
+            self._sample_draft_tokens = _dc_profile.profiled(
+                "draft.sample")(self._sample_draft_tokens)
+
+    @override
+    def _get_model(self) -> nn.Module:  # never load a second copy
+        return self.model
+
+    @override
+    def model_returns_tuple(self) -> bool:
+        # The target model returns a single hidden-state tensor (no aux states).
+        return False
+
+    # ------------------------------------------------------------ draft inputs
+    def _set_inputs_fused_prep(
+        self, next_token_ids, target_positions, cad, num_rejected_tokens_gpu
+    ):
+        from vllm.v1.spec_decode.uno_draft_prep import DraftPrepInputs
+
+        batch_size, k = cad.batch_size(), self.num_speculative_tokens
+        n = batch_size * k
+        layout = self._query_layout_cache.get(
+            batch_size, k, self.uno_lora_id, self.device
+        )
+        self._pending_lora_map = layout.lora_map
+        self._pending_batch_size = batch_size
+        self._pending_draft_prep = DraftPrepInputs(
+            next_token_ids, target_positions, cad.query_start_loc,
+            cad.seq_lens, num_rejected_tokens_gpu,
+        )
+        self._step += 1
+        upper = cad.seq_lens_cpu_upper_bound
+        new_cad = CommonAttentionMetadata(
+            query_start_loc=self._step_constants.query_start_loc_device(
+                batch_size, k, self.token_arange_np, self.device
+            ),
+            query_start_loc_cpu=self._step_constants.query_start_loc_cpu(
+                batch_size, k, self.token_arange_np
+            ),
+            seq_lens=self._draft_prep_seq_lens[:batch_size],
+            _seq_lens_cpu=None,
+            _num_computed_tokens_cpu=None,
+            seq_lens_cpu_upper_bound=None if upper is None else upper + k,
+            num_reqs=cad.num_reqs,
+            num_actual_tokens=n,
+            max_query_len=k,
+            max_seq_len=cad.max_seq_len + k,
+            block_table_tensor=cad.block_table_tensor,
+            slot_mapping=self._slot_mapping_buffer[:n],
+            causal=True,
+        )
+        return n, layout.sample_indices, new_cad
+
+    def _prepare_pending_draft_inputs(self, cad, num_tokens, k):
+        prep = self._pending_draft_prep
+        if prep is None:
+            return
+        from vllm.v1.spec_decode.uno_draft_prep import prepare_uno_draft
+
+        prepare_uno_draft(
+            prep, self.input_ids[:num_tokens], self.positions[:num_tokens],
+            cad.slot_mapping, cad.seq_lens, cad.block_table_tensor,
+            self._draft_prep_step,
+            k=k, seed=self.uno_noise_seed, low=self.uno_low, high=self.uno_high,
+            block_size=self.block_size, max_model_len=self.max_model_len,
+        )
+
+    @override
+    @_dc_profile.profiled("draft.inputs")
+    def set_inputs_first_pass(
+        self,
+        target_token_ids: torch.Tensor,
+        next_token_ids: torch.Tensor,
+        target_positions: torch.Tensor,
+        target_hidden_states: torch.Tensor,
+        token_indices_to_sample: torch.Tensor | None,
+        cad: CommonAttentionMetadata,
+        num_rejected_tokens_gpu: torch.Tensor | None,
+    ) -> tuple[int, torch.Tensor, CommonAttentionMetadata]:
+        if getattr(self.speculative_config, "uno_fused_draft_prep", False):
+            return self._set_inputs_fused_prep(
+                next_token_ids, target_positions, cad, num_rejected_tokens_gpu
+            )
+        batch_size = cad.batch_size()
+        num_context = target_token_ids.shape[0]
+        k = self.num_speculative_tokens
+        q = k  # bonus + (k-1) noise rows; the k-th row was dead (see uno_query_layout)
+        num_query_total = batch_size * q
+        sample_idx = torch.empty(batch_size * k, dtype=torch.int32, device=self.device)
+        max_tokens_per_req = cad.max_query_len + q
+        BLOCK = min(256, next_power_of_2(max_tokens_per_req))
+        grid = (batch_size, (max_tokens_per_req + BLOCK - 1) // BLOCK)
+        has_rej = num_rejected_tokens_gpu is not None
+        copy_and_expand_dflash_inputs_kernel[grid](
+            next_token_ids_ptr=next_token_ids,
+            target_positions_ptr=target_positions,
+            out_input_ids_ptr=self.input_ids,
+            out_context_positions_ptr=self._context_positions_buffer,
+            out_query_positions_ptr=self.positions,
+            out_context_slot_mapping_ptr=self._context_slot_mapping_buffer,
+            out_query_slot_mapping_ptr=self._slot_mapping_buffer,
+            out_token_indices_ptr=sample_idx,
+            block_table_ptr=cad.block_table_tensor,
+            block_table_stride=cad.block_table_tensor.stride(0),
+            query_start_loc_ptr=cad.query_start_loc,
+            num_rejected_tokens_ptr=(num_rejected_tokens_gpu if has_rej else 0),
+            parallel_drafting_token_id=self.parallel_drafting_token_id,
+            block_size=self.block_size,
+            num_query_per_req=q,
+            num_speculative_tokens=k,
+            total_input_tokens=num_context,
+            BLOCK_SIZE=BLOCK,
+            HAS_NUM_REJECTED=has_rej,
+        )
+        # Replace the placeholder ids on the noise rows with uniform noise
+        # (paper: z ~ pi^{B-1}, uniform over [1, mask_token_id)).
+        layout_cache = getattr(self, "_query_layout_cache", None)
+        if layout_cache is None:
+            is_noise, sample_idx, lora_map = uno_query_layout(
+                batch_size, k, self.uno_lora_id, self.device
+            )
+        else:
+            layout = layout_cache.get(batch_size, k, self.uno_lora_id, self.device)
+            is_noise, sample_idx, lora_map = (
+                layout.is_noise, layout.sample_indices, layout.lora_map
+            )
+            self._pending_noise_indices = layout.noise_indices
+        if self._step_constants is not None:
+            req_seeds = self._step_constants.req_seeds(
+                batch_size, q, self.uno_noise_seed, self.device
+            )
+        else:
+            req_seeds = (
+                torch.arange(batch_size, device=self.device, dtype=torch.int64)
+                + self.uno_noise_seed
+            ).repeat_interleave(q)
+        self._step += 1
+        fill_uno_noise(
+            self.input_ids[:num_query_total],
+            is_noise,
+            req_seeds,
+            self._step,
+            self.uno_low,
+            self.uno_high,
+        )
+        if os.environ.get("UNO_DEBUG_NO_LORA"):
+            # Diagnostic: draft with AR weights only (no adapter on noise rows).
+            lora_map = tuple(0 for _ in lora_map)
+        fixed = os.environ.get("UNO_DEBUG_FIXED_NOISE")
+        if fixed and self._step == 1 and batch_size == 1:
+            # Diagnostic: use given noise ids for the first draft pass (fidelity test vs IFM's engine).
+            ids = [int(x) for x in fixed.split(",")][: q - 1]
+            self.input_ids[1 : 1 + len(ids)] = torch.tensor(ids, dtype=self.input_ids.dtype, device=self.device)
+        self._pending_lora_map = lora_map
+        self._pending_batch_size = batch_size
+        if self.gated_lora is not None:
+            if getattr(self.speculative_config, "uno_draft_cost_noise_only", False):
+                disabled = bool(os.environ.get("UNO_DEBUG_NO_LORA"))
+                self.gated_lora.arm(
+                    None if disabled else is_noise,
+                    row_indices=None if disabled else self._pending_noise_indices,
+                )
+            else:
+                self.gated_lora.arm(None if os.environ.get("UNO_DEBUG_NO_LORA") else is_noise)
+        # Noise rows WRITE their K/V to the real slots of positions p+1..p+K: later
+        # noise rows must attend to earlier ones (block-causal attention inside the
+        # draft block, paper Sec. 3.2). Those slots are rewritten by the verify pass
+        # ([bonus + K drafts] at the same positions) before any of them is committed,
+        # and the scheduler reserves them (max_num_new_slots_for_drafting). Only
+        # positions past max_model_len are parked on the padding slot.
+        qsm = self._slot_mapping_buffer[:num_query_total]
+        qsm.masked_fill_(self.positions[:num_query_total] >= self.max_model_len, PADDING_SLOT_ID)
+        eff_seq_lens = cad.seq_lens - num_rejected_tokens_gpu if has_rej else cad.seq_lens
+        upper = (
+            cad.seq_lens_cpu_upper_bound + q
+            if cad.seq_lens_cpu_upper_bound is not None
+            else None
+        )
+        new_cad = CommonAttentionMetadata(
+            query_start_loc=self.arange[: batch_size + 1] * q,
+            seq_lens=eff_seq_lens + q,
+            query_start_loc_cpu=(
+                self._step_constants.query_start_loc_cpu(
+                    batch_size, q, self.token_arange_np
+                )
+                if self._step_constants is not None
+                else torch.from_numpy(
+                    self.token_arange_np[: batch_size + 1]
+                ).clone()
+                * q
+            ),
+            _seq_lens_cpu=None,
+            _num_computed_tokens_cpu=None,
+            seq_lens_cpu_upper_bound=upper,
+            num_reqs=cad.num_reqs,
+            num_actual_tokens=num_query_total,
+            max_query_len=q,
+            max_seq_len=cad.max_seq_len + q,
+            block_table_tensor=cad.block_table_tensor,
+            slot_mapping=qsm,
+            causal=True,
+        )
+        return num_query_total, sample_idx, new_cad
+
+    @override
+    def build_model_inputs_first_pass(
+        self,
+        num_tokens: int,
+        num_input_tokens: int,
+        mm_embed_inputs: tuple[list[torch.Tensor], torch.Tensor] | None,
+    ) -> tuple[dict[str, Any], int]:
+        # Gate the LoRA to the noise rows for the draft forward that follows.
+        if self.gated_lora is not None and num_input_tokens != len(self._pending_lora_map):
+            m = torch.zeros(num_input_tokens, dtype=torch.bool, device=self.device)
+            m[: len(self._pending_lora_map)] = self.gated_lora.row_mask if self.gated_lora.row_mask is not None else False
+            if getattr(self.speculative_config, "uno_draft_cost_noise_only", False):
+                armed = self.gated_lora.row_mask is not None
+                self.gated_lora.arm(m if armed else None,
+                    row_indices=self._pending_noise_indices if armed else None)
+            else:
+                self.gated_lora.arm(m if self.gated_lora.row_mask is not None else None)
+        self._install_draft_lora(
+            num_input_tokens, self._pending_batch_size, self.num_speculative_tokens
+        )
+        return (
+            dict(
+                input_ids=self.input_ids[:num_input_tokens],
+                positions=self._get_positions(num_input_tokens),
+                inputs_embeds=None,
+            ),
+            num_input_tokens,
+        )
+
+    @override
+    def propose(
+        self,
+        num_speculative_tokens,
+        target_token_ids: torch.Tensor,
+        target_positions: torch.Tensor,
+        target_hidden_states: torch.Tensor,
+        next_token_ids: torch.Tensor,
+        token_indices_to_sample: torch.Tensor | None,
+        common_attn_metadata: CommonAttentionMetadata,
+        sampling_metadata,
+        mm_embed_inputs=None,
+        num_rejected_tokens_gpu: torch.Tensor | None = None,
+        slot_mappings=None,
+    ) -> torch.Tensor:
+        """One draft pass = one forward of the TARGET model over [bonus, noise x K] per request.
+
+        graph-backed draft pass: with ``speculative_config.enforce_eager=False`` the pass runs
+        through the target's own captured CUDA graphs. Inputs are staged in the runner's static
+        buffers (the graphs read from those addresses) and the batch is dispatched with the
+        runner's dispatcher using the LoRA-specialised key, since the gated adapter is active on
+        the noise rows. Otherwise the pass runs eagerly with the proposer's own buffers.
+        """
+        self._last_tree = None
+        if self.speculative_config.uno_tree is not None:
+            # Scheduler capacity is N nodes; diffusion depth is configured B.
+            num_speculative_tokens = self.speculative_config.num_speculative_tokens
+            from vllm.v1.spec_decode.uno_tree_attn import set_tree_attention_state
+            set_tree_attention_state(None)
+        timing = os.environ.get("UNO_DEBUG_TIMING")
+        if timing:
+            _dc_profile.synchronize()
+            t0 = time.perf_counter()
+        self._last_draft_probs = None
+        self._last_draft_sparse = None
+        self._last_seedrow = None
+        seedrow_enabled = (
+            getattr(self.speculative_config, "uno_seedrow_verify", False)
+            and self.runner._uno_seedrow.draft_enabled()
+        )
+        if getattr(self.speculative_config, "uno_fused", False):
+            return self._propose_fused(
+                num_speculative_tokens, target_token_ids, target_positions,
+                target_hidden_states, next_token_ids, token_indices_to_sample,
+                common_attn_metadata, sampling_metadata, num_rejected_tokens_gpu,
+            )
+        self.num_speculative_tokens = num_speculative_tokens
+        k = self.num_speculative_tokens
+        _dc_profile.draft_k(k)
+        # A3: dynamic K (num_speculative_tokens_per_batch_size). K = 0 past the knee = bypass: no draft pass at all.
+        assert k <= int(self.speculative_config.num_speculative_tokens), (k, self.speculative_config.num_speculative_tokens)
+        if k == 0:
+            self._n_bypass = getattr(self, "_n_bypass", 0) + 1
+            return torch.empty(common_attn_metadata.batch_size(), 0, device=self.device, dtype=torch.int64)
+        # a two-pass draft pass (bootstrap / hybrid miss) is never a fused batch for the attention backend. Unconditional:
+        # the hybrid miss path clears speculative_config.uno_fused around this call, so a check on it would skip the reset
+        from vllm.v1.spec_decode import uno_fused_attn as _ufa
+        _ufa.FUSED_ACTIVE = False
+        def _lap(name):
+            if timing:
+                _dc_profile.synchronize()
+                now = time.perf_counter()
+                self._laps = getattr(self, "_laps", {})
+                self._laps[name] = self._laps.get(name, 0.0) + (now - self._lap_t) * 1000
+                self._lap_t = now
+        if timing:
+            self._lap_t = t0
+        try:
+            route = self._lookup_route(next_token_ids, common_attn_metadata, k) if getattr(self.speculative_config, "uno_lookup", False) else None
+            if route is not None and route["skip_forward"]:
+                # every request is covered by a lookup draft or runs AR this step: no draft forward at all
+                self._n_lk_skip = getattr(self, "_n_lk_skip", 0) + 1
+                return route["lists"]
+            num_tokens, sample_idx, cad = self.set_inputs_first_pass(
+                target_token_ids=target_token_ids,
+                next_token_ids=next_token_ids,
+                target_positions=target_positions,
+                target_hidden_states=target_hidden_states,
+                token_indices_to_sample=token_indices_to_sample,
+                cad=common_attn_metadata,
+                num_rejected_tokens_gpu=num_rejected_tokens_gpu,
