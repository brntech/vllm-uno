new file mode 100644
index 0000000000000000000000000000000000000000..8c036b2e3f4114748a9c55020c0ea1aadc4ea028
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_tree_runtime.py
@@ -0,0 +1,365 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Eager, single-worker Uno tree integration. No vLLM imports until needed.
+
+The scheduler transports a flat, parent-before-child list. Physical slots retain
+that order; RoPE uses tree depth. Before scheduler rollback, accepted branch KV
+is gathered into the contiguous logical prefix. Pending trees are keyed by
+request id, never by the transient batch row.
+"""
+
+from dataclasses import replace
+
+import torch
+
+
+def compact_kv_cache(cache, source_slots, destination_slots):
+    """Copy FA2 [pages, heads, page_size, 2*head_dim] KV with alias safety."""
+    if cache.ndim != 4:
+        raise ValueError(
+            "uno_tree requires the four-dimensional FlashAttention KV layout"
+        )
+    size = cache.shape[2]
+    # Advanced indexing is a gather (separate storage), including cross-page
+    # and overlapping source/destination ranges. Never scatter node-by-node.
+    selected = cache[source_slots // size, :, source_slots % size, :].clone()
+    cache[destination_slots // size, :, destination_slots % size, :] = selected
+
+
+def validate_runtime(config):
+    from vllm.v1.spec_decode.uno_tree_config import tree_node_count, validate_tree_spec
+
+    sc = config.speculative_config
+    validate_tree_spec(sc)
+    if getattr(config.scheduler_config, "max_num_batched_tokens", float("inf")) <= max(
+        sc.num_speculative_tokens,
+        tree_node_count(sc.num_speculative_tokens, sc.uno_tree["K"], sc.uno_tree["V"]),
+    ):
+        raise ValueError("uno_tree max_num_batched_tokens must exceed both B and N")
+    if not config.model_config.enforce_eager:
+        raise ValueError("uno_tree requires --enforce-eager for the target")
+    if config.scheduler_config.async_scheduling:
+        raise ValueError("uno_tree requires --no-async-scheduling")
+    if config.cache_config.enable_prefix_caching:
+        raise ValueError(
+            "uno_tree requires --no-enable-prefix-caching until COW is GPU-gated"
+        )
+    if config.cache_config.cache_dtype not in ("auto", "float16", "bfloat16"):
+        raise ValueError("uno_tree requires fp16/bf16 KV; quantized KV is unsupported")
+    if config.model_config.dtype not in (torch.float16, torch.bfloat16):
+        raise ValueError("uno_tree requires fp16/bf16 model activations")
+    ac = config.attention_config
+    if (
+        getattr(ac.backend, "name", ac.backend) != "FLASH_ATTN"
+        or ac.flash_attn_version != 2
+    ):
+        raise ValueError("uno_tree requires FLASH_ATTN with flash_attn_version=2")
+    pc = config.parallel_config
+    for field in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "decode_context_parallel_size",
+        "prefill_context_parallel_size",
+    ):
+        if getattr(pc, field, 1) != 1:
+            raise ValueError(f"uno_tree A1 requires {field}=1")
+    if getattr(pc, "enable_dbo", False) or getattr(pc, "ubatch_size", 1) > 1:
+        raise ValueError("uno_tree does not support microbatch overlap")
+    mc = config.model_config
+    if getattr(mc, "logits_processors", None):
+        raise ValueError("uno_tree does not support global custom logits processors")
+    for field in (
+        "is_multimodal_model",
+        "is_encoder_decoder",
+        "use_mla",
+        "is_hybrid",
+        "enable_prompt_embeds",
+        "rswa_window",
+    ):
+        if getattr(mc, field, False):
+            raise ValueError(f"uno_tree requires a full-attention text model ({field})")
+    for field in ("kv_transfer_config", "kv_events_config"):
+        if getattr(config, field, None) is not None:
+            raise ValueError(f"uno_tree does not support {field}")
+
+
+def validate_sampling(params):
+    """Fail closed on processors whose state would otherwise follow flat rows."""
+    if getattr(params, "logprobs", None) == -1:
+        raise ValueError("uno_tree does not support full-vocabulary logprobs=-1")
+    if getattr(params, "thinking_token_budget", None) is not None:
+        raise ValueError("uno_tree does not yet support thinking_token_budget")
+    for field, default in (
+        ("frequency_penalty", 0),
+        ("presence_penalty", 0),
+        ("repetition_penalty", 1),
+        ("min_tokens", 0),
+        ("min_p", 0),
+    ):
+        if getattr(params, field, default) != default:
+            raise ValueError(f"uno_tree does not yet support {field}")
+    for field in (
+        "bad_words",
+        "_bad_words_token_ids",
+        "allowed_token_ids",
+        "logit_bias",
+        "logits_processors",
+        "structured_outputs",
+        "thinking_token_budget",
+        "logprob_token_ids",
+    ):
+        if getattr(params, field, None):
+            raise ValueError(f"uno_tree does not yet support {field}")
+
+
+class UnoTreeRuntime:
+    def __init__(self, runner):
+        validate_runtime(runner.vllm_config)
+        self.runner = runner
+        self.pending = {}
+        self.current = {}
+        self.spans = ()
+        self.prefixes = ()
+        self.checked_cache = False
+
+    def clear_attention(self):
+        from vllm.v1.spec_decode.uno_tree_attn import set_tree_attention_state
+
+        set_tree_attention_state(None)
+
+    def record(self, tree):
+        # A single batched transfer supplies the scheduler's token identity
+        # check. CUDA synchronization here is intentional in this eager fork.
+        ids = tree.tokens.tolist()
+        for row, req_id in enumerate(self.runner.input_batch.req_ids):
+            one = replace(
+                tree,
+                **{
+                    name: getattr(tree, name)[row : row + 1]
+                    for name in ("tokens", "parents", "depths", "draft_probs", "scores")
+                },
+            )
+            self.pending[req_id] = (one, ids[row])
+
+    def _check_cache(self):
+        if self.checked_cache:
+            return
+        from vllm.v1.kv_cache_interface import (
+            FullAttentionSpec,
+            UniformTypeKVCacheSpecs,
+        )
+
+        runner = self.runner
+        if len(runner.kv_cache_config.kv_cache_groups) != 1:
+            raise ValueError(
+                "uno_tree requires one homogeneous full-attention KV group"
+            )
+        group = runner.kv_cache_config.kv_cache_groups[0]
+        spec = group.kv_cache_spec
+        specs = (
+            spec.kv_cache_specs.values()
+            if isinstance(spec, UniformTypeKVCacheSpecs)
+            else [spec]
+        )
+        for spec in specs:
+            if (
+                type(spec) is not FullAttentionSpec
+                or spec.sliding_window is not None
+                or spec.attention_chunk_size is not None
+                or spec.non_causal
+            ):
+                raise ValueError("uno_tree requires ordinary causal full-attention KV")
+        if not runner.kv_caches or any(c.ndim != 4 for c in runner.kv_caches):
+            raise ValueError("uno_tree requires initialized FlashAttention KV caches")
+        for groups in runner.attn_groups:
+            for group in groups:
+                if group.backend.get_name() != "FLASH_ATTN":
+                    raise ValueError("uno_tree encountered a non-FlashAttention layer")
+        self.checked_cache = True
+
+    def prepare(self, scheduler_output, scheduled_counts):
+        from vllm.v1.spec_decode.uno_tree import tree_attention_mask
+        from vllm.v1.spec_decode.uno_tree_attn import (
+            TreeAttentionState,
+            set_tree_attention_state,
+        )
+
+        self.clear_attention()
+        self.current = {}
+        runner = self.runner
+        # Entry-point plugins can be installed without model_config naming
+        # them. Do not silently bypass their modifications of the target law.
+        from vllm.v1.sample.logits_processor.builtin import (
+            LogitBiasLogitsProcessor,
+            MinPLogitsProcessor,
+            MinTokensLogitsProcessor,
+        )
+
+        known = (
+            LogitBiasLogitsProcessor,
+            MinPLogitsProcessor,
+            MinTokensLogitsProcessor,
+        )
+        processors = runner.input_batch.sampling_metadata.logitsprocs
+        if any(type(p) not in known for p in processors.all):
+            raise ValueError(
+                "uno_tree does not support custom/plugin logits processors"
+            )
+        # Reordering, preemption and finished requests cannot inherit batch-row state.
+        self.pending = {
+            key: value for key, value in self.pending.items() if key in runner.requests
+        }
+        spans = [0]
+        prefixes = []
+        masks = {}
+        for row, req_id in enumerate(runner.input_batch.req_ids):
+            req = runner.requests[req_id]
+            validate_sampling(req.sampling_params)
+            q = int(scheduled_counts[row])
+            start = spans[-1]
+            spans.append(start + q)
+            prefix = int(runner.input_batch.num_computed_tokens_cpu[row])
+            prefixes.append(prefix)
+            draft_ids = scheduler_output.scheduled_spec_decode_tokens.get(req_id, [])
+            if not draft_ids:
+                continue
+            self._check_cache()
+            n = len(draft_ids)
+            if q != n + 1:
+                raise ValueError(
+                    "uno_tree drafts must follow exactly one uncomputed root token"
+                )
+            cached = self.pending.get(req_id)
+            if cached is None or cached[1][:n] != draft_ids:
+                raise ValueError(f"uno_tree missing/stale candidates for {req_id}")
+            tree = replace(
+                cached[0],
+                **{
+                    name: getattr(cached[0], name)[:, :n]
+                    for name in ("tokens", "parents", "depths", "draft_probs", "scores")
+                },
+            )
+            self.current[row] = tree
+            # Slot mapping was already built from physical flat positions.
+            # Only RoPE gets logical depth; each sibling keeps its own KV slot.
+            runner.positions[start + 1 : start + q] = prefix + tree.depths[0]
+            masks[row] = tree_attention_mask(tree.parents, validate=False)[0]
+        self.spans = tuple(spans)
+        self.prefixes = tuple(prefixes)
+        if masks:
