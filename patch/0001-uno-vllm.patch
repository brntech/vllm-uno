+                batch_desc = None
+                if use_graphs:
+                    from vllm.config import CUDAGraphMode
+
+                    mode, batch_desc = self.runner.cudagraph_dispatcher.dispatch(
+                        num_tokens=num_tokens,
+                        has_lora=True,
+                        uniform_decode=False,
+                        num_active_loras=1,
