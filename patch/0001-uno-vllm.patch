+def test_native_rejection_forward_receives_raw_seed_p_all_q_and_candidate_bonus(api):
+    """Run actual RejectionSampler.forward with GPU kernels replaced by captures."""
+    h = harness(api, [4, 4], [3, 3], [True, True])
+    indices = h.rt.compact(h.scheduled, h.metadata)
+    raw_seed = h.rt.seed_logits.clone()
+    restored = h.rt.restore_logits(h.raw_logits[h.rt.plan.rows][indices])
+    q = torch.softmax(torch.arange(30, dtype=torch.float32).reshape(6, 5), dim=-1)
+    seen = {}
+
+    def bonus_sampler(*, logits, **kwargs):
+        seen["bonus"] = logits.clone()
+        return NS(sampled_token_ids=torch.zeros(2, 1, dtype=torch.int32))
+
+    def constraints(logits, cumulative, sampling):
+        seen["target"] = logits.clone()
+        logits.div_(2)
+        return logits.softmax(-1)
+
+    def reject(
+        ids, counts, max_len, cumulative, draft_q, target_p, bonus, sampling, **kwargs
+    ):
+        seen["q"] = draft_q
+        seen["ids"] = ids
+        assert counts == [3, 3] and max_len == 3
+        # A d1 rejection emits a correction alone: no unconditional root prefix.
+        return torch.tensor([[4, -1, -1, -1], [3, -1, -1, -1]], dtype=torch.int32)
+
+    scope = source_methods(
+        "vllm/v1/sample/rejection_sampler.py",
+        "RejectionSampler",
+        {"forward"},
+        {
+            "torch": torch,
+            "replace": replace,
+            "MAX_SPEC_LEN": 128,
+            "apply_sampling_constraints": constraints,
+            "rejection_sample": reject,
+            "SamplerOutput": NS,
+        },
+    )
+    sampler = NS(
+        sampler=bonus_sampler,
+        is_processed_logprobs_mode=False,
+        apply_logits_processors=lambda logits, *_: logits,
+        synthetic_mode=False,
+        synthetic_conditional_rates=None,
+        use_fp64_gumbel=False,
+    )
+    output = scope["forward"](sampler, h.metadata, q, restored, Sampling())
+    torch.testing.assert_close(
+        seen["target"], h.raw_logits[h.metadata.target_logits_indices]
+    )
+    torch.testing.assert_close(
+        seen["bonus"], h.raw_logits[h.metadata.bonus_logits_indices]
+    )
+    torch.testing.assert_close(h.rt.seed_logits, raw_seed)
+    assert seen["q"] is q and seen["ids"] is h.metadata.draft_token_ids
+    assert output.sampled_token_ids[:, 1:].eq(-1).all()
