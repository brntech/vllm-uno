+# SPDX-License-Identifier: Apache-2.0
+"""Sampler fast paths must add no host wait to the verification step.
+
+A device wait per step defeats 0014, whose whole purpose is removing them, and
+the two cheapest ways to introduce one are an unsized ``repeat_interleave`` over
+a device tensor of counts and a ``.item()`` on anything derived from the batch.
+These tests run the fast paths with every host-transfer entry point patched to
+raise, on CPU tensors, so a reintroduced wait fails here before GPU execution.
+
+CPU only; torch and pytest alone.
+"""
+
+import importlib.util
+import sys
+from contextlib import contextmanager
+from pathlib import Path
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+us = load(SRC / "vllm/v1/spec_decode/uno_sampler.py", "uno_sampler_nosync_gate")
+
+
+class HostWait(AssertionError):
+    pass
+
+
+# Every torch entry point that moves a value from the device to the host, plus
+# the unsized repeat_interleave that has to read its repeats there.
+TRIPWIRES = (
+    "item",
+    "tolist",
+    "cpu",
+    "numpy",
+    "__bool__",
+    "__int__",
+    "__float__",
+    "nonzero",
+)
+
+
+@contextmanager
+def no_host_wait():
+    saved = {name: getattr(torch.Tensor, name) for name in TRIPWIRES}
+    saved_repeat = torch.Tensor.repeat_interleave
+    saved_sync = torch.cuda.synchronize
+
+    def trip(name):
+        def raise_(*args, **kwargs):
+            raise HostWait(f"Tensor.{name} on the fast path is a device wait")
+
+        return raise_
+
+    def checked_repeat(self, repeats, *args, **kwargs):
+        if isinstance(repeats, torch.Tensor) and kwargs.get("output_size") is None:
+            raise HostWait(
+                "repeat_interleave without output_size reads repeats on the host"
+            )
+        return saved_repeat(self, repeats, *args, **kwargs)
+
+    for name in TRIPWIRES:
+        setattr(torch.Tensor, name, trip(name))
+    torch.Tensor.repeat_interleave = checked_repeat
+    torch.cuda.synchronize = trip("cuda.synchronize")
+    try:
+        yield
+    finally:
+        for name, original in saved.items():
+            setattr(torch.Tensor, name, original)
+        torch.Tensor.repeat_interleave = saved_repeat
+        torch.cuda.synchronize = saved_sync
+
+
+def make_step(seed=3, batch=4, k=3, vocab=64, width=8):
+    gen = torch.Generator().manual_seed(seed)
+    rows = batch * k
+    target = us.build_sparse_support(
+        torch.randn(rows, vocab, generator=gen),
+        torch.ones(rows),
+        torch.full((rows,), width, dtype=torch.int32),
+        torch.full((rows,), 0.9),
+        width,
+    )
+    draft = us.build_sparse_support(
+        torch.randn(rows, vocab, generator=gen),
+        torch.ones(rows),
+        torch.full((rows,), width, dtype=torch.int32),
+        torch.full((rows,), 0.9),
+        width,
+    )
+    drafts = us.sample_from_support(draft, generator=gen).to(torch.int32)
+    return {
+        "gen": gen,
+        "rows": rows,
+        "k": k,
+        "batch": batch,
+        "cu": torch.arange(1, batch + 1, dtype=torch.int32) * k,
+        "target": target,
+        "draft": draft,
+        "drafts": drafts,
+        "bonus": torch.randint(0, vocab, (batch,), generator=gen, dtype=torch.int32),
+        "uniform": torch.rand(rows, dtype=torch.float64, generator=gen),
+    }
+
+
+def test_the_tripwire_actually_trips():
+    """A guard that never fires is not a guard."""
+    with pytest.raises(HostWait):
+        with no_host_wait():
+            torch.zeros(3).sum().item()
+    with pytest.raises(HostWait):
+        with no_host_wait():
+            torch.ones(2).repeat_interleave(torch.tensor([2, 2]))
+
+
+def test_counts_from_cumulative_needs_no_host_read():
+    cu = torch.tensor([3, 6, 6, 9], dtype=torch.int32)
+    with no_host_wait():
+        counts = us.counts_from_cumulative(cu)
+    assert counts.tolist() == [3, 3, 0, 3]
+
+
+def test_expand_per_request_needs_no_host_read():
+    counts = torch.tensor([2, 0, 3], dtype=torch.int64)
+    values = torch.tensor([1.0, 2.0, 3.0])
+    with no_host_wait():
+        out = us.expand_per_request(values, counts, 5)
+        zeros = us.expand_per_request(values, counts, 5, 0.0, 1.0)
+    assert out.tolist() == [1.0, 1.0, 3.0, 3.0, 3.0]
+    assert zeros.tolist() == [1.0, 1.0, 3.0, 3.0, 3.0]
+    assert us.expand_per_request(None, counts, 5) is None
+
+
+def test_sparse_verify_step_needs_no_host_read():
+    step = make_step()
+    with no_host_wait():
+        counts = us.counts_from_cumulative(step["cu"])
+        out = us.sparse_rejection_sample(
+            draft_token_ids=step["drafts"],
+            counts=counts,
+            draft_support=step["draft"],
+            target_support=step["target"],
+            bonus_token_ids=step["bonus"],
+            uniform_probs=step["uniform"],
+            max_spec_len=step["k"],
+            generator=step["gen"],
+        )
+    assert out.shape == (step["batch"], step["k"] + 1)
+
+
+def test_greedy_step_needs_no_host_read():
+    step = make_step()
+    argmax = torch.randint(0, 64, (step["rows"],), dtype=torch.int64)
+    with no_host_wait():
+        counts = us.counts_from_cumulative(step["cu"])
+        out = us.greedy_prefix_sample(
+            draft_token_ids=step["drafts"],
+            counts=counts,
+            target_argmax=argmax,
+            bonus_token_ids=step["bonus"],
+            max_spec_len=step["k"],
+        )
+    assert out.shape == (step["batch"], step["k"] + 1)
+
+
+def test_support_build_and_sample_need_no_host_read():
+    gen = torch.Generator().manual_seed(9)
+    logits = torch.randn(12, 128, generator=gen)
+    temperature = torch.ones(12)
+    top_k = torch.full((12,), 16, dtype=torch.int32)
+    top_p = torch.full((12,), 0.95)
+    with no_host_wait():
+        support = us.build_sparse_support(logits, temperature, top_k, top_p, 16)
+        tokens = us.sample_from_support(support, generator=gen)
+        wide = us.sample_from_support(support, generator=gen, use_fp64_gumbel=True)
+    assert tokens.shape == (12,)
+    assert wide.shape == (12,)
+
+
+def test_ambiguity_tracking_defers_its_device_read():
+    """Recording a boundary tie must stay on the device; only the report line,
+    which correctness arms opt into, reads it."""
+    stats = us.FastPathStats()
+    logits = torch.tensor([[1.0, 1.0, 1.0, 0.0]])
+    with no_host_wait():
+        us.build_sparse_support(
+            logits, None, torch.tensor([2], dtype=torch.int32), None, 2, stats
+        )
+    assert "boundary_tie_rows=1" in stats.report()
+
+
+def test_counters_are_host_side_only():
+    stats = us.FastPathStats(log_every=3)
+    with no_host_wait():
+        # The first use always reports, then every log_every events after it.
+        lines = [stats.used("verify_sparse") for _ in range(4)]
+        stats.declined_for("verify_sparse", "penalties")
+    assert lines[0] is not None
+    assert lines[1] is None and lines[2] is None
+    assert lines[3] is not None
+    assert "verify_sparse=4" in lines[3]
+    assert "boundary_tie_rows=off" in lines[3]
+    assert "verify_sparse:penalties=1" in stats.report()
+
+
+def test_use_fp64_gumbel_widens_the_recovery_draw():
+    """--use-fp64-gumbel is honoured rather than silently downgraded."""
+    step = make_step(seed=5)
+    counts = us.counts_from_cumulative(step["cu"])
+    seen = {}
+    original = torch.empty
+
+    def spy(*args, **kwargs):
+        out = original(*args, **kwargs)
+        seen.setdefault("dtypes", []).append(out.dtype)
+        return out
+
+    torch.empty = spy
+    try:
+        us.sparse_rejection_sample(
+            draft_token_ids=step["drafts"],
+            counts=counts,
+            draft_support=step["draft"],
+            target_support=step["target"],
+            bonus_token_ids=step["bonus"],
+            uniform_probs=step["uniform"],
+            max_spec_len=step["k"],
+            generator=step["gen"],
+            use_fp64_gumbel=True,
+        )
+    finally:
+        torch.empty = original
+    assert torch.float64 in seen["dtypes"]
