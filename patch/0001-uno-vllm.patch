+def test_200k_samples_per_depth_and_every_markov_conditional():
+    """Every depth has 200k output observations, including after recovery.
+
+    The target depends on the previous output token. We continue each stopped tree
+    with exact AR draws, then test all 20 previous-token conditions separately at
+    each depth. This catches wrong parent-row association and future-branch choice,
+    which matching position marginals alone can miss.
+    """
+    generator = torch.Generator().manual_seed(872)
+    vocab, depth, total = 20, 3, 200_000
+    q = torch.full((1, depth, vocab), 0.2 / (vocab - 1), dtype=torch.float64)
+    for d in range(depth):
+        q[0, d, d] = 0.8
+    tree = build_tree(q, K=4, V=24)
+    p = torch.rand((depth + 1, vocab, vocab), dtype=torch.float64, generator=generator)
+    p = 0.35 * p / p.sum(dim=-1, keepdim=True) + 0.01
+    for d in range(depth + 1):
+        p[d, :, d] += 0.45
+    p /= p.sum(dim=-1, keepdim=True)
+    # Root history has previous token vocab-1. Each node's logits predict the
+    # position after its own depth and condition on that node's token.
+    rows = torch.cat(
+        (p[0, vocab - 1].unsqueeze(0), p[tree.depths[0], tree.tokens[0]]), dim=0
+    )
+    counts = torch.zeros((depth + 1, vocab, vocab), dtype=torch.long)
+    accepted_at_depth = torch.zeros(depth, dtype=torch.long)
+    for start in range(0, total, 4096):
+        batch = min(4096, total - start)
+        result = sample_tree(
+            _expand(tree, batch),
+            rows.unsqueeze(0).expand(batch, -1, -1),
+            generator=generator,
+            validate=False,
+        )
+        accepted_at_depth += (result.accepted_nodes >= 0).sum(dim=0)
+        outputs = result.tokens.clone()
+        previous = torch.full((batch,), vocab - 1, dtype=torch.long)
+        for d in range(depth + 1):
+            fallback = torch.multinomial(
+                p[d, previous], 1, generator=generator
+            ).squeeze(1)
+            outputs[:, d] = torch.where(outputs[:, d] < 0, fallback, outputs[:, d])
+            flat = previous * vocab + outputs[:, d]
+            counts[d] += torch.bincount(flat, minlength=vocab * vocab).reshape(
+                vocab, vocab
+            )
+            previous = outputs[:, d]
+    assert bool((accepted_at_depth > 5000).all()), accepted_at_depth
+    assert counts.sum(dim=(1, 2)).tolist() == [total] * (depth + 1)
+    alpha = 1e-5 / (1 + depth * vocab)  # family-wise Bonferroni bound
+    _chi_square(counts[0, vocab - 1], p[0, vocab - 1], alpha)
+    for d in range(1, depth + 1):
+        for previous in range(vocab):
+            _chi_square(counts[d, previous], p[d, previous], alpha)
+
