@@ -0,0 +1,442 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Draft-scoped, single-adapter cuBLAS LoRA with a captured side stream.
+
+The row selection and fork/join follow SGLang UnoCublasLoRABackend. vLLM's
+slot tensors already include alpha/r in B. Independent A slices are packed
+once after activating the pinned adapter; no target weights are modified.
+With uno_lora_fold, a block-diagonal B combines the independent output slices
+of each unquantized fused linear. Packed weights and scratch are ready before
+capture; quantized base linears retain the original per-slice expansion.
+"""
+
+from collections.abc import Callable
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from typing import NamedTuple
+
+import torch
+
+
+class _TensorBinding(NamedTuple):
+    data_ptr: int
+    shape: tuple[int, ...]
+    stride: tuple[int, ...]
+    dtype: torch.dtype
+    device: torch.device
+    version: int | None
+    slot_data_ptr: int | None = None
+
+
+@dataclass(frozen=True)
+class UnoLoRABinding:
+    slot_index: int | None
+    lora_id: int
+    adapter_object_id: int | None = field(compare=False)
+    tensors: tuple[tuple[str, _TensorBinding | None], ...]
+    module_layouts: tuple[tuple[str, int, tuple[int, ...]], ...]
+    # Keep old sources alive while their pointers identify a captured binding.
+    source_tensors: tuple[torch.Tensor, ...] = field(compare=False, repr=False)
+
+    @property
+    def tensor_data_ptrs(self):
+        pointers = []
+        for name, tensor in self.tensors:
+            pointers.append((name, None if tensor is None else tensor.data_ptr))
+            if tensor is not None and tensor.slot_data_ptr is not None:
+                pointers.append((f"{name}.slot", tensor.slot_data_ptr))
+        return tuple(pointers)
+
+    def describe(self):
+        return {
+            "slot_index": self.slot_index,
+            "lora_id": self.lora_id,
+            "adapter_object_id": self.adapter_object_id,
+            "tensor_data_ptrs": dict(self.tensor_data_ptrs),
+        }
+
+
+def _tensor_binding(tensor, slot=None):
+    if tensor is None:
+        return None
+    data_ptr = tensor.data_ptr()
+    stride = tuple(tensor.stride())
+    version = None
+    if slot is None and not tensor.is_inference():
+        version = tensor._version
+    return _TensorBinding(
+        data_ptr,
+        tuple(tensor.shape),
+        stride,
+        tensor.dtype,
+        tensor.device,
+        version,
+        None if slot is None else data_ptr + slot * stride[0] * tensor.element_size(),
+    )
+
+
+@dataclass(frozen=True)
+class DraftLoRARoute:
+    batch_size: int
+    k: int
+    num_tokens: int
+
+    def __post_init__(self):
+        if self.batch_size < 1 or self.k < 1:
+            raise ValueError("Uno LoRA batch size and K must be positive")
+        if self.num_tokens < self.total_rows:
+            raise ValueError("Uno LoRA input cannot truncate a draft block")
+
+    @property
+    def total_rows(self):
+        return self.batch_size * self.k
+
+    @property
+    def lora_rows(self):
+        return self.k - 1 if self.batch_size == 1 else self.total_rows
+
+
+class SingleAdapterPlan:
+    """Frozen dense A/B slices, with the same scaled weights as Punica."""
+
+    def __init__(self, pairs, output_slices, fold=False):
+        self.pairs = tuple(pairs)
+        self.output_slices = tuple(output_slices)
+        if not self.pairs or len(self.pairs) != len(self.output_slices):
+            raise ValueError("Uno LoRA requires one A/B pair per output slice")
+        first = self.pairs[0][0]
+        for (a, b), width in zip(self.pairs, self.output_slices):
+            if (
+                a.ndim != 2
+                or b.ndim != 2
+                or a.shape[0] != b.shape[1]
+                or b.shape[0] != width
+                or a.shape[1] != first.shape[1]
+                or a.dtype != first.dtype
+                or b.dtype != first.dtype
+                or a.device != first.device
+                or b.device != first.device
+                or a.requires_grad
+                or b.requires_grad
+            ):
+                raise ValueError("Uno LoRA requires compatible frozen dense A/B slices")
+        self.packed_a = (
+            first if len(self.pairs) == 1 else torch.cat([a for a, _ in self.pairs])
+        )
+        self.fold = fold
+        self.packed_b = (
+            torch.block_diag(*(b for _, b in self.pairs))
+            if fold and len(self.pairs) > 1
+            else None
+        )
+        self._latents = {}
+
+    def prepare(self, route):
+        """Keep scratch alive across replay without allocating inside capture."""
+        if not self.fold or route.lora_rows in self._latents:
+            return
+        if self.packed_a.is_cuda and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("Uno LoRA fold scratch must be prepared before capture")
+        self._latents[route.lora_rows] = self.packed_a.new_empty(
+            (route.lora_rows, self.packed_a.shape[0])
+        )
+
+    def allocate(self, x, route):
+        if (
+            x.ndim != 2
+            or x.shape != (route.num_tokens, self.packed_a.shape[1])
+            or x.dtype != self.packed_a.dtype
+            or x.device != self.packed_a.device
+        ):
+            raise ValueError("Uno LoRA input must match its draft route and adapter")
+        if self.fold:
+            if route.lora_rows not in self._latents:
+                raise RuntimeError(
+                    "Uno LoRA fold scratch must be prepared before capture"
+                )
+            return self._latents[route.lora_rows]
+        # Allocate on the consumer stream before the fork. Both x and this
+        # buffer remain live until the side stream joins, including in capture.
+        return torch.empty(
+            (route.lora_rows, self.packed_a.shape[0]), device=x.device, dtype=x.dtype
+        )
+
+    def shrink(self, x, route, latent):
+        inputs = x[1 : route.k] if route.batch_size == 1 else x[: route.total_rows]
+        torch.mm(inputs, self.packed_a.t(), out=latent)
+        if route.batch_size > 1:
+            latent.view(route.batch_size, route.k, -1)[:, 0].zero_()
+
+    def expand(self, latent, output, route):
+        if (
+            output.ndim != 2
+            or output.shape
+            != (
+                route.num_tokens,
+                sum(self.output_slices),
+            )
+            or output.dtype != latent.dtype
+        ):
+            raise ValueError("Uno LoRA output must match its draft route and slices")
+        # B=1 skips the seed entirely. B>1 zeros each seed latent before B,
+        # matching SGLang; padding rows are excluded from both GEMMs.
+        target = (
+            output[1 : route.k] if route.batch_size == 1 else output[: route.total_rows]
+        )
+        if self.packed_b is not None:
+            target.addmm_(latent, self.packed_b.t())
+            return output
+        rank_offset = output_offset = 0
+        for (a, b), width in zip(self.pairs, self.output_slices):
+            rank = a.shape[0]
+            target[:, output_offset : output_offset + width].addmm_(
+                latent[:, rank_offset : rank_offset + rank], b.t()
+            )
+            rank_offset += rank
+            output_offset += width
+        return output
+
+
+class _StreamEvents:
+    def __init__(self, device):
+        self.stream = torch.cuda.Stream(device=device)
+        self.ready = torch.cuda.Event()
+        self.done = torch.cuda.Event()
+
+    def run(self, shrink: Callable, base: Callable):
+        # Ordinary (non-breakable) capture records this fork and join as graph
+        # dependencies. Submit A first, unlike maybe_execute_in_parallel(fn0,
+        # fn1), which submits the base callable before switching streams.
+        self.ready.record()
+        try:
+            with torch.cuda.stream(self.stream):
+                self.ready.wait()
+                try:
+                    shrink()
+                finally:
+                    self.done.record()
+            return base()
+        finally:
+            self.done.wait()
+
+
+class UnoLoRAOverlap:
+    """One worker's draft-only route; target forwards retain native Punica.
+
+    Construct after installing LoRA wrappers. Bind after activating the pinned
+    adapter and before graph capture. A route must never span sampling, target
+    verification, or a prefill forward. DBO and distributed execution are refused
+    by the feature's configuration validator.
+    """
+
+    def __init__(self, model, fold=False):
+        from vllm.logger import init_logger
+        from vllm.lora.layers.base_linear import BaseLinearLayerWithLoRA
+
+        self.fold = fold
+        self._logger = init_logger(__name__)
+        self._fold_logged = False
+        self.layers = tuple(
+            layer
+            for layer in model.modules()
+            if isinstance(layer, BaseLinearLayerWithLoRA)
+        )
+        if not self.layers:
+            raise ValueError("uno_lora_overlap requires dense Punica LoRA layers")
+        self.plans = {}
+        self.route = None
+        self.binding_state = None
+        self._streams = {}
+        self.binding_key = 0
+        for layer in self.layers:
+            if not layer._enable_uno_lora_overlap:
+                raise ValueError("Uno overlap wrappers must be enabled before compile")
+            layer._uno_lora_overlap = self
+
+    def resolve_binding(self, manager, adapter_id):
+        """Read the selected adapter's storage without touching CUDA streams."""
+        adapter = manager.get_adapter(adapter_id)
+        slot = (
+            manager.lora_index_to_id.index(adapter_id)
+            if adapter is not None and adapter_id in manager.lora_index_to_id
+            else None
+        )
+        tensors = []
+        sources = []
+        module_layouts = []
+        if adapter is not None:
+            for name, layer in sorted(manager.modules.items()):
+                weights = manager._get_lora_layer_weights(adapter, name)
+                if weights is None:
+                    continue
+                module_layouts.append(
+                    (name, id(layer), tuple(getattr(layer, "output_slices", ())))
+                )
+                for side in ("a", "b"):
+                    values = getattr(weights, f"lora_{side}")
+                    values = values if isinstance(values, (list, tuple)) else (values,)
+                    for index, tensor in enumerate(values):
+                        tensors.append(
+                            (f"{name}.source_{side}[{index}]", _tensor_binding(tensor))
+                        )
+                        if tensor is not None:
+                            sources.append(tensor)
+                    if slot is not None:
+                        for index, tensor in enumerate(
+                            getattr(layer, f"lora_{side}_stacked", ())
+                        ):
+                            tensors.append(
+                                (
+                                    f"{name}.stacked_{side}[{index}]",
+                                    _tensor_binding(tensor, slot),
+                                )
+                            )
+        return UnoLoRABinding(
+            slot,
+            adapter_id,
+            None if adapter is None else id(adapter),
+            tuple(tensors),
+            tuple(module_layouts),
+            tuple(sources),
+        )
+
+    def matches(self, manager, adapter_id):
+        state = self.resolve_binding(manager, adapter_id)
+        return state.slot_index is not None and state == self.binding_state
+
+    def bind(self, manager, adapter_id):
+        state = self.resolve_binding(manager, adapter_id)
+        if state.slot_index is not None and state == self.binding_state:
+            self.binding_state = state
+            return
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("Uno overlap adapter must be bound before capture")
+        from vllm.lora.layers.column_parallel_linear import (
+            ColumnParallelLinearWithLoRA,
+            MergedColumnParallelLinearWithLoRA,
+            MergedQKVParallelLinearWithLoRA,
+            QKVParallelLinearWithLoRA,
+        )
+        from vllm.lora.layers.replicated_linear import ReplicatedLinearWithLoRA
+        from vllm.lora.layers.row_parallel_linear import RowParallelLinearWithLoRA
+        from vllm.model_executor.layers.linear import (
+            ColumnParallelLinear,
+            MergedColumnParallelLinear,
+            QKVParallelLinear,
+            ReplicatedLinear,
+            RowParallelLinear,
+            UnquantizedLinearMethod,
+        )
+
+        supported = {
+            ColumnParallelLinearWithLoRA: ColumnParallelLinear,
+            MergedColumnParallelLinearWithLoRA: MergedColumnParallelLinear,
+            MergedQKVParallelLinearWithLoRA: QKVParallelLinear,
+            QKVParallelLinearWithLoRA: QKVParallelLinear,
+            ReplicatedLinearWithLoRA: ReplicatedLinear,
+            RowParallelLinearWithLoRA: RowParallelLinear,
+        }
+        adapter = manager.get_adapter(adapter_id)
+        if state.slot_index is None:
+            raise ValueError("Uno overlap requires an activated, pinned adapter")
+        slot = state.slot_index
+        plans = {}
+        quant_fallbacks = {}
+        for name, layer in manager.modules.items():
+            if manager._get_lora_layer_weights(adapter, name) is None:
+                continue
+            if (
+                type(layer) not in supported
+                or type(layer.base_layer) is not supported[type(layer)]
+                or layer.tp_size != 1
+                or layer not in self.layers
+            ):
+                raise ValueError(f"uno_lora_overlap unsupported adapter module: {name}")
+            pairs = tuple(
+                (a[slot, 0], b[slot, 0])
+                for a, b in zip(layer.lora_a_stacked, layer.lora_b_stacked)
+            )
+            if any(a.device.type != "cuda" for a, _ in pairs):
+                raise ValueError("uno_lora_overlap requires CUDA adapter weights")
+            fold = self.fold
+            if (
+                fold
+                and type(layer.base_layer.quant_method) is not UnquantizedLinearMethod
+            ):
+                method = type(layer.base_layer.quant_method).__name__
+                quant_fallbacks[method] = quant_fallbacks.get(method, 0) + 1
+                fold = False
+            plans[layer] = SingleAdapterPlan(pairs, layer.output_slices, fold)
+        if not plans:
+            raise ValueError("uno_lora_overlap found no supported adapter weights")
+        self.plans = plans
+        self.binding_state = state
+        self.binding_key += 1
+        self._fold_logged = False
+        if self.fold:
+            before = sum(len(plan.pairs) for plan in plans.values())
+            after = sum(
+                1 if plan.packed_b is not None else len(plan.pairs)
+                for plan in plans.values()
+            )
+            self._logger.info(
+                "Uno LoRA fold bound variant=3 generation=%d "
+                "B_gemms=%d->%d quant_fallbacks=%s",
+                self.binding_key,
+                before,
+                after,
+                quant_fallbacks,
+            )
+
+    @contextmanager
+    def draft(self, manager, adapter_id, batch_size, k, num_tokens):
+        if self.route is not None:
+            raise RuntimeError("Uno overlap draft routes cannot nest")
+        self.bind(manager, adapter_id)
+        route = DraftLoRARoute(batch_size, k, num_tokens)
+        if self.fold:
+            for plan in self.plans.values():
+                plan.prepare(route)
+        self.route = route
+        try:
+            yield
+        finally:
+            self.route = None
+
+    def apply(self, layer, x, base):
+        route = self.route
+        if route is None:
+            raise RuntimeError("Uno overlap requires an armed draft route")
+        plan = self.plans.get(layer)
+        if plan is None or route.k == 1:
+            return base()
+        from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+        if BreakableCUDAGraphCapture.is_active():
+            raise RuntimeError("Uno overlap requires a non-breakable draft forward")
+        if not x.is_cuda or x.ndim != 2:
+            raise ValueError("Uno overlap requires two-dimensional CUDA activations")
+        main = torch.cuda.current_stream(x.device)
+        events = self._streams.get(main)
+        if events is None:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError(
+                    "Uno overlap side stream was not warmed before capture"
+                )
+            events = _StreamEvents(x.device)
+            self._streams[main] = events
+        latent = plan.allocate(x, route)
+        output = events.run(lambda: plan.shrink(x, route, latent), base)
+        output = plan.expand(latent, output, route)
+        if plan.packed_b is not None and not self._fold_logged:
+            self._logger.info(
+                "Uno LoRA fold active variant=3 generation=%d "
+                "slices=%d batch_size=%d k=%d capturing=%s",
+                self.binding_key,
+                len(plan.pairs),
+                route.batch_size,
+                route.k,
+                torch.cuda.is_current_stream_capturing(),
+            )
+            self._fold_logged = True
+        return output
