+def _punica_math(x, base, pairs, mask):
+    output = base.clone()
+    offset = 0
+    for a, b in pairs:
+        acc_dtype = torch.float64 if x.dtype == torch.float64 else torch.float32
+        shrink = (x[mask].to(acc_dtype) @ a.t().to(acc_dtype)).to(x.dtype)
+        delta = (shrink.to(acc_dtype) @ b.t().to(acc_dtype)).to(x.dtype)
+        width = b.shape[0]
+        output[mask, offset : offset + width] += delta
+        offset += width
+    return output
+
