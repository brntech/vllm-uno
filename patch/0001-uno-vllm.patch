+    p._get_slot_mapping = lambda n, slots: {"layer.attn": slots}
+    scope.update(
+        self=p,
+        seedrow_enabled=False,
+        _lap=lambda name: None,
+        nullcontext=contextlib.nullcontext,
+        set_forward_context=sys.modules["vllm.forward_context"].set_forward_context,
+    )
+    if with_overlap:
+        manager.adapter = NS(id=UNO_ID, weights=captured_adapter.weights)
+        assert manager.adapter is not captured_adapter
+
+    for batch in (3, 1, 2, 4, 1):
+        ids, positions, cad = live_inputs(batch)
+        cad.batch_size = lambda batch=batch: batch
+        runner.input_batch.num_reqs = batch
+        counts = np.ones(batch, dtype=np.int32)
+        assert runner._uno_set_base_loras(counts * 8, counts)
+        p.input_ids[: len(ids)].copy_(ids)
+        p.positions[: len(ids)].copy_(positions)
+        p._pending_lora_map = ns.draft_lora_mapping(len(ids), batch, 7, UNO_ID)
+        scope.update(num_tokens=len(ids), cad=cad, k=7)
+        exec(draft, scope)
+        expected = ids + positions + torch.tensor([-1] + [0] * 6).repeat(batch)
+        assert torch.equal(scope["hidden_states"], expected)
+        p._lora_hook(None)
+        p._lora_plan_hook(None, None, None, None)
+        assert controller.route is None
+        if with_overlap:
