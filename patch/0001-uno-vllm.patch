+    forward_calls = harness.state.forward_calls
+    ids, positions, cad = live_inputs(batch)
+    entry = graphs.entries[batch, 7, 8]
+    plan = entry.plan
+    expected = ids + positions + torch.tensor([-1, 0, 0, 0, 0, 0, 0] * batch)
+    with no_host_sync():
+        for _ in range(4):
+            assert harness.cache.restore(harness.wrapper, "base", (8, 1), SLOTS)
+            harness.manager._last_mapping = harness.manager._last_slot_layout = "base"
+            output = graphs.replay(batch, 7, ids, positions, cad, harness.manager)
+            assert output is entry.output
+            assert entry.plan is plan
+            assert harness.manager._last_mapping is None
+            assert harness.manager._last_slot_layout is None
