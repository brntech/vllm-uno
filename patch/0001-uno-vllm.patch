+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Configuration boundaries for the opt-in Uno draft optimizations."""
+
+import os
+
+
+def validate_overlap_spec(sc):
+    if getattr(sc, "uno_lora_fold", False) and not getattr(
+        sc, "uno_lora_overlap", False
+    ):
+        raise ValueError("uno_lora_fold requires uno_lora_overlap")
+    flags = [
+        name
+        for name in ("uno_lora_overlap", "uno_lora_fold", "uno_fused_draft_prep")
+        if getattr(sc, name, False)
+    ]
+    if not flags:
+        return
+    if not sc.use_uno() or not getattr(sc, "uno_no_host_sync", False):
+        raise ValueError(f"{', '.join(flags)} requires method=uno and uno_no_host_sync")
+    if (
+        getattr(sc, "uno_fused", False)
+        or getattr(sc, "uno_lookup", False)
+        or getattr(sc, "uno_tree", None) is not None
+    ):
+        raise ValueError(f"{', '.join(flags)} requires the linear two-pass proposer")
+
+
+def validate_overlap(config, lora_impl):
+    sc = config.speculative_config
+    validate_overlap_spec(sc)
+    if not any(
+        getattr(sc, name, False)
+        for name in ("uno_lora_overlap", "uno_lora_fold", "uno_fused_draft_prep")
+    ):
+        return
+    reasons = []
+    if lora_impl != "punica":
+        reasons.append("UNO_LORA_IMPL=punica")
+    pc = config.parallel_config
+    for name in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "decode_context_parallel_size",
+        "prefill_context_parallel_size",
+    ):
+        if getattr(pc, name, 1) != 1:
+            reasons.append(f"{name}=1")
+    if getattr(pc, "enable_dbo", False):
+        reasons.append("DBO disabled")
+    if os.environ.get("UNO_DEBUG_NO_LORA"):
+        reasons.append("UNO_DEBUG_NO_LORA unset")
+    if getattr(sc, "uno_fused_draft_prep", False):
+        for name in ("UNO_DEBUG_FIXED_NOISE", "UNO_DEBUG_DUMP"):
+            if os.environ.get(name):
+                reasons.append(f"{name} unset")
+    if reasons:
+        raise ValueError("Uno overlap/prep requires " + "; ".join(reasons))
diff --git a/vllm/v1/spec_decode/uno_sampler.py b/vllm/v1/spec_decode/uno_sampler.py
