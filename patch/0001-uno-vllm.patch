+    elif condition == "user_adapter":
+        obj.runner.input_batch.lora_id_to_lora_request = {42: object()}
+    elif condition == "dropped_adapter":
+        obj.runner.lora_manager.list_adapters = lambda: set()
+    elif condition == "debug_no_lora":
