+def _expand(tree, batch):
+    return UnoTree(
+        *(
+            getattr(tree, name).expand(batch, -1)
+            for name in ("tokens", "parents", "depths", "draft_probs", "scores")
+        ),
+        max_depth=tree.max_depth,
+    )
+
+
+def _paths(tree, batch=0):
+    paths = []
+    for token, parent in zip(tree.tokens[batch].tolist(), tree.parents[batch].tolist()):
+        paths.append((paths[parent] if parent >= 0 else ()) + (token,))
+    return paths
+
+
+def _brute(probs, k, budget):
+    top = [
+        sorted(range(row.numel()), key=lambda t: (-float(row[t]), t))[:k]
+        for row in probs
+    ]
+    candidates = []
+    for depth in range(1, len(top) + 1):
+        for path in itertools.product(*top[:depth]):
+            log_mass = sum(float(probs[d, token].log()) for d, token in enumerate(path))
+            candidates.append((path, log_mass))
+    # Random continuous cases have no equal cumulative scores. Separate tests
+    # exercise deterministic tie policy and ancestor closure.
+    return sorted(candidates, key=lambda item: (-item[1], len(item[0])))[:budget]
+
