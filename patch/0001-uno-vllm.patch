+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU configuration contract: unsupported execution must fail before startup.
+
+Load the shipped validators without importing the CUDA runtime. The flags
+must be inert when disabled and reject incompatible routing when enabled.
+"""
+
+import ast
+import hashlib
+import importlib.util
+import os
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+
+ROOT = Path(os.environ.get("VLLM_UNO_SOURCE_ROOT", Path(__file__).resolve().parents[3]))
+FLAGS = ("uno_lora_overlap", "uno_lora_fold", "uno_fused_draft_prep")
+spec = importlib.util.spec_from_file_location(
+    "uno_overlap_config_cpu", ROOT / "vllm/v1/spec_decode/uno_overlap_config.py"
+)
+config_api = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(config_api)
+
+seedrow_spec = importlib.util.spec_from_file_location(
+    "uno_seedrow_config_cpu", ROOT / "vllm/v1/spec_decode/uno_seedrow_config.py"
+)
+seedrow_api = importlib.util.module_from_spec(seedrow_spec)
+seedrow_spec.loader.exec_module(seedrow_api)
+
+
+def config(flag):
+    return NS(
+        speculative_config=NS(
+            **{
+                name: name == flag
+                or (name == "uno_lora_overlap" and flag == "uno_lora_fold")
+                for name in FLAGS
+            },
+            use_uno=lambda: True,
+            uno_no_host_sync=True,
+            uno_fused=False,
+            uno_lookup=False,
+            uno_tree=None,
+        ),
+        parallel_config=NS(tensor_parallel_size=1),
+    )
+
+
+@pytest.mark.parametrize("flag", FLAGS)
+@pytest.mark.parametrize(
+    "bad,match",
+    [
+        ("method", "method=uno"),
+        ("uno_no_host_sync", "uno_no_host_sync"),
+        ("hooks", "punica"),
+        ("tensor_parallel_size", "tensor_parallel_size=1"),
+        ("pipeline_parallel_size", "pipeline_parallel_size=1"),
+        ("data_parallel_size", "data_parallel_size=1"),
+        ("decode_context_parallel_size", "decode_context_parallel_size=1"),
+        ("prefill_context_parallel_size", "prefill_context_parallel_size=1"),
+        ("enable_dbo", "DBO disabled"),
+        ("uno_fused", "linear two-pass"),
+        ("uno_lookup", "linear two-pass"),
+        ("uno_tree", "linear two-pass"),
+    ],
+)
+def test_flags_refuse_unsupported_routing(flag, bad, match):
+    cfg = config(flag)
+    impl = "punica"
+    if bad == "method":
+        cfg.speculative_config.use_uno = lambda: False
+    elif bad == "hooks":
+        impl = "hooks"
+    elif bad == "uno_no_host_sync":
+        cfg.speculative_config.uno_no_host_sync = False
+    elif bad.startswith("uno_"):
+        setattr(cfg.speculative_config, bad, True)
+    else:
+        setattr(cfg.parallel_config, bad, 2)
+    with pytest.raises(ValueError, match=match):
