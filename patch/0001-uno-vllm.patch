+@pytest.mark.parametrize("batch", [1, 8, 32])
+def test_all_rejection_lengths_use_logical_next_seed_positions_and_slots(api, k, batch):
+    """Rejecting d1 must gather this request's saved seed, never row start-1."""
+    h = harness(api, [k + 1] * batch, [k] * batch, [True] * batch)
+    h.rt.compact(h.scheduled, h.metadata)
+    ends = h.positions[torch.tensor(h.qsl[1:] - 1)] + 1
+    cad = Attention(
+        h.r.query_start_loc.gpu,
+        h.r.query_start_loc.cpu,
+        ends,
+        batch * k,
+        k,
+        h.r.input_batch.block_table.slot_mapping.gpu,
+        h.r.positions,
+    )
+    logical = h.rt.draft_context(cad)
+    torch.testing.assert_close(
+        logical.query_start_loc, torch.tensor(h.qsl, dtype=torch.int32)
+    )
+    torch.testing.assert_close(logical.slot_mapping, h.slots)
+    # Rotating acceptance produces differing lengths within one batch, and
+    # visits every rejection position for every request across the loop.
+    for accepted_offset in range(k + 1):
+        accepted = (torch.arange(batch) + accepted_offset) % (k + 1)
+        valid_count = accepted + 1
+        rejected = k + 1 - valid_count
+        last = logical.query_start_loc[1:] - rejected - 1
+        assert torch.all(last >= logical.query_start_loc[:-1])
+        next_positions = logical.positions[last.long()] + 1
+        expected = h.positions[torch.tensor(h.qsl[:-1])] + valid_count
+        torch.testing.assert_close(next_positions, expected)
+        torch.testing.assert_close(next_positions, logical.seq_lens - rejected)
