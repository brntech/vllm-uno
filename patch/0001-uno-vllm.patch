+def test_fallback_counter_counts_request_steps_not_deduplicated_warnings(
+    api, monkeypatch
+):
+    """Two padded cache-hit requests falling back twice must report four, not one."""
+    h = harness(api, [9, 9, 17], [8, 8, 0], [False] * 3)
+    messages = []
+    logger = ModuleType("vllm.logger")
+    logger.init_logger = lambda _: NS(info=lambda _, message: messages.append(message))
+    monkeypatch.setitem(sys.modules, logger.__name__, logger)
+    h.rt.log = MethodType(api.runtime.SeedRowRuntime.log, h.rt)
+    assert h.rt.compact(h.scheduled, None) is None
+    for expected in (2, 4):
+        assert h.rt.compact(h.scheduled, h.metadata) is None
+        assert h.rt.fallback_request_steps == expected
+    assert h.scheduled.tolist() == [9, 9, 17]
+    assert messages == [
+        "fallback_counts total=0 reasons=-",
+        "fallback missing_frontier",
+        "fallback_counts total=2 reasons=missing_frontier:2",
+        "fallback_counts total=4 reasons=missing_frontier:4",
+    ]
+    assert len(h.rt._logged) == 2
