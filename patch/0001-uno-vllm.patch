+++ b/tests/v1/spec_decode/test_uno_draft_cost_mapping.py
@@ -0,0 +1,260 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU mapping tests against actual pinned Punica builder source, no vLLM import.
+
+Set VLLM_DC_SOURCE_ROOT to the local fork for native-reference tests. Standalone
+layout/cache-contract tests work from the overlay with torch and pytest alone.
+"""
+
+import ast
+import importlib.util
+import os
+import random
+import sys
+from contextlib import nullcontext
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+dc = load(SRC / "vllm/v1/spec_decode/uno_draft_cost.py", "dc_mapping_gate")
+
+
+def extract(path, name, cls=None, **scope):
+    nodes = ast.parse(path.read_text(encoding="utf-8")).body
+    if cls:
+        nodes = next(
+            n for n in nodes if isinstance(n, ast.ClassDef) and n.name == cls
+        ).body
+    node = next(n for n in nodes if isinstance(n, ast.FunctionDef) and n.name == name)
+    node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            node,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    globals_ = {"torch": torch, **scope}
+    exec(compile(module, str(path), "exec"), globals_)
+    return globals_[name]
+
+
+@pytest.fixture(scope="module")
+def native():
+    root = os.environ.get("VLLM_DC_SOURCE_ROOT")
+    if not root:
+        pytest.skip("set VLLM_DC_SOURCE_ROOT for actual Punica source comparison")
+    root = Path(root)
+    kernel = load(
+        root / "vllm/lora/ops/triton_ops/lora_kernel_metadata.py", "dc_native_kernel"
+    )
+    convert = extract(
+        root / "vllm/lora/punica_wrapper/utils.py",
+        "convert_mapping",
+        async_tensor_h2d=lambda data, *, dtype, device: torch.tensor(
+            data, dtype=dtype, device=device
+        ),
+    )
+    base = extract(
+        root / "vllm/lora/punica_wrapper/punica_base.py",
+        "_update_base_metadata",
+        "PunicaWrapperBase",
+        convert_mapping=convert,
+    )
+    update = extract(
+        root / "vllm/lora/punica_wrapper/punica_gpu.py",
+        "update_metadata",
+        "PunicaWrapperGPU",
+        gpu_sync_allowed=nullcontext,
+    )
+    return kernel.LoRAKernelMeta, base, update
+
+
+def wrapper(native, capacity=256):
+    meta_cls, base, update = native
+
+    class Wrapper:
+        def __init__(self):
+            self.device = torch.device("cpu")
+            for name in dc._BASE_FIELDS:
+                setattr(self, name, torch.full((capacity,), -777, dtype=torch.long))
+            self.indices_len = [0] * 4
+            self.is_prefill = False
+            for name in dc._METAS:
+                meta = meta_cls.make(3, capacity, "cpu", [1, 2, 4])
+                meta.token_lora_mapping.fill_(-777)
+                meta.token_indices_sorted_by_lora_ids.fill_(-777)
+                meta.active_lora_ids.fill_(-1)
+                setattr(self, name, meta)
+
+        @property
+        def token_lora_indices(self):
+            return self._token_lora_indices[: self.indices_len[0]]
+
+        @property
+        def sampler_indices(self):
+            return self._sampler_indices[: self.indices_len[1]]
+
+    Wrapper._update_base_metadata = base
+    Wrapper.update_metadata = update
+    return Wrapper()
+
+
+def mapping(tokens, prompts=(), prefill=True):
+    return NS(
+        index_mapping=tuple(tokens),
+        prompt_mapping=tuple(prompts),
+        is_prefill=prefill,
+        type=1,
+    )
+
+
+def check_same(left, right):
+    assert left.indices_len == right.indices_len
+    assert left.is_prefill == right.is_prefill
+    for (_, a), (_, b) in zip(
+        dc.PunicaMappingCache()._buffers(left), dc.PunicaMappingCache()._buffers(right)
+    ):
+        assert torch.equal(a, b)
+
+
+def run_cached(cache, target, value, slots, native_calls):
+    if not cache.restore(target, value, slots, 4, 151936):
+        native_calls.append(1)
+        target.update_metadata(value, list(slots), 4, 151936)
+        cache.remember(target, value, slots, 4, 151936)
+
+
+def test_cached_equals_native_over_random_shapes_and_slot_changes(native):
+    reference, cached = wrapper(native), wrapper(native)
+    cache = dc.PunicaMappingCache(capacity=48)
+    native_calls = []
+    rng = random.Random(481)
+    workloads = []
+    for _ in range(24):
+        batch, k = rng.randint(1, 12), rng.randint(1, 16)
+        slots = (1000003, 4, None) if rng.random() < 0.5 else (4, None, 1000003)
+        tokens = ((0,) + (1000003,) * (k - 1)) * batch
+        padding = rng.randint(0, 16)
+        workloads.append((mapping(tokens + (0,) * padding, [0] * batch), slots))
+        workloads.append((mapping([0] * batch, [0] * batch, False), slots))
+    pointers = [t.data_ptr() for _, t in cache._buffers(cached)]
+    # Keep full tails in the equality check: cache hits must emulate precisely
+    # which slices native code writes, including its all-no-LoRA early return.
+    for _ in range(3):
+        for value, slots in workloads:
+            reference.update_metadata(value, list(slots), 4, 151936)
+            run_cached(cache, cached, value, slots, native_calls)
+            check_same(reference, cached)
+    assert cache.hits >= len(workloads)
+    assert [t.data_ptr() for _, t in cache._buffers(cached)] == pointers
+    assert len(native_calls) < len(workloads) * 2
+
+
+def test_same_shape_different_mappings_do_not_collide(native):
+    target = wrapper(native)
+    cache = dc.PunicaMappingCache()
+    calls = []
+    for value in (
+        mapping([0, 9, 9], [0]),
+        mapping([9, 0, 9], [0]),
+        mapping([0, 9, 9], [9]),
+        mapping([0, 9, 9], [0], False),
+    ):
+        run_cached(cache, target, value, (9, 8, None), calls)
+    assert len(calls) == 4
+
+
+def test_slots_invalidate_mapping_identity_and_buffers_invalidate_cache(native):
+    target = wrapper(native)
+    cache = dc.PunicaMappingCache()
+    value, calls = mapping([0, 9, 9], [0]), []
+    run_cached(cache, target, value, (9, None, None), calls)
+    run_cached(cache, target, value, (None, 9, None), calls)
+    assert target._token_lora_indices[:3].tolist() == [-1, 1, 1]
+    target._token_lora_indices = target._token_lora_indices.clone()
+    run_cached(cache, target, value, (None, 9, None), calls)
+    assert cache.invalidations == 1 and len(calls) == 3
+
+
+def test_cache_lru_is_bounded_and_eviction_rebuilds(native):
+    target, cache, calls = wrapper(native), dc.PunicaMappingCache(2), []
+    for n in (1, 2, 3, 1):
+        run_cached(cache, target, mapping([9] * n), (9, None, None), calls)
+    assert len(calls) == 4 and len(cache.entries) == 2
+
+
+def test_hit_does_not_call_native_sort_unique_or_synchronize(native, monkeypatch):
+    target, cache = wrapper(native), dc.PunicaMappingCache()
+    value = mapping([0, 9, 9, 0, 9, 9], [0, 0])
+    run_cached(cache, target, value, (9, None, None), [])
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError(
+            "cache hit performed native reconstruction or synchronization"
+        )
+
+    monkeypatch.setattr(torch, "sort", forbidden)
+    monkeypatch.setattr(torch, "unique", forbidden)
+    monkeypatch.setattr(torch.cuda, "synchronize", forbidden)
+    assert cache.restore(target, value, (9, None, None), 4, 151936)
+
+
+def test_unknown_wrapper_uses_native_fallback():
+    cache = dc.PunicaMappingCache()
+    assert not cache.restore(NS(), mapping([0]), (), 1, 8)
+    cache.remember(NS(), mapping([0]), (), 1, 8)
+    assert not cache.entries and cache.bypasses == 1
+
+
+def test_partial_wrapper_uses_native_fallback(native):
+    target = wrapper(native)
+    del target.token_mapping_meta.captured_lora_counts
+    cache = dc.PunicaMappingCache()
+    assert not cache.restore(target, mapping([0]), (), 1, 8)
+    cache.remember(target, mapping([0]), (), 1, 8)
+    assert not cache.entries
+
+
+@pytest.mark.parametrize("batch", [1, 2, 8, 32])
+@pytest.mark.parametrize("k", [1, 3, 7, 16])
+def test_query_layout_equals_original_and_padding_does_not_sample(batch, k):
+    cache = dc.QueryLayoutCache()
+    padded = batch * k + 13
+    layout = cache.get(batch, k, 1000003, "cpu", padded)
+    actual = batch * k
+    rows = torch.arange(actual)
+    old_mask = rows % k > 0
+    old_mapping = tuple(1000003 if i % k else 0 for i in range(actual))
+    assert torch.equal(layout.is_noise[:actual], old_mask)
+    assert not bool(layout.is_noise[actual:].any())
+    assert layout.lora_map == old_mapping + (0,) * 13
+    assert layout.sample_indices.tolist() == list(range(actual))
+    assert layout.noise_indices.tolist() == rows[old_mask].tolist()
+    assert cache.get(batch, k, 1000003, torch.device("cpu"), padded) is layout
+    assert cache.hits == 1 and cache.misses == 1
+
+
+def test_query_layout_capacity_and_invalid_inputs():
+    cache = dc.QueryLayoutCache(2)
+    for k in (2, 3, 4):
+        cache.get(1, k, 9, "cpu")
+    assert len(cache.entries) == 2
+    for batch, k, padded in ((0, 1, None), (1, 0, None), (2, 3, 5)):
+        with pytest.raises(ValueError):
+            cache.get(batch, k, 9, "cpu", padded)
