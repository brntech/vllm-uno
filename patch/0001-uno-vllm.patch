+            out = draft_token_ids.view(-1, k)
+            self._maybe_dump(out)
+            if timing:
+                _dc_profile.synchronize()
+                dt = (time.perf_counter() - t0) * 1000
+                self._t_hist = getattr(self, "_t_hist", [])
+                self._t_hist.append(dt)
+                if len(self._t_hist) % 50 == 0:
