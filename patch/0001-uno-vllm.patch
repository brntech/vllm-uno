+@dataclass
+class Attention:
+    query_start_loc: torch.Tensor
+    query_start_loc_cpu: torch.Tensor
+    seq_lens: torch.Tensor
+    num_actual_tokens: int
+    max_query_len: int
+    slot_mapping: torch.Tensor
+    positions: torch.Tensor
+    _num_computed_tokens_cpu: torch.Tensor | None = None
+
+
+def harness(api, scheduled, counts, reuse, sampled=True, *, starts=None, table=None):
+    scheduled = np.asarray(scheduled, dtype=np.int32)
+    counts = np.asarray(counts, dtype=np.int32)
+    reuse = np.asarray(reuse, dtype=bool)
+    qsl = np.concatenate(([0], np.cumsum(scheduled, dtype=np.int32)))
+    n, batch = int(scheduled.sum()), len(scheduled)
+    starts = [31 + i * 19 for i in range(batch)] if starts is None else starts
+    positions = torch.cat(
+        [
+            torch.arange(starts[i], starts[i] + width)
+            for i, width in enumerate(scheduled)
+        ]
+    )
+    r = NS(
+        device="cpu",
+        input_ids=Buffer(torch.arange(n) + 100),
+        positions=positions,
+        query_start_loc=Buffer(torch.tensor(qsl, dtype=torch.int32)),
+        arange_np=np.arange(n + batch, dtype=np.int32),
+        _arange_scratch=np.empty(n + batch, dtype=np.int32),
+        requests={},
+    )
+    blocks = BlockTables(n, batch)
+    if table is not None:
+        blocks.table = table.clone()
+    blocks.compute_slot_mapping(batch, r.query_start_loc.gpu, positions)
+    r.input_batch = NS(
+        req_ids=[f"r{i}" for i in range(batch)],
+        block_table=blocks,
+        lora_id_to_lora_request={},
+        sampling_metadata=NS(all_greedy=not sampled),
+    )
+    r.discard_request_mask = NS(np=np.zeros(batch, dtype=bool))
+    for i, req_id in enumerate(r.input_batch.req_ids):
+        r.requests[req_id] = NS(block_ids=[blocks.table[i].tolist()])
+    for name, value in api.methods.items():
+        if name.startswith("_get_") or name == "_calc_spec_decode_metadata":
+            setattr(r, name, MethodType(value, r))
+    metadata = r._calc_spec_decode_metadata(counts, qsl[1:])
+    rt = api.runtime.SeedRowRuntime(r)
+    rt.log = lambda *_, **kwargs: None
+    rt._checked_cache = True
+    raw_logits = torch.arange(n * 5, dtype=torch.float32).reshape(n, 5) / 7
+    for row in np.flatnonzero(reuse):
+        start = qsl[row]
+        rt.pending[r.input_batch.req_ids[row]] = api.runtime.SeedFrontier(
+            r.requests[r.input_batch.req_ids[row]],
+            rt._blocks(r.input_batch.req_ids[row]),
+            positions[start].clone(),
+            blocks.slot_mapping.gpu[start].clone(),
+            r.input_ids.gpu[start].clone(),
+            raw_logits[start].clone(),
+            r.input_ids.gpu[start + 1 : qsl[row + 1]].clone(),
+        )
+    return NS(
+        r=r,
+        rt=rt,
+        scheduled=scheduled,
+        counts=counts,
+        reuse=reuse,
+        metadata=metadata,
+        raw_logits=raw_logits,
+        qsl=qsl,
+        positions=positions.clone(),
+        slots=blocks.slot_mapping.gpu.clone(),
+    )
+
