+def test_record_prepare_preserves_request_identity_after_reorder_and_trim():
+    runner = _runner(
+        req_ids=("a", "b", "finished"), counts=(6, 6, 6), prefixes=(10, 20, 30)
+    )
+    rt = runtime.UnoTreeRuntime(runner)
+    probs = torch.rand((3, 3, 8), generator=torch.Generator().manual_seed(91))
+    proposed = tree.build_tree(probs / probs.sum(-1, keepdim=True), 2, 5)
+    rt.record(proposed)
+    assert set(rt.pending) == {"a", "b", "finished"}
+    runner.requests.pop("finished")
+    runner.requests["prefill"] = NS(sampling_params=NS(temperature=0))
+    runner.input_batch.req_ids = ["b", "prefill", "a"]
+    runner.input_batch.num_computed_tokens_cpu = [20, 0, 40]
+    runner.positions = torch.tensor([20, 21, 22, 0, 1, 40, 41, 42, 43])
+    tokens = {
+        "b": proposed.tokens[1, :2].tolist(),
+        "a": proposed.tokens[0, :3].tolist(),
+    }
+    rt.prepare(NS(scheduled_spec_decode_tokens=tokens), [3, 2, 4])
+    assert set(rt.pending) == {"a", "b"}
+    assert set(rt.current) == {0, 2}
+    assert rt.spans == (0, 3, 5, 9) and rt.prefixes == (20, 0, 40)
+    torch.testing.assert_close(rt.current[0].tokens, proposed.tokens[1:2, :2])
+    torch.testing.assert_close(rt.current[2].tokens, proposed.tokens[0:1, :3])
+    assert runner.positions[[0, 3, 4, 5]].tolist() == [20, 0, 1, 40]
+    torch.testing.assert_close(runner.positions[1:3], 20 + proposed.depths[1, :2])
+    torch.testing.assert_close(runner.positions[6:9], 40 + proposed.depths[0, :3])
+    state = attention.get_tree_attention_state()
+    assert set(state.masks) == {0, 2}
+    torch.testing.assert_close(
+        state.masks[0], tree.tree_attention_mask(proposed.parents[1:2, :2])[0]
+    )
+    torch.testing.assert_close(
+        state.masks[2], tree.tree_attention_mask(proposed.parents[0:1, :3])[0]
+    )
+    # A later prefill-only step clears explicit attention/current-tree state.
+    rt.prepare(NS(scheduled_spec_decode_tokens={}), [3, 2, 4])
+    assert rt.current == {} and attention.get_tree_attention_state() is None
+
