+# SPDX-License-Identifier: Apache-2.0
+"""Fallback predicates and the compact path's allocation ceiling.
+
+Both fast paths are opt-in and must decline every batch they cannot serve
+exactly. These tests pin the decline reasons and check that the support builder
+never materialises a rows-by-vocabulary tensor at K2-Horizon's 250,624 ids.
+CPU only; torch and pytest alone.
+"""
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+us = load(SRC / "vllm/v1/spec_decode/uno_sampler.py", "uno_sampler_guard_gate")
+
+K2_VOCAB = 250624
+
+
+class Procs:
+    def __init__(self, argmax_invariant=(), non_argmax_invariant=()):
+        self.argmax_invariant = list(argmax_invariant)
+        self.non_argmax_invariant = list(non_argmax_invariant)
+
+
+def metadata(**overrides):
+    """A batch every fast path accepts, before the override under test."""
+    base = dict(
+        all_greedy=False,
+        all_random=True,
+        temperature=torch.ones(2),
+        top_p=None,
+        top_k=torch.full((2,), 50, dtype=torch.int32),
+        generators={},
+        max_num_logprobs=None,
+        logprob_token_ids=None,
+        no_penalties=True,
+        bad_words_token_ids={},
+        allowed_token_ids_mask=None,
+        logitsprocs=Procs(),
+        thinking_budget_state_holder=None,
+    )
+    base.update(overrides)
+    return NS(**base)
+
+
+# ---------------------------------------------------------------------------
+# (d) fallbacks
+# ---------------------------------------------------------------------------
+
+
+def test_sparse_accepts_a_plain_random_batch():
+    assert us.sparse_blocker(metadata(), 50) is None
+
+
+def test_greedy_accepts_a_plain_greedy_batch():
+    assert us.greedy_blocker(metadata(all_greedy=True, all_random=False)) is None
+
+
+@pytest.mark.parametrize(
+    "overrides,max_top_k,reason",
+    [
+        ({}, 129, "top_k_above_limit"),
+        ({}, None, "no_top_k"),
+        ({"top_k": None}, 50, "no_top_k"),
+        ({"all_random": False}, 50, "not_all_random"),
+        ({"generators": {0: object()}}, 50, "seeded_generators"),
+        (
+            {"logitsprocs": Procs(argmax_invariant=["min_p"])},
+            50,
+            "argmax_invariant_processors",
+        ),
+        (
+            {"logitsprocs": Procs(non_argmax_invariant=["logit_bias"])},
+            50,
+            "logits_processors",
+        ),
+        ({"no_penalties": False}, 50, "penalties"),
+        ({"bad_words_token_ids": {0: [[1]]}}, 50, "bad_words"),
+        (
+            {"allowed_token_ids_mask": torch.zeros(2, 4, dtype=torch.bool)},
+            50,
+            "allowed_token_ids",
+        ),
+        ({"max_num_logprobs": 5}, 50, "logprobs"),
+        ({"max_num_logprobs": 0}, 50, "logprobs"),
+        ({"logprob_token_ids": {0: [3]}}, 50, "logprob_token_ids"),
+    ],
+)
+def test_sparse_blocker_reasons(overrides, max_top_k, reason):
+    assert us.sparse_blocker(metadata(**overrides), max_top_k) == reason
+
+
+@pytest.mark.parametrize(
+    "overrides,reason",
+    [
+        ({"all_greedy": False}, "not_all_greedy"),
+        ({"no_penalties": False}, "penalties"),
+        ({"bad_words_token_ids": {0: [[1]]}}, "bad_words"),
+        (
+            {"allowed_token_ids_mask": torch.zeros(2, 4, dtype=torch.bool)},
+            "allowed_token_ids",
+        ),
+        (
+            {"logitsprocs": Procs(non_argmax_invariant=["min_tokens"])},
+            "logits_processors",
+        ),
+        ({"max_num_logprobs": 1}, "logprobs"),
+    ],
+)
+def test_greedy_blocker_reasons(overrides, reason):
+    base = dict(all_greedy=True, all_random=False)
+    base.update(overrides)
+    assert us.greedy_blocker(metadata(**base)) == reason
+
+
+def test_greedy_ignores_min_p():
+    """min_p is argmax invariant, so it cannot change a greedy result and does
+    not have to block the greedy path (it does block the sparse one)."""
+    meta = metadata(
+        all_greedy=True, all_random=False, logitsprocs=Procs(argmax_invariant=["min_p"])
+    )
+    assert us.greedy_blocker(meta) is None
+
+
+def test_thinking_budget_blocks_only_when_tracking():
+    idle = NS(has_tracked_requests=lambda: False)
+    busy = NS(has_tracked_requests=lambda: True)
+    assert us.sparse_blocker(metadata(thinking_budget_state_holder=idle), 50) is None
+    assert (
+        us.sparse_blocker(metadata(thinking_budget_state_holder=busy), 50)
+        == "thinking_budget"
+    )
+
+
+def test_batch_max_top_k_reads_the_host_mirror():
+    """A request that did not set top_k carries the vocabulary size, which puts
+    the whole batch over the limit without touching the device."""
+    import numpy as np
+
+    batch = NS(top_k_cpu=np.array([20, 50, K2_VOCAB, 1], dtype=np.int32))
+    assert us.batch_max_top_k(batch, 2) == 50
+    assert us.batch_max_top_k(batch, 3) == K2_VOCAB
+    assert (
+        us.sparse_blocker(metadata(), us.batch_max_top_k(batch, 3))
+        == "top_k_above_limit"
+    )
+    assert us.batch_max_top_k(NS(), 4) is None
+    assert us.batch_max_top_k(batch, 0) is None
+
+
+# ---------------------------------------------------------------------------
+# (e) allocation ceiling at a K2-sized vocabulary.
+#
+# The narrow, true claim: the compact helpers allocate no rows-by-vocabulary
+# tensor of their OWN. The dense [B*K, V] draft logits still exist (uno.py calls
+# compute_logits), and the runner still gathers the verify rows to fp32, which
+# is about 6.7 MiB per request at K=7 on K2's 250,624 ids. What the compact path
+# removes is the retained probability tensor, its contiguous copy, the runner's
+# per-step cat, the full-vocabulary softmax and the recovery scan. The logits are
+# therefore created INSIDE the recorder here, and the assertion allows exactly
+# that one large tensor and nothing else.
+# ---------------------------------------------------------------------------
+
+
+class RecordAllocations(torch.overrides.TorchFunctionMode):
+    """Record the element count of every tensor an op returns."""
+
+    def __init__(self):
+        self.sizes = []
+
+    def __torch_function__(self, func, types, args=(), kwargs=None):
+        result = func(*args, **(kwargs or {}))
+        for item in result if isinstance(result, (tuple, list)) else (result,):
+            if isinstance(item, torch.Tensor):
+                self.sizes.append(item.numel())
+        return result
+
+
+def test_sparse_support_allocates_nothing_beyond_the_logits_it_is_given():
+    rows, width = 8, 64
+    temperature = torch.ones(rows)
+    top_k = torch.full((rows,), width, dtype=torch.int32)
+    top_p = torch.full((rows,), 0.9)
+    with RecordAllocations() as recorder:
+        logits = torch.randn(rows, K2_VOCAB)
+        support = us.build_sparse_support(logits, temperature, top_k, top_p, width)
+    assert support.ids.shape == (rows, width)
+    assert support.probs.shape == (rows, width)
+    ceiling = rows * (width + 1) * 4
+    oversized = [n for n in recorder.sizes if n > ceiling]
+    assert oversized == [rows * K2_VOCAB], (
+        f"only the caller's own logits may be rows x vocab; saw {oversized}"
+    )
+    assert rows * K2_VOCAB > ceiling * 100  # the saving is real, not a tautology
+
+
+def test_sparse_sampling_and_rejection_stay_compact():
+    rows, width = 16, 32
+    logits = torch.randn(rows, K2_VOCAB)
+    top_k = torch.full((rows,), width, dtype=torch.int32)
+    support = us.build_sparse_support(logits, torch.ones(rows), top_k, None, width)
+    draft = us.build_sparse_support(
+        torch.randn(rows, K2_VOCAB), torch.ones(rows), top_k, None, width
+    )
+    with RecordAllocations() as recorder:
+        tokens = us.sample_from_support(draft)
+        out = us.sparse_rejection_sample(
+            draft_token_ids=tokens.to(torch.int32),
+            counts=torch.full((rows // 4,), 4, dtype=torch.int64),
+            draft_support=draft,
+            target_support=support,
+            bonus_token_ids=torch.zeros(rows // 4, dtype=torch.int32),
+            uniform_probs=torch.rand(rows, dtype=torch.float64),
+            max_spec_len=4,
+        )
+    assert out.shape == (rows // 4, 5)
+    # The widest intermediate is the [rows, n, width] id-match block.
+    ceiling = rows * width * width
+    assert max(recorder.sizes) <= ceiling
+    assert ceiling < rows * K2_VOCAB
+
+
+def test_per_request_reshape_matches_the_dense_layout():
+    rows, k, width = 12, 3, 8
+    ids = torch.arange(rows * width).view(rows, width)
+    probs = torch.rand(rows, width)
+    draft = us.SparseDraft(
+        token_ids=torch.zeros(rows, dtype=torch.int64),
+        support=us.SparseSupport(ids=ids, probs=probs),
+    )
+    out_ids, out_probs = draft.per_request(k)
+    assert out_ids.shape == (rows // k, k, width)
+    assert torch.equal(out_ids[1, 0], ids[k])
+    assert torch.equal(out_probs[1, 0], probs[k])
+
+
+def test_one_hot_draft_is_a_width_one_support():
+    tokens = torch.tensor([4, 9, 4], dtype=torch.int64)
+    draft = us.one_hot_draft(tokens)
+    assert draft.support.width == 1
+    assert torch.equal(draft.token_ids, tokens)
+    looked_up = draft.support.lookup(tokens.view(-1, 1))
+    assert torch.equal(looked_up.view(-1), torch.ones(3))
+    assert float(draft.support.lookup(torch.tensor([[7], [7], [7]]))[0]) == 0.0
