+@pytest.mark.parametrize("raise_in_base", [False, True])
+def test_a_is_enqueued_before_base_and_side_stream_is_joined(
+    monkeypatch, raise_in_base
+):
+    calls = []
+
+    @contextlib.contextmanager
+    def stream(value):
+        calls.append("side-enter")
+        yield
+        calls.append("side-exit")
+
+    monkeypatch.setattr(torch.cuda, "stream", stream)
+    events = overlap._StreamEvents.__new__(overlap._StreamEvents)
+    events.stream = object()
+    events.ready = NS(
+        record=lambda: calls.append("fork-record"),
+        wait=lambda: calls.append("fork-wait"),
+    )
+    events.done = NS(
+        record=lambda: calls.append("join-record"),
+        wait=lambda: calls.append("join-wait"),
+    )
+
+    def base():
+        calls.append("base")
+        if raise_in_base:
+            raise RuntimeError("base failed")
+        return 123
+
+    if raise_in_base:
+        with pytest.raises(RuntimeError, match="base failed"):
+            events.run(lambda: calls.append("A"), base)
+    else:
+        assert events.run(lambda: calls.append("A"), base) == 123
+    assert calls == [
+        "fork-record",
+        "side-enter",
+        "fork-wait",
+        "A",
+        "join-record",
+        "side-exit",
+        "base",
+        "join-wait",
+    ]
