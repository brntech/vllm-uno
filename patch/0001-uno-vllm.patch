+    assert abs(0.5 / 0.9 - 0.5) > 0.05
+    tree = _expand(build_tree(torch.tensor([[[0.9, 0.1]]]), 1, 1), 200_000)
+    p = torch.full((200_000, 2, 2), 0.5)
