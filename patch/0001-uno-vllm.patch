+# SPDX-License-Identifier: Apache-2.0
+"""Small dependency-free configuration contract for the experimental Uno tree."""
+
+
+def validate_tree_options(value):
+    if value is None:
+        return None
+    if not isinstance(value, dict) or set(value) != {"K", "V"}:
+        raise ValueError('uno_tree must be null or {"K": int, "V": int}')
+    if any(type(value[key]) is not int or value[key] <= 0 for key in value):
+        raise ValueError("uno_tree K and V must be positive integers (not bools)")
+    if value["V"] > 128:
+        raise ValueError("uno_tree V must be <=128 in the A1 fork")
+    return dict(value)
+
+
+def tree_node_count(depth, k, budget):
+    """Nonempty prefixes, capped without computing huge powers."""
+    total, level = 0, 1
+    for _ in range(depth):
+        level = min(budget, level * k)
+        total = min(budget, total + level)
+        if total == budget:
+            break
+    return total
+
+
+def validate_tree_spec(config):
+    options = validate_tree_options(config.uno_tree)
+    if options is None:
+        return
+    if config.method != "uno":
+        raise ValueError("uno_tree requires method='uno'")
+    if not 1 <= config.num_speculative_tokens <= 128:
+        raise ValueError("uno_tree num_speculative_tokens B must be in [1,128]")
+    for name in (
+        "uno_fused",
+        "uno_lookup",
+        "num_speculative_tokens_per_batch_size",
+        "disable_padded_drafter_batch",
+    ):
+        if getattr(config, name, None):
+            raise ValueError(f"uno_tree does not support {name}")
+    if config.rejection_sample_method != "standard":
+        raise ValueError("uno_tree requires standard lossless rejection sampling")
+    if not config.enforce_eager:
+        raise ValueError("uno_tree requires speculative_config.enforce_eager=true")
+    if options["K"] > config.target_model_config.get_vocab_size():
+        raise ValueError("uno_tree K exceeds the target vocabulary")
