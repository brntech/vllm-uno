@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Execution boundaries for reusing the base-weight Uno draft seed row."""
+
+
+def validate_seedrow_spec(sc):
+    if not getattr(sc, "uno_seedrow_verify", False):
+        return
+    if not sc.use_uno() or not getattr(sc, "uno_no_host_sync", False):
+        raise ValueError("uno_seedrow_verify requires method=uno and uno_no_host_sync")
+    if getattr(sc, "disable_padded_drafter_batch", False):
+        raise ValueError("uno_seedrow_verify requires padded draft batches")
+    if getattr(sc, "num_speculative_tokens_per_batch_size", None) is not None:
+        raise ValueError("uno_seedrow_verify requires a fixed candidate width")
+    if getattr(sc, "uno_sparse_topk", False):
+        raise ValueError("uno_seedrow_verify requires uno_sparse_topk disabled")
+    if (
+        getattr(sc, "uno_fused", False)
+        or getattr(sc, "uno_lookup", False)
+        or getattr(sc, "uno_tree", None) is not None
+    ):
+        raise ValueError("uno_seedrow_verify requires the linear two-pass proposer")
+
+
+def validate_seedrow(config, lora_impl):
+    sc = config.speculative_config
+    validate_seedrow_spec(sc)
+    if not getattr(sc, "uno_seedrow_verify", False):
+        return
+    reasons = []
+    if lora_impl != "punica":
+        reasons.append("UNO_LORA_IMPL=punica")
+    for name in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "decode_context_parallel_size",
+        "prefill_context_parallel_size",
+    ):
+        if getattr(config.parallel_config, name, 1) != 1:
+            reasons.append(f"{name}=1")
+    if getattr(config.parallel_config, "enable_dbo", False):
+        reasons.append("DBO disabled")
+    if getattr(config.parallel_config, "use_ubatching", False):
+        reasons.append("microbatching disabled")
+    if getattr(getattr(config, "cache_config", None), "kv_sharing_fast_prefill", False):
+        reasons.append("KV-sharing fast prefill disabled")
+    if getattr(config, "kv_transfer_config", None) is not None:
+        reasons.append("KV transfer disabled")
+    model = config.model_config
+    if getattr(model, "use_mla", False):
+        reasons.append("ordinary multihead/grouped-query attention without MLA")
+    if getattr(model, "is_multimodal_model", False):
+        reasons.append("a text-only model")
+    if getattr(model, "enable_prompt_embeds", False):
+        reasons.append("prompt embeddings disabled")
+    if getattr(model, "uses_mrope", False) or getattr(model, "uses_xdrope_dim", 0):
+        reasons.append("one-dimensional token positions")
+    if getattr(model, "enable_return_routed_experts", False):
+        reasons.append("routed expert outputs disabled")
+    if getattr(model, "is_encoder_decoder", False):
+        reasons.append("a decoder-only model")
+    if getattr(model, "is_hybrid", False) or getattr(model, "is_attention_free", False):
+        reasons.append("a transformer without stateful layers")
+    if getattr(model, "rswa_window", None) is not None or getattr(
+        model, "is_mm_prefix_lm", False
+    ):
+        reasons.append("ordinary causal attention without R-SWA/PrefixLM")
+    if getattr(model, "enable_sleep_mode", False):
+        reasons.append("sleep mode disabled")
+    offload = getattr(config, "offload_config", None)
+    if getattr(getattr(offload, "uva", None), "cpu_offload_gb", 0) or getattr(
+        getattr(offload, "prefetch", None), "offload_group_size", 0
+    ):
+        reasons.append("weight offloading disabled")
+    if reasons:
+        raise ValueError("uno_seedrow_verify requires " + "; ".join(reasons))
diff --git a/vllm/v1/spec_decode/uno_tree.py b/vllm/v1/spec_decode/uno_tree.py
