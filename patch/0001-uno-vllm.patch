@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import torch
+
+from vllm.v1.spec_decode.uno_noise import fill_uno_noise
+
+
+def _case(step=3, seed=11):
+    ids = torch.zeros(2 * 8, dtype=torch.int32)  # 2 requests x (1 bonus + 7 noise)
+    ids[0] = 100
+    ids[8] = 200
+    is_noise = torch.ones(16, dtype=torch.bool)
+    is_noise[0] = False
+    is_noise[8] = False
+    req_seeds = torch.tensor([seed, seed + 1], dtype=torch.int64).repeat_interleave(8)
+    fill_uno_noise(ids, is_noise, req_seeds, step, low=1, high=250624)
+    return ids
+
+
+def test_noise_in_range_and_bonus_untouched():
+    ids = _case()
+    assert ids[0] == 100 and ids[8] == 200
+    n = ids[[i for i in range(16) if i not in (0, 8)]]
+    assert bool((n >= 1).all()) and bool((n < 250624).all())
+    assert n.unique().numel() > 8
+
+
+def test_noise_deterministic_and_step_dependent():
+    assert torch.equal(_case(step=3), _case(step=3))
+    assert not torch.equal(_case(step=3), _case(step=4))
+    assert not torch.equal(_case(seed=11), _case(seed=12))
+
+
+def test_noise_roughly_uniform():
+    ids = torch.zeros(200_000, dtype=torch.int64)
+    fill_uno_noise(ids, torch.ones_like(ids, dtype=torch.bool),
+                   torch.full_like(ids, 7), 1, 1, 250624)
+    hist = torch.histc(ids.float(), bins=10, min=1, max=250624)
+    assert (hist.max() - hist.min()) / hist.mean() < 0.1
+
+
+def test_noise_large_step_and_seed_do_not_overflow():
+    for step in (115, 10_000, 2**31, 2**40):
+        ids = _case(step=step, seed=2**40)
+        assert bool((ids[1:8] >= 1).all()) and bool((ids[1:8] < 250624).all())
diff --git a/tests/v1/spec_decode/test_uno_nosync_plan.py b/tests/v1/spec_decode/test_uno_nosync_plan.py
new file mode 100644
index 0000000000000000000000000000000000000000..8444b7a90f638be277b0cddba9a540f1414a99a4
--- /dev/null
+++ b/tests/v1/spec_decode/test_uno_nosync_plan.py
@@ -0,0 +1,367 @@
+# SPDX-License-Identifier: Apache-2.0
+"""No-host-sync plan cache and per-shape constants on CPU tensors; no vLLM import or GPU.
+
+These tests drive vLLM's *real* ``LoRAKernelMeta.prepare_tensors`` as the native
+metadata builder, on CPU, so a restored plan is compared against what the engine
+itself would have produced for that shape. They never import ``vllm``, start a
+server or touch a device.
+"""
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+# uno_nosync imports the field lists from uno_draft_cost; both are pure
+# torch + stdlib, so they load from file without pulling the package in.
+load(SRC / "vllm/v1/spec_decode/uno_draft_cost.py",
+     "vllm.v1.spec_decode.uno_draft_cost")
+kernel_meta = load(
+    SRC / "vllm/lora/ops/triton_ops/lora_kernel_metadata.py",
+    "uno_nosync_kernel_meta",
+)
+ns = load(SRC / "vllm/v1/spec_decode/uno_nosync.py", "uno_nosync_under_test")
+
+MAX_LORAS = 4
+VOCAB = 512
+
+
+class FakeWrapper:
+    """The subset of ``PunicaWrapperGPU`` the plan cache reads and writes.
+
+    Buffer names, shapes and the ``indices_len`` bookkeeping match the real
+    wrapper; ``update_metadata`` reproduces ``PunicaWrapperGPU.update_metadata``
+    on CPU, using the engine's own ``LoRAKernelMeta``.
+    """
+
+    def __init__(self, max_num_tokens=64, max_loras=MAX_LORAS):
+        self.max_num_tokens = max_num_tokens
+        self._token_lora_indices = torch.zeros(max_num_tokens, dtype=torch.long)
+        self._sampler_indices = torch.zeros(max_num_tokens, dtype=torch.long)
+        self._sampler_indices_padded = torch.zeros(max_num_tokens, dtype=torch.long)
+        self._embeddings_indices = torch.zeros(max_num_tokens, dtype=torch.long)
+        self.token_mapping_meta = kernel_meta.LoRAKernelMeta.make(
+            max_loras, max_num_tokens, device="cpu"
+        )
+        self.prompt_mapping_meta = kernel_meta.LoRAKernelMeta.make(
+            max_loras, max_num_tokens, device="cpu"
+        )
+        self.indices_len = [None] * 4
+        self.is_prefill = False
+        self.native_calls = 0
+
+    @property
+    def token_lora_indices(self):
+        return self._token_lora_indices[: self.indices_len[0]]
+
+    @property
+    def sampler_indices(self):
+        return self._sampler_indices[: self.indices_len[1]]
+
+    def update_metadata(self, mapping, lora_index_to_id, max_loras, vocab_size):
+        self.native_calls += 1
+        self.is_prefill = mapping.is_prefill
+        id_to_index = {
+            lora_id: index
+            for index, lora_id in enumerate(lora_index_to_id)
+            if lora_id is not None
+        }
+        base = [id_to_index[x] if x > 0 else -1 for x in mapping.index_mapping]
+        embeddings = [
+            id_to_index[x] * vocab_size if x > 0 else 0 for x in mapping.index_mapping
+        ]
+        prompt = [id_to_index[x] if x > 0 else -1 for x in mapping.prompt_mapping]
+        padded = [max_loras - 1 if x == -1 else x for x in prompt]
+        padded = [i + v * len(padded) for i, v in enumerate(padded)]
+
+        for name, values in (
+            ("_token_lora_indices", base),
+            ("_sampler_indices", prompt),
+            ("_sampler_indices_padded", padded),
+            ("_embeddings_indices", embeddings),
+        ):
+            buf = getattr(self, name)
+            buf[: len(values)].copy_(torch.tensor(values, dtype=torch.long))
+        self.indices_len[:] = [
+            len(base), len(prompt), len(padded), len(embeddings)
+        ]
+        self.token_mapping_meta.prepare_tensors(self.token_lora_indices)
+        self.prompt_mapping_meta.prepare_tensors(self.sampler_indices)
+
+
+class Mapping:
+    def __init__(self, index_mapping, prompt_mapping, is_prefill=True):
+        self.index_mapping = tuple(index_mapping)
+        self.prompt_mapping = tuple(prompt_mapping)
+        self.is_prefill = is_prefill
+
+
+BASE_FIELDS = ("_token_lora_indices", "_sampler_indices",
+               "_sampler_indices_padded", "_embeddings_indices")
+RESET_FIELDS = ("active_lora_ids", "num_tokens_per_lora", "lora_token_start_loc",
+                "no_lora_flag_cpu", "num_active_loras_cpu")
+PREFIX_FIELDS = ("token_lora_mapping", "token_indices_sorted_by_lora_ids")
+
+
+def snapshot_state(wrapper):
+    """Everything a restore is supposed to reproduce.
+
+    Only the live prefix of each buffer counts: the native builder writes
+    ``indices_len`` entries and leaves the tail alone, so a plan that restored
+    the tail as well would be doing more than the engine does, not less. On an
+    all-no-LoRA meta the native builder returns after resetting the counters and
+    never writes the token buffers at all, so those are excluded there too --
+    that omission is the semantics a restore has to preserve.
+    """
+    lengths = list(wrapper.indices_len)
+    state = {"indices_len": lengths, "is_prefill": wrapper.is_prefill}
+    for name, length in zip(BASE_FIELDS, lengths):
+        state[name] = getattr(wrapper, name)[:length].clone()
+    for owner, length in zip(("token_mapping_meta", "prompt_mapping_meta"), lengths):
+        meta = getattr(wrapper, owner)
+        for field in RESET_FIELDS:
+            state[(owner, field)] = getattr(meta, field).clone()
+        if not bool(meta.no_lora_flag_cpu[0]):
+            for field in PREFIX_FIELDS:
+                state[(owner, field)] = getattr(meta, field)[:length].clone()
+    return state
+
+
+def install(wrapper, cache, kind, shape, mapping, slots):
+    """The body of ``LoRAModelManager.set_adapter_mapping_planned``."""
+    if cache.restore(wrapper, kind, shape, slots):
+        return True
+    wrapper.update_metadata(mapping, list(slots), MAX_LORAS + 1, VOCAB)
+    cache.remember(wrapper, kind, shape, slots)
+    return False
+
+
+UNO_ID = 1_000_003
+SLOTS = (UNO_ID, None, None, None)
+
+
+def draft_mapping(num_tokens, batch, k):
+    return Mapping(
+        ns.draft_lora_mapping(num_tokens, batch, k, UNO_ID),
+        (0,) * batch,
+    )
+
+
+# ---------------------------------------------------------------- draft_lora_mapping
+
+
+@pytest.mark.parametrize("batch,k", [(1, 2), (1, 8), (4, 3), (7, 5)])
+def test_draft_mapping_is_one_clean_row_then_adapter_rows(batch, k):
+    mapping = ns.draft_lora_mapping(batch * k, batch, k, UNO_ID)
+    assert len(mapping) == batch * k
+    for request in range(batch):
+        rows = mapping[request * k : (request + 1) * k]
+        assert rows[0] == 0, "the bonus row must run base weights (paper Eq. 4)"
+        assert set(rows[1:]) <= {UNO_ID}
+        assert len(rows) == k
+
+
+def test_draft_mapping_pads_with_base_rows():
+    mapping = ns.draft_lora_mapping(16, 2, 4, UNO_ID)
+    assert mapping[:8] == (0, UNO_ID, UNO_ID, UNO_ID) * 2
+    assert set(mapping[8:]) == {0}
+
+
+def test_draft_mapping_refuses_to_truncate_real_rows():
+    with pytest.raises(ValueError):
+        ns.draft_lora_mapping(7, 2, 4, UNO_ID)
+
+
+# ------------------------------------------------------------------------ plan cache
+
+
+@pytest.mark.parametrize("batch,k", [(1, 4), (3, 4), (8, 2)])
+def test_restored_plan_equals_the_native_build(batch, k):
+    """A hit reproduces the native builder's state field for field."""
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    num_tokens = batch * k
+    mapping = draft_mapping(num_tokens, batch, k)
+    shape = (num_tokens, batch, k, UNO_ID)
+
+    assert install(wrapper, cache, "draft", shape, mapping, SLOTS) is False
+    expected = snapshot_state(wrapper)
+
+    # Scribble over every buffer, then restore.
+    for name in ("_token_lora_indices", "_sampler_indices",
+                 "_sampler_indices_padded", "_embeddings_indices"):
+        getattr(wrapper, name).fill_(-99)
+    for owner in ("token_mapping_meta", "prompt_mapping_meta"):
+        meta = getattr(wrapper, owner)
+        meta.token_lora_mapping.fill_(-99)
+        meta.active_lora_ids.fill_(-99)
+        meta.num_tokens_per_lora.fill_(-99)
+        meta.lora_token_start_loc.fill_(-99)
+        meta.no_lora_flag_cpu.fill_(True)
+        meta.num_active_loras_cpu.fill_(-99)
+    wrapper.indices_len[:] = [None] * 4
+    wrapper.is_prefill = not wrapper.is_prefill
+
+    assert install(wrapper, cache, "draft", shape, mapping, SLOTS) is True
+    assert wrapper.native_calls == 1, "a hit must not call the native builder"
+    got = snapshot_state(wrapper)
+    for key, want in expected.items():
+        if isinstance(want, torch.Tensor):
+            assert torch.equal(got[key], want), key
+        else:
+            assert got[key] == want, key
+
+
+def test_second_shape_is_its_own_entry():
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    for batch in (1, 2, 4):
+        shape = (batch * 4, batch, 4, UNO_ID)
+        assert install(wrapper, cache, "draft", shape, draft_mapping(*shape[:3]),
+                       SLOTS) is False
+    assert wrapper.native_calls == 3
+    for batch in (1, 2, 4):
+        shape = (batch * 4, batch, 4, UNO_ID)
+        assert install(wrapper, cache, "draft", shape, draft_mapping(*shape[:3]),
+                       SLOTS) is True
+    assert wrapper.native_calls == 3
+    assert cache.stats()["entries"] == 3
+
+
+def test_kinds_do_not_collide():
+    """The base and draft mappings can share a token count; they must not share
+    an entry."""
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    base = Mapping((0,) * 8, (0,) * 8)
+    install(wrapper, cache, "base", (8, 8), base, SLOTS)
+    base_state = snapshot_state(wrapper)
+    install(wrapper, cache, "draft", (8, 2, 4, UNO_ID),
+            draft_mapping(8, 2, 4), SLOTS)
+    assert wrapper.native_calls == 2
+    assert install(wrapper, cache, "base", (8, 8), base, SLOTS) is True
+    got = snapshot_state(wrapper)
+    assert torch.equal(got["_token_lora_indices"], base_state["_token_lora_indices"])
+
+
+def test_all_base_mapping_keeps_the_no_lora_flag():
+    """An all-base restore must leave the native no-LoRA semantics intact."""
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    base = Mapping((0,) * 6, (0,) * 6)
+    install(wrapper, cache, "base", (6, 6), base, SLOTS)
+    assert bool(wrapper.token_mapping_meta.no_lora_flag_cpu[0]) is True
+    wrapper.token_mapping_meta.no_lora_flag_cpu.fill_(False)
+    assert install(wrapper, cache, "base", (6, 6), base, SLOTS) is True
+    assert bool(wrapper.token_mapping_meta.no_lora_flag_cpu[0]) is True
+
+
+def test_slot_reassignment_is_a_different_key():
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    shape = (8, 2, 4, UNO_ID)
+    install(wrapper, cache, "draft", shape, draft_mapping(8, 2, 4), SLOTS)
+    moved = (None, UNO_ID, None, None)
+    assert install(wrapper, cache, "draft", shape,
+                   Mapping(ns.draft_lora_mapping(8, 2, 4, UNO_ID), (0,) * 2),
+                   moved) is False
+
+
+def test_reallocated_buffers_invalidate_every_entry():
+    cache = ns.UnoLoRAPlanCache()
+    wrapper = FakeWrapper()
+    shape = (8, 2, 4, UNO_ID)
+    install(wrapper, cache, "draft", shape, draft_mapping(8, 2, 4), SLOTS)
+    assert cache.stats()["entries"] == 1
+    # A new buffer at a new address: the snapshot no longer describes this
+    # wrapper, so the cache drops everything rather than restoring into it.
+    wrapper._token_lora_indices = torch.zeros(64, dtype=torch.long)
+    assert install(wrapper, cache, "draft", shape, draft_mapping(8, 2, 4),
+                   SLOTS) is False
+    assert cache.stats()["invalidations"] == 1
+
+
+def test_capacity_is_bounded():
+    cache = ns.UnoLoRAPlanCache(capacity=2)
+    wrapper = FakeWrapper()
+    for batch in (1, 2, 3):
+        shape = (batch * 4, batch, 4, UNO_ID)
+        install(wrapper, cache, "draft", shape, draft_mapping(*shape[:3]), SLOTS)
+    assert cache.stats()["entries"] == 2
+
+
+def test_capacity_must_be_positive():
+    with pytest.raises(ValueError):
+        ns.UnoLoRAPlanCache(capacity=0)
+    with pytest.raises(ValueError):
+        ns.StepConstants(capacity=0)
+
+
+def test_unknown_wrapper_layout_bypasses_rather_than_crashing():
+    cache = ns.UnoLoRAPlanCache()
+
+    class Bare:
+        pass
+
+    assert cache.restore(Bare(), "draft", (8, 2, 4, UNO_ID), SLOTS) is False
+    assert cache.stats()["bypasses"] == 1
+
+
+# -------------------------------------------------------------- step constants
+
+
+@pytest.mark.parametrize("batch,q,seed", [(1, 4, 0), (5, 3, 7), (32, 8, 11)])
+def test_req_seeds_equal_the_eager_expression(batch, q, seed):
+    constants = ns.StepConstants()
+    device = torch.device("cpu")
+    want = (torch.arange(batch, dtype=torch.int64) + seed).repeat_interleave(q)
+    for _ in range(3):
+        got = constants.req_seeds(batch, q, seed, device)
+        assert torch.equal(got, want)
+    assert constants.stats()["misses"] == 1
+    assert constants.stats()["hits"] == 2
+
+
+def test_req_seeds_separate_entries_per_shape_and_seed():
+    constants = ns.StepConstants()
+    device = torch.device("cpu")
+    a = constants.req_seeds(2, 4, 0, device)
+    b = constants.req_seeds(2, 4, 5, device)
+    c = constants.req_seeds(3, 4, 0, device)
+    assert not torch.equal(a, b)
+    assert a.shape != c.shape
+    assert constants.stats()["seed_entries"] == 3
+
+
+@pytest.mark.parametrize("batch,q", [(1, 4), (6, 2), (17, 8)])
+def test_query_start_loc_equals_the_eager_expression(batch, q):
+    constants = ns.StepConstants()
+    token_arange_np = torch.arange(256, dtype=torch.int32).numpy()
+    want = torch.from_numpy(token_arange_np[: batch + 1]).clone() * q
+    for _ in range(3):
+        assert torch.equal(
+            constants.query_start_loc_cpu(batch, q, token_arange_np), want
+        )
+    assert constants.stats()["misses"] == 1
+
+
+def test_step_constants_reject_degenerate_shapes():
+    constants = ns.StepConstants()
+    token_arange_np = torch.arange(8, dtype=torch.int32).numpy()
+    with pytest.raises(ValueError):
+        constants.req_seeds(0, 4, 0, torch.device("cpu"))
+    with pytest.raises(ValueError):
+        constants.query_start_loc_cpu(4, 0, token_arange_np)
