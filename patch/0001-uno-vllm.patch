+# SPDX-License-Identifier: Apache-2.0
+"""No-host-sync wiring read from the patched source; no vLLM import or GPU.
+
+Set VLLM_UNO_SOURCE_ROOT (or VLLM_DC_SOURCE_ROOT) to the fork, or run from the
+patched tree, where the checkout is found by walking up from this file. Checks
+that need the fork skip explicitly when it is unreachable; a skip is not a pass.
+"""
+
+import ast
+import os
+import textwrap
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def source_root():
+    for key in ("VLLM_UNO_SOURCE_ROOT", "VLLM_DC_SOURCE_ROOT"):
+        value = os.environ.get(key)
+        if value:
+            return Path(value)
+    return SRC
+
+
+@pytest.fixture(scope="module")
+def fork():
+    root = source_root()
+    if not (root / "vllm/v1/spec_decode/uno.py").exists():
+        pytest.skip(f"patched fork not found at {root}")
+    return root
+
+
+def read(fork, relative):
+    return (fork / relative).read_text(encoding="utf-8")
+
+
+def function_source(tree, source, name):
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return ast.get_source_segment(source, node)
+    return None
+
+
+# ----------------------------------------------------------------- the flag itself
+
+
+def test_flag_exists_and_defaults_off(fork):
+    text = read(fork, "vllm/config/speculative.py")
+    assert "uno_no_host_sync: bool = False" in text
+
+
+def test_flag_rejects_the_paths_it_was_not_audited_for(fork):
+    """Fused, lookup and tree all read device state back by construction."""
+    text = read(fork, "vllm/config/speculative.py")
+    guard = text.split("if self.uno_no_host_sync:", 1)[1].split("\n        if ", 1)[0]
+    assert "uno_no_host_sync requires method=uno" in guard
+    assert "self.uno_fused" in guard
+    assert "self.uno_lookup" in guard
+    assert "self.uno_tree" in guard
+
+
+# -------------------------------------------------------- async-scheduling allowlist
+
+
+def test_allowlist_entry_is_conditional_on_the_flag(fork):
+    """Uno joins the allowlist only with uno_no_host_sync.
+
+    Both branches -- the explicit ``--async-scheduling`` hard failure and the
+    default-on heuristic -- go through the same helper, so neither can drift.
+    """
+    source = read(fork, "vllm/config/vllm.py")
+    tree = ast.parse(source)
+    helper = function_source(tree, source, "_uno_supports_async_scheduling")
+    assert helper is not None, "the allowlist helper is missing"
+    assert 'method == "uno"' in helper
+    assert "uno_no_host_sync" in helper
+    assert source.count("_uno_supports_async_scheduling(self.speculative_config)") == 2
+
+
+def test_allowlist_helper_is_false_without_the_flag(fork):
+    """Evaluate the helper's own source against stand-in configs."""
+    source = read(fork, "vllm/config/vllm.py")
+    tree = ast.parse(source)
+    namespace: dict = {}
+    exec(  # noqa: S102 - the helper is pure and read from the pinned fork
+        function_source(tree, source, "_uno_supports_async_scheduling"), namespace
+    )
+    helper = namespace["_uno_supports_async_scheduling"]
+
+    class Config:
+        def __init__(self, method, flag):
+            self.method = method
+            self.uno_no_host_sync = flag
+
+    assert helper(Config("uno", True)) is True
+    assert helper(Config("uno", False)) is False
+    assert helper(Config("eagle", True)) is False
+
+    class NoFlag:
+        method = "uno"
+
+    assert helper(NoFlag()) is False
+
+
+# ---------------------------------------------------------------- proposer wiring
+
+
+def test_proposer_builds_its_no_sync_state_only_under_the_flag(fork):
+    source = read(fork, "vllm/v1/spec_decode/uno.py")
+    assert 'self.no_host_sync = bool(getattr(sc, "uno_no_host_sync", False))' in source
+    assert "_nosync.StepConstants() if self.no_host_sync else None" in source
+    assert "if self._query_layout_cache is None:" in source
+
+
+def test_environment_reads_were_left_alone(fork):
+    """The step path still reads its ``UNO_DEBUG_*`` knobs from ``os.environ``.
+
+    They were audited and deliberately not touched: an environment read is a
+    dict lookup, not a device synchronisation, and every one of those lines is a
+    literal anchor of the timing and sparse-sampling source checks, so rewriting
+    them would break those checks for no measurable gain.
+    """
+    source = read(fork, "vllm/v1/spec_decode/uno.py")
+    assert 'timing = os.environ.get("UNO_DEBUG_TIMING")' in source
+    assert 'junk = os.environ.get("UNO_DEBUG_DRAFT_JUNK")' in source
+
+
+def test_draft_lora_install_prefers_the_plan_hook(fork):
+    source = read(fork, "vllm/v1/spec_decode/uno.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_install_draft_lora")
+    assert body is not None
+    assert body.index("_lora_plan_hook") < body.index("_lora_hook is not None"), (
+        "the plan hook must take precedence when it is installed"
+    )
+
+
+def test_proposer_has_no_lora_tuple_left_on_the_hit_path(fork):
+    """The mapping tuple is built inside a lambda, so a plan hit never
+    materialises it."""
+    source = read(fork, "vllm/v1/spec_decode/uno.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_install_draft_lora")
+    assert "lambda:" in body
+
+
+# ------------------------------------------------------------------ runner wiring
+
+
+def test_runner_registers_the_plan_hook_only_under_the_flag(fork):
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_install_uno_lora")
+    assert body is not None
+    assert 'getattr(self.speculative_config, "uno_no_host_sync", False)' in body
+    assert "set_lora_plan_hook" in body
+    assert "drafter.set_lora_hook(_uno_lora_hook)" in body, (
+        "the ordinary hook must stay installed for the flag-off path"
+    )
+
+
+def test_runner_base_plan_falls_back_when_user_adapters_are_present(fork):
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_uno_set_base_loras")
+    assert body is not None
+    assert "lora_id_to_lora_request" in body
+    assert "return False" in body
+    assert "if not self._uno_set_base_loras(" in source, (
+        "the ordinary set_active_loras path must remain the fallback"
+    )
+
+
+# --------------------------------------- adapter registration on the plan path
+
+
+def test_ensure_uno_adapter_is_defined_once_and_used_by_both_hooks(fork):
+    """The plan hook must not duplicate the adapter re-registration step."""
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    install = function_source(tree, source, "_install_uno_lora")
+    assert install is not None
+    assert install.count("def _ensure_uno_adapter(") == 1
+    flat = textwrap.dedent(install)
+    ensure = function_source(ast.parse(flat), flat, "_ensure_uno_adapter")
+    # The re-add lives in the shared helper. The method's own startup call is a
+    # separate, first-time registration and is not counted here.
+    assert ensure.count("self.lora_manager.add_adapter(drafter.lora_request)") == 1
+    for hook in ("_uno_lora_hook", "_uno_lora_plan_hook"):
+        body = function_source(ast.parse(flat), flat, hook)
+        assert body is not None, hook
+        assert "_ensure_uno_adapter()" in body, hook
+        assert "add_adapter" not in body, f"{hook} duplicates adapter registration"
+        assert body.index("_ensure_uno_adapter()") < body.index("activate_adapter("), (
+            f"{hook} activates by id before ensuring the adapter is registered"
+        )
+
+
+def test_ensure_uno_adapter_re_registers_after_profiling(fork):
+    """Registered -> dropped by post-profiling cleanup -> first draft pass.
+
+    The shipped function's own source is executed against stand-in managers, so
+    this is the code the engine runs, not a restatement of it. Without the
+    ensure step the planned path raised KeyError on the first real request
+    during CUDA execution.
+    """
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_ensure_uno_adapter")
+    assert body is not None
+
+    class Request:
+        adapter_id = lora_int_id = 1_000_003
+
+    class Manager:
+        def __init__(self):
+            self.registered = {1_000_003}
+            self.added = 0
+            self.pinned = 0
+
+        def list_adapters(self):
+            return set(self.registered)
+
+        def add_adapter(self, request):
+            self.registered.add(request.lora_int_id)
+            self.added += 1
+
+        def pin_adapter(self, lora_id):
+            assert lora_id in self.registered
+            self.pinned += 1
+
+    class Drafter:
+        uno_lora_id = 1_000_003
+        lora_request = Request()
+
+    class Runner:
+        def __init__(self, manager):
+            self.lora_manager = manager
+
+    class Logger:
+        def info(self, *args, **kwargs):
+            pass
+
+    manager = Manager()
+    namespace = {"drafter": Drafter(), "self": Runner(manager), "logger": Logger()}
+    exec(textwrap.dedent(body), namespace)  # noqa: S102 - source read from the pinned fork
+    ensure = namespace["_ensure_uno_adapter"]
+
+    # Still registered from startup: nothing to do.
+    ensure()
+    assert (manager.added, manager.pinned) == (0, 0)
+
+    # vLLM's post-profiling cleanup drops every adapter.
+    manager.registered.clear()
+    ensure()
+    assert (manager.added, manager.pinned) == (1, 1)
+    assert manager.registered == {1_000_003}
+
+    # Every later step finds it registered and re-adds nothing.
+    for _ in range(5):
+        ensure()
+    assert (manager.added, manager.pinned) == (1, 1)
+
+
+def test_ensure_uno_adapter_does_not_read_the_device(fork):
+    """A set membership test, not a tensor read: it stays out of the budget."""
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_ensure_uno_adapter")
+    for call in (".item()", ".tolist()", ".cpu()", "synchronize", "nonzero"):
+        assert call not in body, call
+
+
+def test_target_plan_path_never_activates_by_id(fork):
+    """The all-base target mapping needs no adapter, so it needs no ensure step.
+
+    If this ever starts activating an adapter it must call _ensure_uno_adapter
+    first, for the same reason the draft hook does.
+    """
+    source = read(fork, "vllm/v1/worker/gpu_model_runner.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "_uno_set_base_loras")
+    assert body is not None
+    assert "activate_adapter" not in body
+    assert '"base"' in body
+
+
+# ---------------------------------------------------------------- manager wiring
+
+
+def test_manager_plan_install_falls_through_to_the_native_builder(fork):
+    source = read(fork, "vllm/lora/model_manager.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "set_adapter_mapping_planned")
+    assert body is not None
+    assert "cache.restore(" in body
+    assert "punica_wrapper.update_metadata(" in body
+    assert "cache.remember(" in body
+    assert "self._last_mapping = None" in body
+
+
+def test_manager_prefix_logic_has_one_source(fork):
+    """The planned install and the native install resolve the same wrapper."""
+    source = read(fork, "vllm/lora/model_manager.py")
+    tree = ast.parse(source)
+    assert function_source(tree, source, "_mapping_target_prefix") is not None
+    native = function_source(tree, source, "_set_adapter_mapping")
+    planned = function_source(tree, source, "set_adapter_mapping_planned")
+    assert "_mapping_target_prefix(" in native
+    assert "_mapping_target_prefix(" in planned
+
+
+# ------------------------------------------------------------ config restrictions
+
+
+def test_flag_requires_punica_and_single_rank(fork):
+    """The plan path serves only the punica implementation, at TP 1.
+
+    The runner installs planned mappings on the punica path alone, and the hooks
+    implementation applies the adapter by dynamic boolean row indexing inside a
+    forward hook, which the plan cache neither covers nor makes sync-free. A
+    plan is a snapshot of one punica wrapper's buffers, so TP > 1 is unreasoned.
+    """
+    source = read(fork, "vllm/v1/spec_decode/uno_nosync.py")
+    tree = ast.parse(source)
+    body = function_source(tree, source, "validate_no_host_sync")
+    assert body is not None
+    namespace: dict = {}
+    exec(body, namespace)  # noqa: S102 - pure, read from the pinned fork
+    validate = namespace["validate_no_host_sync"]
+
+    class Spec:
+        def __init__(self, flag):
+            self.uno_no_host_sync = flag
+
+    class Parallel:
+        def __init__(self, tp):
+            self.tensor_parallel_size = tp
+
+    class Config:
+        def __init__(self, flag=True, tp=1):
+            self.speculative_config = Spec(flag)
+            self.parallel_config = Parallel(tp)
+
+    # Accepted.
+    validate(Config(), "punica")
+    # The flag off, or no speculation at all: nothing to check.
+    validate(Config(flag=False), "hooks")
+    validate(Config(flag=False), "punica")
+
+    class NoSpec:
+        speculative_config = None
+
+    validate(NoSpec(), "hooks")
+
+    with pytest.raises(ValueError, match="UNO_LORA_IMPL=punica"):
+        validate(Config(), "hooks")
+    with pytest.raises(ValueError, match="tensor_parallel_size=1"):
+        validate(Config(tp=2), "punica")
+
+
+def test_proposer_calls_the_restriction_at_construction(fork):
+    source = read(fork, "vllm/v1/spec_decode/uno.py")
+    assert "_nosync.validate_no_host_sync(vllm_config, self.lora_impl)" in source
+
+
+# ---------------------------------------- the sync probe must see allowed syncs
+
+
+def test_detector_can_report_syncs_inside_allowed_regions(fork):
+    """A count taken without this override is not evidence.
+
+    Both sites the audit names sit inside a ``gpu_sync_allowed()`` region, and
+    the stock hook returns before reporting anything there, so a server run
+    under plain ``VLLM_GPU_SYNC_CHECK=warn`` reports zero whether or not the
+    syncs are still happening.
+    """
+    source = read(fork, "vllm/utils/gpu_sync_debug.py")
+    assert "VLLM_GPU_SYNC_REPORT_ALLOWED" in source
+    assert "ALLOWED_SYNC_MESSAGE" in source
+    tree = ast.parse(source)
+    hook = function_source(tree, source, "_sync_warning_hook")
+    assert hook is not None
+    assert "_REPORT_ALLOWED" in hook
+    # Reporting only: an allowed sync must never become an error, or every
+    # caller that legitimately relies on the region breaks.
+    allowed_branch = hook.split("if _allow_depth.get():", 1)[1]
+    allowed_branch = allowed_branch.split("if mode ==", 1)[0]
+    assert "raise" not in allowed_branch
+    # The regions themselves are untouched, so the syncs still succeed.
+    for path, marker in (
+        ("vllm/lora/punica_wrapper/punica_gpu.py", "with gpu_sync_allowed():"),
+        ("vllm/v1/attention/backends/flashinfer.py", "with gpu_sync_allowed():"),
+    ):
+        assert marker in read(fork, path)
+
+
+
+
+
+
+# ------------------------------------------------ the sync this patch is aimed at
+
+
+def test_the_native_builder_still_reads_device_state(fork):
+    """The premise, asserted against upstream source.
+
+    ``LoRAKernelMeta.prepare_tensors`` branches on a device boolean and calls
+    ``torch.unique``, whose output size is data dependent. If either disappears
+    upstream, the reason for this patch has changed and the GPU numbers need
+    re-taking.
+    """
+    source = read(fork, "vllm/lora/ops/triton_ops/lora_kernel_metadata.py")
+    assert "no_lora = torch.all(token_lora_mapping == -1)" in source
+    assert "if no_lora:" in source
+    assert "torch.unique(" in source
+    punica = read(fork, "vllm/lora/punica_wrapper/punica_gpu.py")
+    assert "# TODO avoid gpu<->cpu sync here" in punica
+    assert "with gpu_sync_allowed():" in punica
