+def test_share_a_requires_exact_weights_not_shape_or_approximate_equality():
+    a = torch.ones((2, 4), dtype=torch.float64)
+    independent = a.clone()
+    independent[0, 0] += 1e-12
+    b = torch.ones((3, 2), dtype=torch.float64)
+    plan = lora._SlicePlan(
+        [(a, b), (a.clone(), b.clone()), (independent, b.clone())],
+        [0, 3, 6, 9],
+        fuse_lora=False,
+        share_a=True,
+    )
+    assert len(plan.unique_as) == 2
+    assert plan.a_for_slice == [0, 0, 1]
+    unshared = lora._SlicePlan(
+        [(a, b), (a, b)], [0, 3, 6], fuse_lora=False, share_a=False
+    )
+    assert len(unshared.unique_as) == 2
+
+
+def test_equal_as_are_never_reused_across_distinct_module_inputs():
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=True, noise_only=True, share_a=True
+    )
+    a, b = (
+        torch.ones((2, 4), dtype=torch.float64),
+        torch.ones((3, 2), dtype=torch.float64),
+    )
+    hook1 = wrapper._make_hook([(a, b)], [0, 3])
+    hook2 = wrapper._make_hook([(a, b)], [0, 3])
+    wrapper.arm(torch.tensor([True, True]), all_rows=True)
+    output1, output2 = (
+        torch.zeros((2, 3), dtype=torch.float64),
+        torch.zeros((2, 3), dtype=torch.float64),
+    )
+    hook1(None, (torch.ones((2, 4), dtype=torch.float64),), output1)
+    hook2(None, (torch.full((2, 4), 3.0, dtype=torch.float64),), output2)
+    torch.testing.assert_close(output2, output1 * 3, rtol=0, atol=1e-14)
+    assert len(wrapper.plans) == 2
+
