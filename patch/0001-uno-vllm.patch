+# SPDX-License-Identifier: Apache-2.0
+"""CPU attention exactness and runtime dispatch contracts, no vLLM/CUDA imports."""
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+_PATH = Path(__file__).resolve().parents[3] / "vllm/v1/spec_decode/uno_tree_attn.py"
+_SPEC = importlib.util.spec_from_file_location("uno_tree_attn_cpu", _PATH)
+attn = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = attn
+_SPEC.loader.exec_module(attn)
+
+
+@pytest.fixture(autouse=True)
+def reset_state():
+    attn.set_tree_attention_state(None)
+    yield
+    attn.set_tree_attention_state(None)
+
+
+def dense_reference(query, key, value, mask, scale):
+    groups = query.shape[1] // key.shape[1]
+    k = key.float().repeat_interleave(groups, dim=1)
+    v = value.float().repeat_interleave(groups, dim=1)
+    scores = torch.einsum("qhd,khd->hqk", query.float(), k) * scale
+    scores.masked_fill_(~mask[None], -torch.inf)
+    lse = torch.logsumexp(scores, -1)
+    probs = torch.softmax(scores, -1).nan_to_num()
+    out = torch.einsum("hqk,khd->qhd", probs, v).to(query.dtype)
+    return out, lse
+
+
+def tree_mask(parents):
+    mask = torch.eye(len(parents), dtype=torch.bool)
+    for node, parent in enumerate(parents):
+        while parent >= 0:
+            mask[node, parent] = True
+            parent = parents[parent]
+    return mask
+
+
+def merge_reference(out, a, la, b, lb):
+    total = torch.logaddexp(la, lb)
+    wa = torch.exp(la - total).T[..., None]
+    wb = torch.exp(lb - total).T[..., None]
+    out.copy_((a.float() * wa + b.float() * wb).to(out.dtype))
+
+
+@pytest.mark.parametrize("heads,kv_heads", [(1, 1), (4, 1), (6, 2), (8, 8)])
+@pytest.mark.parametrize("prefix_len", [0, 1, 7])
+def test_split_tree_matches_dense_ancestor_attention(heads, kv_heads, prefix_len):
+    generator = torch.Generator().manual_seed(23 + heads + prefix_len)
+    n, d = 9, 11
+    parents = [-1] + [
+        int(torch.randint(0, i, (), generator=generator)) for i in range(1, n)
+    ]
+    mask = tree_mask(parents)
+    query = torch.randn(n, heads, d, generator=generator)
+    keys = torch.randn(prefix_len + n, kv_heads, d, generator=generator)
+    values = torch.randn(prefix_len + n, kv_heads, d, generator=generator)
+    actual, lse = attn.block_attention(
+        query, keys[prefix_len:], values[prefix_len:], mask, d**-0.5
+    )
+    block_ref, lse_ref = dense_reference(
+        query, keys[prefix_len:], values[prefix_len:], mask, d**-0.5
+    )
+    torch.testing.assert_close(actual, block_ref)
+    torch.testing.assert_close(lse, lse_ref)
+    if prefix_len:
+        pre_out, pre_lse = dense_reference(
+            query,
+            keys[:prefix_len],
+            values[:prefix_len],
+            torch.ones(n, prefix_len, dtype=torch.bool),
+            d**-0.5,
+        )
+        merged = torch.empty_like(actual)
+        merge_reference(merged, pre_out, pre_lse, actual, lse)
+    else:
+        merged = actual
+    full_mask = torch.cat((torch.ones(n, prefix_len, dtype=torch.bool), mask), 1)
+    full_ref, _ = dense_reference(query, keys, values, full_mask, d**-0.5)
+    torch.testing.assert_close(merged, full_ref, atol=2e-6, rtol=2e-5)
+
+
+def test_mask_blocks_siblings_and_empty_rows():
+    mask = tree_mask([-1, 0, 0, 1, 2])
+    query = torch.ones(5, 2, 3)
+    key = torch.ones(5, 1, 3)
+    value = torch.arange(5.0).reshape(5, 1, 1).expand(5, 1, 3).clone()
+    baseline, _ = attn.block_attention(query, key, value, mask, 1)
+    value[2] = 100_000
+    changed, _ = attn.block_attention(query, key, value, mask, 1)
+    torch.testing.assert_close(changed[3], baseline[3])
+    assert not torch.equal(changed[4], baseline[4])
+    mask[4] = False
+    empty, lse = attn.block_attention(query, key, value, mask, 1)
+    assert torch.equal(empty[4], torch.zeros_like(empty[4]))
+    assert torch.isneginf(lse[:, 4]).all()
+
+
+def test_state_requires_explicit_valid_request_spans():
+    assert attn.get_tree_attention_state() is None
+    masks = {0: torch.eye(3, dtype=torch.bool)}
+    state = attn.TreeAttentionState((0, 3, 4), (5, 0), masks)
+    attn.set_tree_attention_state(state)
+    masks.clear()
+    assert 0 in attn.get_tree_attention_state().masks
+    invalid = [
+        attn.TreeAttentionState((1, 3), (0,), {}),
+        attn.TreeAttentionState((0, 0), (0,), {}),
+        attn.TreeAttentionState((0, 3), (-1,), {}),
+        attn.TreeAttentionState((0, 3), (0,), {1: torch.eye(3, dtype=torch.bool)}),
+        attn.TreeAttentionState((0, 3), (0,), {0: torch.eye(2, dtype=torch.bool)}),
+        attn.TreeAttentionState((0, 3), (0,), {0: torch.eye(3)}),
+    ]
+    for state in invalid:
+        with pytest.raises(ValueError):
+            attn.set_tree_attention_state(state)
+
+
+def make_runtime_fixture():
+    # Ragged mixed batch: a branched decode, an ordinary chunked prefill, and a
+    # tree with empty prefix. Physical page IDs are deliberately permuted.
+    starts, prefixes = (0, 5, 8, 10), (4, 2, 0)
+    masks = {0: tree_mask([-1, 0, 0, 1, 2]), 2: tree_mask([-1, 0])}
+    torch.manual_seed(19)
+    query = torch.randn(10, 4, 8, dtype=torch.float16)
+    key = torch.randn(10, 2, 8, dtype=torch.float16)
+    value = torch.randn_like(key)
+    kc = torch.randn(8, 4, 2, 8, dtype=torch.float16)
+    vc = torch.randn_like(kc)
+    table = torch.tensor([[5, 2, 7], [0, 6, 1], [4, 3, 1]], dtype=torch.int32)
+    for r, prefix in enumerate(prefixes):
+        start, end = starts[r : r + 2]
+        for j in range(end - start):
+            pos = prefix + j
+            block, slot = int(table[r, pos // 4]), pos % 4
+            kc[block, slot] = key[start + j]
+            vc[block, slot] = value[start + j]
+    metadata = SimpleNamespace(
+        query_start_loc=torch.tensor(starts, dtype=torch.int32),
+        seq_lens=torch.tensor([9, 5, 2], dtype=torch.int32),
+        max_seq_len=9,
+        num_actual_tokens=10,
+        causal=True,
+        use_cascade=False,
+        block_table=table,
+    )
+    impl = SimpleNamespace(
+        vllm_flash_attn_version=2,
+        scale=8**-0.5,
+        kv_cache_dtype="auto",
+        sliding_window=None,
+    )
+    state = attn.TreeAttentionState(starts, prefixes, masks)
+    return impl, metadata, state, query, key, value, kc, vc
+
+
+def test_ragged_runtime_dispatch_and_explicit_reset():
+    impl, metadata, state, query, key, value, kc, vc = make_runtime_fixture()
+    calls = []
+
+    def flash_reference(**kwargs):
+        calls.append(
+            (kwargs["causal"], kwargs["q"].shape[0], int(kwargs["seqused_k"][0]))
+        )
+        length = int(kwargs["seqused_k"][0])
+        table = kwargs["block_table"][0]
+        k = torch.stack([kwargs["k"][table[j // 4], j % 4] for j in range(length)])
+        v = torch.stack([kwargs["v"][table[j // 4], j % 4] for j in range(length)])
+        n = len(kwargs["q"])
+        mask = torch.ones(n, length, dtype=torch.bool)
+        if kwargs["causal"]:
+            mask = torch.arange(length)[None] <= torch.arange(n)[:, None] + length - n
+        out, lse = dense_reference(kwargs["q"], k, v, mask, kwargs["softmax_scale"])
+        if "out" in kwargs:
+            kwargs["out"].copy_(out)
+            return kwargs["out"]
+        return out, lse
+
+    output = torch.full((12, 4, 8), 123, dtype=torch.float16)
+    attn.set_tree_attention_state(state)
+    result = attn.tree_attention_forward(
+        impl,
+        None,
+        query,
+        key,
+        value,
+        kc,
+        vc,
+        metadata,
+        output,
+        _flash_attn_func=flash_reference,
+        _merge_func=merge_reference,
+    )
+    assert result is output
+    assert calls == [(False, 5, 4), (True, 3, 5)]
+    assert (output[10:] == 123).all(), "padding outside actual tokens is unchanged"
+    for r, prefix in enumerate(state.prefix_lens):
+        a, b = state.query_start_locs[r : r + 2]
+        full_len = prefix + b - a
+        keys = torch.stack(
+            [kc[metadata.block_table[r, j // 4], j % 4] for j in range(full_len)]
+        )
+        vals = torch.stack(
+            [vc[metadata.block_table[r, j // 4], j % 4] for j in range(full_len)]
+        )
+        mask = state.masks.get(r, torch.ones(b - a, b - a, dtype=torch.bool).tril())
+        full = torch.cat((torch.ones(b - a, prefix, dtype=torch.bool), mask), 1)
+        expected, _ = dense_reference(query[a:b], keys, vals, full, impl.scale)
+        torch.testing.assert_close(output[a:b], expected, atol=0.002, rtol=0.002)
+    attn.set_tree_attention_state(None)
+    with pytest.raises(RuntimeError, match="without explicit"):
+        attn.tree_attention_forward(
+            impl, None, query, key, value, kc, vc, metadata, output
+        )
+
+
+@pytest.mark.parametrize(
+    "owner,attribute,bad_value",
+    [
+        ("impl", "vllm_flash_attn_version", 3),
+        ("impl", "attn_type", "encoder_decoder"),
+        ("impl", "dcp_world_size", 2),
+        ("impl", "sliding_window", (64, 0)),
+        ("impl", "alibi_slopes", torch.zeros(4)),
+        ("impl", "logits_soft_cap", 30.0),
+        ("impl", "sinks", torch.zeros(4)),
+        ("impl", "kv_cache_dtype", "fp8"),
+        ("metadata", "use_cascade", True),
+        ("metadata", "causal", False),
+        ("metadata", "mm_prefix_query_range_tensor", torch.zeros(1)),
+        ("metadata", "rswa_prefix_lens", torch.zeros(1)),
+        ("metadata", "num_actual_tokens", 11),
+    ],
+)
+def test_unsupported_runtime_options_fail_before_kernel(owner, attribute, bad_value):
+    impl, metadata, state, query, key, value, kc, vc = make_runtime_fixture()
+    setattr(impl if owner == "impl" else metadata, attribute, bad_value)
