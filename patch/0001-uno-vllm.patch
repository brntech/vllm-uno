+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests of physical Uno rows and the unchanged logical sampler contract.
+
+The runtime owns request-specific seed writes, gathers candidate-only forwards,
+and restores raw seed logits for rejection. Cross-request indices and premature
+promotion of d1 are the failures under test. Load the actual metadata builder and
+rejection forward from source; only GPU kernels/model execution are stand-ins.
+"""
+
+import ast
+import importlib.util
+import itertools
+import sys
+from collections import defaultdict
+from collections.abc import Sequence
+from dataclasses import dataclass, replace
+from pathlib import Path
+from types import MethodType, ModuleType
+from types import SimpleNamespace as NS
+from typing import overload
+
+import numpy as np
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, ROOT / path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def source_methods(path, owner, names, scope):
+    tree = ast.parse((ROOT / path).read_text(encoding="utf-8"))
+    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == owner)
+    nodes = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in names]
+    for node in nodes:
+        node.decorator_list = []
+    body = [
+        ast.ImportFrom(module="__future__", names=[ast.alias("annotations")], level=0)
+    ]
+    code = ast.fix_missing_locations(ast.Module(body=body + nodes, type_ignores=[]))
+    exec(compile(code, str(ROOT / path), "exec"), scope)
+    return scope
+
+
+@pytest.fixture
+def api(monkeypatch):
+    helper = ModuleType("vllm.utils.torch_utils")
+    helper.async_tensor_h2d = lambda value, device, dtype=None: torch.tensor(
+        value, device=device, dtype=dtype
+    )
+    monkeypatch.setitem(sys.modules, helper.__name__, helper)
+    metadata = load_module("_uno_seedrow_metadata", "vllm/v1/spec_decode/metadata.py")
+    monkeypatch.setitem(sys.modules, "vllm.v1.spec_decode.metadata", metadata)
+    runtime = load_module("_uno_seedrow_test", "vllm/v1/spec_decode/uno_seedrow.py")
+    methods = source_methods(
+        "vllm/v1/worker/gpu_model_runner.py",
+        "GPUModelRunner",
+        {
+            "_get_cumsum_and_arange",
+            "_calc_spec_decode_metadata",
+            "_get_spec_decode_draft_probs",
+        },
+        {
+            "np": np,
+            "torch": torch,
+            "async_tensor_h2d": helper.async_tensor_h2d,
+            "SpecDecodeMetadata": metadata.SpecDecodeMetadata,
+        },
+    )
+    return NS(runtime=runtime, metadata=metadata, methods=methods)
+
+
+class Buffer:
+    def __init__(self, tensor):
+        self.cpu = tensor.clone()
+        self.np = self.cpu.numpy()
+        self.gpu = tensor.clone()
+
+    def copy_to_gpu(self):
+        self.gpu.copy_(self.cpu)
+
+
+def test_deferred_logical_qsl_upload_survives_physical_host_rewrite(api, monkeypatch):
+    """An in-flight logical H2D must not read compacted query starts at c32."""
+    queue = []
+    uploads = []
+
+    class Device:
+        def __init__(self, data):
+            self.data = data.clone()
+            self.dtype, self.device = data.dtype, data.device
+
+        def copy_(self, source, **kwargs):
+            queue.append(
+                lambda: self.data.copy_(
+                    source.data if isinstance(source, Device) else source
+                )
+            )
+            return self
+
+        def clone(self):
+            return Device(torch.zeros_like(self.data)).copy_(self)
+
+    def deferred_upload(value, dtype, device):
+        host = torch.as_tensor(value, dtype=dtype)
+        uploads.append(host)
+        return Device(torch.zeros_like(host)).copy_(host)
+
+    monkeypatch.setattr(
+        sys.modules["vllm.utils.torch_utils"], "async_tensor_h2d", deferred_upload
+    )
+    logical = torch.arange(33, dtype=torch.int32) * 9
+    physical = torch.arange(33, dtype=torch.int32) * 8
+    buffer = Buffer(logical)
+    buffer.gpu = Device(torch.zeros_like(logical))
+    runner = NS(query_start_loc=buffer)
+    runtime = api.runtime.SeedRowRuntime(runner)
+    runner._uno_seedrow = runtime
+    tree = ast.parse((ROOT / "vllm/v1/worker/gpu_model_runner.py").read_text("utf-8"))
+    upload_branch = next(
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.If)
+        and any(
+            isinstance(call, ast.Call)
+            and isinstance(call.func, ast.Attribute)
+            and call.func.attr == "copy_query_start_loc"
+            for call in ast.walk(node)
+        )
+    )
+    exec(
+        compile(
+            ast.Module(body=[upload_branch], type_ignores=[]), "qsl-upload", "exec"
+        ),
+        {"self": runner},
+    )
+    logical_gpu_snapshot = buffer.gpu.clone()
+    buffer.cpu.copy_(physical)
+    runtime.copy_query_start_loc()
+    for operation in queue:
+        operation()
+    torch.testing.assert_close(logical_gpu_snapshot.data, logical)
+    torch.testing.assert_close(buffer.gpu.data, physical)
+    assert len(uploads) == 2
+    runtime.copy_query_start_loc()
+    assert len(uploads) == 2
+
+    # The former direct upload reproduces the race under the same stream delay.
+    queue.clear()
+    buffer.cpu.copy_(logical)
+    buffer.copy_to_gpu()
+    stale_snapshot = buffer.gpu.clone()
+    buffer.cpu.copy_(physical)
+    for operation in queue:
+        operation()
+    assert not torch.equal(stale_snapshot.data, logical)
+
+
+class BlockTables:
+    def __init__(self, capacity, batch):
+        self.table = torch.arange(batch * 128).reshape(batch, 128) + 10
+        self.slot_mapping = Buffer(torch.zeros(capacity, dtype=torch.int64))
+
+    def __getitem__(self, index):
+        assert index == 0
+        return self
+
+    def compute_slot_mapping(self, batch, qsl, positions):
+        for row in range(batch):
+            start, end = int(qsl[row]), int(qsl[row + 1])
+            pos = positions[start:end]
+            self.slot_mapping.gpu[start:end] = (
+                self.table[row, pos // 16] * 16 + pos % 16
+            )
+
