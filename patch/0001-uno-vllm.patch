+# SPDX-License-Identifier: Apache-2.0
+"""Capture-local kernel selection; real resolver code, CPU, no Triton.
+
+The contract is a scoped dictionary override for one small draft shape. The
+failure to guard against is cache/context leakage into verify or another model.
+Loading the resolver definitions from the source AST is sufficient to exercise
+that contract without importing vLLM, compiling kernels or probing CUDA.
+"""
+
+# Extracted method bodies retain deferred annotation semantics on Python 3.12.
+from __future__ import annotations
+
+import ast
+import functools
+import importlib.util
+import os
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+@pytest.fixture
+def config_api():
+    root = Path(os.environ.get("VLLM_UNO_SOURCE_ROOT", SRC))
+    path = root / "vllm/lora/ops/triton_ops/utils.py"
+    source = ast.parse(path.read_text(encoding="utf-8"))
+    selected = {
+        "uno_draft_lora_config",
+        "get_lora_op_configs",
+        "_get_lora_op_configs_cached",
+    }
+    nodes = [
+        node
+        for node in source.body
+        if isinstance(node, ast.FunctionDef) and node.name in selected
+    ]
+    platform = SimpleNamespace(
+        cuda=True,
+        capability=90,
+    )
+    platform.is_cuda = lambda: platform.cuda
+    platform.is_device_capability = lambda value: platform.capability == value
+    envs = SimpleNamespace(VLLM_TUNED_CONFIG_FOLDER=None)
+    ns = {
+        "functools": functools,
+        "contextmanager": contextmanager,
+        "_UNO_DRAFT_ACTIVE_ROWS": ContextVar("uno_draft_test_rows", default=None),
+        "current_platform": platform,
+        "envs": envs,
+        "is_batch_invariant": False,
+        "load_lora_op_config": lambda *_: None,
+        "logger": SimpleNamespace(warning_once=lambda *_: None),
+        "next_power_of_2": lambda value: 1 << (value - 1).bit_length(),
+        "Any": Any,
+    }
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(path), "exec"), ns)
+    return ns
+
+
+def resolve(api, op="shrink", **kwargs):
+    args = dict(
+        op_type=op,
+        max_loras=2,
+        batch=8,
+        hidden_size=4096,
+        rank=128,
+        num_slices=1,
+    )
+    args.update(kwargs)
+    return api["get_lora_op_configs"](**args)
+
+
+@pytest.mark.parametrize("op", ["shrink", "expand"])
+def test_warm_default_cache_does_not_hide_or_retain_draft_override(config_api, op):
+    default = resolve(config_api, op)
+    with config_api["uno_draft_lora_config"](6):
+        draft = resolve(config_api, op)
+        assert draft["block_m"] == 16
+        assert draft != default
+    assert resolve(config_api, op) is default
+
+
