+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import pytest
+
+from vllm.config import ModelConfig, ParallelConfig, SpeculativeConfig
+
+MODEL = "IFM/K2-Horizon-7B"
+REV = "586b03f0fd1fbbf2f13eeafc33749e95ae34dd10"
+
+
+def _target():
+    return ModelConfig(model=MODEL, revision=REV, trust_remote_code=True,
+                       dtype="bfloat16", max_model_len=4096, seed=0)
+
+
+def test_uno_config_defaults():
+    cfg = SpeculativeConfig(method="uno", uno_lora_path="IFM/K2-Horizon-7B-Uno",
+                            num_speculative_tokens=7, target_model_config=_target(),
+                            target_parallel_config=ParallelConfig())
+    assert cfg.use_uno()
+    assert cfg.parallel_drafting is True
+    assert cfg.draft_model_config is cfg.target_model_config
+    assert cfg.uno_mask_token_id == 250624
+    assert cfg.max_num_new_slots_for_drafting == 7
+    assert not cfg.uses_draft_model()
+    assert not cfg.use_eagle()
+
+
+def test_uno_block_size_default():
+    cfg = SpeculativeConfig(method="uno", uno_lora_path="IFM/K2-Horizon-7B-Uno",
+                            target_model_config=_target(),
+                            target_parallel_config=ParallelConfig())
+    assert cfg.num_speculative_tokens == 7
+
+
+def test_uno_requires_lora_path():
+    with pytest.raises(ValueError, match="uno_lora_path"):
+        SpeculativeConfig(method="uno", num_speculative_tokens=7,
+                          target_model_config=_target(),
+                          target_parallel_config=ParallelConfig())
