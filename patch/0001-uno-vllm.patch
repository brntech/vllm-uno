+def accounting_runner(row_metadata, k, seedrow, prefix_caching, max_reqs=32):
+    cfg = SimpleNamespace(
+        num_speculative_tokens=k,
+        speculative_config=SimpleNamespace(uno_seedrow_verify=seedrow),
+        model_config=SimpleNamespace(multimodal_config=None),
+        cache_config=SimpleNamespace(enable_prefix_caching=prefix_caching),
+    )
+    cfg.verify_row_layout = config_method("vllm/config/vllm.py", "verify_row_layout")(
+        cfg
+    )
+    cfg.uniform_decode_query_len = config_method(
+        "vllm/config/vllm.py", "uniform_decode_query_len"
+    )(cfg)
+    return SimpleNamespace(
+        vllm_config=cfg,
+        uniform_decode_query_len=cfg.uniform_decode_query_len,
+        scheduler_config=SimpleNamespace(max_num_seqs=max_reqs),
+        max_num_tokens=8192,
+    )
+
