+def test_exact_finite_law_of_ordered_delta_residual_rejection():
+    generator = torch.Generator().manual_seed(18)
+    p = torch.rand((20,), dtype=torch.float64, generator=generator)
+    p /= p.sum()
+    for width in (1, 2, 7, 20):
+        children = torch.randperm(20, generator=generator)[:width]
+        residual = p.clone()
+        rejected_probability = torch.tensor(1.0, dtype=torch.float64)
+        output_law = torch.zeros_like(p)
+        for child in children:
+            acceptance = residual[child].clone()
+            output_law[child] += rejected_probability * acceptance
+            rejected_probability *= 1 - acceptance
+            residual[child] = 0
+            if residual.sum() > 0:
+                residual /= residual.sum()
+        output_law += rejected_probability * residual
+        torch.testing.assert_close(output_law, p, atol=1e-14, rtol=1e-14)
+
