+def _chi_square(counts, probs, alpha):
+    observed = counts.to(torch.float64)
+    expected = observed.sum() * probs.to(torch.float64)
+    assert bool((expected >= 5).all()), "fixture is too sparse for Pearson chi-square"
+    statistic = ((observed - expected).square() / expected).sum()
+    pvalue = torch.special.gammaincc(
+        torch.tensor((counts.numel() - 1) / 2, dtype=torch.float64), statistic / 2
+    )
+    assert pvalue > alpha, (float(statistic), float(pvalue), counts.tolist())
+
