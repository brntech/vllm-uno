+            if seedrow_enabled and hidden_states is not None:
+                from vllm.v1.spec_decode.metadata import VerifyRowLayout
+
+                verify_width = VerifyRowLayout(k, reuse_seed=True).verify_width
+                entry = self._draft_graph_runner.entries[
+                    cad.batch_size(), k, verify_width
+                ]
+                seed_buffers = (entry.input_ids, entry.positions, entry.slot_mapping)
+            use_graphs = hidden_states is not None
+            if hidden_states is None:
+                if getattr(self.speculative_config, "uno_fused_draft_prep", False):
+                    self._prepare_pending_draft_inputs(cad, num_tokens, k)
+                _, per_layer_attn_metadata = self.build_per_group_and_layer_attn_metadata(cad)
+                _lap("attn_meta")
+                use_graphs = (
+                    not self.speculative_config.enforce_eager
