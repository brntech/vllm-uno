+    p.speculative_config.uno_seedrow_verify = True
+    p.runner.compilation_config.cudagraph_capture_sizes = [8, 64, 256]
+    graphs = dg.UnoDraftGraphRunner()
+    graphs.capture(p)
+    assert set(graphs.entries) == {(batch, 8, 8) for batch in (1, 8, 32)}
+    for batch in (1, 8, 32, 8, 1):
+        ids, positions, cad = live_inputs(batch, 8)
+        entry = graphs.entries[batch, 8, 8]
+        with no_host_sync():
+            result = graphs.replay(
+                batch, 8, ids, positions, cad, harness.manager, verify_width=8
+            )
+        expected_route = torch.tensor([-1] + [0] * 7).repeat(batch)
+        assert torch.equal(result, ids + positions + expected_route)
+        assert torch.equal(entry.input_ids, ids)
+        assert torch.equal(entry.positions, positions)
+        assert torch.equal(entry.slot_mapping, cad.slot_mapping)
+    assert graphs.replays == 5 and graphs.fallbacks == 0
