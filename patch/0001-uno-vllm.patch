+class _TupleLinear(nn.Linear):
+    def forward(self, x):
+        return super().forward(x), "unchanged-bias-marker"
+
+
+class _Layer(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.self_attn = nn.Module()
+        self.self_attn.qkv_proj = _TupleLinear(6, 15, bias=False)
+        self.self_attn.o_proj = nn.Linear(15, 6, bias=False)
+        self.mlp = nn.Module()
+        self.mlp.gate_up_proj = _TupleLinear(6, 16, bias=False)
+        self.mlp.down_proj = nn.Linear(8, 6, bias=False)
+
+    def forward(self, x):
+        value, bias = self.self_attn.qkv_proj(x)
+        assert bias == "unchanged-bias-marker"
+        value = self.self_attn.o_proj(value)
+        up, bias = self.mlp.gate_up_proj(value)
+        assert bias == "unchanged-bias-marker"
+        gate, up = up.chunk(2, dim=-1)
+        return self.mlp.down_proj(torch.sigmoid(gate) * up)
+
+
+class _Model(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = nn.ModuleList([_Layer(), _Layer()])
+
+    def forward(self, x):
+        for layer in self.layers:
+            x = layer(x)
+        return x
+
+
+def _model_and_baseline():
+    torch.manual_seed(194)
+    model = _Model().double()
+    generator = torch.Generator().manual_seed(225)
+    dimensions = {
+        "q_proj": (6, 9),
+        "k_proj": (6, 3),
+        "v_proj": (6, 3),
+        "o_proj": (15, 6),
+        "gate_proj": (6, 8),
+        "up_proj": (6, 8),
+        "down_proj": (8, 6),
+    }
+    baseline = _bare_baseline()
+    baseline.layers = {}
+    for layer in range(2):
+        baseline.layers[layer] = {}
+        for name, (inputs, outputs) in dimensions.items():
+            a = (
+                torch.randn((3, inputs), dtype=torch.float64, generator=generator)
+                * 0.15
+            )
+            b = (
+                torch.randn((outputs, 3), dtype=torch.float64, generator=generator)
+                * 0.15
+            )
+            baseline.layers[layer][name] = (a, b)
+        baseline.layers[layer]["k_proj"] = (
+            baseline.layers[layer]["q_proj"][0].clone(),
+            baseline.layers[layer]["k_proj"][1],
+        )
+    baseline._install(model)
+    return model, baseline
+
+
+@pytest.mark.parametrize("options", _options)
+@torch.no_grad()
+def test_installer_preserves_weights_and_model_outputs_with_single_hooks(
+    options,
+):
+    model, baseline = _model_and_baseline()
+    base_weights = {name: weight.clone() for name, weight in model.state_dict().items()}
+    mask = torch.tensor([False, True, True, False, True])
+    baseline.arm(mask)
+    x = torch.arange(30, dtype=torch.float64).reshape(5, 6) / 31
+    reference = model(x)
+    baseline.arm(None)
+    clean_target = model(x)
+    old_handles = baseline._handles[:]
+    wrapped = lora.install_draft_cost_lora(baseline, model, **options)
+    assert wrapped is not baseline
+    assert wrapped.scale == baseline.scale
+    assert len(wrapped._handles) == len(old_handles) == 8
+    assert all(
+        handle.id not in module._forward_hooks
+        for module in model.modules()
+        for handle in old_handles
+    )
+    assert all(
+        len(module._forward_hooks) == 1
+        for module in model.modules()
+        if isinstance(module, nn.Linear)
+    )
+    wrapped.arm(mask, row_indices=mask.nonzero().flatten())
+    actual = model(x)
+    torch.testing.assert_close(actual, reference, atol=1e-12, rtol=1e-12)
+    assert torch.equal(actual[~mask], clean_target[~mask])
+    wrapped.arm(None)
+    assert torch.equal(model(x), clean_target)
+    for name, weight in model.state_dict().items():
+        assert torch.equal(weight, base_weights[name])
+    assert lora.install_draft_cost_lora(wrapped, model, **options) is wrapped
+
+
+@torch.no_grad()
+def test_flags_off_leave_original_object_hooks_outputs_and_rng_bit_identical():
+    model, baseline = _model_and_baseline()
+    factory, handles = baseline._make_hook, baseline._handles
+    mask = torch.tensor([False, True, True])
+    baseline.arm(mask)
+    x = torch.arange(18, dtype=torch.float64).reshape(3, 6) / 11
+    before = model(x)
+    state = torch.get_rng_state().clone()
+    result = lora.install_draft_cost_lora(baseline, model)
+    assert result is baseline
+    assert result._handles is handles and result._make_hook == factory
+    assert torch.equal(model(x), before)
+    assert torch.equal(torch.get_rng_state(), state)
+
