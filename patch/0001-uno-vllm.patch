+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Deterministic uniform draft noise for Uno (arXiv 2609.04010, Sec. 4.1).
+
+The draft block is ``[x_L, z_1 .. z_{B-1}]`` with ``z ~ pi^{B-1}`` and ``pi`` the
+uniform prior over ``[low, high)`` (for K2-Horizon: ``[1, mask_token_id)``). The
+noise is a stateless integer hash of (request seed, decode step, slot), so it is
+reproducible and independent of vLLM's sampling RNG: greedy Uno output stays
+token-identical to plain greedy decoding.
+"""
+
+import torch
+
+_M1 = 0x3F58476D1CE4E5B9
+_M2 = 0x14D049BB133111EB
+_MASK = (1 << 62) - 1  # keep intermediate values well inside int64
+
+
+def _mix(x: torch.Tensor) -> torch.Tensor:
+    x = ((x ^ (x >> 30)) * _M1) & _MASK
+    x = ((x ^ (x >> 27)) * _M2) & _MASK
+    return x ^ (x >> 31)
+
+
+def fill_uno_noise(
+    input_ids: torch.Tensor,
+    is_noise: torch.Tensor,
+    req_seeds: torch.Tensor,
+    step: int,
+    low: int,
+    high: int,
+) -> None:
+    """In place: ``input_ids[is_noise] <- uniform ints in [low, high)``.
+
+    ``req_seeds`` is per token (already expanded to ``input_ids.shape[0]``).
+    """
+    n = input_ids.shape[0]
+    slot = torch.arange(n, device=input_ids.device, dtype=torch.int64)
+    # Python-side terms are masked BEFORE they meet the tensor: an unmasked
+    # int(step) * constant overflows int64 after ~115 decode steps.
+    step_term = (int(step) * 0x11B54A32D192ED0) & _MASK
+    seeds = (req_seeds.to(torch.int64) * 0x1E3779B185EBCA8) & _MASK
+    h = _mix((seeds + step_term + slot) & _MASK)
+    noise = (h % (high - low)) + low
+    input_ids.copy_(torch.where(is_noise, noise.to(input_ids.dtype), input_ids))
