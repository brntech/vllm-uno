+@pytest.mark.parametrize(
+    "shared,fused,mm_count,bmm_count",
+    [
+        (False, False, 6, 0),
+        (False, True, 2, 1),
+        (True, False, 4, 0),
+        (True, True, 2, 0),
+    ],
+)
+def test_actual_gemm_count_preserves_independent_latents_without_padding(
+    monkeypatch, shared, fused, mm_count, bmm_count
+):
+    generator = torch.Generator().manual_seed(164)
+    specs, offsets = _specs(generator, dtype=torch.float64, shared=shared)
+    plan = lora._SlicePlan(specs, offsets, fuse_lora=fused, share_a=shared)
+    calls = []
+    real_mm, real_bmm = torch.mm, torch.bmm
+
+    def mm(a, b):
+        calls.append(("mm", tuple(a.shape), tuple(b.shape)))
+        return real_mm(a, b)
+
+    def bmm(a, b):
+        calls.append(("bmm", tuple(a.shape), tuple(b.shape)))
+        return real_bmm(a, b)
+
+    monkeypatch.setattr(torch, "mm", mm)
+    monkeypatch.setattr(torch, "bmm", bmm)
+    plan.compute(torch.ones((5, 6), dtype=torch.float64))
+    assert sum(kind == "mm" for kind, *_ in calls) == mm_count
+    assert sum(kind == "bmm" for kind, *_ in calls) == bmm_count
+    if fused and not shared:
+        assert plan.packed_a.shape == (9, 6)  # three distinct rank-3 latents
+        packed_bs = [matrix for _, matrix in plan.b_groups if matrix is not None]
+        assert [matrix.shape for matrix in packed_bs] == [torch.Size([2, 2, 3])]
+    if fused and shared:
+        assert plan.packed_a.shape == (3, 6)
+        assert plan.units[0].b.shape == (11, 3)
+
