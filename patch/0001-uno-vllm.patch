@@ -0,0 +1,236 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded Uno metadata caches; no model weights or sampling law are changed.
+
+Punica's exact native builder supplies each cache miss. Hits copy the resulting
+integer metadata back into the same live buffers, preserving CUDA graph
+addresses. The cache key includes adapter slots as well as the complete mapping.
+No snapshot allocation or cache copy is captured inside a CUDA graph.
+"""
+
+from collections import OrderedDict
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True)
+class QueryLayout:
+    is_noise: torch.Tensor
+    sample_indices: torch.Tensor
+    lora_map: tuple[int, ...]
+    noise_indices: torch.Tensor
+
+
+class QueryLayoutCache:
+    def __init__(self, capacity=32):
+        if capacity < 1:
+            raise ValueError("cache capacity must be positive")
+        self.capacity = capacity
+        self.entries = OrderedDict()
+        self.hits = self.misses = 0
+
+    def get(self, batch, k, lora_id, device, padded_tokens=None):
+        if batch < 1 or k < 1:
+            raise ValueError("query layout requires positive batch and K")
+        actual = batch * k
+        padded = actual if padded_tokens is None else padded_tokens
+        if padded < actual:
+            raise ValueError("padding cannot truncate actual draft rows")
+        device = torch.device(device)
+        key = (batch, k, lora_id, device, padded)
+        if key in self.entries:
+            self.hits += 1
+            self.entries.move_to_end(key)
+            return self.entries[key]
+        self.misses += 1
+        # These buffers are immutable from the callers' perspective. Never
+        # persist an allocation from the capture pool after capture completes.
+        capturing = device.type == "cuda" and torch.cuda.is_current_stream_capturing()
+        rows = torch.arange(actual, device=device, dtype=torch.int32)
+        noise_rows = rows.reshape(batch, k)[:, 1:].reshape(-1).long()
+        mask = torch.zeros(padded, dtype=torch.bool, device=device)
+        mask[noise_rows] = True
+        mapping = ((0,) + (lora_id,) * (k - 1)) * batch + (0,) * (padded - actual)
+        value = QueryLayout(mask, rows, mapping, noise_rows)
+        if not capturing:
+            self.entries[key] = value
+            if len(self.entries) > self.capacity:
+                self.entries.popitem(last=False)
+        return value
+
+
+_BASE_FIELDS = (
+    "_token_lora_indices",
+    "_sampler_indices",
+    "_sampler_indices_padded",
+    "_embeddings_indices",
+)
+_KERNEL_PREFIX = ("token_lora_mapping", "token_indices_sorted_by_lora_ids")
+_KERNEL_RESET = (
+    "active_lora_ids",
+    "num_tokens_per_lora",
+    "lora_token_start_loc",
+    "no_lora_flag_cpu",
+    "num_active_loras_cpu",
+)
+_METAS = ("token_mapping_meta", "prompt_mapping_meta")
+
+
+class PunicaMappingCache:
+    """Per-wrapper LRU of exact native integer metadata, with in-place restores.
+
+    Use restore() immediately before the native update, remember() immediately
+    after a miss. Unknown wrapper layouts take the native path without caching.
+    Kernel tails not touched by the native builder are deliberately not restored.
+    """
+
+    def __init__(self, capacity=32):
+        if capacity < 1:
+            raise ValueError("cache capacity must be positive")
+        self.capacity = capacity
+        self.entries = OrderedDict()
+        self.hits = self.misses = self.bypasses = self.invalidations = 0
+        self._fingerprint = None
+
+    def _buffers(self, wrapper):
+        for name in _BASE_FIELDS:
+            yield name, getattr(wrapper, name)
+        for owner in _METAS:
+            meta = getattr(wrapper, owner)
+            for name in (
+                *_KERNEL_PREFIX,
+                *_KERNEL_RESET,
+                "default_num_active_loras_cpu",
+            ):
+                yield (owner, name), getattr(meta, name)
+
+    def _key(self, wrapper, mapping, slots, max_loras, vocab_size):
+        try:
+            buffers = list(self._buffers(wrapper))
+            if any(not isinstance(value, torch.Tensor) for _, value in buffers):
+                return None
+            captured_counts = tuple(
+                tuple(getattr(wrapper, owner).captured_lora_counts) for owner in _METAS
+            )
+        except AttributeError:
+            return None
+        device = wrapper._token_lora_indices.device
+        if device.type == "cuda" and torch.cuda.is_current_stream_capturing():
+            return None
+        fingerprint = (
+            tuple(
+                (
+                    name,
+                    value.data_ptr(),
+                    tuple(value.shape),
+                    value.stride(),
+                    value.dtype,
+                    value.device,
+                )
+                for name, value in buffers
+            ),
+            captured_counts,
+        )
+        if self._fingerprint != fingerprint:
+            if self._fingerprint is not None:
+                self.invalidations += 1
+            self.entries.clear()
+            self._fingerprint = fingerprint
+        return (
+            tuple(mapping.index_mapping),
+            tuple(mapping.prompt_mapping),
+            mapping.is_prefill,
+            mapping.type,
+            tuple(slots),
+            max_loras,
+            vocab_size,
+        )
+
+    @staticmethod
+    def _target(wrapper, name):
+        if isinstance(name, tuple):
+            return getattr(getattr(wrapper, name[0]), name[1])
+        return getattr(wrapper, name)
+
+    def restore(self, wrapper, mapping, slots, max_loras, vocab_size):
+        key = self._key(wrapper, mapping, slots, max_loras, vocab_size)
+        if key is None:
+            self.bypasses += 1
+            return False
+        entry = self.entries.get(key)
+        if entry is None:
+            self.misses += 1
+            return False
+        self.hits += 1
+        self.entries.move_to_end(key)
+        lengths, prefill, tensors = entry
+        for name, snapshot in tensors:
+            target = self._target(wrapper, name)
+            target[: snapshot.shape[0]].copy_(snapshot, non_blocking=True)
+        wrapper.indices_len[:] = lengths
+        wrapper.is_prefill = prefill
+        return True
+
+    def remember(self, wrapper, mapping, slots, max_loras, vocab_size):
+        key = self._key(wrapper, mapping, slots, max_loras, vocab_size)
+        if key is None:
+            return
+        lengths = tuple(wrapper.indices_len)
+        tensors = [
+            (name, getattr(wrapper, name)[:length].clone())
+            for name, length in zip(_BASE_FIELDS, lengths)
+        ]
+        for owner, length in zip(_METAS, lengths[:2]):
+            meta = getattr(wrapper, owner)
+            tensors.extend(
+                ((owner, name), getattr(meta, name).clone()) for name in _KERNEL_RESET
+            )
+            # Native all-no-LoRA update resets counters/flags but leaves token
+            # buffers alone. Its flag is already CPU-resident: no device read.
+            if not bool(meta.no_lora_flag_cpu[0]):
+                tensors.extend(
+                    ((owner, name), getattr(meta, name)[:length].clone())
+                    for name in _KERNEL_PREFIX
+                )
+        self.entries[key] = (lengths, wrapper.is_prefill, tensors)
+        self.entries.move_to_end(key)
+        if len(self.entries) > self.capacity:
+            self.entries.popitem(last=False)
+
+    def stats(self):
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "bypasses": self.bypasses,
+            "invalidations": self.invalidations,
+            "entries": len(self.entries),
+        }
+
+
+def enable_mapping_cache(manager):
+    """Called once after Uno adapter installation, before profiling/capture."""
+    for wrapper in manager.punica_wrapper_mapping.values():
+        if not hasattr(wrapper, "_uno_metadata_cache"):
+            wrapper._uno_metadata_cache = PunicaMappingCache()
+
+
+def validate_draft_cost(config, lora_impl):
+    """Reject unsupported optional hook variants before loading weights."""
+    sc = config.speculative_config
+    flags = (
+        sc.uno_draft_cost_fuse_lora,
+        sc.uno_draft_cost_noise_only,
+        sc.uno_draft_cost_share_a,
+    )
+    if not any(flags):
+        return
+    if lora_impl != "hooks":
+        raise ValueError(
+            "Uno draft-cost LoRA compute flags require UNO_LORA_IMPL=hooks"
+        )
+    if not config.model_config.enforce_eager or not sc.enforce_eager:
+        raise ValueError("Uno draft-cost hook variants require eager target and draft")
+    if getattr(sc, "uno_fused", False):
+        raise ValueError("Uno draft-cost hook variants are two-pass only")
+    if config.parallel_config.tensor_parallel_size != 1:
+        raise ValueError("Uno draft-cost hook variants require tensor_parallel_size=1")
