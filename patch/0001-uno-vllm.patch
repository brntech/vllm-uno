+    harness = baseline.harness.__wrapped__(monkeypatch, request)
+    proposer = harness.proposer
+    proposer.speculative_config.uno_fused_draft_prep = True
+    proposer.speculative_config.uno_first_draft_replay = first_draft_replay
+    proposer.speculative_config.uno_seedrow_verify = seedrow
+    verify_width = 7 if seedrow else 8
+    proposer.runner.compilation_config.cudagraph_capture_sizes = [
+        batch * verify_width for batch in (1, 2, 4)
+    ]
+    proposer._draft_prep_step = torch.zeros((), dtype=torch.int64)
+    proposer.uno_noise_seed = 11
+    proposer.uno_low, proposer.uno_high = 1, 250624
+    proposer.block_size = 16
+    real_prepare = prep.prepare_uno_draft
+    allocated = {}
+    real_inputs = prep.DraftPrepInputs
+
+    def allocate_inputs(*args):
+        assert harness.state.active is None
+        result = real_inputs(*args)
+        batch = result.next_token_ids.numel()
+        capacity = (
+            max(batch * 8, proposer.runner.max_num_tokens)
+            if first_draft_replay
+            else batch * 8
+        )
+        assert result.target_positions.numel() == capacity
+        allocated[batch] = result.target_positions.data_ptr()
+        return result
+
+    def captured_prepare(*args, **kwargs):
+        if harness.state.active is not None:
+            harness.state.active.ops.append(lambda: real_prepare(*args, **kwargs))
+        real_prepare(*args, **kwargs)
+
+    monkeypatch.setattr(prep, "prepare_uno_draft", captured_prepare)
+    monkeypatch.setitem(
+        sys.modules,
+        "vllm.v1.spec_decode.uno_draft_prep",
+        types.SimpleNamespace(
+            DraftPrepInputs=allocate_inputs, prepare_uno_draft=captured_prepare
+        ),
+    )
+    graphs = baseline.dg.UnoDraftGraphRunner()
+    graphs.capture(proposer)
+    assert proposer._draft_prep_step == 0
+    layouts = [
+        (1, [48], [0]),
+        (4, None, None),
+        (2, [19, 1], [101, 70]),
+        (1, None, None),
+    ]
+    for step, (batch, widths, starts) in enumerate(layouts, 1):
+        inputs, blocks = case(
+            prep, batch, 7, widths=widths, starts=starts, rejected=widths is None
+        )
+        inputs.next_token_ids = inputs.next_token_ids.long() + step
+        ids, positions, cad = baseline.live_inputs(batch)
+        cad.block_table_tensor = blocks[:, :16].contiguous()
+        with baseline.no_host_sync():
+            actual = graphs.replay(
+                batch,
+                7,
+                ids,
+                positions,
+                cad,
+                harness.manager,
+                prep_inputs=inputs,
+                verify_width=verify_width,
+            )
+        expected = eager_oracle(
+            inputs, cad.block_table_tensor, 7, step, 11, 1, 250624, 256
+        )
+        if not first_draft_replay and widths is not None:
+            assert actual is None
+            log = harness.state.logs[-1]
+            assert "reason=prep_target_positions_capacity" in log
+            source_sizes, target_sizes = log.split(" target_sizes=", 1)
+            assert "source_sizes=" in source_sizes
+            assert (
+                f"'prep.target_positions': {(inputs.target_positions.numel(),)}"
+                in source_sizes
+            )
+            assert f"'prep.target_positions': {(batch * 8,)}" in target_sizes
+            fallback = execute(
+                prep,
+                inputs,
+                cad.block_table_tensor,
+                7,
+                proposer._draft_prep_step,
+                max_model_len=256,
+            )
+            assert all(torch.equal(got, want) for got, want in zip(fallback, expected))
+            assert proposer._draft_prep_step == step
+            continue
+        assert torch.equal(
+            actual,
+            expected[0] + expected[1] + torch.tensor([-1, 0, 0, 0, 0, 0, 0] * batch),
+        )
+        entry = graphs.entries[batch, 7, verify_width]
+        assert entry.prep_inputs.target_positions.data_ptr() == allocated[batch]
+        assert torch.equal(entry.slot_mapping, expected[2])
+        assert torch.equal(entry.seq_lens, expected[3])
+        assert proposer._draft_prep_step == step
+    inputs.target_positions = torch.zeros(
+        proposer.runner.max_num_tokens + 1, dtype=torch.int64
+    )
+    assert (
+        graphs.replay(1, 7, ids, positions, cad, harness.manager, prep_inputs=inputs)
+        is None
+    )
+    assert proposer._draft_prep_step == 4
diff --git a/tests/v1/spec_decode/test_uno_lora_overlap_proposer.py b/tests/v1/spec_decode/test_uno_lora_overlap_proposer.py
new file mode 100644
index 0000000000000000000000000000000000000000..eeb673711e2dfbb8eab7073b525f74546f514480
--- /dev/null
+++ b/tests/v1/spec_decode/test_uno_lora_overlap_proposer.py
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Run the actual proposer control flow on CPU with model/graph stand-ins."""
+
+import ast
+import importlib.util
+import os
+import sys
+import types
+from contextlib import nullcontext
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+ROOT = Path(os.environ.get("VLLM_UNO_SOURCE_ROOT", Path(__file__).resolve().parents[3]))
+SPEC = importlib.util.spec_from_file_location(
+    "uno_lora_overlap_proposer_gate", ROOT / "vllm/v1/spec_decode/uno_lora_overlap.py"
+)
+overlap = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = overlap
+SPEC.loader.exec_module(overlap)
+
+
+def actual_propose():
+    tree = ast.parse((ROOT / "vllm/v1/spec_decode/uno.py").read_text("utf-8"))
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef))
+    method = next(node for node in cls.body if getattr(node, "name", "") == "propose")
+    method.decorator_list = []
+    namespace = {
+        "torch": torch,
+        "os": os,
+        "nullcontext": nullcontext,
+        "set_forward_context": lambda *args, **kwargs: nullcontext(),
+        "_dc_profile": NS(
+            draft_k=lambda k: None,
+            execution=lambda *args: None,
+            span=lambda *args: nullcontext(),
+        ),
+    }
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            method,
+        ],
+        type_ignores=[],
+    )
+    exec(
+        compile(ast.fix_missing_locations(module), "<actual Uno propose>", "exec"),
+        namespace,
+    )
+    return namespace["propose"]
+
+
+def harness(monkeypatch, prep, enabled, graph_hit, fail=False):
+    for key in tuple(os.environ):
+        if key.startswith("UNO_DEBUG_"):
+            monkeypatch.delenv(key)
+    spec_module = types.ModuleType("vllm.v1.spec_decode")
+    spec_module.uno_fused_attn = NS(FUSED_ACTIVE=False)
+    monkeypatch.setitem(sys.modules, spec_module.__name__, spec_module)
+    calls = []
+    controller = overlap.UnoLoRAOverlap.__new__(overlap.UnoLoRAOverlap)
+    controller.fold = False
+    controller.route, controller.bind = None, lambda *args: None
+    hidden = torch.arange(12).reshape(6, 2)
+    sample_idx = torch.tensor([5, 4, 3, 2, 1, 0])
+    cad = NS(batch_size=lambda: 2, slot_mapping=torch.arange(6))
+    p = NS(
+        speculative_config=NS(
+            uno_tree=None,
+            num_speculative_tokens=3,
+            enforce_eager=True,
+            uno_fused_draft_prep=prep,
+            uno_lora_overlap=enabled,
+        ),
+        input_ids=torch.tensor([100, 201, 202, 101, 204, 205]),
+        positions=torch.arange(6),
+        device="cpu",
+        vllm_config=object(),
+        runner=NS(lora_manager=NS(_adapter_manager=object())),
+        uno_lora_id=7,
+        gated_lora=None,
+        _lora_hook=None,
+        _lora_plan_hook=None,
+        _lora_overlap=controller if enabled else None,
+        _pending_draft_prep=object(),
+        set_inputs_first_pass=lambda **kwargs: (6, sample_idx, cad),
+        _replay_draft_graph=lambda *args: hidden if graph_hit else None,
+        _prepare_pending_draft_inputs=lambda *args: calls.append("prepare"),
+        build_per_group_and_layer_attn_metadata=lambda cad: ([], {}),
+        _determine_batch_execution_and_padding=lambda n, **kw: ("NONE", n, None),
+        _get_positions=lambda n: torch.arange(n),
+        _install_draft_lora=lambda *args: None,
+        _get_slot_mapping=lambda n, slots: slots,
+        _sample_draft_sparse=lambda *args: None,
+        _maybe_dump=lambda out: None,
+    )
+
+    def model(**kwargs):
+        assert (controller.route is not None) == enabled
+        assert torch.equal(kwargs["input_ids"], p.input_ids)
+        calls.append("model")
+        if fail:
+            raise RuntimeError("model failed")
+        return hidden
+
+    def sample(selected, metadata):
+        assert controller.route is None, "sampler must not inherit draft LoRA routing"
+        torch.testing.assert_close(selected, hidden if prep else hidden[sample_idx])
+        calls.append("sample")
+        return torch.arange(900, 906), None
+
+    p.model, p._sample_draft_tokens = model, sample
+    return p, cad, calls, controller
+
+
+@pytest.mark.parametrize(
+    "prep,enabled", [(False, False), (True, False), (False, True), (True, True)]
+)
+@pytest.mark.parametrize("graph_hit", [False, True])
+def test_propose_prepares_once_and_samples_model_output_outside_overlap(
+    monkeypatch,
+    prep,
+    enabled,
+    graph_hit,
+):
+    p, cad, calls, controller = harness(monkeypatch, prep, enabled, graph_hit)
+    output = actual_propose()(p, 3, None, None, None, None, None, cad, None)
+    assert calls == (
+        ["sample"] if graph_hit else (["prepare"] if prep else []) + ["model", "sample"]
+    )
+    assert torch.equal(output, torch.arange(900, 906).reshape(2, 3))
+    assert not torch.isin(output, p.input_ids).any()
+    assert controller.route is None and p._pending_draft_prep is None
+
+
+def test_model_exception_clears_overlap_and_pending_prep_without_sampling(monkeypatch):
+    p, cad, calls, controller = harness(monkeypatch, True, True, False, fail=True)
+    with pytest.raises(RuntimeError, match="model failed"):
+        actual_propose()(p, 3, None, None, None, None, None, cad, None)
+    assert calls == ["prepare", "model"]
+    assert controller.route is None and p._pending_draft_prep is None
