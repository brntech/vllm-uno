+@pytest.mark.parametrize("seedrow", [False, True])
+@pytest.mark.parametrize("prefix_caching", [False, True])
+@pytest.mark.parametrize("k", [1, 8, 15])
+def test_dummy_capture_and_memory_profile_keep_physical_query_totals(
+    row_metadata, dummy_accounting, seedrow, prefix_caching, k
+):
+    """Exercise actual startup partitioning for captures and full-budget profiles."""
+    run, warnings = dummy_accounting
+    runner = accounting_runner(row_metadata, k, seedrow, prefix_caching)
+    width = runner.vllm_config.verify_row_layout.verify_width
+    cfg = runner.vllm_config
+    cfg.scheduler_config = runner.scheduler_config
+    cfg.compilation_config = SimpleNamespace(
+        cudagraph_capture_sizes=[width, 8 * width, 32 * width, 64 * width],
+    )
+    modes = SimpleNamespace(NONE="none", FULL="full", PIECEWISE="piecewise")
+    mode = SimpleNamespace(
+        mixed_mode=lambda: modes.NONE,
+        decode_mode=lambda: modes.FULL,
+        separate_routine=lambda: True,
+        has_mode=lambda value: value == modes.FULL,
+    )
+    captures = []
+    dispatcher = SimpleNamespace(
+        vllm_config=cfg,
+        compilation_config=cfg.compilation_config,
+        uniform_decode_query_len=width,
+        _compute_bs_to_padded_graph_size=lambda: None,
+        _bs_to_padded_graph_size=list(range(64 * width + 1)),
+        _get_lora_cases=lambda: [0],
+        add_cudagraph_key=lambda mode, desc: captures.append(desc),
+    )
+    descriptor = config_method(
+        "vllm/v1/cudagraph_dispatcher.py",
+        "_create_padded_batch_descriptor",
+        CUDAGraphMode=modes,
+        BatchDescriptor=SimpleNamespace,
+    )
+    dispatcher._create_padded_batch_descriptor = lambda *args: descriptor(
+        dispatcher, *args
+    )
+    from itertools import product
+
+    initialize = config_method(
+        "vllm/v1/cudagraph_dispatcher.py",
+        "initialize_cudagraph_keys",
+        CUDAGraphMode=modes,
+        product=product,
+    )
+    initialize(dispatcher, mode)
+    assert [desc.num_reqs for desc in captures] == [1, 8, 32]
+    for desc in captures:
+        rows, max_query_len, uniform = run(
+            runner,
+            desc.num_tokens,
+            uniform_decode=desc.uniform,
+            is_graph_capturing=True,
+        )
+        assert rows == [width] * desc.num_reqs
+        assert sum(rows) == desc.num_tokens
+        assert max_query_len == width and uniform
+    rows, _, uniform = run(runner, 8192, is_profile=True)
+    assert len(rows) == 32 and sum(rows) == 8192 and not uniform
+    assert warnings == []
+
