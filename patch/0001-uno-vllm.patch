+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU equivalence gates against the actual original UnoGatedLoRA hooks."""
+
+import ast
+import importlib.util
+import itertools
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+import torch.nn as nn
+
+_root = Path(__file__).resolve().parents[3]
+_path = _root / "vllm/v1/spec_decode/uno_draft_cost_lora.py"
+_spec = importlib.util.spec_from_file_location("uno_draft_cost_lora_gate", _path)
+lora = importlib.util.module_from_spec(_spec)
+sys.modules[_spec.name] = lora
+_spec.loader.exec_module(lora)
+
+
+def _baseline_class():
+    source = (_root / "vllm/v1/spec_decode/uno_gated_lora.py").read_text(
+        encoding="utf-8"
+    )
+    klass = next(
+        node
+        for node in ast.parse(source).body
+        if isinstance(node, ast.ClassDef) and node.name == "UnoGatedLoRA"
+    )
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            klass,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "torch": torch,
+        "nn": nn,
+        "_ATTN": ("q_proj", "k_proj", "v_proj"),
+        "_MLP": ("gate_proj", "up_proj"),
+    }
+    exec(compile(module, "<actual baseline UnoGatedLoRA>", "exec"), namespace)
+    return namespace["UnoGatedLoRA"]
+
+
+Baseline = _baseline_class()
+_options = [
+    dict(zip(("fuse_lora", "noise_only", "share_a"), values))
+    for values in itertools.product((False, True), repeat=3)
+    if any(values)
+]
+
+
+@pytest.fixture(scope="module", autouse=True)
+def small_cpu_thread_pool():
+    old = torch.get_num_threads()
+    torch.set_num_threads(min(4, old))
+    yield
+    torch.set_num_threads(old)
+
+
+def _bare_baseline(scale=0.7):
+    instance = Baseline.__new__(Baseline)
+    instance.scale = scale
+    instance.row_mask = None
+    instance._handles = []
+    return instance
+
+
+def _specs(
+    generator, *, dtype, shared=False, ranks=(3, 3, 3), widths=(7, 2, 2), inputs=6
+):
+    pairs = []
+    for rank, output in zip(ranks, widths):
+        a = (
+            torch.randn((rank, inputs), dtype=torch.float64, generator=generator).to(
+                dtype
+            )
+            * 0.3
+        )
+        if shared and pairs and rank == pairs[0][0].shape[0]:
+            a = pairs[0][0].clone()
+        b = (
+            torch.randn((output, rank), dtype=torch.float64, generator=generator).to(
+                dtype
+            )
+            * 0.3
+        )
+        pairs.append((a, b))
+    offsets = [1]  # preserve output columns on both sides of adapted region
+    for width in widths:
+        offsets.append(offsets[-1] + width)
+    return pairs, offsets
+
+
+@pytest.mark.parametrize("options", _options)
+@pytest.mark.parametrize("dtype", [torch.float64, torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("shared", [False, True])
+def test_every_option_matches_actual_hook_for_mixed_noise_rows(options, dtype, shared):
+    generator = torch.Generator().manual_seed(812)
+    specs, offsets = _specs(generator, dtype=dtype, shared=shared)
+    x = torch.randn((9, 6), dtype=torch.float64, generator=generator).to(dtype)
+    mask = torch.tensor([False, True, True, False, False, True, False, True, True])
+    x[~mask] = float("nan")  # clean activations must not enter adapter GEMMs
+    original_y = torch.randn(
+        (9, offsets[-1] + 2), dtype=torch.float64, generator=generator
+    ).to(dtype)
+    baseline = _bare_baseline()
+    reference_hook = baseline._make_hook(specs, offsets)
+    baseline.arm(mask)
+    reference = original_y.clone()
+    auxiliary = object()
+    assert reference_hook(None, (x,), (reference, auxiliary)) is None
+    wrapper = lora.DraftCostLoRA(_bare_baseline(), **options)
+    hook = wrapper._make_hook(specs, offsets)
+    wrapper.arm(mask, row_indices=mask.nonzero().flatten())
+    actual = original_y.clone()
+    assert hook(None, (x,), (actual, auxiliary)) is None
+    tolerance = {
+        torch.float64: (1e-12, 1e-12),
+        torch.float32: (2e-6, 2e-6),
+        torch.bfloat16: (0.03, 0.03),
+    }[dtype]
+    torch.testing.assert_close(actual, reference, rtol=tolerance[0], atol=tolerance[1])
+    assert torch.equal(actual[~mask], original_y[~mask])
+    assert torch.equal(actual[:, :1], original_y[:, :1])
+    assert torch.equal(actual[:, offsets[-1] :], original_y[:, offsets[-1] :])
+    assert torch.isfinite(actual).all()
+
+
+@pytest.mark.parametrize("options", _options)
+def test_variable_ranks_and_unequal_output_slices_remain_independent(options):
+    generator = torch.Generator().manual_seed(521)
+    specs, offsets = _specs(
+        generator, dtype=torch.float64, ranks=(2, 3, 4), widths=(7, 2, 5)
+    )
+    x = torch.randn((7, 6), dtype=torch.float64, generator=generator)
+    mask = torch.tensor([True, False, True, False, True, False, True])
+    y = torch.randn((7, offsets[-1]), dtype=torch.float64, generator=generator)
+    baseline = _bare_baseline()
+    baseline.arm(mask)
+    reference = y.clone()
+    baseline._make_hook(specs, offsets)(None, (x,), reference)
+    optimized = lora.DraftCostLoRA(_bare_baseline(), **options)
+    hook = optimized._make_hook(specs, offsets)
+    optimized.arm(mask)
+    actual = y.clone()
+    hook(None, (x,), actual)
+    torch.testing.assert_close(actual, reference, atol=1e-12, rtol=1e-12)
+
+
+@pytest.mark.parametrize(
+    "input_dtype,output_dtype",
+    [(torch.float32, torch.bfloat16), (torch.bfloat16, torch.float32)],
+)
+def test_noise_selection_preserves_promoted_addition_for_mixed_output_dtype(
+    input_dtype, output_dtype
+):
+    generator = torch.Generator().manual_seed(985)
+    specs, offsets = _specs(generator, dtype=input_dtype)
+    x = torch.randn((7, 6), generator=generator).to(input_dtype)
+    mask = torch.tensor([True, False, False, True, True, True, False])
+    y = torch.randn((7, offsets[-1]), generator=generator).to(output_dtype)
+    baseline = _bare_baseline()
+    baseline.arm(mask)
+    reference = y.clone()
+    baseline._make_hook(specs, offsets)(None, (x,), reference)
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=False, noise_only=True, share_a=False
+    )
+    hook = wrapper._make_hook(specs, offsets)
+    wrapper.arm(mask, row_indices=mask.nonzero().flatten())
+    actual = y.clone()
+    hook(None, (x,), actual)
+    assert torch.equal(actual, reference)
+
