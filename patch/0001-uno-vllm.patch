index 0000000000000000000000000000000000000000..129a67da44a05d928571499ef5562a23d7772481
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_tree.py
@@ -0,0 +1,272 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Torch-only deterministic Uno trees and exact target-distribution traversal.
+
+The diffusion marginals rank candidates; they are NOT the sampling law of a
+deterministically selected top-K token. Each ordered proposal has law delta_x.
+Its rejection test is therefore residual[x], and rejection removes x from the
+residual. Sampling the target once and finding its matching child is exactly the
+same output law. Using target[x] / marginal[x] here would be biased.
+
+V counts nonempty speculative prefixes, excluding the already committed root.
+This differs by one row from IFM's tree_verify_size, which includes that root.
+No vLLM, Triton, CUDA, or scipy imports are needed to exercise this module.
+"""
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor
+
+
+@dataclass(frozen=True)
+class UnoTree:
+    tokens: Tensor  # [batch, nodes], int64
+    parents: Tensor  # -1 denotes the implicit root; otherwise a node index
+    depths: Tensor  # one-based speculative depth
+    draft_probs: Tensor  # original diffusion marginal; ranking metadata only
+    scores: Tensor  # cumulative log probability of the prefix
+    max_depth: int  # configured B, even if pruning produces shallower trees
+
+
+@dataclass(frozen=True)
+class TreeSample:
+    tokens: Tensor  # [batch, B+1], -1 after the bonus/recovery token
+    accepted_nodes: Tensor  # [batch, B], zero-based tree indices, -1 padding
+    lengths: Tensor  # number of emitted tokens, including bonus/recovery
+    num_accepted: Tensor  # number of cached speculative nodes
+
+
+def _check_probabilities(probs: Tensor) -> None:
+    if not probs.is_floating_point():
+        raise ValueError("probabilities must be floating point")
+    if not bool(torch.isfinite(probs).all()) or bool((probs < 0).any()):
+        raise ValueError("probabilities must be finite and nonnegative")
+    sums = probs.sum(dim=-1)
+    if not torch.allclose(sums, torch.ones_like(sums), atol=1e-5, rtol=1e-4):
+        raise ValueError("each probability row must sum to one")
+
+
+def _stable_topk(probs: Tensor, k: int) -> tuple[Tensor, Tensor]:
+    """Descending probability, then ascending token ID, including cutoff ties.
+
+    Avoid a full vocabulary sort: select the cutoff with topk, resolve its tied
+    membership with a linear scan, and sort only the resulting k candidates.
+    """
+    cutoff = torch.topk(probs, k, dim=-1, sorted=False).values.amin(
+        dim=-1, keepdim=True
+    )
+    above = probs > cutoff
+    equal = probs == cutoff
+    remaining = k - above.sum(dim=-1, keepdim=True)
+    selected = above | (equal & (equal.cumsum(dim=-1) <= remaining))
+    vocab = probs.shape[-1]
+    ids = torch.arange(vocab, device=probs.device).expand_as(probs)
+    ids = torch.topk(
+        ids.masked_fill(~selected, vocab), k, dim=-1, largest=False, sorted=True
+    ).values
+    values = probs.gather(-1, ids)
+    order = torch.argsort(values, dim=-1, descending=True, stable=True)
+    return values.gather(-1, order), ids.gather(-1, order)
+
+
+def build_tree(probs: Tensor, K: int, V: int, *, validate: bool = True) -> UnoTree:
+    """Select the global V best nonempty prefixes of independent marginals.
+
+    probs is [batch, B, vocabulary]. K is clamped to vocabulary size. Ties use
+    shallower depth first, then the stable parent-beam order and candidate rank.
+    Parents always precede children. Zero-mass candidates may fill a large budget.
+
+    At each depth we retain at most V prefixes. Because all prefixes at a given
+    depth have identical available suffix distributions, a discarded prefix cannot
+    contribute a top-V descendant. Finally we select globally across depths. Scores
+    never increase down an edge, so depth-first tie resolution guarantees closure.
+    Only the B depth loop is Python; all requests, nodes and tokens are tensorized.
+
+    Set validate=False only for already checked model probabilities on the hot path
+    to avoid device-to-host synchronization from numerical validation.
+    """
+    if probs.ndim != 3 or min(probs.shape) < 1:
+        raise ValueError("probs must have nonempty shape [batch, B, vocabulary]")
+    if isinstance(K, bool) or not isinstance(K, int) or K < 1:
+        raise ValueError("K must be a positive integer")
+    if isinstance(V, bool) or not isinstance(V, int) or V < 1:
+        raise ValueError("V must be a positive integer")
+    if validate:
+        _check_probabilities(probs)
+    batch, depth_limit, vocab = probs.shape
+    k = min(K, vocab)
+    working = probs if probs.dtype == torch.float64 else probs.float()
+    top_probs, top_tokens = _stable_topk(working, k)
+    top_logs = top_probs.log()
+    device = probs.device
+    previous_scores = torch.zeros((batch, 1), dtype=working.dtype, device=device)
+    all_tokens, all_parents, all_depths, all_probs, all_scores = [], [], [], [], []
+    previous_offset, total = 0, 0
+    for depth in range(depth_limit):
+        expanded = previous_scores.unsqueeze(-1) + top_logs[:, depth, None, :]
+        expanded = expanded.flatten(1)
+        count = min(V, expanded.shape[1])
+        chosen = torch.argsort(expanded, dim=1, descending=True, stable=True)
+        chosen = chosen[:, :count]
+        previous_scores = expanded.gather(1, chosen)
+        ranks, local_parents = chosen % k, chosen // k
+        parent = local_parents + previous_offset
+        if depth == 0:
+            parent = torch.full_like(parent, -1)
+        all_tokens.append(top_tokens[:, depth].gather(1, ranks))
+        all_probs.append(top_probs[:, depth].gather(1, ranks))
+        all_parents.append(parent)
+        all_depths.append(torch.full_like(parent, depth + 1))
+        all_scores.append(previous_scores)
+        previous_offset = total
+        total += count
+    scores = torch.cat(all_scores, dim=1)
+    count = min(V, total)
+    selected = torch.argsort(scores, dim=1, descending=True, stable=True)[:, :count]
+    inverse = torch.full((batch, total), -1, dtype=torch.long, device=device)
+    inverse.scatter_(1, selected, torch.arange(count, device=device).expand(batch, -1))
+    parent = torch.cat(all_parents, dim=1).gather(1, selected)
+    remapped = inverse.gather(1, parent.clamp_min(0))
+    parent = torch.where(parent < 0, -1, remapped)
+    return UnoTree(
+        tokens=torch.cat(all_tokens, dim=1).gather(1, selected),
+        parents=parent,
+        depths=torch.cat(all_depths, dim=1).gather(1, selected),
+        draft_probs=torch.cat(all_probs, dim=1).gather(1, selected),
+        scores=scores.gather(1, selected),
+        max_depth=depth_limit,
+    )
+
+
+def tree_attention_mask(parents: Tensor, *, validate: bool = True) -> Tensor:
+    """[batch,N+1,N+1] visibility: implicit root, self, and ancestors only."""
+    if parents.ndim != 2:
+        raise ValueError("parents must have shape [batch, nodes]")
+    batch, count = parents.shape
+    device = parents.device
+    ids = torch.arange(count, device=device)
+    if validate and (bool((parents < -1).any()) or bool((parents >= ids).any())):
+        raise ValueError("parents must be -1 or a strictly earlier node")
+    # Parent pointers in target-row coordinates. Root is its own parent.
+    row_parents = torch.cat(
+        (torch.zeros((batch, 1), dtype=torch.long, device=device), parents.long() + 1),
+        dim=1,
+    )
+    mask = (
+        torch.eye(count + 1, dtype=torch.bool, device=device)
+        .expand(batch, -1, -1)
+        .clone()
+    )
+    # Pointer doubling unions paths of length 1, 2, 4, ... without a node loop.
+    ancestors = row_parents
+    for _ in range(max(1, count.bit_length())):
+        mask |= mask.gather(1, ancestors.unsqueeze(-1).expand(-1, -1, count + 1))
+        ancestors = ancestors.gather(1, ancestors)
+    return mask
+
+
+def walk_tree(tree: UnoTree, target_tokens: Tensor) -> TreeSample:
+    """Follow one independent target draw per history, then append the bonus.
+
+    target_tokens[batch,0] is the draw after the committed root; row i+1 is
+    the draw after tree node i. Never choose a longest independently sampled path:
+    that would condition the output on future branch success and bias it.
+    """
+    batch, count = tree.tokens.shape
+    if target_tokens.shape != (batch, count + 1):
+        raise ValueError("target_tokens must have shape [batch, nodes+1]")
+    device = tree.tokens.device
+    root = torch.zeros((batch, 1), dtype=torch.long, device=device)
+    row_parents = torch.cat((root, tree.parents.long() + 1), dim=1)
+    matches = tree.tokens == target_tokens.gather(1, tree.parents.long() + 1)
+    reachable = torch.cat((torch.ones_like(root, dtype=torch.bool), matches), dim=1)
+    # A node is reachable iff its incoming edge AND every ancestor's edge
+    # match that parent's one fixed target draw. Root is the True identity.
+    # Pointer doubling closes paths of length 1, 2, 4, ... in O(log N)
+    # rounds, with no Python loop over draft depth or accepted tokens.
+    ancestors = row_parents
+    for _ in range(count.bit_length()):
+        reachable &= reachable.gather(1, ancestors)
+        ancestors = ancestors.gather(1, ancestors)
+    reachable = reachable[:, 1:]
+    depths = torch.arange(1, tree.max_depth + 1, device=device)
+    # Sibling token IDs are unique in the deduplicated tree. Consequently
+    # reachable nodes form ONE connected path, with at most one per depth.
+    # This never selects an independently successful descendant of a rejected
+    # branch or compares the lengths of separately sampled branch paths.
+    depth_matches = reachable[:, None, :] & (
+        tree.depths[:, None, :] == depths[None, :, None]
+    )
+    candidates = torch.where(
+        depth_matches, torch.arange(count, device=device)[None, None, :], -1
+    )
+    # The -1 sentinel also makes reduction over an empty candidate set safe.
+    sentinel = torch.full(
+        (batch, tree.max_depth, 1), -1, dtype=torch.long, device=device
+    )
+    accepted = torch.cat((candidates, sentinel), dim=-1).amax(dim=-1)
+    num_accepted = reachable.sum(dim=1)
+    lengths = num_accepted + 1
+    target_rows = torch.cat((root, accepted + 1), dim=1)
+    outputs = target_tokens.gather(1, target_rows).long()
+    outputs.masked_fill_(
+        torch.arange(tree.max_depth + 1, device=device)[None, :] >= lengths[:, None],
+        -1,
+    )
+    return TreeSample(outputs, accepted, lengths, num_accepted)
+
+
+def sample_tree(
+    tree: UnoTree,
+    target_probs: Tensor,
+    *,
+    greedy: bool = False,
+    generator: torch.Generator | None = None,
+    target_uniforms: Tensor | None = None,
+    validate: bool = True,
+) -> TreeSample:
+    """Exact deterministic-proposal verification, implemented by target draws.
+
+    target_probs has [batch, nodes+1, vocabulary] with all desired target sampling
+    transforms already applied. Each node requires its own independent draw. A
+    supplied target_uniforms tensor has [batch,nodes+1] and entries in [0,1).
+    Greedy ignores uniforms and follows the longest exactly matching branch.
+    """
+    batch, count = tree.tokens.shape
+    if target_probs.ndim != 3 or target_probs.shape[:2] != (batch, count + 1):
+        raise ValueError("target_probs must have shape [batch, nodes+1, vocabulary]")
+    if validate:
+        _check_probabilities(target_probs)
+    if greedy:
+        draws = target_probs.argmax(dim=-1)
+    elif target_uniforms is not None:
+        if target_uniforms.shape != (batch, count + 1):
+            raise ValueError("target_uniforms must have shape [batch, nodes+1]")
+        if validate and (
+            not bool(torch.isfinite(target_uniforms).all())
+            or bool(((target_uniforms < 0) | (target_uniforms >= 1)).any())
+        ):
+            raise ValueError("target uniforms must be finite in [0,1)")
+        cdf = target_probs.cumsum(dim=-1)
+        # Avoid the last-bin roundoff gap, preserving earlier bin boundaries.
+        cdf[..., -1] = 1
+        draws = (target_uniforms.unsqueeze(-1) >= cdf).sum(dim=-1)
+    else:
+        draws = torch.multinomial(
+            target_probs.reshape(-1, target_probs.shape[-1]), 1, generator=generator
+        ).reshape(batch, count + 1)
+    return walk_tree(tree, draws)
+
+
+def accepted_target_rows(sample: TreeSample) -> Tensor:
+    """Target-row indices to retain in order: root, then accepted tree nodes.
+
+    The final emitted bonus/recovery token has no computed KV yet. Callers must
+    gather all source KV before scattering: source and destination may overlap.
+    """
+    root = torch.zeros(
+        (sample.tokens.shape[0], 1), dtype=torch.long, device=sample.tokens.device
+    )
+    nodes = torch.where(sample.accepted_nodes >= 0, sample.accepted_nodes + 1, -1)
+    return torch.cat((root, nodes), dim=1)
