+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import torch
+
+from vllm.v1.spec_decode.uno_fused_mask import (
+    fused_layout,
+    fused_mask_batch,
+    fused_mask_for_request,
+    group_rows,
+)
+
+
+def test_layout_k4():
+    q, first_noise = fused_layout(4)
+    assert q == 1 + 4 + 5 * 4 == 25 and first_noise == 5
+
+
+def test_verify_rows_are_causal_over_prefix_and_themselves():
+    p, k = 3, 2
+    m = fused_mask_for_request(p, k)
+    assert m.shape == (1 + k + (k + 1) * k, p + 1 + k + (k + 1) * k)
+    assert m[:, :p].all()                              # prefix visible to everyone
+    for r in range(1 + k):
+        assert m[r, p : p + r + 1].all()
+        assert not m[r, p + r + 1 :].any()             # nothing after itself
+
+
+def test_noise_group_sees_only_its_prefix_and_itself():
+    p, k = 2, 3
+    m = fused_mask_for_request(p, k)
+    for j in range(k + 1):
+        s, e = group_rows(k, j)
+        for i, r in enumerate(range(s, e)):
+            row = m[r]
+            assert row[p : p + j + 1].all()            # bonus + d_1..d_j
+            if j < k:
+                assert not row[p + j + 1 : p + 1 + k].any()   # never d_{j+1}..d_K
+            assert row[p + s : p + s + i + 1].all()    # own group up to itself
+            assert not row[p + s + i + 1 : p + e].any()      # not later rows of own group
+            for jj in range(k + 1):                    # never another group
+                if jj != j:
+                    s2, e2 = group_rows(k, jj)
+                    assert not row[p + s2 : p + e2].any()
+
+
+def test_batch_concatenation_is_request_major_row_major():
+    k = 2
+    a, b = fused_mask_for_request(1, k), fused_mask_for_request(4, k)
+    flat = fused_mask_batch([1, 4], k)
+    assert flat.numel() == a.numel() + b.numel()
+    assert torch.equal(flat[: a.numel()], a.reshape(-1))
+    assert torch.equal(flat[a.numel() :], b.reshape(-1))
