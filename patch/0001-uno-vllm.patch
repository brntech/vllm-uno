index 0000000000000000000000000000000000000000..f1bfffaa0891d1c70f5043e800a37afb4e0ba360
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_fused_mask.py
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Attention mask for the fused single-pass Uno block (paper Sec. 6, "quadratic samplers").
+
+Per decode request the fused query block is, in order:
+    row 0          bonus token b               position p
+    rows 1..K      drafts d_1..d_K             positions p+1..p+K
+    group j=0..K   noise z^j_1..z^j_K          positions p+j+1..p+j+K
+Total Q = 1 + K + (K+1)*K rows. Keys/values of the request are [prefix (p tokens)] + the Q new rows,
+written in that order, so kv index of new row r is p + r.
+
+Visibility (block-causal, matching the adapter's training mask):
+  * rows 0..K: causal over prefix and rows 0..self.
+  * noise group j, row i: the prefix, rows 0..j (bonus + d_1..d_j), and rows z^j_1..z^j_{i-1} of its own
+    group (plus itself). Never other groups, never d_{j+1}.. .
+"""
+
+import torch
+
+
+def fused_layout(k: int, groups: int | None = None) -> tuple[int, int]:
+    """(rows per request, index of the first noise row). `groups` = number of carried noise groups
+    (default K+1 = one per possible accepted count; the hybrid sampler carries fewer)."""
+    g = k + 1 if groups is None else groups
+    return 1 + k + g * k, 1 + k
+
+
+def fused_mask_for_request(p: int, k: int, device=None, groups=None) -> torch.Tensor:
+    """Boolean mask [Q, p + Q] for one request with prefix length p. `groups` lists the accepted counts j
+    the carried noise groups stand for, in block order (default (0, 1, ..., K))."""
+    js = tuple(range(k + 1)) if groups is None else tuple(groups)
+    q, first_noise = fused_layout(k, len(js))
+    kv = p + q
+    m = torch.zeros((q, kv), dtype=torch.bool, device=device)
+    m[:, :p] = True  # everyone sees the real prefix
+    # verify rows: causal over the new rows 0..K
+    for r in range(first_noise):
+        m[r, p : p + r + 1] = True
+    # noise groups: group g stands for j = js[g]
+    for g, j in enumerate(js):
+        base = first_noise + g * k
+        for i in range(k):
+            r = base + i
+            m[r, p : p + j + 1] = True                 # bonus + d_1..d_j
+            m[r, p + base : p + base + i + 1] = True   # own group's earlier rows + itself
+    return m
+
+
+def fused_mask_batch(prefix_lens: list[int], k: int, device=None) -> torch.Tensor:
+    """FlashInfer `custom_mask` layout: request-major concatenation of row-major [Q_r, KV_r] masks."""
+    parts = [fused_mask_for_request(p, k, device).reshape(-1) for p in prefix_lens]
+    return torch.cat(parts) if parts else torch.zeros(0, dtype=torch.bool, device=device)
+
+
+def group_rows(k: int, g: int) -> tuple[int, int]:
+    """Row range [start, end) of carried noise group index g inside the fused block."""
+    _, first_noise = fused_layout(k)
+    s = first_noise + g * k
+    return s, s + k
diff --git a/vllm/v1/spec_decode/uno_gated_lora.py b/vllm/v1/spec_decode/uno_gated_lora.py
new file mode 100644
index 0000000000000000000000000000000000000000..35c4369dfce1dd63207e911663fe12eba82af117
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_gated_lora.py
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Gated LoRA applied by forward hooks on the target model's linear layers.
+
+Uno's diffusion weights are a PEFT LoRA (rank 128) on q/k/v/o/gate/up/down that must act only on
+the noise rows of the draft block (paper Sec. 3.2, "gated LoRA"). This module applies
+``y[rows] += ((x[rows] @ A^T) @ B^T) * alpha/r`` on the flagged rows via forward hooks on vLLM's
+fused linear modules (``qkv_proj``, ``gate_up_proj`` slices; ``o_proj``, ``down_proj`` whole),
+exactly like IFM's reference engine, and is a no-op whenever no row mask is armed (target pass).
+It needs no ``--enable-lora`` and no LoRA slots.
+"""
+
+import json
+import os
+
+import torch
+import torch.nn as nn
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_ATTN = ("q_proj", "k_proj", "v_proj")
+_MLP = ("gate_proj", "up_proj")
+
+
+class UnoGatedLoRA:
+    def __init__(self, adapter_path: str, model: nn.Module, device: torch.device, dtype: torch.dtype):
+        from safetensors.torch import load_file
+
+        cfg = json.load(open(os.path.join(adapter_path, "adapter_config.json")))
+        self.scale = float(cfg["lora_alpha"]) / float(cfg["r"])
+        raw = load_file(os.path.join(adapter_path, "adapter_model.safetensors"))
+        # group tensors by layer index and projection name
+        self.layers: dict[int, dict[str, tuple[torch.Tensor, torch.Tensor]]] = {}
+        for k, v in raw.items():
+            if not k.endswith(".lora_A.weight"):
+                continue
+            prefix = k[: -len(".lora_A.weight")]          # model.layers.N.<scope>.<proj>
+            parts = prefix.split(".")
+            layer, proj = int(parts[2]), parts[4]
+            A = v.to(device=device, dtype=dtype)
+            B = raw[prefix + ".lora_B.weight"].to(device=device, dtype=dtype)
+            self.layers.setdefault(layer, {})[proj] = (A, B)
+        self.row_mask: torch.Tensor | None = None   # bool [num_tokens]; None => disabled
+        self._handles = []
+        self._install(model)
+        logger.info("UnoGatedLoRA: %d layers, scale %.1f, hooks on qkv/o/gate_up/down", len(self.layers), self.scale)
+
+    # ---- hooks -----------------------------------------------------------------------------
+    def _install(self, model: nn.Module) -> None:
+        n = 0
+        for name, mod in model.named_modules():
+            parts = name.split(".")
+            if "layers" not in parts:
+                continue
+            try:
+                layer = int(parts[parts.index("layers") + 1])
+            except (ValueError, IndexError):
+                continue
+            leaf = parts[-1]
+            if layer not in self.layers:
+                continue
+            L = self.layers[layer]
+            if leaf == "qkv_proj":
+                specs = [(L[p][0], L[p][1]) for p in _ATTN if p in L]
+                sizes = [B.shape[0] for _, B in specs]
+            elif leaf == "gate_up_proj":
+                specs = [(L[p][0], L[p][1]) for p in _MLP if p in L]
+                sizes = [B.shape[0] for _, B in specs]
+            elif leaf in ("o_proj", "down_proj") and leaf in L:
+                specs, sizes = [L[leaf]], [L[leaf][1].shape[0]]
+            else:
+                continue
+            offs = [0]
+            for s in sizes:
+                offs.append(offs[-1] + s)
+            self._handles.append(mod.register_forward_hook(self._make_hook(specs, offs)))
+            n += 1
+        assert n == 4 * len(self.layers), f"hooked {n} modules, expected {4 * len(self.layers)}"
+
+    def _make_hook(self, specs, offs):
+        scale = self.scale
+
+        def hook(mod, inputs, output):
+            mask = self.row_mask
+            if mask is None:
+                return None
+            x = inputs[0]
+            y = output[0] if isinstance(output, tuple) else output
+            if x.shape[0] != mask.shape[0]:
+                return None  # not the draft pass (e.g. padded dummy run)
+            xm = x[mask]
+            if xm.shape[0] == 0:
+                return None
+            for (A, B), lo, hi in zip(specs, offs[:-1], offs[1:]):
+                delta = (xm @ A.t()) @ B.t()
+                y[mask, lo:hi] += delta * scale
+            return None
+
+        return hook
+
+    def arm(self, row_mask: torch.Tensor | None) -> None:
+        self.row_mask = row_mask
