+    counts = torch.bincount(result.tokens[:, 0], minlength=2)
+    _chi_square(counts, torch.tensor([0.5, 0.5]), alpha=1e-7)
+    wrong_expected = 200_000 * torch.tensor([5 / 9, 4 / 9])
+    wrong_statistic = ((counts - wrong_expected).square() / wrong_expected).sum()
+    assert wrong_statistic > 1000, "negative control must detect the biased verifier"
