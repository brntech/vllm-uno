+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import numpy as np
+
+from vllm.v1.spec_decode.uno_fused_layout import (
+    build_fused_layout,
+    expanded_logits_indices,
+    group_row_offsets,
+    noise_positions,
+)
+
+K = 4
+E = (K + 1) * K  # 20
+
+
+def _batch():
+    # req0: decode with K drafts (fused); req1: prefill chunk of 6 tokens; req2: decode with 2 drafts (not fused)
+    return np.array([K + 1, 6, 3], dtype=np.int32), np.array([K, 0, 2], dtype=np.int32)
+
+
+def test_layout_expands_only_fused_requests():
+    nst, ndt = _batch()
+    L = build_fused_layout(nst, ndt, K)
+    assert L.fused.tolist() == [True, False, False]
+    assert L.expanded_query_start_loc.tolist() == [0, K + 1 + E, K + 1 + E + 6, K + 1 + E + 6 + 3]
+    assert L.num_expanded_tokens == K + 1 + E + 6 + 3
+    # copied rows point at compact rows; noise rows do not
+    assert L.src_row[: K + 1].tolist() == list(range(K + 1))
+    assert (L.src_row[K + 1 : K + 1 + E] == -1).all()
+    assert L.src_row[K + 1 + E : K + 1 + E + 6].tolist() == list(range(K + 1, K + 1 + 6))
+    assert L.noise_group[K + 1 : K + 1 + E].tolist() == [j for j in range(K + 1) for _ in range(K)]
+    assert L.noise_index[K + 1 : K + 1 + E].tolist() == [i for _ in range(K + 1) for i in range(K)]
+
+
+def test_noise_positions_follow_group_then_index():
+    nst, ndt = _batch()
+    L = build_fused_layout(nst, ndt, K)
+    pos = noise_positions(L, bonus_positions=np.array([100, 0, 0]))
+    want = [100 + j + 1 + i for j in range(K + 1) for i in range(K)]
+    assert pos[K + 1 : K + 1 + E].tolist() == want
+    assert (pos[: K + 1] == -1).all() and (pos[K + 1 + E :] == -1).all()
+
+
+def test_logits_indices_skip_noise_rows():
+    nst, ndt = _batch()
+    L = build_fused_layout(nst, ndt, K)
+    num_sampled = np.array([K + 1, 1, 3])
+    idx = expanded_logits_indices(L, num_sampled)
+    s1 = K + 1 + E                      # request 1 starts after fused request 0
+    s2 = s1 + 6
+    assert idx.tolist() == list(range(0, K + 1)) + [s1 + 5] + list(range(s2, s2 + 3))
+
+
+def test_group_offsets_select_the_accepted_prefix_group():
+    nst, ndt = _batch()
+    L = build_fused_layout(nst, ndt, K)
+    off = group_row_offsets(L, num_accepted=np.array([2, 0, 0]))
+    assert off.tolist() == [K + 1 + 2 * K, -1, -1]
