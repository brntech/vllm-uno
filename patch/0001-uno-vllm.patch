+@torch.no_grad()
+def test_failed_installation_rolls_back_without_removing_baseline_hooks(monkeypatch):
+    model, baseline = _model_and_baseline()
+    baseline.arm(torch.tensor([False, True, True]))
+    x = torch.ones((3, 6), dtype=torch.float64)
+    before = model(x)
+    old_install, old_handles = baseline._install, baseline._handles
+
+    def fail_after_install(model):
+        old_install(model)
+        raise ValueError("intentional late install failure")
+
+    monkeypatch.setattr(baseline, "_install", fail_after_install)
+    with pytest.raises(ValueError, match="intentional"):
+        lora.install_draft_cost_lora(baseline, model, fuse_lora=True)
+    assert baseline._handles is old_handles
+    assert torch.equal(model(x), before)
+    assert all(
+        len(module._forward_hooks) == 1
+        for module in model.modules()
+        if isinstance(module, nn.Linear)
+    )
+
+
+def test_mutable_training_adapter_is_rejected_instead_of_caching_stale_weights():
+    a = torch.ones((2, 3), requires_grad=True)
+    with pytest.raises(ValueError, match="frozen"):
+        lora._SlicePlan([(a, torch.ones((4, 2)))], [0, 4], fuse_lora=True, share_a=True)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        dict(row_mask=torch.ones((2, 2), dtype=torch.bool)),
+        dict(row_mask=torch.ones(2)),
+        dict(row_mask=None, row_indices=torch.tensor([0])),
+        dict(
+            row_mask=torch.ones(2, dtype=torch.bool),
+            row_indices=torch.tensor([0], dtype=torch.int32),
+        ),
+    ],
+)
+def test_bad_selection_metadata_fails_before_arming(kwargs):
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=False, noise_only=True, share_a=False
+    )
+    with pytest.raises(ValueError):
+        wrapper.arm(**kwargs)
+    assert wrapper.row_mask is None
