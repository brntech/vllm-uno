+def test_200k_sequential_delta_residual_reference():
+    generator = torch.Generator().manual_seed(591)
+    p = torch.arange(1, 21, dtype=torch.float64)
+    p /= p.sum()
+    n = 200_000
+    children = [19, 4, 11, 1, 18]
+    residual = p.clone()
+    output = torch.full((n,), -1, dtype=torch.long)
+    for child in children:
+        accepted = (output < 0) & (torch.rand(n, generator=generator) < residual[child])
+        output[accepted] = child
+        residual[child] = 0
+        residual /= residual.sum()
+    recovery = torch.multinomial(residual, n, replacement=True, generator=generator)
+    output = torch.where(output < 0, recovery, output)
+    _chi_square(torch.bincount(output, minlength=20), p, alpha=1e-7)
+
