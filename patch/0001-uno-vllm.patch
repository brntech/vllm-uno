index 0000000000000000000000000000000000000000..1a52656ef0e135855cc90f81279172ef2f10512e
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_fused_attn.py
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Split attention for a fused Uno step on FlashAttention-2 (graph-capturable, no per-step plan).
+
+A fused step is a UNIFORM batch: every request carries Q = 1 + K + (K+1)*K query rows. Every row attends to
+the whole real prefix (p tokens, unmasked); inside the Q new rows the mask is block-causal
+(`uno_fused_mask.fused_mask_for_request`). So:
+    out = merge( FA2(q, prefix KV, causal=False, seqused_k = seq_len - Q),   # kernel, captured in the graph
+                 block_attention(q, k_new, v_new, mask[Q, Q]) )              # tiny torch ops, also captured
+with log-sum-exp merging (`vllm.v1.attention.ops.merge_attn_states`). This keeps the step on the FULL CUDA
+graph path (FlashInfer's custom-mask prefill wrapper needs a per-step plan and runs piecewise).
+"""
+
+import torch
+
+from vllm.v1.spec_decode.uno_fused_mask import fused_mask_for_request
+
+_MASK_CACHE: dict = {}
+# Set by UnoProposer at construction (before CUDA-graph capture): rows per fused request and K. 0 = off.
+FUSED_Q: int = 0
+FUSED_K: int = 0
+# Set by the runner per step: True only while a fully fused batch (every request carries the Q-row block) is
+# being executed, or while the uniform Q-row shape is being graph-captured. The FA2 split path is gated on it —
+# never on tensor shape alone (a 25-token prefill at K=4 has the fused shape).
+FUSED_ACTIVE: bool = False
+FUSED_G: int = 0          # carried groups (0 = all K+1, one static mask); >0 = hybrid, per-request masks
+MASK_BUF = None           # [max_reqs, Q, Q] static buffer read inside the captured graph
+
+
+def fused_block_mask_for(q: int, k: int, groups: tuple, device) -> torch.Tensor:
+    """[Q, Q] block mask for a carried group set, cached."""
+    key = (q, k, groups, str(device))
+    if key not in _MASK_CACHE:
+        m = fused_mask_for_request(0, k, device, groups)
+        assert m.shape == (q, q), (m.shape, q)
+        _MASK_CACHE[key] = m
+    return _MASK_CACHE[key]
+
+
+def mask_buffer(max_reqs: int, q: int, device) -> torch.Tensor:
+    global MASK_BUF
+    if MASK_BUF is None or MASK_BUF.shape[0] < max_reqs or MASK_BUF.shape[1] != q:
+        MASK_BUF = torch.ones((max(max_reqs, 8), q, q), dtype=torch.bool, device=device)
+    return MASK_BUF
+
+
+def fill_mask_buffer(groups_per_req: list, q: int, k: int, device) -> None:
+    """Write each request's block mask into MASK_BUF[:B] (runner hook, before the forward)."""
+    buf = mask_buffer(len(groups_per_req), q, device)
+    stacked = torch.stack([fused_block_mask_for(q, k, tuple(g), device) for g in groups_per_req])
+    buf[: len(groups_per_req)].copy_(stacked)
+
+
+def fused_block_mask(q: int, k: int, device) -> torch.Tensor:
+    """[Q, Q] bool block-causal mask for one request (prefix columns excluded), cached per device."""
+    key = (q, k, str(device))
+    if key not in _MASK_CACHE:
+        m = fused_mask_for_request(0, k, device)
+        assert m.shape == (q, q), (m.shape, q)
+        _MASK_CACHE[key] = m
+    return _MASK_CACHE[key]
+
+
+def block_attention(
+    query: torch.Tensor,   # [T, H, D]   T = B * Q
+    key: torch.Tensor,     # [T, HKV, D] new tokens' K (this step)
+    value: torch.Tensor,   # [T, HKV, D]
+    q: int,
+    k_drafts: int,
+    scale: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Attention of the Q new rows over the Q new rows only, block-causal. Returns (out [T, H, D] in
+    query.dtype, lse [H, T] float32) — the layout `merge_attn_states` expects."""
+    t, h, d = query.shape
+    hkv = key.shape[1]
+    b = t // q
+    g = h // hkv
+    qb = query.view(b, q, hkv, g, d).float()
+    kb = key.view(b, q, hkv, 1, d).float()
+    vb = value.view(b, q, hkv, 1, d).float()
+    # scores [b, hkv, g, q, q]
+    s = torch.einsum("bqhgd,bkhxd->bhgqk", qb, kb) * scale
+    if FUSED_G > 0:
+        mask = mask_buffer(b, q, query.device)[:b]           # [b, q, q], per request (hybrid groups)
+        s = s.masked_fill(~mask[:, None, None], float("-inf"))
+    else:
+        mask = fused_block_mask(q, k_drafts, query.device)
+        s = s.masked_fill(~mask, float("-inf"))
+    lse = torch.logsumexp(s, dim=-1)                       # [b, hkv, g, q]
+    p = torch.exp(s - lse.unsqueeze(-1))
+    o = torch.einsum("bhgqk,bkhxd->bqhgd", p, vb)          # [b, q, hkv, g, d]
+    out = o.reshape(t, h, d).to(query.dtype)
+    lse_ht = lse.permute(1, 2, 3, 0).reshape(h, q, b).permute(0, 2, 1).reshape(h, t)  # [h, t] with t = b*q
+    return out, lse_ht.contiguous()
diff --git a/vllm/v1/spec_decode/uno_fused_batch.py b/vllm/v1/spec_decode/uno_fused_batch.py
new file mode 100644
index 0000000000000000000000000000000000000000..1e4bc7f9473be7f9158f177bb87ed02ffd6f2b2f
--- /dev/null
+++ b/vllm/v1/spec_decode/uno_fused_batch.py
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Whole-batch mask + positions for the fused Uno step (scheduler-placed noise rows).
+
+Layout per fused decode request (K real drafts, E = (K+1)*K noise rows, all scheduled as speculative
+tokens by the scheduler): query rows = [bonus, d_1..d_K, z^0_1..z^0_K, ..., z^K_1..z^K_K]. Every row has
+its own KV slot in write order (kv index of new row r = p + r, p = num_computed_tokens). Non-fused
+requests (prefill chunks, partial-draft decodes) keep plain causal attention.
+"""
+
+import numpy as np
+import torch
+
+from vllm.v1.spec_decode.uno_fused_mask import fused_mask_for_request
+
+
+def fused_rows(k: int, groups: int | None = None) -> int:
+    g = k + 1 if groups is None else groups
+    return 1 + k + g * k
+
+
+_BLOCK_CACHE: dict = {}
+
+
+def _fused_block(k: int, device, groups=None) -> torch.Tensor:
+    """The q x q block-causal part of a fused request's mask (prefix-independent), cached per (K, groups)."""
+    key = (k, str(device), groups)
+    if key not in _BLOCK_CACHE:
+        q = fused_rows(k, None if groups is None else len(groups))
+        _BLOCK_CACHE[key] = fused_mask_for_request(0, k, device, groups)[:, :q].contiguous()
+    return _BLOCK_CACHE[key]
+
+
+def batch_custom_mask(
+    q_lens: np.ndarray,          # [num_reqs] scheduled query rows per request (compact layout)
+    prefix_lens: np.ndarray,     # [num_reqs] num_computed_tokens per request (kv rows before the new ones)
+    is_fused: np.ndarray,        # [num_reqs] bool
+    k: int,
+    device: torch.device,
+    groups=None,                 # per-request carried group tuples (None = all K+1 groups)
+) -> torch.Tensor:
+    """Boolean mask in FlashInfer custom_mask order: for each request, q_len x (prefix + q_len),
+    row-major, requests concatenated. Pass it UNPACKED as `custom_mask=` (FlashInfer packs per request)."""
+    parts = []
+    for r in range(len(q_lens)):
+        q, p = int(q_lens[r]), int(prefix_lens[r])
+        if is_fused[r]:
+            block = _fused_block(k, device, None if groups is None else groups[r])
+            m = torch.cat([torch.ones((block.shape[0], p), dtype=torch.bool, device=device), block], dim=1)
+            parts.append(m.reshape(-1))
+        else:
+            m = torch.zeros((q, p + q), dtype=torch.bool, device=device)
+            m[:, :p] = True
+            m[:, p:] = torch.tril(torch.ones((q, q), dtype=torch.bool, device=device))
+            parts.append(m.reshape(-1))
+    return torch.cat(parts) if parts else torch.zeros(0, dtype=torch.bool, device=device)
+
+
+def noise_row_positions(k: int, p: int, groups=None) -> np.ndarray:
+    """Positions of the noise rows of one fused request: carried group g standing for j, index i ->
+    p + j + 1 + i (default groups (0..K))."""
+    js = np.arange(k + 1) if groups is None else np.asarray(groups)
+    rows = np.arange(len(js) * k)
+    return p + js[rows // k] + 1 + rows % k
+
+
+def fused_requests(num_scheduled: np.ndarray, num_draft: np.ndarray, k: int, groups: int | None = None) -> np.ndarray:
+    """A request is fused iff it is a decode step carrying exactly K + G*K speculative tokens."""
+    e = (k + 1 if groups is None else groups) * k
+    return (num_draft == k + e) & (num_scheduled == 1 + k + e)
