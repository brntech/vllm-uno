+
+def test_layout_bonus_then_noise():
+    # k rows per request: bonus + (k-1) noise; every row is sampled (draft_1 from the bonus row, draft_{j+1}
+    # from noise row j). The former (k+1)-th row was a dead noise row.
+    is_noise, sample_idx, lora_map = uno_query_layout(
+        batch_size=2, k=3, uno_lora_id=5, device="cpu"
+    )
+    assert is_noise.tolist() == [False, True, True, False, True, True]
+    assert sample_idx.tolist() == [0, 1, 2, 3, 4, 5]
+    assert lora_map == (0, 5, 5, 0, 5, 5)
