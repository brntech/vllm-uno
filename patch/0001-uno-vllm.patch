+++ b/vllm/v1/spec_decode/uno_fused.py
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fused single-pass Uno: drafts read off the target forward's hidden states.
+
+With the fused batch layout (see uno_fused_layout.py) the target's verify forward already computed the
+noise groups. After the rejection sampler decides how many drafts each request accepted (j), the next
+K drafts are the predictions of noise group j: argmax under greedy, or a sample with `draft_probs` for
+the rejection sampler under sampling. No second forward.
+"""
+
+import os
+
+import numpy as np
+import torch
+
+from vllm.logger import init_logger
+from vllm.v1.spec_decode.uno_fused_layout import FusedBatchLayout, group_row_offsets
+
+logger = init_logger(__name__)
+
+
+class UnoFusedDrafts:
+    def __init__(self, model, k: int, device: torch.device, probabilistic: bool):
+        self.model = model
+        self.k = k
+        self.device = device
+        self.probabilistic = probabilistic
+        self._last_draft_probs: torch.Tensor | None = None
+        self._step = 0
+
+    def take_last_draft_probs(self) -> torch.Tensor | None:
+        return self._last_draft_probs
+
+    @torch.inference_mode()
+    def propose(
+        self,
+        hidden_states: torch.Tensor,        # expanded-layout hidden states of the target forward
+        layout: FusedBatchLayout,
+        num_accepted: np.ndarray,           # per request: drafts accepted by the rejection sampler
+        sampling_metadata,
+        sample_fn,                          # (logits, sampling_metadata) -> (token_ids, probs|None)
+    ) -> tuple[torch.Tensor, np.ndarray]:
+        """Returns (draft_token_ids [num_fused, K] on GPU, fused request indices)."""
+        self._step += 1
+        self._last_draft_probs = None
+        fused_idx = np.nonzero(layout.fused)[0]
+        if fused_idx.size == 0:
+            return torch.empty(0, self.k, dtype=torch.int64, device=self.device), fused_idx
+        starts = group_row_offsets(layout, num_accepted)[fused_idx]
+        rows = (starts[:, None] + np.arange(self.k)[None, :]).reshape(-1)
+        rows_t = torch.as_tensor(rows, device=self.device)
+        logits = self.model.compute_logits(hidden_states[rows_t])
+        if self.probabilistic and not sampling_metadata.all_greedy:
+            token_ids, probs = sample_fn(logits, sampling_metadata)
+            if probs is not None:
+                self._last_draft_probs = probs.view(-1, self.k, probs.shape[-1]).contiguous()
+        else:
+            token_ids = logits.argmax(dim=-1)
+        if os.environ.get("UNO_DEBUG_DUMP") and self._step <= 4:
+            torch.save({"step": self._step, "rows": rows, "drafts": token_ids.view(-1, self.k).cpu()},
+                       os.path.join(os.environ["UNO_DEBUG_DUMP"], f"uno-fused-dump-step{self._step}.pt"))
+        return token_ids.view(-1, self.k), fused_idx
