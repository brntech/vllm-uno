+@pytest.mark.parametrize("k", [1, 8, 15])
+@pytest.mark.parametrize("seedrow", [False, True])
+def test_capture_rounding_and_dispatch_follow_physical_verify_rows(
+    k, seedrow, row_metadata
+):
+    """Compact K-row batches must hit their own capture bucket at c8/c32."""
+    cfg = SimpleNamespace(
+        num_speculative_tokens=k,
+        speculative_config=SimpleNamespace(uno_seedrow_verify=seedrow),
+    )
+    cfg.verify_row_layout = config_method("vllm/config/vllm.py", "verify_row_layout")(
+        cfg
+    )
+    width = config_method("vllm/config/vllm.py", "uniform_decode_query_len")(cfg)
+    assert width == (k if seedrow else k + 1)
+    compilation = SimpleNamespace(
+        pass_config=SimpleNamespace(enable_sp=False),
+        cudagraph_capture_sizes=list(range(1, 513)),
+        max_cudagraph_capture_size=512,
+    )
+    adjust = config_method(
+        "vllm/config/compilation.py",
+        "adjust_cudagraph_sizes_for_spec_decode",
+        round_up=lambda n, d: (n + d - 1) // d * d,
+    )
+    adjust(compilation, width, 1)
+    assert compilation.cudagraph_capture_sizes == list(range(width, 513, width))
+    assert all(
+        batch * width in compilation.cudagraph_capture_sizes for batch in (8, 32)
+    )
+    cfg.compilation_config = compilation
+    cfg.uniform_decode_query_len = width
+    root = Path(os.environ.get("VLLM_UNO_SOURCE_ROOT", SRC))
+    path = root / "vllm/v1/cudagraph_dispatcher.py"
+    init = next(
+        node
+        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8")))
+        if isinstance(node, ast.FunctionDef) and node.name == "__init__"
+    )
+    setup = []
+    for node in init.body:
+        if isinstance(node, ast.ImportFrom):
+            break
+        setup.append(node)
+    dispatcher = SimpleNamespace()
+    exec(
+        compile(ast.Module(body=setup, type_ignores=[]), str(path), "exec"),
+        {
+            "self": dispatcher,
+            "vllm_config": cfg,
+            "CUDAGraphMode": SimpleNamespace(PIECEWISE="piecewise", FULL="full"),
+        },
+    )
+    assert dispatcher.uniform_decode_query_len == width
