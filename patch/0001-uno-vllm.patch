+++ b/tests/v1/spec_decode/test_uno_sampler_dense.py
@@ -0,0 +1,530 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Sparse verifier against a dense reference of vLLM's own rejection rules.
+
+CPU only, torch and pytest alone. The dense reference reproduces
+``rejection_random_sample_kernel`` / ``sample_recovered_tokens_kernel`` /
+``rejection_greedy_sample_kernel`` in vectorised torch, and takes its truncation
+from the fork's own ``apply_top_k_top_p_pytorch`` when a checkout is reachable
+(``VLLM_UNO_SOURCE_ROOT``/``VLLM_DC_SOURCE_ROOT``, or the fork itself when these
+tests run from the patched tree). Tests that need the pinned source skip
+explicitly when it is absent; a skip is not a pass.
+
+No CUDA kernel, no triton, no vLLM package import.
+"""
+
+import ast
+import importlib.util
+import os
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+SRC = Path(__file__).resolve().parents[3]
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+us = load(SRC / "vllm/v1/spec_decode/uno_sampler.py", "uno_sampler_dense_gate")
+
+PLACEHOLDER = us.PLACEHOLDER_TOKEN_ID
+
+
+def extract(path, name, **scope):
+    """Compile one top-level function out of a source file, decorators removed."""
+    node = next(
+        n
+        for n in ast.parse(path.read_text(encoding="utf-8")).body
+        if isinstance(n, ast.FunctionDef) and n.name == name
+    )
+    node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            node,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    globals_ = {"torch": torch, **scope}
+    exec(compile(module, str(path), "exec"), globals_)
+    return globals_[name]
+
+
+def source_root():
+    for key in ("VLLM_UNO_SOURCE_ROOT", "VLLM_DC_SOURCE_ROOT"):
+        value = os.environ.get(key)
+        if value:
+            return Path(value)
+    return SRC
+
+
+@pytest.fixture(scope="module")
+def pinned_truncation():
+    path = source_root() / "vllm/v1/sample/ops/topk_topp_sampler.py"
+    if not path.exists():
+        pytest.skip(
+            "set VLLM_UNO_SOURCE_ROOT to compare against pinned vLLM truncation"
+        )
+    return extract(path, "apply_top_k_top_p_pytorch")
+
+
+# ---------------------------------------------------------------------------
+# Dense reference: vLLM's rejection rules, written out in vectorised torch.
+# ---------------------------------------------------------------------------
+
+
+def dense_target_probs(logits, temperature, top_k, top_p, truncate):
+    """apply_sampling_constraints followed by the kernel's softmax."""
+    logits = logits.to(torch.float32).clone()
+    logits.div_(temperature.unsqueeze(-1))
+    logits = truncate(logits, top_k, top_p)
+    return logits.softmax(dim=-1, dtype=torch.float32)
+
+
+def dense_rejection_reference(
+    *,
+    draft_token_ids,
+    num_draft_tokens,
+    draft_probs,
+    target_probs,
+    bonus_token_ids,
+    uniform_probs,
+    max_spec_len,
+    recovery_noise,
+):
+    """rejection_random_sample_kernel + sample_recovered_tokens_kernel."""
+    batch = len(num_draft_tokens)
+    out = torch.full((batch, max_spec_len + 1), PLACEHOLDER, dtype=torch.int32)
+    start = 0
+    for req in range(batch):
+        n = num_draft_tokens[req]
+        rejected = False
+        for pos in range(n):
+            row = start + pos
+            draft = int(draft_token_ids[row])
+            coin = uniform_probs[row]
+            q = float(draft_probs[row, draft])
+            p = float(target_probs[row, draft])
+            if draft >= 0 and q > 0 and torch.tensor(p / q, dtype=coin.dtype) >= coin:
+                out[req, pos] = draft
+                continue
+            residual = (target_probs[row] - draft_probs[row]).clamp_min(0.0)
+            out[req, pos] = int((residual / recovery_noise[req]).argmax())
+            rejected = True
+            break
+        if not rejected:
+            out[req, n] = int(bonus_token_ids[req])
+        start += n
+    return out
+
+
+def dense_greedy_reference(
+    *, draft_token_ids, num_draft_tokens, target_argmax, bonus_token_ids, max_spec_len
+):
+    """rejection_greedy_sample_kernel, transcribed."""
+    batch = len(num_draft_tokens)
+    out = torch.full((batch, max_spec_len + 1), PLACEHOLDER, dtype=torch.int32)
+    start = 0
+    for req in range(batch):
+        n = num_draft_tokens[req]
+        rejected = False
+        for pos in range(n):
+            if rejected:
+                continue
+            row = start + pos
+            out[req, pos] = int(target_argmax[row])
+            rejected = int(draft_token_ids[row]) != int(target_argmax[row])
+        if not rejected:
+            out[req, n] = int(bonus_token_ids[req])
+        start += n
+    return out
+
+
+def make_case(seed, batch, k, vocab, top_k_value, top_p_value, truncate):
+    """One synthetic step: dense p/q plus the identical compact supports."""
+    gen = torch.Generator().manual_seed(seed)
+    num_draft_tokens = [k] * batch
+    rows = batch * k
+    target_logits = torch.randn(rows, vocab, generator=gen)
+    draft_logits = torch.randn(rows, vocab, generator=gen)
+    temperature = torch.rand(batch, generator=gen).add(0.5).repeat_interleave(k)
+    top_k = torch.full((rows,), top_k_value, dtype=torch.int32)
+    top_p = None if top_p_value is None else torch.full((rows,), top_p_value)
+
+    dense_p = dense_target_probs(target_logits, temperature, top_k, top_p, truncate)
+    dense_q = dense_target_probs(draft_logits, temperature, top_k, top_p, truncate)
+    sparse_p = us.build_sparse_support(
+        target_logits, temperature, top_k, top_p, top_k_value
+    )
+    sparse_q = us.build_sparse_support(
+        draft_logits, temperature, top_k, top_p, top_k_value
+    )
+    return {
+        "num_draft_tokens": num_draft_tokens,
+        "counts": torch.tensor(num_draft_tokens, dtype=torch.int64),
+        "rows": rows,
+        "vocab": vocab,
+        "gen": gen,
+        "dense_p": dense_p,
+        "dense_q": dense_q,
+        "sparse_p": sparse_p,
+        "sparse_q": sparse_q,
+    }
+
+
+def scatter_support(support, vocab):
+    dense = torch.zeros(support.rows, vocab, dtype=torch.float32)
+    return dense.scatter_(1, support.ids, support.probs)
+
+
+# ---------------------------------------------------------------------------
+# (a) equality with the dense path
+# ---------------------------------------------------------------------------
+
+
+def test_support_probs_match_dense_truncation(pinned_truncation):
+    """top_k = V: the compact support carries exactly the dense distribution."""
+    case = make_case(1, 3, 2, 24, 24, 0.9, pinned_truncation)
+    assert case["sparse_p"].width == 24
+    torch.testing.assert_close(
+        scatter_support(case["sparse_p"], 24), case["dense_p"], rtol=0, atol=1e-6
+    )
+
+
+def test_support_probs_match_dense_truncation_top_k(pinned_truncation):
+    """top_k < V: the same nonzero entries, and zero everywhere else."""
+    case = make_case(2, 4, 3, 64, 9, 0.95, pinned_truncation)
+    dense = case["dense_p"]
+    sparse = scatter_support(case["sparse_p"], 64)
+    assert int((dense > 0).sum()) == int((sparse > 0).sum())
+    torch.testing.assert_close(sparse, dense, rtol=0, atol=1e-6)
+
+
+@pytest.mark.parametrize(
+    "top_k_value,top_p_value", [(24, None), (24, 0.9), (7, None), (7, 0.85)]
+)
+def test_sparse_rejection_bit_identical_to_dense(
+    pinned_truncation, top_k_value, top_p_value
+):
+    """One draft per request, shared coins and shared recovery noise: the two
+    samplers must emit the identical token id, including the recovered one.
+
+    With one draft the rejection row is the request's own row, so the dense
+    reference's per-request full-vocabulary noise can be reordered into the
+    support's column order up front. Entries the truncation removed carry
+    residual exactly zero in both, so a full-vocabulary argmax and a
+    support-only argmax select the same id.
+    """
+    vocab, batch = 24, 96
+    case = make_case(3, batch, 1, vocab, top_k_value, top_p_value, pinned_truncation)
+    gen = case["gen"]
+    drafts = (
+        torch.multinomial(case["dense_q"], 1, generator=gen).view(-1).to(torch.int32)
+    )
+    uniform = torch.rand(batch, dtype=torch.float64, generator=gen)
+    bonus = torch.randint(0, vocab, (batch,), generator=gen, dtype=torch.int32)
+    noise = torch.empty(batch, vocab).exponential_(generator=gen)
+
+    expected = dense_rejection_reference(
+        draft_token_ids=drafts,
+        num_draft_tokens=case["num_draft_tokens"],
+        draft_probs=case["dense_q"],
+        target_probs=case["dense_p"],
+        bonus_token_ids=bonus,
+        uniform_probs=uniform,
+        max_spec_len=1,
+        recovery_noise=noise,
+    )
+    got = us.sparse_rejection_sample(
+        draft_token_ids=drafts,
+        counts=case["counts"],
+        draft_support=case["sparse_q"],
+        target_support=case["sparse_p"],
+        bonus_token_ids=bonus,
+        uniform_probs=uniform,
+        max_spec_len=1,
+        recovery_noise=noise.gather(1, case["sparse_p"].ids),
+    )
+    assert torch.equal(got, expected)
+    assert int((expected[:, 0] != PLACEHOLDER).sum()) == batch
+
+
+def test_sparse_rejection_chain_prefix_matches_dense(pinned_truncation):
+    """Multi-token chains: accepted prefix, chain length and bonus all agree,
+    and the recovered token is drawn from the target support."""
+    vocab, batch, k = 40, 24, 4
+    case = make_case(4, batch, k, vocab, 11, 0.95, pinned_truncation)
+    gen = case["gen"]
+    rows = case["rows"]
+    drafts = (
+        torch.multinomial(case["dense_q"], 1, generator=gen).view(-1).to(torch.int32)
+    )
+    uniform = torch.rand(rows, dtype=torch.float64, generator=gen)
+    bonus = torch.randint(0, vocab, (batch,), generator=gen, dtype=torch.int32)
+
+    expected = dense_rejection_reference(
+        draft_token_ids=drafts,
+        num_draft_tokens=case["num_draft_tokens"],
+        draft_probs=case["dense_q"],
+        target_probs=case["dense_p"],
+        bonus_token_ids=bonus,
+        uniform_probs=uniform,
+        max_spec_len=k,
+        recovery_noise=torch.ones(batch, vocab),
+    )
+    got = us.sparse_rejection_sample(
+        draft_token_ids=drafts,
+        counts=case["counts"],
+        draft_support=case["sparse_q"],
+        target_support=case["sparse_p"],
+        bonus_token_ids=bonus,
+        uniform_probs=uniform,
+        max_spec_len=k,
+        generator=gen,
+    )
+    assert torch.equal(got == PLACEHOLDER, expected == PLACEHOLDER)
+    support_ids = case["sparse_p"].ids
+    for req in range(batch):
+        emitted = [int(v) for v in got[req] if v != PLACEHOLDER]
+        reference = [int(v) for v in expected[req] if v != PLACEHOLDER]
+        assert len(emitted) == len(reference)
+        assert emitted[:-1] == reference[:-1]  # accepted prefix is deterministic
+        if len(emitted) == k + 1:
+            assert emitted[-1] == int(bonus[req])  # every draft accepted
+        else:
+            row = req * k + len(emitted) - 1
+            assert emitted[-1] in set(support_ids[row].tolist())
+    assert any(int((got[r] != PLACEHOLDER).sum()) <= k for r in range(batch))
+
+
+def test_sparse_emitted_token_law_is_exactly_target(pinned_truncation):
+    """Losslessness: the emitted token's law is p, not q, on a compact support."""
+    vocab, width, trials = 32, 6, 60000
+    gen = torch.Generator().manual_seed(11)
+    target_logits = torch.randn(1, vocab, generator=gen).repeat(trials, 1)
+    draft_logits = torch.randn(1, vocab, generator=gen).repeat(trials, 1)
+    temperature = torch.ones(trials)
+    top_k = torch.full((trials,), width, dtype=torch.int32)
+    p = us.build_sparse_support(target_logits, temperature, top_k, None, width)
+    q = us.build_sparse_support(draft_logits, temperature, top_k, None, width)
+    drafts = us.sample_from_support(q, generator=gen).to(torch.int32)
+    counts = torch.ones(trials, dtype=torch.int64)
+    out = us.sparse_rejection_sample(
+        draft_token_ids=drafts,
+        counts=counts,
+        draft_support=q,
+        target_support=p,
+        bonus_token_ids=torch.full((trials,), -7, dtype=torch.int32),
+        uniform_probs=torch.rand(trials, dtype=torch.float64, generator=gen),
+        max_spec_len=1,
+        generator=gen,
+    )
+    emitted = out[:, 0]
+    assert int((emitted == PLACEHOLDER).sum()) == 0
+    observed = torch.zeros(vocab)
+    observed.scatter_add_(0, emitted.to(torch.int64), torch.ones(trials))
+    observed /= trials
+    expected = scatter_support(p, vocab)[0]
+    # 5 sigma on the binomial standard error of each cell.
+    tolerance = 5 * (expected * (1 - expected) / trials).sqrt() + 1e-6
+    assert torch.all((observed - expected).abs() <= tolerance), (observed, expected)
+
+
+def test_sparse_matches_dense_law_under_the_same_q():
+    """Same q for both samplers: the emitted distributions agree cell by cell."""
+    vocab, width, trials = 24, 5, 40000
+    gen = torch.Generator().manual_seed(12)
+    target_logits = torch.randn(1, vocab, generator=gen).repeat(trials, 1)
+    draft_logits = torch.randn(1, vocab, generator=gen).repeat(trials, 1)
+    temperature = torch.ones(trials)
+    top_k = torch.full((trials,), width, dtype=torch.int32)
+    p = us.build_sparse_support(target_logits, temperature, top_k, None, width)
+    q = us.build_sparse_support(draft_logits, temperature, top_k, None, width)
+    dense_p = scatter_support(p, vocab)
+    dense_q = scatter_support(q, vocab)
+    drafts = us.sample_from_support(q, generator=gen).to(torch.int32)
+    uniform = torch.rand(trials, dtype=torch.float64, generator=gen)
+    noise = torch.empty(trials, vocab).exponential_(generator=gen)
+    counts = torch.ones(trials, dtype=torch.int64)
+
+    expected = dense_rejection_reference(
+        draft_token_ids=drafts,
+        num_draft_tokens=[1] * trials,
+        draft_probs=dense_q,
+        target_probs=dense_p,
+        bonus_token_ids=torch.full((trials,), -7, dtype=torch.int32),
+        uniform_probs=uniform,
+        max_spec_len=1,
+        recovery_noise=noise,
+    )
+    got = us.sparse_rejection_sample(
+        draft_token_ids=drafts,
+        counts=counts,
+        draft_support=q,
+        target_support=p,
+        bonus_token_ids=torch.full((trials,), -7, dtype=torch.int32),
+        uniform_probs=uniform,
+        max_spec_len=1,
+        recovery_noise=noise.gather(1, p.ids),
+    )
+    assert torch.equal(got, expected)
+
+
+# ---------------------------------------------------------------------------
+# (b) residual edge cases
+# ---------------------------------------------------------------------------
+
+
+def test_empty_residual_falls_back_to_target():
+    """p == q on the support: a forced rejection still emits a token from p."""
+    ids = torch.tensor([[3, 1, 7]])
+    probs = torch.tensor([[0.5, 0.3, 0.2]])
+    support = us.SparseSupport(ids=ids, probs=probs)
+    out = us.sparse_rejection_sample(
+        draft_token_ids=torch.tensor([3], dtype=torch.int32),
+        counts=torch.tensor([1]),
+        draft_support=support,
+        target_support=us.SparseSupport(ids=ids.clone(), probs=probs.clone()),
+        bonus_token_ids=torch.tensor([99], dtype=torch.int32),
+        uniform_probs=torch.tensor([1.5], dtype=torch.float64),  # forces a reject
+        max_spec_len=1,
+        recovery_noise=torch.tensor([[1.0, 1.0, 1.0]]),
+    )
+    assert int(out[0, 0]) in {3, 1, 7}
+    assert int(out[0, 0]) == 3  # weights fall back to p, whose mode is id 3
+    assert int(out[0, 1]) == PLACEHOLDER
+
+
+def test_residual_excludes_draft_mass():
+    """A normal rejection samples (p - q)+, never the rejected draft itself."""
+    p_ids = torch.tensor([[0, 1, 2]])
+    p_probs = torch.tensor([[0.6, 0.3, 0.1]])
+    q_ids = torch.tensor([[0, 1, 2]])
+    q_probs = torch.tensor([[0.9, 0.1, 0.0]])
+    out = us.sparse_rejection_sample(
+        draft_token_ids=torch.tensor([0], dtype=torch.int32),
+        counts=torch.tensor([1]),
+        draft_support=us.SparseSupport(ids=q_ids, probs=q_probs),
+        target_support=us.SparseSupport(ids=p_ids, probs=p_probs),
+        bonus_token_ids=torch.tensor([99], dtype=torch.int32),
+        uniform_probs=torch.tensor([0.99], dtype=torch.float64),  # 0.6/0.9 < 0.99
+        max_spec_len=1,
+        recovery_noise=torch.tensor([[1.0, 1.0, 1.0]]),
+    )
+    # residual = (0.6-0.9)+, (0.3-0.1)+, (0.1-0)+ = 0, 0.2, 0.1 -> id 1 wins.
+    assert int(out[0, 0]) == 1
+
+
+def test_token_outside_target_support_is_rejected():
+    """q may propose an id that p truncated away; p = 0 there, so it must lose."""
+    out = us.sparse_rejection_sample(
+        draft_token_ids=torch.tensor([5], dtype=torch.int32),
+        counts=torch.tensor([1]),
+        draft_support=us.SparseSupport(
+            ids=torch.tensor([[5, 0]]), probs=torch.tensor([[0.5, 0.5]])
+        ),
+        target_support=us.SparseSupport(
+            ids=torch.tensor([[0, 1]]), probs=torch.tensor([[0.7, 0.3]])
+        ),
+        bonus_token_ids=torch.tensor([99], dtype=torch.int32),
+        # vLLM accepts on `p / q >= u`, so a uniform of exactly 0.0 would accept
+        # even a zero-probability draft; that is why the dense path draws its
+        # coins in float64. Any positive coin rejects here.
+        uniform_probs=torch.tensor([1e-9], dtype=torch.float64),
+        max_spec_len=1,
+        recovery_noise=torch.tensor([[1.0, 1.0]]),
+    )
+    # q puts 0.5 on id 0 and 0.5 on id 5, which p truncated away; the residual
+    # is (0.7-0.5, 0.3-0.0) = (0.2, 0.3), so id 1 wins.
+    assert int(out[0, 0]) == 1
+
+
+# ---------------------------------------------------------------------------
+# (c) greedy fast path
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("seed", range(8))
+def test_greedy_fastpath_matches_kernel(seed):
+    gen = torch.Generator().manual_seed(seed)
+    batch, vocab, max_spec_len = 6, 40, 4
+    counts = torch.randint(0, max_spec_len + 1, (batch,), generator=gen)
+    counts[0] = max_spec_len
+    num_tokens = max(int(counts.sum()), 1)
+    drafts = torch.randint(0, 4, (num_tokens,), generator=gen, dtype=torch.int32)
+    argmax = torch.randint(0, 4, (num_tokens,), generator=gen, dtype=torch.int64)
+    bonus = torch.randint(0, vocab, (batch,), generator=gen, dtype=torch.int32)
+    got = us.greedy_prefix_sample(
+        draft_token_ids=drafts,
+        counts=counts.to(torch.int64),
+        target_argmax=argmax,
+        bonus_token_ids=bonus,
+        max_spec_len=max_spec_len,
+    )
+    expected = dense_greedy_reference(
+        draft_token_ids=drafts,
+        num_draft_tokens=counts.tolist(),
+        target_argmax=argmax,
+        bonus_token_ids=bonus,
+        max_spec_len=max_spec_len,
+    )
+    assert torch.equal(got, expected), (counts.tolist(), got, expected)
+
+
+def test_greedy_fastpath_equals_one_hot_rejection():
+    """(c) in the brief's form: greedy == rejection sampling with q one-hot on
+    the draft and p one-hot on the target argmax."""
+    gen = torch.Generator().manual_seed(21)
+    batch, k, vocab = 5, 3, 16
+    counts = torch.full((batch,), k, dtype=torch.int64)
+    rows = batch * k
+    drafts = torch.randint(0, 5, (rows,), generator=gen, dtype=torch.int32)
+    argmax = torch.randint(0, 5, (rows,), generator=gen, dtype=torch.int64)
+    bonus = torch.randint(0, vocab, (batch,), generator=gen, dtype=torch.int32)
+    greedy = us.greedy_prefix_sample(
+        draft_token_ids=drafts,
+        counts=counts,
+        target_argmax=argmax,
+        bonus_token_ids=bonus,
+        max_spec_len=k,
+    )
+    one_hot_q = us.SparseSupport(
+        ids=drafts.to(torch.int64).view(-1, 1), probs=torch.ones(rows, 1)
+    )
+    one_hot_p = us.SparseSupport(ids=argmax.view(-1, 1), probs=torch.ones(rows, 1))
+    rejected = us.sparse_rejection_sample(
+        draft_token_ids=drafts,
+        counts=counts,
+        draft_support=one_hot_q,
+        target_support=one_hot_p,
+        bonus_token_ids=bonus,
+        uniform_probs=torch.full((rows,), 0.5, dtype=torch.float64),
+        max_spec_len=k,
+        recovery_noise=torch.ones(batch, 1),
+    )
+    assert torch.equal(greedy, rejected)
+
+
+def test_greedy_fastpath_consumes_no_randomness():
+    gen = torch.Generator().manual_seed(5)
+    before = torch.rand(4, generator=gen)
+    state = gen.get_state()
+    us.greedy_prefix_sample(
+        draft_token_ids=torch.tensor([1, 2], dtype=torch.int32),
+        counts=torch.tensor([2]),
+        target_argmax=torch.tensor([1, 3]),
+        bonus_token_ids=torch.tensor([9], dtype=torch.int32),
+        max_spec_len=2,
+    )
+    assert torch.equal(gen.get_state(), state)
+    del before
