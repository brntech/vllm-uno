+    )
+    exec(
+        compile(ast.Module(body=[warmup], type_ignores=[]), str(worker_path), "exec"),
+        {"self": worker, "max_num_reqs": 4, "CUDAGraphMode": NS(NONE="NONE")},
+    )
+    if with_overlap:
