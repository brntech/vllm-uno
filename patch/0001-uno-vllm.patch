+@pytest.mark.parametrize(
+    "mask", [None, torch.tensor([False, False]), torch.tensor([True])]
+)
+def test_unarmed_empty_or_shape_mismatched_hooks_do_no_adapter_work(mask, monkeypatch):
+    wrapper = lora.DraftCostLoRA(
+        _bare_baseline(), fuse_lora=True, noise_only=True, share_a=True
+    )
+    hook = wrapper._make_hook([(torch.ones((2, 3)), torch.ones((4, 2)))], [0, 4])
+    wrapper.arm(mask)
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("no adapter computation is allowed")
+
+    monkeypatch.setattr(torch, "mm", forbidden)
+    monkeypatch.setattr(torch, "bmm", forbidden)
+    output = torch.zeros((2, 4))
+    hook(None, (torch.ones((2, 3)),), output)
+    assert torch.equal(output, torch.zeros_like(output))
+    wrapper.arm(None)
+    assert (
+        wrapper.row_mask is None
+        and wrapper.row_indices is None
+        and not wrapper.all_rows
+    )
+
