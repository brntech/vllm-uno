+                        cudagraph_runtime_mode=mode,
+                        batch_descriptor=batch_desc,
+                        slot_mapping=self._get_slot_mapping(
+                            num_input_tokens, cad.slot_mapping
+                        ),
+                    ),
+                    _dc_profile.span("draft.forward"),
+                ):
+                    hidden_states = self.model(
+                        input_ids=input_ids, positions=positions, inputs_embeds=None
+                    )
+            _lap("forward")
+            sample_hidden_states = (
+                hidden_states[:num_tokens]
+                if getattr(self.speculative_config, "uno_fused_draft_prep", False)
+                else hidden_states[sample_idx]
+            )
+            if self.speculative_config.uno_tree is not None:
+                from vllm.v1.spec_decode.uno_tree import build_tree
+                tree_logits = self.model.compute_logits(sample_hidden_states).float()
+                temperature = sampling_metadata.temperature
+                if temperature is not None:
+                    temperature = temperature.repeat_interleave(k).clamp_min(0)
+                    temperature = torch.where(temperature < 1e-5,
+                                              torch.ones_like(temperature), temperature)
+                    tree_logits = tree_logits / temperature[:, None]
+                marginals = tree_logits.softmax(-1).view(-1, k, tree_logits.shape[-1])
+                options = self.speculative_config.uno_tree
+                self._last_tree = build_tree(marginals, options["K"], options["V"],
+                                             validate=False)
+                return self._last_tree.tokens
+            sparse = None
+            if seedrow_enabled:
+                from vllm.v1.spec_decode.uno_seedrow import SeedWrite
+
+                draft_logits = self.model.compute_logits(sample_hidden_states)
+                # Draft temperature processing mutates logits in place. Retain
+                # base raw logits before it, including every request's seed.
+                seed_logits = draft_logits.view(-1, k, draft_logits.shape[-1])[
+                    :, 0
+                ].clone()
+                self._last_seedrow = SeedWrite(
+                    positions=seed_buffers[1][:num_tokens].view(-1, k)[:, 0].clone(),
+                    slots=seed_buffers[2][:num_tokens].view(-1, k)[:, 0].clone(),
+                    tokens=seed_buffers[0][:num_tokens].view(-1, k)[:, 0].clone(),
