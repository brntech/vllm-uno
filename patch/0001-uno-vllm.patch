+++ b/vllm/v1/spec_decode/uno_tree_attn.py
@@ -0,0 +1,232 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Eager FA2 tree verification with paged prefix and masked current-block attention.
+
+The runner installs explicit step state after preparing physical KV slots and
+logical RoPE positions. It clears that state before the Uno draft pass, including
+on exceptions. Shape alone must never activate tree attention: an ordinary
+prefill can have exactly the same query length as a tree.
+
+Only torch is imported at module load, so the block and merge identities can be
+tested on CPU without a vLLM installation. No tensor is copied to CPU in attention.
+"""
+
+from collections.abc import Callable
+from dataclasses import dataclass
+
+import torch
+
+
+@dataclass(frozen=True)
+class TreeAttentionState:
+    """CPU query spans and committed prefix lengths, plus device block masks.
+
+    ``masks[r]`` includes the anchor row and all scheduled tree nodes. Requests
+    absent from ``masks`` use ordinary causal attention (including chunked
+    prefills). Prefix lengths count KV tokens preceding this query span.
+    """
+
+    query_start_locs: tuple[int, ...]
+    prefix_lens: tuple[int, ...]
+    masks: dict[int, torch.Tensor]
+
+
+_ACTIVE_STATE: TreeAttentionState | None = None
+
+
+def set_tree_attention_state(state: TreeAttentionState | None) -> None:
+    """Install runner-owned state; validate using host metadata only."""
+    global _ACTIVE_STATE
+    if state is not None:
+        starts = state.query_start_locs
+        if not starts or starts[0] != 0 or len(starts) != len(state.prefix_lens) + 1:
+            raise ValueError(
+                "Uno tree query spans must start at zero and match prefix lengths"
+            )
+        if any(type(x) is not int for x in starts + state.prefix_lens):
+            raise ValueError(
+                "Uno tree spans and prefix lengths must be Python integers"
+            )
+        if any(b <= a for a, b in zip(starts, starts[1:])):
+            raise ValueError("Uno tree query spans must be strictly increasing")
+        if any(x < 0 for x in state.prefix_lens):
+            raise ValueError("Uno tree prefix lengths must be nonnegative")
+        for r, mask in state.masks.items():
+            if type(r) is not int or not 0 <= r < len(state.prefix_lens):
+                raise ValueError("Uno tree mask request index is outside the batch")
+            q = starts[r + 1] - starts[r]
+            if mask.dtype != torch.bool or mask.shape != (q, q):
+                raise ValueError("Uno tree mask must be bool [query_len, query_len]")
+        # Copy the dictionary so mutation of the caller's registry cannot swap
+        # a mask between layers in the middle of a target forward.
+        state = TreeAttentionState(starts, state.prefix_lens, dict(state.masks))
+    _ACTIVE_STATE = state
+
+
+def get_tree_attention_state() -> TreeAttentionState | None:
+    return _ACTIVE_STATE
+
+
+def block_attention(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    mask: torch.Tensor,
+    scale: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """GQA attention over one tree block; output [Q,H,D], LSE [H,Q].
+
+    Accumulate scores and probabilities in float32, independently for every
+    query head. The mask has one True for each ancestor, including self. There
+    are no Python loops over nodes, tokens, heads, or vocabulary entries.
+    """
+    if query.ndim != 3 or key.ndim != 3 or value.shape != key.shape:
+        raise ValueError(
+            "Uno tree attention requires Q/K/V in [tokens, heads, head_dim]"
+        )
+    q, h, d = query.shape
+    nk, hkv, dk = key.shape
+    if hkv < 1 or h % hkv or d != dk:
+        raise ValueError("Uno tree attention requires compatible grouped-query heads")
+    if mask.dtype != torch.bool or mask.shape != (q, nk):
+        raise ValueError(
+            "Uno tree attention mask must be bool [query_tokens, key_tokens]"
+        )
+    groups = h // hkv
+    qb = query.reshape(q, hkv, groups, d).float()
+    kb = key.float()
+    vb = value.float()
+    scores = torch.einsum("qhgd,khd->hgqk", qb, kb) * scale
+    scores = scores.masked_fill(~mask[None, None], float("-inf"))
+    lse = torch.logsumexp(scores, dim=-1)
+    # An empty row can arise in adversarial CPU tests. Return the empty
+    # attention state (zero output, -inf LSE), which composes safely in merging.
+    shifted = torch.where(
+        torch.isfinite(lse[..., None]), scores - lse[..., None], -torch.inf
+    )
+    probs = torch.exp(shifted)
+    out = torch.einsum("hgqk,khd->qhgd", probs, vb)
+    return out.reshape(q, h, d).to(query.dtype), lse.reshape(h, q).contiguous()
+
+
+def _validate_runtime(impl, metadata, query, key_cache, value_cache, state) -> None:
+    if getattr(impl, "vllm_flash_attn_version", None) != 2:
+        raise ValueError("uno_tree requires FlashAttention version 2")
+    if getattr(impl, "attn_type", "decoder") != "decoder":
+        raise ValueError("uno_tree requires decoder self-attention")
+    if getattr(impl, "dcp_world_size", 1) != 1:
+        raise ValueError("uno_tree does not support decode context parallelism")
+    if metadata.use_cascade:
+        raise ValueError("uno_tree does not support cascade attention")
+    if metadata.causal is not True:
+        raise ValueError("uno_tree requires ordinary causal decoder attention")
+    window = getattr(impl, "sliding_window", None)
+    if window is not None and tuple(window) != (-1, -1):
+        raise ValueError("uno_tree does not support sliding-window attention")
+    if (
+        getattr(impl, "alibi_slopes", None) is not None
+        or getattr(impl, "logits_soft_cap", 0)
+        or getattr(impl, "sinks", None) is not None
+    ):
+        raise ValueError(
+            "uno_tree does not support ALiBi, soft caps, or attention sinks"
+        )
+    if (
+        getattr(metadata, "mm_prefix_query_range_tensor", None) is not None
+        or getattr(metadata, "rswa_prefix_lens", None) is not None
+    ):
+        raise ValueError(
+            "uno_tree does not support multimodal prefix or R-SWA attention"
+        )
+    if getattr(impl, "kv_cache_dtype", "auto") not in ("auto", "float16", "bfloat16"):
+        raise ValueError("uno_tree requires unquantized fp16/bf16 KV cache")
+    if any(
+        t.dtype not in (torch.float16, torch.bfloat16)
+        for t in (query, key_cache, value_cache)
+    ):
+        raise ValueError("uno_tree requires fp16/bf16 query and KV tensors")
+    if (
+        state.query_start_locs[-1] != metadata.num_actual_tokens
+        or len(state.prefix_lens) + 1 != metadata.query_start_loc.shape[0]
+    ):
+        raise ValueError("Uno tree attention state does not match this forward's batch")
+    if any(m.device != query.device for m in state.masks.values()):
+        raise ValueError("Uno tree masks must already be on the query device")
+
+
+def tree_attention_forward(
+    impl,
+    layer,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    attn_metadata,
+    output: torch.Tensor,
+    *,
+    _flash_attn_func: Callable | None = None,
+    _merge_func: Callable | None = None,
+) -> torch.Tensor:
+    """Dispatch ragged tree and ordinary requests inside ONE target forward.
+
+    Called by FlashAttentionImpl after obtaining paged K/V views, before its
+    regular/cascade branches. Per-request kernel launches are deliberate for
+    this initial eager-only implementation; the target model still runs once.
+    Private callable overrides permit CPU contract tests of the dispatch.
+    """
+    state = get_tree_attention_state()
+    if state is None:
+        raise RuntimeError("Uno tree attention called without explicit runner state")
+    _validate_runtime(impl, attn_metadata, query, key_cache, value_cache, state)
+    if _flash_attn_func is None:
+        from vllm.v1.attention.backends.fa_utils import flash_attn_varlen_func
+
+        _flash_attn_func = flash_attn_varlen_func
+    if _merge_func is None:
+        from vllm.v1.attention.ops.merge_attn_states import merge_attn_states
+
+        _merge_func = merge_attn_states
+
+    for r, prefix_len in enumerate(state.prefix_lens):
+        start, end = state.query_start_locs[r : r + 2]
+        q = end - start
+        mask = state.masks.get(r)
+        query_r = query[start:end]
+        out_r = output[start:end]
+        # CPU starts avoid any .item()/D2H synchronization in attention. The
+        # two-element CUDA cu_seqlens keeps this request's first row at zero.
+        starts_r = attn_metadata.query_start_loc[r : r + 2] - start
+        kwargs = dict(
+            q=query_r,
+            k=key_cache,
+            v=value_cache,
+            cu_seqlens_q=starts_r,
+            max_seqlen_q=q,
+            seqused_k=attn_metadata.seq_lens[r : r + 1],
+            max_seqlen_k=attn_metadata.max_seq_len,
+            softmax_scale=impl.scale,
+            causal=True,
+            window_size=(-1, -1),
+            block_table=attn_metadata.block_table[r : r + 1],
+            fa_version=2,
+        )
+        if mask is None:
+            _flash_attn_func(out=out_r, **kwargs)
+            continue
+
+        block_out, block_lse = block_attention(
+            query_r, key[start:end], value[start:end], mask, impl.scale
+        )
+        if prefix_len == 0:
+            out_r.copy_(block_out)
+            continue
+
+        kwargs.update(
+            seqused_k=kwargs["seqused_k"] - q,
+            causal=False,
+            return_softmax_lse=True,
+        )
+        prefix_out, prefix_lse = _flash_attn_func(**kwargs)
+        _merge_func(out_r, prefix_out, prefix_lse, block_out, block_lse)
+    return output
