@@ -0,0 +1,309 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Optional eager-only application plans for frozen Uno LoRA adapters.
+
+Independent A matrices retain independent latent slices. Exact equal A weights
+may share a latent only inside the same fused module invocation, where the input
+activation is also identical. Nothing is merged into target model weights.
+
+The baseline already excludes clean rows from LoRA GEMMs. ``noise_only`` instead
+reuses active indices and updates only those output rows with index_add_, avoiding
+repeated boolean selection and gathering the output. Callers may supply indices
+from a validated immutable layout cache; otherwise they are computed once per arm.
+"""
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor
+
+
+@dataclass(frozen=True)
+class _Unit:
+    a_index: int
+    b: Tensor
+    slices: tuple[int, ...]
+    widths: tuple[int, ...]
+
+
+class _SlicePlan:
+    """Static packing of one qkv, gate/up, o, or down module's adapter."""
+
+    def __init__(self, specs, offsets, *, fuse_lora: bool, share_a: bool):
+        self.specs = tuple(specs)
+        self.offsets = tuple(offsets)
+        self.fuse_lora = fuse_lora
+        if not self.specs or len(self.offsets) != len(self.specs) + 1:
+            raise ValueError("LoRA slices require one more offset than A/B pairs")
+        first_a = self.specs[0][0]
+        self.unique_as: list[Tensor] = []
+        self.a_for_slice: list[int] = []
+        groups: list[list[int]] = []
+        for index, ((a, b), lo, hi) in enumerate(
+            zip(self.specs, self.offsets[:-1], self.offsets[1:])
+        ):
+            if a.ndim != 2 or b.ndim != 2 or b.shape[1] != a.shape[0]:
+                raise ValueError("LoRA requires A[rank,input] and B[output,rank]")
+            if a.requires_grad or b.requires_grad:
+                raise ValueError("draft-cost LoRA plans require frozen adapter tensors")
+            if a.shape[1] != first_a.shape[1] or hi - lo != b.shape[0] or lo < 0:
+                raise ValueError("LoRA input dimensions or output offsets disagree")
+            if (
+                a.dtype != first_a.dtype
+                or b.dtype != first_a.dtype
+                or a.device != first_a.device
+                or b.device != first_a.device
+            ):
+                raise ValueError("packed LoRA tensors must share dtype and device")
+            match = None
+            if share_a:
+                for candidate, existing in enumerate(self.unique_as):
+                    # One-time exact comparison while installing immutable
+                    # weights; never infer sharing from shapes or layer names.
+                    if a.shape == existing.shape and torch.equal(a, existing):
+                        match = candidate
+                        break
+            if match is None:
+                match = len(self.unique_as)
+                self.unique_as.append(a)
+                groups.append([])
+            self.a_for_slice.append(match)
+            groups[match].append(index)
+
+        self.a_offsets = [0]
+        for a in self.unique_as:
+            self.a_offsets.append(self.a_offsets[-1] + a.shape[0])
+        self.packed_a = None
+        if fuse_lora:
+            self.packed_a = (
+                self.unique_as[0]
+                if len(self.unique_as) == 1
+                else torch.cat(self.unique_as, dim=0)
+            )
+        self.units: list[_Unit] = []
+        if fuse_lora:
+            # If A is truly shared, concatenating its Bs is an ordinary dense
+            # GEMM, with no zero-padded block diagonal or fictitious tied A.
+            for a_index, slices in enumerate(groups):
+                bs = [self.specs[index][1] for index in slices]
+                packed_b = bs[0] if len(bs) == 1 else torch.cat(bs, dim=0)
+                self.units.append(
+                    _Unit(
+                        a_index, packed_b, tuple(slices), tuple(b.shape[0] for b in bs)
+                    )
+                )
+        else:
+            for index, (_, b) in enumerate(self.specs):
+                self.units.append(
+                    _Unit(self.a_for_slice[index], b, (index,), (b.shape[0],))
+                )
+        compatible: dict[tuple[int, int], list[int]] = {}
+        for index, unit in enumerate(self.units):
+            compatible.setdefault(tuple(unit.b.shape), []).append(index)
+        self.b_groups = []
+        for indices in compatible.values():
+            if fuse_lora and len(indices) > 1:
+                packed_b = torch.stack([self.units[index].b for index in indices])
+                self.b_groups.append((tuple(indices), packed_b))
+            else:
+                self.b_groups.extend(((index,), None) for index in indices)
+
+    def compute(self, inputs: Tensor) -> list[Tensor]:
+        if self.packed_a is None:
+            latents = [torch.mm(inputs, a.t()) for a in self.unique_as]
+        else:
+            packed = torch.mm(inputs, self.packed_a.t())
+            latents = [
+                packed[:, lo:hi]
+                for lo, hi in zip(self.a_offsets[:-1], self.a_offsets[1:])
+            ]
+        deltas: list[Tensor | None] = [None] * len(self.specs)
+        for unit_indices, packed_b in self.b_groups:
+            if packed_b is None:
+                unit = self.units[unit_indices[0]]
+                outputs = (torch.mm(latents[unit.a_index], unit.b.t()),)
+            else:
+                packed_inputs = torch.stack(
+                    [latents[self.units[index].a_index] for index in unit_indices]
+                )
+                outputs = torch.bmm(packed_inputs, packed_b.transpose(1, 2)).unbind(0)
+            for unit_index, output in zip(unit_indices, outputs):
+                unit = self.units[unit_index]
+                for slice_index, delta in zip(
+                    unit.slices, output.split(unit.widths, dim=1)
+                ):
+                    deltas[slice_index] = delta
+        return deltas
+
+
+class DraftCostLoRA:
+    """Wrapper retaining UnoGatedLoRA's arm/row_mask contract.
+
+    Adapter tensors must stay immutable after installation. Shape-compatible A/B
+    fusion changes GEMM grouping and therefore may change floating-point rounding.
+    CPU equality tests do not establish GPU bitwise equality or latency improvements.
+    """
+
+    def __init__(self, baseline, *, fuse_lora: bool, noise_only: bool, share_a: bool):
+        self._baseline = baseline
+        self.fuse_lora = fuse_lora
+        self.noise_only = noise_only
+        self.share_a = share_a
+        self.row_indices: Tensor | None = None
+        self.all_rows = False
+        self.plans: list[_SlicePlan] = []
+
+    def __getattr__(self, name):
+        return getattr(self._baseline, name)
+
+    @property
+    def row_mask(self):
+        return self._baseline.row_mask
+
+    def plan_summary(self) -> dict[str, int]:
+        """Startup counters; actual speedups still require GPU measurement."""
+        return {
+            "modules": len(self.plans),
+            "original_a_matrices": sum(len(plan.specs) for plan in self.plans),
+            "unique_a_matrices": sum(len(plan.unique_as) for plan in self.plans),
+            "a_gemm_launches": sum(
+                1 if plan.fuse_lora else len(plan.unique_as) for plan in self.plans
+            ),
+            "b_gemm_launches": sum(len(plan.b_groups) for plan in self.plans),
+        }
+
+    def arm(
+        self,
+        row_mask: Tensor | None,
+        *,
+        row_indices: Tensor | None = None,
+        all_rows: bool = False,
+    ) -> None:
+        """Arm a draft layout; cached indices must equal mask.nonzero().flatten().
+
+        ``all_rows`` is a trusted cache fact and must only be true if every mask row is
+        active. Validated metadata avoids synchronizing CUDA tensors to inspect
+        their values on every arm. Changing the mask requires new indices.
+        """
+        if row_mask is not None and (
+            row_mask.ndim != 1 or row_mask.dtype != torch.bool
+        ):
+            raise ValueError("row_mask must be one-dimensional bool or None")
+        if row_indices is not None:
+            if (
+                row_mask is None
+                or row_indices.ndim != 1
+                or row_indices.dtype != torch.long
+            ):
+                raise ValueError(
+                    "row_indices require an armed mask and one-dimensional int64"
+                )
+            if row_indices.device != row_mask.device:
+                raise ValueError("row_indices and row_mask must share a device")
+        self._baseline.arm(row_mask)
+        self.all_rows = bool(all_rows) if row_mask is not None else False
+        self.row_indices = None
+        if self.noise_only and row_mask is not None and not self.all_rows:
+            self.row_indices = (
+                row_indices
+                if row_indices is not None
+                else row_mask.nonzero(as_tuple=False).flatten()
+            )
+
+    def _make_hook(self, specs, offsets):
+        plan = _SlicePlan(
+            specs, offsets, fuse_lora=self.fuse_lora, share_a=self.share_a
+        )
+        self.plans.append(plan)
+        scale = self._baseline.scale
+
+        def hook(module, inputs, output):
+            mask = self.row_mask
+            if mask is None:
+                return None
+            x = inputs[0]
+            y = output[0] if isinstance(output, tuple) else output
+            if x.shape[0] != mask.shape[0]:
+                return None
+            if self.noise_only:
+                if self.all_rows:
+                    selected = x
+                else:
+                    indices = self.row_indices
+                    if indices is None:
+                        raise RuntimeError(
+                            "noise-only LoRA must be armed with row selection"
+                        )
+                    if indices.numel() == 0:
+                        return None
+                    selected = x.index_select(0, indices)
+            else:
+                selected = x[mask]
+            if selected.shape[0] == 0:
+                return None
+            deltas = plan.compute(selected)
+            if self.noise_only:
+                combined = torch.cat(deltas, dim=1) * scale
+                target = y[:, plan.offsets[0] : plan.offsets[-1]]
+                if self.all_rows:
+                    target.add_(combined)
+                elif target.dtype != combined.dtype:
+                    # index_add_ requires matching dtypes. Preserve the
+                    # baseline's promoted addition before casting back, rather
+                    # than rounding the delta to output dtype prematurely.
+                    updated = target.index_select(0, self.row_indices) + combined
+                    target.index_copy_(0, self.row_indices, updated.to(target.dtype))
+                else:
+                    # Layout-cache indices are unique. This updates noise rows
+                    # directly, without gathering y or touching clean rows.
+                    target.index_add_(0, self.row_indices, combined)
+            else:
+                for delta, lo, hi in zip(deltas, plan.offsets[:-1], plan.offsets[1:]):
+                    y[mask, lo:hi] += delta * scale
+            return None
+
+        return hook
+
+
+def install_draft_cost_lora(
+    gated,
+    model,
+    *,
+    fuse_lora: bool = False,
+    noise_only: bool = False,
+    share_a: bool = False,
+):
+    """Replace hooks once; return the untouched original when every flag is off.
+
+    Call after loading UnoGatedLoRA and assign the result to self.gated_lora. Install
+    new hooks before removing old ones, rolling back if a plan cannot be constructed.
+    The caller must not execute a model forward concurrently with installation.
+    """
+    options = (fuse_lora, noise_only, share_a)
+    if any(type(option) is not bool for option in options):
+        raise ValueError("draft-cost LoRA options must be booleans")
+    if isinstance(gated, DraftCostLoRA):
+        if options == (gated.fuse_lora, gated.noise_only, gated.share_a):
+            return gated
+        raise ValueError(
+            "draft-cost LoRA options cannot change after hook installation"
+        )
+    if not any(options):
+        return gated
+    wrapper = DraftCostLoRA(
+        gated, fuse_lora=fuse_lora, noise_only=noise_only, share_a=share_a
+    )
+    original_factory, original_handles = gated._make_hook, gated._handles
+    gated._handles = []
+    gated._make_hook = wrapper._make_hook
+    try:
+        gated._install(model)
+    except Exception:
+        for handle in gated._handles:
+            handle.remove()
+        gated._handles = original_handles
+        gated._make_hook = original_factory
+        raise
+    for handle in original_handles:
+        handle.remove()
+    return wrapper
