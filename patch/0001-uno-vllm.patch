+@pytest.mark.parametrize("device", ["cpu", "cuda"])
+@pytest.mark.parametrize("widths", [(7, 3, 3), (9, 9), (7,)])
+@pytest.mark.parametrize("batch", [1, 3])
+def test_fold_matches_current_b_updates_and_reuses_static_scratch(
+    device, widths, batch
+):
+    """Independent A ranks must not mix across fused projections on replay."""
+    if device == "cuda" and not torch.cuda.is_available():
+        pytest.skip("CUDA is unavailable")
+    gen = torch.Generator(device=device).manual_seed(18)
+
+    def rand(*shape):
+        return (torch.randn(*shape, generator=gen, device=device) * 0.15).bfloat16()
+
+    pairs = tuple((rand(i + 2, 11), rand(w, i + 2)) for i, w in enumerate(widths))
+    route = overlap.DraftLoRARoute(batch, 11, batch * 11 + 3)
+    weight = rand(sum(widths), 11)
+    original_weight = weight.clone()
+    folded = overlap.SingleAdapterPlan(pairs, widths, fold=True)
+    current = overlap.SingleAdapterPlan(pairs, widths)
+    folded.prepare(route)
+    pointer = None
+    for _ in range(3):
+        x = rand(route.num_tokens, 11)
+        base = x @ weight.t()
+        latent = folded.allocate(x, route)
+        if pointer is not None:
+            assert latent.data_ptr() == pointer
+        pointer = latent.data_ptr()
+        latent.fill_(float("nan"))
+        folded.shrink(x, route, latent)
+        result = folded.expand(latent, base.clone(), route)
+        expected = current.expand(latent, base.clone(), route)
+        rows = torch.arange(route.num_tokens, device=device)
+        noise = (rows < route.total_rows) & (rows % route.k != 0)
+        torch.testing.assert_close(result, expected, atol=0.016, rtol=0.016)
+        torch.testing.assert_close(
+            result, _punica_math(x, base, pairs, noise), atol=0.016, rtol=0.016
+        )
+        assert torch.equal(result[~noise], base[~noise])
+    assert torch.equal(weight, original_weight)
