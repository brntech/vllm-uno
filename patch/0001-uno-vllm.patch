+        with pytest.raises(RuntimeError, match="capture failed"), scope(32):
+            assert resolve(config_api) is default
+            raise RuntimeError("capture failed")
+        assert resolve(config_api)["block_m"] == 16
+    assert resolve(config_api) is default
