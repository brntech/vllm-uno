+def _reference_chain(draft, target_draws):
+    emitted, accepted = [], []
+    for depth, token in enumerate(draft):
+        emitted.append(int(target_draws[depth]))
+        if emitted[-1] != int(token):
+            break
+        accepted.append(depth)
+    else:
+        emitted.append(int(target_draws[len(draft)]))
+    return emitted, accepted
