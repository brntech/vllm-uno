+def test_capture_builds_private_exact_buckets_after_warmup(harness):
+    graphs = dg.UnoDraftGraphRunner()
+    graphs.capture(harness.proposer)
+    assert list(graphs.entries) == [(4, 7, 8), (2, 7, 8), (1, 7, 8)]
+    assert len({id(entry.pool) for entry in graphs.entries.values()}) == 3
+    assert harness.state.forward_calls == 6
+    assert harness.state.synchronizations == 3
+    assert harness.manager._last_mapping is None
+    for (batch, k, verify_width), entry in graphs.entries.items():
+        assert verify_width == k + 1
+        assert entry.input_ids.shape == (batch * k,)
+        assert entry.metadata.query_start_loc.tolist() == list(
+            range(0, (batch + 1) * k, k)
+        )
+        assert entry.metadata.max_seq_len == 256
+        assert entry.metadata.max_num_splits == 1
+        assert (
+            entry.plan
+            is harness.cache.entries[("draft", (batch * k, batch, k, UNO_ID), SLOTS)]
+        )
+        assert entry.input_ids.data_ptr() != harness.proposer.input_ids.data_ptr()
+        assert entry.positions.data_ptr() != harness.proposer.positions.data_ptr()
+        assert entry.metadata.scheduler_metadata is None
+    events = harness.state.events
+    for index, event in enumerate(events):
+        if event == "capture-begin":
+            assert "model-warmup" in events[:index]
+            end = events.index("capture-end", index)
+            assert "install-plan" not in events[index:end]
+            assert "build-metadata" not in events[index:end]
+            assert "captured-plan-copy" in events[index:end]
