+                    num_input_tokens = batch_desc.num_tokens
+                    self.runner.input_ids.gpu[:num_tokens].copy_(self.input_ids[:num_tokens])
+                    self.runner.positions[:num_tokens].copy_(self.positions[:num_tokens])
+                    if num_input_tokens > num_tokens:
