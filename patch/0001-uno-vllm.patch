@@ -0,0 +1,556 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Private, exact-shape transformer graphs for the two-pass Uno draft.
+
+Capture is startup-only, after the runner's graphs. No graph or retained input
+is allocated by a live request. Optional fused input preparation runs inside
+the graph; sampling stays in the proposer. This is not an entire decoding step.
+"""
+
+from contextlib import nullcontext
+from dataclasses import dataclass
+
+import torch
+
+from vllm.v1.spec_decode.metadata import VerifyRowLayout
+from vllm.v1.spec_decode.uno_nosync import _target, wrapper_fingerprint
+
+
+def validate_draft_graph(config, lora_impl):
+    sc = config.speculative_config
+    if not getattr(sc, "uno_draft_full_graph", False):
+        return
+    reasons = []
+    if not sc.use_uno() or not sc.uno_no_host_sync:
+        reasons.append("method=uno and uno_no_host_sync")
+    if lora_impl != "punica":
+        reasons.append("UNO_LORA_IMPL=punica")
+    pc = config.parallel_config
+    for name in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "decode_context_parallel_size",
+        "prefill_context_parallel_size",
+    ):
+        if getattr(pc, name, 1) != 1:
+            reasons.append(f"{name}=1")
+    if getattr(pc, "enable_dbo", False):
+        reasons.append("DBO disabled")
+    if sc.enforce_eager or config.model_config.enforce_eager:
+        reasons.append("eager disabled for target and draft")
+    mode = config.compilation_config.cudagraph_mode
+    if not mode.has_full_cudagraphs():
+        reasons.append("a CUDA graph mode containing FULL")
+    if (
+        getattr(sc, "uno_fused", False)
+        or getattr(sc, "uno_lookup", False)
+        or getattr(sc, "uno_tree", None) is not None
+    ):
+        reasons.append("linear two-pass Uno without fused/lookup/tree")
+    if getattr(config.model_config, "is_multimodal_model", False):
+        reasons.append("a text-only model")
+    if getattr(config.model_config, "enable_sleep_mode", False):
+        reasons.append("sleep mode disabled")
+    if getattr(config.model_config, "rswa_window", None) is not None or getattr(
+        config.model_config, "is_mm_prefix_lm", False
+    ):
+        reasons.append("ordinary causal attention without R-SWA/PrefixLM")
+    offload = getattr(config, "offload_config", None)
+    if getattr(getattr(offload, "uva", None), "cpu_offload_gb", 0) or getattr(
+        getattr(offload, "prefetch", None), "offload_group_size", 0
+    ):
+        reasons.append("weight offloading disabled")
+    if reasons:
+        raise ValueError("uno_draft_full_graph requires " + "; ".join(reasons))
+
+
+def capture_keys(capture_sizes, max_batch_size, k, verify_width=None):
+    """Key exact request buckets by independent draft and verifier widths.
+
+    Ordinary verification has K+1 rows; seed-row reuse has K rows. Dynamic
+    widths without a matching startup capture use the existing draft path.
+    """
+    if k < 1 or max_batch_size < 1:
+        raise ValueError("draft graph batch capacity and widths must be positive")
+    if verify_width is None:
+        verify_width = VerifyRowLayout(k).verify_width
+    if verify_width < 1:
+        raise ValueError("draft graph batch capacity and widths must be positive")
+    return sorted(
+        {
+            (n // verify_width, k, verify_width)
+            for n in capture_sizes
+            if n % verify_width == 0 and 0 < n // verify_width <= max_batch_size
+        },
+        reverse=True,
+    )
+
+
+def device_plan_copies(plan, wrapper):
+    """Bind destinations before capture; omit every host tensor and scalar."""
+    return tuple(
+        (_target(wrapper, name)[: value.shape[0]], value)
+        for name, value in plan.tensors
+        if value.device.type != "cpu"
+    )
+
+
+def copy_buffers(pairs):
+    for target, source in pairs:
+        target.copy_(source, non_blocking=True)
+
+
+@dataclass
+class DraftGraphEntry:
+    graph: object
+    output: torch.Tensor
+    input_ids: torch.Tensor
+    positions: torch.Tensor
+    seq_lens: torch.Tensor
+    block_table: torch.Tensor
+    slot_mapping: torch.Tensor
+    plan: object
+    fingerprint: object
+    slots: tuple
+    # Strong references to ordinary allocations and the graph's private pool.
+    metadata: object
+    pool: object
+    query_start_loc_cpu: torch.Tensor
+    prep_inputs: object = None
+    overlap_binding: object = None
+    overlap_binding_state: object = None
+
+    def overlap_miss_reason(self, manager):
+        if self.overlap_binding is None:
+            return None
+        controller, adapter_id, binding_key = self.overlap_binding
+        if controller.binding_key != binding_key:
+            return "overlap_binding_generation"
+        if not controller.matches(manager, adapter_id):
+            return "overlap_adapter_binding"
+        return None
+
+    def input_miss_reason(
+        self, input_ids, positions, cad, fingerprint, slots, prep_inputs=None
+    ):
+        if self.fingerprint != fingerprint:
+            return "wrapper_fingerprint"
+        if self.slots != slots:
+            return "adapter_slots"
+        for name, target, source in (
+            ("input_ids", self.input_ids, input_ids),
+            ("positions", self.positions, positions),
+            ("seq_lens", self.seq_lens, cad.seq_lens),
+            ("block_table", self.block_table, cad.block_table_tensor),
+            ("slot_mapping", self.slot_mapping, cad.slot_mapping),
+        ):
+            if source.shape != target.shape:
+                return f"{name}_shape"
+            if source.device != target.device or source.dtype != target.dtype:
+                return f"{name}_device_or_dtype"
+        if cad.causal is not True:
+            return "noncausal"
+        if cad.query_start_loc_cpu.device.type != "cpu":
+            return "query_start_loc_cpu_device"
+        if not torch.equal(cad.query_start_loc_cpu, self.query_start_loc_cpu):
+            return "query_start_loc_cpu_layout"
+        if cad.query_start_loc.shape != self.query_start_loc_cpu.shape:
+            return "query_start_loc_shape"
+        for name in ("uno_custom_mask", "rswa_prefix_lens", "mm_req_doc_ranges"):
+            if getattr(cad, name, None) is not None:
+                return name
+        if (self.prep_inputs is None) != (prep_inputs is None):
+            return "prep_mode"
+        if self.prep_inputs is not None:
+            reason = self.prep_inputs.miss_reason(prep_inputs)
+            if reason is not None:
+                return f"prep_{reason}"
+        return None
+
+    def replay(self, input_ids, positions, cad, prep_inputs=None):
+        if self.prep_inputs is not None:
+            self.prep_inputs.copy_from(prep_inputs)
+            self.block_table.copy_(cad.block_table_tensor, non_blocking=True)
+        else:
+            copy_buffers(
+                (
+                    (self.input_ids, input_ids),
+                    (self.positions, positions),
+                    (self.seq_lens, cad.seq_lens),
+                    (self.block_table, cad.block_table_tensor),
+                    (self.slot_mapping, cad.slot_mapping),
+                )
+            )
+        self.graph.replay()
+        return self.output
+
+
+class UnoDraftGraphRunner:
+    def __init__(self):
+        self.entries = {}
+        self.replays = self.fallbacks = 0
+
+    def miss(
+        self,
+        reason,
+        key,
+        manager=None,
+        *,
+        input_ids=None,
+        positions=None,
+        cad=None,
+        prep_inputs=None,
+    ):
+        self.fallbacks += 1
+        if self.fallbacks <= 20 or self.fallbacks % 1000 == 0:
+            from vllm.logger import init_logger
+
+            binding = ""
+            entry = self.entries.get(key)
+
+            def sizes(prep, **tensors):
+                for name in (
+                    "next_token_ids",
+                    "target_positions",
+                    "query_start_loc",
+                    "seq_lens",
+                    "num_rejected_tokens",
+                ):
+                    tensors[f"prep.{name}"] = getattr(prep, name, None)
+                return {
+                    name: tuple(value.shape) if value is not None else None
+                    for name, value in tensors.items()
+                }
+
+            source_sizes = sizes(
+                prep_inputs,
+                input_ids=input_ids,
+                positions=positions,
+                **{
+                    name: getattr(cad, name, None)
+                    for name in (
+                        "seq_lens",
+                        "query_start_loc",
+                        "block_table_tensor",
+                        "slot_mapping",
+                    )
+                },
+            )
+            target_sizes = (
+                sizes(
+                    entry.prep_inputs,
+                    input_ids=entry.input_ids,
+                    positions=entry.positions,
+                    seq_lens=entry.seq_lens,
+                    query_start_loc=entry.query_start_loc_cpu,
+                    block_table_tensor=entry.block_table,
+                    slot_mapping=entry.slot_mapping,
+                )
+                if entry is not None
+                else None
+            )
+            if entry is not None and entry.overlap_binding is not None:
+                controller, adapter_id, generation = entry.overlap_binding
+                live = (
+                    controller.resolve_binding(manager, adapter_id).describe()
+                    if manager is not None
+                    else None
+                )
+                binding = (
+                    f" overlap_capture_generation={generation}"
+                    f" overlap_bound_generation={controller.binding_key}"
+                    f" overlap_capture={entry.overlap_binding_state.describe()}"
+                    f" overlap_bound={controller.binding_state.describe()}"
+                    f" overlap_live={live}"
+                )
+            init_logger(__name__).info(
+                "UNO_DRAFT_GRAPH miss reason=%s key=%s count=%d"
+                " source_sizes=%s target_sizes=%s%s",
+                reason,
+                key,
+                self.fallbacks,
+                source_sizes,
+                target_sizes,
+                binding,
+            )
+        return None
+
+    def replay(
+        self,
+        batch_size,
+        k,
+        input_ids,
+        positions,
+        cad,
+        manager,
+        prep_inputs=None,
+        *,
+        verify_width=None,
+    ):
+        if verify_width is None:
+            verify_width = VerifyRowLayout(k).verify_width
+        key = (batch_size, k, verify_width)
+        entry = self.entries.get(key)
+        if entry is None:
+            reason = "uncaptured_key"
+        elif (reason := entry.overlap_miss_reason(manager)) is not None:
+            pass
+        elif cad.num_reqs != batch_size:
+            reason = "request_count"
+        elif cad.max_query_len != k:
+            reason = "query_width"
+        elif cad.num_actual_tokens != batch_size * k:
+            reason = "token_count"
+        elif cad.max_seq_len > entry.metadata.max_seq_len:
+            reason = "max_seq_len"
+        else:
+            wrapper = manager._get_punica_wrapper("")
+            reason = entry.input_miss_reason(
+                input_ids,
+                positions,
+                cad,
+                wrapper_fingerprint(wrapper),
+                tuple(manager.lora_index_to_id),
+                prep_inputs,
+            )
+        if reason is not None:
+            return self.miss(
+                reason,
+                key,
+                manager,
+                input_ids=input_ids,
+                positions=positions,
+                cad=cad,
+                prep_inputs=prep_inputs,
+            )
+        # Replay writes live device metadata behind the manager's back. Never
+        # let a subsequent native target mapping short-circuit on stale state.
+        manager._last_mapping = manager._last_slot_layout = None
+        output = entry.replay(input_ids, positions, cad, prep_inputs)
+        self.replays += 1
+        return output
+
+    def capture(self, proposer):
+        """Called after verifier capture, with workspace growth already locked."""
+        from vllm.config import CUDAGraphMode
+        from vllm.forward_context import set_forward_context
+        from vllm.logger import init_logger
+        from vllm.lora.layers.utils import LoRAMapping
+        from vllm.lora.ops.triton_ops.utils import uno_draft_lora_config
+        from vllm.v1.attention.backend import CommonAttentionMetadata
+        from vllm.v1.attention.backends.flash_attn import (
+            FlashAttentionMetadataBuilder,
+            get_flash_attn_version,
+        )
+        from vllm.v1.spec_decode.uno_nosync import draft_lora_mapping
+
+        logger = init_logger(__name__)
+        runner = proposer.runner
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("Uno draft capture cannot nest in runner capture")
+        if self.entries:
+            raise RuntimeError("Uno draft graphs have already been captured")
+        groups = proposer.draft_attn_groups
+        if len(groups) != 1 or not isinstance(
+            groups[0].get_metadata_builder(), FlashAttentionMetadataBuilder
+        ):
+            raise ValueError(
+                "uno_draft_full_graph requires one FlashAttention KV group (FA2 or FA3)"
+            )
+        builder = groups[0].get_metadata_builder()
+        if get_flash_attn_version() not in (2, 3):
+            raise ValueError("uno_draft_full_graph requires FA2 or FA3")
+        # Warmup initializes lazy attention helpers in ordinary memory. AOT
+        # scheduling is disabled by build_for_drafting / fast_build below.
+        manager = runner.lora_manager._adapter_manager
+        runner.lora_manager.add_adapter(proposer.lora_request)
+        runner.lora_manager.pin_adapter(proposer.uno_lora_id)
+        manager.activate_adapter(proposer.uno_lora_id)
+        wrapper = manager._get_punica_wrapper("")
+        k = int(proposer.speculative_config.num_speculative_tokens)
+        row_layout = runner.vllm_config.verify_row_layout
+        verify_width = row_layout.verify_width
+        keys = capture_keys(
+            runner.compilation_config.cudagraph_capture_sizes,
+            proposer.max_batch_size,
+            k,
+            verify_width,
+        )
+        block_table = runner.input_batch.block_table[proposer.kv_cache_gid]
+        block_template = block_table.get_device_tensor(proposer.max_batch_size)
+        for batch_size, k, verify_width in keys:
+            n = batch_size * k
+            device = proposer.device
+            # All retained metadata/input allocations happen before cuda.graph.
+            ids = torch.zeros_like(proposer.input_ids[:n])
+            positions = torch.zeros_like(proposer.positions[:n])
+            seq_lens = torch.full((batch_size,), k, dtype=torch.int32, device=device)
+            blocks = torch.zeros_like(block_template[:batch_size])
+            slots = torch.full((n,), -1, dtype=torch.int64, device=device)
+            prep_inputs = None
+            prepare = None
+            if getattr(proposer.speculative_config, "uno_fused_draft_prep", False):
+                from functools import partial
+
+                from vllm.v1.spec_decode.uno_draft_prep import (
+                    DraftPrepInputs,
+                    prepare_uno_draft,
+                )
+
+                # Source positions cover a whole scheduled prefill chunk; the
+                # kernel gathers its last row per request through the live QSL.
+                # Per-request fallback can still pass logical K+1 target rows.
+                position_capacity = batch_size * row_layout.logical_width
+                if getattr(proposer.speculative_config, "uno_first_draft_replay", True):
+                    position_capacity = max(position_capacity, runner.max_num_tokens)
+                prep_inputs = DraftPrepInputs(
+                    torch.zeros(batch_size, dtype=ids.dtype, device=device),
+                    torch.zeros(
+                        position_capacity, dtype=positions.dtype, device=device
+                    ),
+                    torch.arange(batch_size + 1, dtype=torch.int32, device=device)
+                    * verify_width,
+                    torch.full(
+                        (batch_size,), verify_width, dtype=torch.int32, device=device
+                    ),
+                    torch.zeros(batch_size, dtype=torch.int32, device=device),
+                )
+                prepare = partial(
+                    prepare_uno_draft,
+                    prep_inputs,
+                    ids,
+                    positions,
+                    slots,
+                    seq_lens,
+                    blocks,
+                    proposer._draft_prep_step,
+                    k=k,
+                    seed=proposer.uno_noise_seed,
+                    low=proposer.uno_low,
+                    high=proposer.uno_high,
+                    block_size=proposer.block_size,
+                    max_model_len=proposer.max_model_len,
+                )
+            qsl_cpu = torch.arange(batch_size + 1, dtype=torch.int32) * k
+            cad = CommonAttentionMetadata(
+                query_start_loc=qsl_cpu.to(device),
+                query_start_loc_cpu=qsl_cpu,
+                seq_lens=seq_lens,
+                num_reqs=batch_size,
+                num_actual_tokens=n,
+                max_query_len=k,
+                max_seq_len=proposer.max_model_len,
+                block_table_tensor=blocks,
+                slot_mapping=slots,
+                causal=True,
+            )
+            metadata = builder.build_for_drafting(cad, draft_index=0)
+            # Bound FA3 split workspace and capture the non-AOT GPU scheduler.
+            metadata.max_num_splits = max(1, metadata.max_num_splits)
+            per_layer = {name: metadata for name in groups[0].layer_names}
+            slot_dict = {name: slots for name in proposer._draft_attn_layer_names}
+            shape = (n, batch_size, k, proposer.uno_lora_id)
+            manager.set_adapter_mapping_planned(
+                "draft",
+                shape,
+                runner._uno_lora_plans,
+                lambda n=n, batch_size=batch_size, k=k: LoRAMapping(
+                    draft_lora_mapping(n, batch_size, k, proposer.uno_lora_id),
+                    (0,) * batch_size,
+                    is_prefill=True,
+                ),
+            )
+            plan = runner._uno_lora_plans.entries.get(
+                ("draft", shape, tuple(manager.lora_index_to_id))
+            )
+            if plan is None:
+                raise ValueError(
+                    "uno_draft_full_graph requires a snapshotable Punica wrapper"
+                )
+            if not bool(wrapper.prompt_mapping_meta.no_lora_flag_cpu[0]):
+                raise ValueError("Uno draft graph requires base-only LM-head routing")
+            device_copies = device_plan_copies(plan, wrapper)
+
+            def forward(
+                per_layer=per_layer,
+                n=n,
+                slot_dict=slot_dict,
+                ids=ids,
+                positions=positions,
+                prepare=prepare,
+            ):
+                if prepare is not None:
+                    prepare()
+                # NONE bypasses the target's FULL and PIECEWISE wrappers; our
+                # outer graph owns every model kernel and its intermediate pool.
+                with set_forward_context(
+                    per_layer,
+                    proposer.vllm_config,
+                    num_tokens=n,
+                    cudagraph_runtime_mode=CUDAGraphMode.NONE,
+                    slot_mapping=slot_dict,
+                ):
+                    return proposer.model(
+                        input_ids=ids, positions=positions, inputs_embeds=None
+                    )
+
+            overlap = getattr(proposer, "_lora_overlap", None)
+            with (
+                uno_draft_lora_config(active_rows=batch_size * (k - 1)),
+                overlap.draft(manager, proposer.uno_lora_id, batch_size, k, n)
+                if overlap is not None
+                else nullcontext(),
+            ):
+                for _ in range(
+                    max(1, runner.compilation_config.cudagraph_num_of_warmups)
+                ):
+                    forward()
+                torch.cuda.synchronize(device)
+                graph = torch.cuda.CUDAGraph()
+                pool = torch.cuda.graph_pool_handle()
+                with torch.cuda.graph(
+                    graph, pool=pool, stream=torch.cuda.current_stream(device)
+                ):
+                    copy_buffers(device_copies)
+                    output = forward()
+            self.entries[batch_size, k, verify_width] = DraftGraphEntry(
+                graph,
+                output,
+                ids,
+                positions,
+                seq_lens,
+                blocks,
+                slots,
+                plan,
+                wrapper_fingerprint(wrapper),
+                tuple(manager.lora_index_to_id),
+                metadata,
+                pool,
+                qsl_cpu,
+                prep_inputs,
+                (overlap, proposer.uno_lora_id, overlap.binding_key)
+                if overlap is not None
+                else None,
+                overlap.binding_state if overlap is not None else None,
+            )
+            logger.info(
+                "UNO_DRAFT_GRAPH capture batch_size=%d k=%d verify_width=%d",
+                batch_size,
+                k,
+                verify_width,
+            )
+            logger.info(
+                "UNO_DRAFT_OPTIMIZATION capture overlap=%s prep=%s batch_size=%d k=%d",
+                overlap is not None,
+                prep_inputs is not None,
+                batch_size,
+                k,
+            )
+        manager._last_mapping = manager._last_slot_layout = None
+        if getattr(proposer.speculative_config, "uno_fused_draft_prep", False):
+            # Startup capture/warmup launches are not decode steps. The counter
+            # address remains shared by every graph and every eager fallback.
+            proposer._draft_prep_step.zero_()
+        if not self.entries:
+            raise ValueError("uno_draft_full_graph has no eligible capture buckets")
