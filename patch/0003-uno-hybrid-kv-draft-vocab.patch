@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the Uno draft vocabulary (UNO_DRAFT_VOCAB).
+
+The draft head scores only the listed token ids; the list must be integer ids of
+the logical vocabulary, the head must be unsharded, and the restricted logits
+must be the full head's logits for those ids under the same soft cap and scale
+(LogitsProcessor.forward: soft cap first, then scale)."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.worker.gpu.spec_decode.uno import UnoSpeculator
+
+VOCAB = 64      # logical vocabulary
+PADDED = 72     # physical head rows (padding past the logical vocabulary)
+HIDDEN = 16
+
+
+class _Holder(torch.nn.Module):
+    def __init__(self, tp_size: int = 1, soft_cap: float | None = 30.0, scale: float = 1.0):
+        super().__init__()
+        self.lm_head = torch.nn.Linear(HIDDEN, PADDED, bias=False)
+        self.lm_head.tp_size = tp_size
+        self.logits_processor = SimpleNamespace(soft_cap=soft_cap, scale=scale, org_vocab_size=VOCAB)
+
+
+def _proposer(holder: _Holder):
+    instance = object.__new__(UnoSpeculator)
+    instance.use_local_argmax_reduction = False
+    instance.model = torch.nn.ModuleDict({"m": holder})
+    instance.max_num_reqs = 2
+    instance.k = 4
+    return instance
+
+
+def _arm(tmp_path, monkeypatch, ids, holder=None):
+    path = tmp_path / "vocab.json"
+    path.write_text(json.dumps({"token_ids": ids}))
+    monkeypatch.setenv("UNO_DRAFT_VOCAB", str(path))
+    proposer = _proposer(holder or _Holder())
+    UnoSpeculator._arm_draft_vocab(proposer)
+    return proposer
+
+
+def test_unset_keeps_the_full_head(monkeypatch):
+    monkeypatch.delenv("UNO_DRAFT_VOCAB", raising=False)
+    proposer = _proposer(_Holder())
+    UnoSpeculator._arm_draft_vocab(proposer)
+    assert proposer._draft_vocab_weight is None
+
+
+def test_valid_list_arms_and_buffer_spans_the_logical_vocabulary(tmp_path, monkeypatch):
+    proposer = _arm(tmp_path, monkeypatch, [5, 1, 5, 63])
+    assert proposer._draft_vocab_ids.tolist() == [1, 5, 63]
+    assert proposer._draft_vocab_full.shape == (2 * 4, VOCAB)
+    assert torch.isneginf(proposer._draft_vocab_full).all()
+
+
+@pytest.mark.parametrize("ids", [[], [1, 2.0], [1, True], ["3"], [-1, 2], [1, VOCAB], [1, PADDED - 1]])
+def test_malformed_or_out_of_range_lists_are_refused(tmp_path, monkeypatch, ids):
+    with pytest.raises(ValueError, match="UNO_DRAFT_VOCAB"):
+        _arm(tmp_path, monkeypatch, ids)
+
+
+def test_sharded_head_is_refused(tmp_path, monkeypatch):
+    with pytest.raises(ValueError, match="tensor parallel size 1"):
+        _arm(tmp_path, monkeypatch, [1, 2], holder=_Holder(tp_size=2))
+
+
+@pytest.mark.parametrize("soft_cap,scale", [(30.0, 1.0), (None, 1.0), (30.0, 0.5)])
+def test_restricted_logits_equal_the_full_heads_for_listed_ids(tmp_path, monkeypatch, soft_cap, scale):
+    holder = _Holder(soft_cap=soft_cap, scale=scale)
+    ids = [0, 7, 31, 63]
+    proposer = _arm(tmp_path, monkeypatch, ids, holder=holder)
+    hidden = torch.randn(3, HIDDEN)
+    full = hidden @ holder.lm_head.weight.t()
+    if soft_cap is not None:
+        full = torch.tanh(full / soft_cap) * soft_cap
+    full = full * scale
+    got = UnoSpeculator._draft_vocab_logits(proposer, hidden)
+    torch.testing.assert_close(got, full[:, ids])
+    greedy = UnoSpeculator._greedy_sample_draft(proposer, hidden)
+    assert greedy.tolist() == [ids[i] for i in full[:, ids].argmax(dim=-1).tolist()]
