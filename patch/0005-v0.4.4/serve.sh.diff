+is_on() { case ${1,,} in 1|true|yes|on) return 0;; *) return 1;; esac; }
+# v0.4.4: ONE parser for every numeric override. A set, non-empty value is stripped of surrounding whitespace and must
+# then be digits; anything else (+8, 8x, a lone space) is refused here. The width check below, the settings line and
+# the Python block that builds the speculative config all read the parsed value; the engine reads it from the env.
+uint() {
+  local n v
+  for n; do
+    [[ -n ${!n:-} ]] || continue
+    v=${!n}; v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
+    [[ $v =~ ^[0-9]+$ ]] || { echo "$n must be a whole number (got '${!n}')." >&2; exit 2; }
+    printf -v "$n" '%s' "$v"
+  done
+}
+uint UNO_K UNO_PLOOKUP_L UNO_PLOOKUP_MAX_CTX UNO_MASK_TOKEN_ID UNO_NOISE_SEED UNO_NOISE_LOW UNO_MAX_MODEL_LEN
+case ${UNO_RECOMMENDED:-0} in
+  0) ;;
+  1) if [[ $profile != gemma4 ]]; then echo 'UNO_RECOMMENDED=1 applies to UNO_PROFILE=gemma4 only.' >&2; exit 2; fi
+     # v0.4.4: the measured recipe in one switch. ${VAR-default}: a variable already set, even to empty, is kept. An empty
+     # override must mean what the help says, or be refused: an empty UNO_K would fall back to the profile's K=4 and an
+     # empty UNO_PLOOKUP_MAX_CTX with lookup on would drop the length gate, both unmeasured with the rest of the recipe.
+     [[ ${UNO_K-unset} != '' ]] || { echo 'UNO_K= (empty) has no meaning with UNO_RECOMMENDED=1: unset it for K=5, or set a value.' >&2; exit 2; }
+     export UNO_K=${UNO_K-5} UNO_PLOOKUP_L=${UNO_PLOOKUP_L-2} UNO_PLOOKUP_MAX_CTX=${UNO_PLOOKUP_MAX_CTX-4096} \
+       UNO_DRAFT_MOE_TOPK=${UNO_DRAFT_MOE_TOPK-4} UNO_GEMMA_SPLITKV_MULTI=${UNO_GEMMA_SPLITKV_MULTI-1}
+     if [[ -z $UNO_PLOOKUP_MAX_CTX ]] && ((10#${UNO_PLOOKUP_L:-0} > 0)); then
+       echo 'UNO_PLOOKUP_MAX_CTX= (empty) with prompt lookup on would run lookup at every context length: set a length, or UNO_PLOOKUP_L= to turn lookup off.' >&2
+       exit 2
+     fi ;;
+  *) echo 'UNO_RECOMMENDED must be 0 or 1.' >&2; exit 2 ;;
+esac
+# UNO_GEMMA_SPLITKV_MULTI is read here, before the profiles, so that a value no profile handles is refused on any profile.
+case ${UNO_GEMMA_SPLITKV_MULTI:-} in
+  ''|0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff]) multi=0 ;;
+  1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn])
+    multi=1
+    if [[ $profile != gemma4 ]]; then echo 'UNO_GEMMA_SPLITKV_MULTI=1 applies to UNO_PROFILE=gemma4 only.' >&2; exit 2; fi ;;
+  *) echo 'UNO_GEMMA_SPLITKV_MULTI must be 1 or 0 (or true/false, yes/no, on/off).' >&2; exit 2 ;;
+esac
