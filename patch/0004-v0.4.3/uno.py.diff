+    def _refuse_draft_top_k_without_capture(
+        self, cudagraph_mode: CUDAGraphMode
+    ) -> None:
+        """Refuse UNO_DRAFT_MOE_TOPK at startup when capture() will not run.
+
+        The draft top-k variant exists only inside the graphs capture() records,
+        and a real proposal with no captured graph is refused. A launch that
+        never reaches capture() used to start and then stop at its first
+        request: --enforce-eager (the worker skips capture), cudagraph mode NONE
+        or PIECEWISE (no FULL decode graph for the draft), attention without
+        uniform-batch graphs, no capture size that holds one request's draft
+        rows, or a FULL-only mode in which the target captures nothing (the
+        runner calls capture() only after a target capture). Whatever capture()
+        does record is checked against every reachable batch afterwards, in
+        _log_draft_graph_coverage.
+        """
+        if not uno_draft_moe_enabled():
+            return
+        assert self.cudagraph_manager is not None
+        model_config = self.vllm_config.model_config
+        cc = self.vllm_config.compilation_config
+        sizes = sorted(cc.cudagraph_capture_sizes or [])
+        max_size = cc.max_cudagraph_capture_size or 0
+        widths = [self.num_speculative_steps + 1]
+        target_captures = bool(sizes)
+        if target_captures and cudagraph_mode.mixed_mode() == CUDAGraphMode.NONE:
+            # FULL-only: the target captures a uniform decode graph only where a
+            # size rounds up to its verify width within the largest size, as in
+            # CudaGraphManager._init_candidates.
+            widths = plookup_gate_decode_query_lens(widths, self.speculative_config)
+            target_captures = any(
+                -(-s // w) * w <= min(max_size, self.max_num_reqs * w)
+                for s in sizes
+                for w in widths
+            )
+        if model_config is not None and model_config.enforce_eager:
+            reason = "--enforce-eager skips CUDA graph capture"
+        elif cudagraph_mode.decode_mode() != CUDAGraphMode.FULL:
+            reason = (
+                f"cudagraph_mode {cudagraph_mode.name} captures no FULL decode "
+                "graph for the draft"
+            )
+        elif self.cudagraph_manager.cudagraph_mode == CUDAGraphMode.NONE:
+            reason = "the attention backend has no uniform-batch CUDA graph support"
+        elif not self.cudagraph_manager.needs_capture():
+            reason = (
+                f"no cudagraph_capture_sizes entry holds the {self.k} draft rows "
+                "of one request"
+            )
+        elif not target_captures:
+            reason = (
+                "the target model captures no graph at these cudagraph_capture_sizes "
+                "(decode widths "
+                f"{widths}), and draft capture runs only after a target capture"
+            )
+        else:
+            return
+        raise DraftMoEConfigurationError(
+            f"{_DRAFT_MOE_ENV} needs captured draft graphs, and this launch "
+            f"captures none: {reason}. Remove --enforce-eager, use "
+            "cudagraph_mode FULL_AND_PIECEWISE with capture sizes up to "
+            f"max_num_seqs x {self.k} = {self.max_num_reqs * self.k}, or unset "
+            f"{_DRAFT_MOE_ENV}."
+        )
 
