+    def _init_uno_plookup_gate(self) -> None:
+        """Prompt-lookup length gate: requests whose context exceeds UNO_PLOOKUP_MAX_CTX verify only Uno's K drafts.
+
+        Uno + prompt lookup proposes K Uno drafts followed by L lookup tokens (num_spec_tokens = K + L). For a
+        request whose context (prompt + output, in-flight tokens included) is above the threshold, the scheduler
+        schedules only the first K draft rows, so the lookup rows are never verified and cost no verify width.
+        The draft count is chosen from the request's length before the step runs, never from token values.
+        """
+        self._uno_plookup_len = 0
+        self._uno_plookup_max_ctx: int | None = None
+        self._uno_plookup_gated_steps = 0
+        if not self.use_uno:
+            return
+        from vllm.v1.worker.gpu.spec_decode.uno_plookup import (
+            plookup_len_from_env,
+            plookup_max_ctx_from_env,
+        )
+
+        lookup_len = plookup_len_from_env()
+        max_ctx = plookup_max_ctx_from_env()
+        if max_ctx is None or lookup_len == 0:
+            return
+        if self.num_spec_tokens <= lookup_len:
+            raise ValueError("UNO_PLOOKUP_MAX_CTX needs num_speculative_tokens = K + UNO_PLOOKUP_L with K >= 1")
+        self._uno_plookup_len = lookup_len
+        self._uno_plookup_max_ctx = max_ctx
+        logger.info(
+            "Uno prompt lookup gate: L=%d lookup rows only while a request's context is <= %d tokens; "
+            "longer requests verify K=%d Uno drafts",
+            lookup_len,
+            max_ctx,
+            self.num_spec_tokens - lookup_len,
+        )
+
+    def _uno_plookup_gate(self, request: Request, spec_token_ids: list[int]) -> list[int]:
+        """Drop the lookup rows (the last L of K + L) of a request whose context is above the gate."""
+        if self._uno_plookup_max_ctx is None or not spec_token_ids:
+            return spec_token_ids
+        from vllm.v1.worker.gpu.spec_decode.uno_plookup import gated_num_spec
+
+        context_len = request.num_tokens + request.num_output_placeholders
+        n = gated_num_spec(
+            len(spec_token_ids), self._uno_plookup_len, self._uno_plookup_max_ctx, context_len
+        )
+        if n == len(spec_token_ids):
+            return spec_token_ids
+        if self._uno_plookup_gated_steps == 0:
+            logger.info(
+                "Uno prompt lookup gate engaged: context %d > %d, verifying %d of %d draft rows",
+                context_len,
+                self._uno_plookup_max_ctx,
+                n,
+                len(spec_token_ids),
+            )
+        self._uno_plookup_gated_steps += 1
+        return spec_token_ids[:n]
+
     def _uno_output_token_limit(self, request: Request) -> int:
