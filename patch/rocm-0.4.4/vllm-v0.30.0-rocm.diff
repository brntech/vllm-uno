+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""ROCm admission for Uno.
+
+Every Uno platform gate keeps its CUDA condition first and consults this module
+only when that condition fails, so a CUDA process never reaches a decision made
+here. ROCm GPUs are admitted by architecture: only architectures on which the
+Uno exactness and serving checks have been run are listed. Any other ROCm GPU
+keeps the original refusal.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+
+# gfx1201 = Radeon AI PRO R9700 (RDNA4): Uno serving + exactness checked.
+VALIDATED_ROCM_ARCHS = frozenset({"gfx1201"})
+
+
+def rocm_arch(device: Any = None) -> str | None:
+    """The ROCm architecture name of ``device`` (``gfx1201``), or None off ROCm."""
+    from vllm.platforms import current_platform
+
+    if not current_platform.is_rocm() or not torch.cuda.is_available():
+        return None
+    if device is None:
+        device = torch.cuda.current_device()
+    props = torch.cuda.get_device_properties(torch.device(device))
+    name = getattr(props, "gcnArchName", "") or ""
+    return name.split(":", 1)[0] or None
+
+
+def uno_rocm_supported(device: Any = None) -> bool:
+    """Whether ``device`` is a ROCm GPU whose architecture Uno has validated."""
+    try:
+        return rocm_arch(device) in VALIDATED_ROCM_ARCHS
+    except (RuntimeError, AssertionError):
+        return False
