+@_triton.jit
+def _uno_group_slots_kernel(
+    positions_ptr,  # [>= max_tokens] int64, draft-row positions (clamped)
+    slot0_ptr,  # [max_tokens] int64, group-0 slot mapping from the fused preparation
+    table_ptrs,  # [G] uint64, batch-local input block tables
+    table_strides,  # [G] int64
+    table_widths,  # [G] int64
+    block_sizes,  # [G] int32, kernel block sizes
+    slots_ptr,  # [G, max_tokens] int64
+    slots_stride,
+    count,
+    k,
+    max_tokens,
+    PAD_ID: _tl.constexpr,
+    BLOCK: _tl.constexpr,
+):
+    g = _tl.program_id(0) + 1
+    offs = _tl.program_id(1) * BLOCK + _tl.arange(0, BLOCK)
+    in_buf = offs < max_tokens
+    is_row = offs < count
+    table = _tl.cast(_tl.load(table_ptrs + g), _tl.pointer_type(_tl.int32))
+    stride = _tl.load(table_strides + g)
+    width = _tl.load(table_widths + g)
+    bs = _tl.load(block_sizes + g).to(_tl.int64)
+    pos = _tl.load(positions_ptr + offs, mask=is_row, other=0).to(_tl.int64)
+    slot0 = _tl.load(slot0_ptr + offs, mask=is_row, other=PAD_ID)
+    req = (offs // k).to(_tl.int64)
+    bn = pos // bs
+    ok = is_row & (slot0 != PAD_ID) & (bn < width)
+    bid = _tl.load(table + req * stride + bn, mask=ok, other=0).to(_tl.int64)
+    ok = ok & (bid > 0)
+    slot = _tl.where(ok, bid * bs + pos % bs, PAD_ID)
+    _tl.store(slots_ptr + g * slots_stride + offs, slot, mask=in_buf)
+
