+# ROCm gfx12, gemma4 profile: larger attention tiles for prefill-shaped launches, patched into this container's own
+# vLLM before the server starts (release/gfx12_prefill_tiles.py; it refuses, and the server does not start, if the file
+# it patches is not the one it was written for). Decode and verify launches keep vLLM's tiles. R9700_PREFILL_TILES=0
+# skips it.
+if [[ $profile == gemma4 && ${rocm_arch:-} == gfx12 ]]; then
+  "$py" "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/gfx12_prefill_tiles.py" >&2 \
+    || { echo 'The gfx12 prefill-tile patch refused (above); R9700_PREFILL_TILES=0 starts without it.' >&2; exit 2; }
+fi
 exec "${cmd[@]}"
